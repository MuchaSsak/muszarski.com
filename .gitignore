inputs/
workspaces/
# The GitLab job builds inside its own checkout: `workspace/` is the per-job
# scratch tree (payload, prompt, the whole generated repo) and `.seed/` is the
# throwaway the push proof commits from. Neither belongs in this repo, and a
# local reproduction of the pipeline would otherwise offer to commit gigabytes.
/workspace
/.seed
rag_storage/
LightRAG-main/
RAG-Anything-main/
/TODO.md
# only the root level context for Claude Code, not React context/ folders
/context/

tmp.txt
*.log

.claude/session-state
