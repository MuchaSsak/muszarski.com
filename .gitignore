# Private inputs: the root-level context for Claude Code (pstryk code, memo). Never committed.
/context/
# Personal Claude Code rules (loaded with CLAUDE.md; never committed)
/CLAUDE.local.md
.claude/session-state
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/skills/session-handoff
.claude/skills/stop-session
/.tokensave
/.playwright-mcp
/scratchpad

# Third-party site screenshots from research stay local (the repo may go public)
/.claude/project-info/research/inspirations/img/

# Rebrand comps: the owner's media copies and scratch shots stay local
/comps/media/
/comps/shots/.work/

# Raw project media (screen recordings, captures) stay local; only encoded outputs are committed
/assets/**/raw/
# Temporary project captures (placeholders; PstrykWeb ones show third-party content)
/assets/projects/

# NOT `*.txt`: public/robots.txt and public/llms.txt must be tracked
tmp.txt
tmp.json
*.log

# dependencies
node_modules/
# bun: track the text lockfile bun.lock, ignore the binary one
bun.lockb

# build output and caches
dist/
.astro/
.turbo/
.vercel
.cache/
*.tsbuildinfo
__pycache__/
*.pyc

# test and audit output (accepted screenshots live in /screenshots/, scratch in .work/)
test-results/
playwright-report/
lighthouse/
/screenshots/.work/

# env files (names live in .env.example and tech/technologies.md)
.env
.env*.local
!.env.example

# OS
.DS_Store
