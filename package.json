{
  "name": "muszarski-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@package/web",
    "build": "turbo run build",
    "preview": "bun run --cwd=apps/web preview",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "bun run --cwd=apps/web e2e",
    "lhci": "bun run --cwd=apps/web lhci",
    "shots": "bun run --cwd=apps/web shots",
    "fonts": "bun run --cwd=apps/web fonts",
    "i18n:extract": "bun run --cwd=apps/web i18n:extract",
    "fmt": "prettier --write . --log-level warn",
    "wiki": "node .claude/hooks/wiki-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
