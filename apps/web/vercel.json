{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": {
            "pre": "pl"
          }
        }
      ],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": {
            "pre": "es"
          }
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "PL"
            ]
          }
        }
      ],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "AR",
              "BO",
              "CL",
              "CO",
              "CR",
              "CU",
              "DO",
              "EC",
              "ES",
              "GQ",
              "GT",
              "HN",
              "MX",
              "NI",
              "PA",
              "PE",
              "PR",
              "PY",
              "SV",
              "UY",
              "VE"
            ]
          }
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/:page(work|cv|my-life|privacy|terms)/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": {
            "pre": "pl"
          }
        }
      ],
      "destination": "/pl/:page/",
      "permanent": false
    },
    {
      "source": "/:page(work|cv|my-life|privacy|terms)/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": {
            "pre": "es"
          }
        }
      ],
      "destination": "/es/:page/",
      "permanent": false
    },
    {
      "source": "/:page(work|cv|my-life|privacy|terms)/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "PL"
            ]
          }
        }
      ],
      "destination": "/pl/:page/",
      "permanent": false
    },
    {
      "source": "/:page(work|cv|my-life|privacy|terms)/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "AR",
              "BO",
              "CL",
              "CO",
              "CR",
              "CU",
              "DO",
              "EC",
              "ES",
              "GQ",
              "GT",
              "HN",
              "MX",
              "NI",
              "PA",
              "PE",
              "PR",
              "PY",
              "SV",
              "UY",
              "VE"
            ]
          }
        }
      ],
      "destination": "/es/:page/",
      "permanent": false
    },
    {
      "source": "/:page(work|cv|my-life|privacy|terms)/",
      "destination": "/en/:page/",
      "permanent": false
    },
    {
      "source": "/blog/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": {
            "pre": "pl"
          }
        }
      ],
      "destination": "/pl/blog/",
      "permanent": false
    },
    {
      "source": "/blog/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "PL"
            ]
          }
        }
      ],
      "destination": "/pl/blog/",
      "permanent": false
    },
    {
      "source": "/blog/",
      "destination": "/en/blog/",
      "permanent": false
    },
    {
      "source": "/en/blog/how-this-site-was-built/",
      "destination": "/en/blog/case-study/",
      "permanent": true
    },
    {
      "source": "/pl/blog/jak-powstala-ta-strona/",
      "destination": "/pl/blog/case-study/",
      "permanent": true
    },
    {
      "source": "/blog/jak-powstala-ta-strona/",
      "destination": "/pl/blog/case-study/",
      "permanent": true
    },
    {
      "source": "/en/blog/getting-started-with-claude-code/",
      "destination": "/en/blog/how-i-work-with-claude-code/",
      "permanent": true
    },
    {
      "source": "/pl/blog/claude-code-po-polsku/",
      "destination": "/pl/blog/jak-pracuje-z-claude-code/",
      "permanent": true
    },
    {
      "source": "/blog/claude-code-po-polsku/",
      "destination": "/pl/blog/jak-pracuje-z-claude-code/",
      "permanent": true
    },
    {
      "source": "/blog/:slug(case-study|yws-lu-case-study)/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": {
            "pre": "pl"
          }
        }
      ],
      "destination": "/pl/blog/:slug/",
      "permanent": false
    },
    {
      "source": "/blog/:slug(case-study|yws-lu-case-study)/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": {
            "inc": [
              "PL"
            ]
          }
        }
      ],
      "destination": "/pl/blog/:slug/",
      "permanent": false
    },
    {
      "source": "/blog/:slug(analityka-bez-cookies-w-polsce|aplikacja-mobilna-w-pojedynke|astro-czy-nextjs-na-portfolio|claude-code-skille-hooki-mcp-subagenty|cv-strona-i-pdf-z-jednego-zrodla|dlaczego-moje-portfolio-threejs-bylo-wolne|dopasowanie-tekstu-do-szerokosci|efekty-hover-na-telefonach|expo-react-native-czy-natywnie|formularz-kontaktowy-na-statycznej-stronie|jak-pracuje-z-claude-code|lighthouse-16-portfolio-programistow|lingui-czy-i18next|llm-wiki-pamiec-projektu-dla-claude-code|psychologia-w-ux-i-frontendzie|reduced-motion-i-przycisk-pauzy|tlumaczenie-katalogow-lingui-przez-llm|wielojezyczna-strona-astro-z-lingui)/",
      "destination": "/pl/blog/:slug/",
      "permanent": false
    },
    {
      "source": "/blog/:slug/",
      "destination": "/en/blog/:slug/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/sprite-(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/files/mateusz-muszarski-cv-en.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"mateusz-muszarski-cv-en.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://muszarski.com/en/cv/>; rel=\"canonical\""
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/files/mateusz-muszarski-cv-pl.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"mateusz-muszarski-cv-pl.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://muszarski.com/pl/cv/>; rel=\"canonical\""
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/files/mateusz-muszarski-cv-es.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"mateusz-muszarski-cv-es.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://muszarski.com/es/cv/>; rel=\"canonical\""
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
