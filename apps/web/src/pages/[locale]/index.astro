---
/**
 * Home (sheet A-00). Slice 0 renders only the H1 block on the foundation; slice 2 builds the hero and
 * the signature drawing, then the sections follow one slice at a time (working-agreement.md § 9).
 */
import { t } from "lingui-for-astro/macro";

import BaseLayout from "~/components/layout/BaseLayout.astro";
import { SITE } from "~/data/site";
import { localeStaticPaths } from "~/lib/routes";

export const getStaticPaths = localeStaticPaths;

const title = t`Full-stack Developer · TypeScript, React, three.js`;
const description = t`Mateusz Muszarski, a full-stack product engineer from Poland. Web and mobile products in TypeScript, React and Node.js, from the business problem to the shipped app.`;
---

<BaseLayout title={title} description={description} home>
  <section class="shell pt-[clamp(3rem,10vh,8rem)] pb-24" aria-labelledby="hero-title">
    <p class="label text-ink-muted">A-00 · {SITE.name}</p>
    <h1 id="hero-title" class="font-display text-display mt-4 max-w-[14ch] font-extrabold">
      {t`Full-stack product engineer`}
    </h1>
    <!-- PLACEHOLDER: draft subline from brand.md; the owner rewrites it (placeholders.md P6). -->
    <p class="text-lg text-ink-muted mt-6 max-w-[38ch]">
      {t`I turn a business problem into a shipped web or mobile product, and I tell you early what it will cost and what can wait.`}
    </p>
  </section>
</BaseLayout>
