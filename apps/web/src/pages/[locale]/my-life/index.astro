<script>
  import { motionStill } from "~/scripts/motion";

  // A band moves only while it is in view.
  const rows = [...document.querySelectorAll<HTMLElement>("[data-rows] .row")];
  const seen = new IntersectionObserver((entries) => {
    for (const entry of entries) entry.target.classList.toggle("live", entry.isIntersecting);
  });
  for (const row of rows) {
    seen.observe(row);
    // A tap boosts the band for a moment (the hover twin for touch screens).
    let timer = 0;
    row.addEventListener("click", () => {
      row.classList.add("boost");
      clearTimeout(timer);
      timer = window.setTimeout(() => row.classList.remove("boost"), 2400);
    });
  }

  // The departures board: every few seconds, while in view, each flap spins through letters and lands on its own,
  // left to right.
  const ABC = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  for (const board of document.querySelectorAll<HTMLElement>(".m-board")) {
    const flaps = [...board.querySelectorAll<HTMLElement>(".ch")];
    let busy = false;
    const spin = () => {
      if (busy || motionStill() || document.hidden || !board.classList.contains("live")) return;
      busy = true;
      let left = flaps.length;
      flaps.forEach((flap, k) => {
        const own = flap.dataset.ch ?? "";
        if (own.trim() === "" || own === String.fromCharCode(160)) return void (left -= 1);
        let turns = 5 + k * 2;
        const tick = () => {
          flap.classList.remove("flip");
          void flap.offsetWidth;
          flap.classList.add("flip");
          if (turns-- > 0 && !motionStill()) {
            flap.textContent = ABC[Math.floor(Math.random() * ABC.length)]!;
            window.setTimeout(tick, 70);
          } else {
            flap.textContent = own;
            if (--left <= 0) busy = false;
          }
        };
        window.setTimeout(tick, k * 40);
      });
      if (left <= 0) busy = false;
    };
    window.setInterval(spin, 4800);
    board.addEventListener("click", spin);
  }

  // The chat's messages arrive in turn as it scrolls into view. Without the script, or with motion paused, they are
  // simply there.
  if (!motionStill()) {
    for (const chat of document.querySelectorAll<HTMLElement>("[data-chat]")) {
      chat.classList.add("dealing");
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          chat.classList.add("in");
          observer.disconnect();
        },
        { rootMargin: "0px 0px -15% 0px" },
      ).observe(chat);
    }
  }
</script>
