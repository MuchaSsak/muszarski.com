<script>
  // The sticker board: drag a sticker anywhere on the board; it remembers where it was left (this visit only).
  for (const board of document.querySelectorAll<HTMLElement>("[data-board]")) {
    let top = 10;
    for (const sticker of board.querySelectorAll<HTMLElement>(".stk")) {
      let startX = 0;
      let startY = 0;
      let baseX = 0;
      let baseY = 0;
      sticker.addEventListener("pointerdown", (event) => {
        sticker.setPointerCapture(event.pointerId);
        startX = event.clientX;
        startY = event.clientY;
        baseX = parseFloat(sticker.style.getPropertyValue("--dx")) || 0;
        baseY = parseFloat(sticker.style.getPropertyValue("--dy")) || 0;
        sticker.classList.add("held");
        sticker.style.zIndex = String((top += 1));
      });
      sticker.addEventListener("pointermove", (event) => {
        if (!sticker.classList.contains("held")) return;
        // Keep the sticker on the board.
        const box = board.getBoundingClientRect();
        const own = sticker.offsetLeft;
        const ownTop = sticker.offsetTop;
        const dx = Math.max(-own, Math.min(box.width - own - sticker.offsetWidth, baseX + event.clientX - startX));
        const dy = Math.max(-ownTop, Math.min(box.height - ownTop - sticker.offsetHeight, baseY + event.clientY - startY));
        sticker.style.setProperty("--dx", `${dx}px`);
        sticker.style.setProperty("--dy", `${dy}px`);
      });
      const drop = () => sticker.classList.remove("held");
      sticker.addEventListener("pointerup", drop);
      sticker.addEventListener("pointercancel", drop);
    }
  }
  // A tap on a card boosts its toy for a moment (the hover twin for touch screens).
  for (const card of document.querySelectorAll<HTMLElement>("[data-likes] .lk")) {
    let timer = 0;
    card.addEventListener("click", () => {
      card.classList.add("boost");
      clearTimeout(timer);
      timer = window.setTimeout(() => card.classList.remove("boost"), 2400);
    });
  }
</script>
