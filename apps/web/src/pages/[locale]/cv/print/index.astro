---
/**
 * The CV as one plain, ATS-safe column for the PDF (`bun run cv:pdf` prints this page with Playwright). Same data and
 * component as /cv/. noindex and out of the sitemap; no site chrome, no motion, the one site font.
 */
import "~/styles/global.css";

import { createHash } from "node:crypto";

import { t } from "lingui-for-astro/macro";

import CvBody from "~/components/cv/CvBody.astro";
import { CV, cvDigestSource } from "~/data/cv";
import { SITE } from "~/data/site";
import { FONT_FILES } from "~/lib/fonts.gen";
import { localeStaticPaths, pathTo } from "~/lib/routes";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.locals.locale;
const site = Astro.site ?? new URL("http://localhost:4321");
const home = new URL(pathTo(locale), site).href;
const font = FONT_FILES.find((file) => file.preload);
const cvLabel = t`CV`;
// Which CV data this page shows; `bun run cv:pdf` records it next to the PDF and cv.test.ts compares.
const digest = createHash("sha256").update(cvDigestSource(locale)).digest("hex").slice(0, 16);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{SITE.name} – {cvLabel}</title>
    <meta name="author" content={SITE.name} />
    <meta name="description" content={CV.title[locale]} />
    <meta name="cv-digest" content={digest} />
    {font && <link rel="preload" href={font.href} as="font" type="font/woff2" crossorigin />}
  </head>
  <body class="print-body">
    <header class="ph">
      <h1>{SITE.name}</h1>
      <p class="pt">{CV.title[locale]}</p>
      <p class="pa">{CV.availability[locale]}</p>
    </header>
    <CvBody variant="print" siteUrl={home} />
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 12mm 14mm;
  }
  /* Light canvas: the site's dark color-scheme would paint the page margins dark. */
  :root {
    color-scheme: light;
    background: #fff !important;
  }
  body.print-body {
    background: #fff;
    color: #0a0d33;
    min-height: 0;
  }
  body.print-body {
    max-width: 180mm;
    margin: 0 auto;
    padding: 0;
    font-size: 10.5pt;
  }
  .print-body .ph {
    margin-bottom: 12pt;
    padding-bottom: 8pt;
    border-bottom: 3pt solid #0a0d33;
  }
  .print-body h1 {
    margin: 0;
    font-weight: 900;
    font-size: 26pt;
    line-height: 1;
    text-transform: uppercase;
    font-stretch: 80%;
  }
  .print-body .pt {
    margin: 4pt 0 0;
    font-weight: 700;
    font-size: 12pt;
  }
  .print-body .pa {
    margin: 2pt 0 0;
    font-size: 10pt;
  }
</style>
