---
/**
 * The web CV (structure.md § /cv/, requirements.md F11): the same data and sections as the PDF (`~/data/cv`, one
 * source), laid out as a poster sheet, with a direct PDF download (size in the label) and a print stylesheet.
 * ProfilePage + Person JSON-LD. Never edit this page or the PDF alone: change the data, run `bun run cv:pdf`.
 * The site's CV button downloads the PDF and lands here (`CvLink`); the page then confirms the download.
 */
import { statSync } from "node:fs";

import { t } from "lingui-for-astro/macro";

import CvBody from "~/components/cv/CvBody.astro";
import BaseLayout from "~/components/layout/BaseLayout.astro";
import JsonLd from "~/components/seo/JsonLd.astro";
import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { CV } from "~/data/cv";
import { cvPdfHref, SITE } from "~/data/site";
import { chromeLinks } from "~/lib/nav";
import { localeStaticPaths, pathTo } from "~/lib/routes";
import { breadcrumbs, personId, personNode, websiteId } from "~/lib/schema";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const site = Astro.site ?? new URL("http://localhost:4321");
const url = new URL(pathTo(locale, "cv"), site).href;
const pdf = cvPdfHref(locale);
let pdfSize = "";
try {
  pdfSize = `${Math.max(1, Math.round(statSync(`public${pdf}`).size / 1024))} KB`;
} catch {
  // Not generated yet (`bun run cv:pdf`); the launch gate fails on a missing PDF.
}
const [first, last] = SITE.name.split(" ") as [string, string];
const title = t`CV`;
const description = t`The CV of Mateusz Muszarski, full-stack developer: experience, projects, skills, qualifications and languages. Also as a PDF.`;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${url}#webpage`,
      url,
      name: `${title} – ${SITE.name}`,
      description,
      inLanguage: locale,
      isPartOf: { "@id": websiteId(site) },
      mainEntity: { "@id": personId(site) },
    },
    personNode(site, locale),
    breadcrumbs([
      { name: SITE.name, url: new URL(links.home, site).href },
      { name: title, url },
    ]),
  ],
};
---

<BaseLayout title={title} description={description} path="cv" og="cv">
  <JsonLd slot="head" data={graph} />
  <section class="sec field-hero top" aria-labelledby="cv-name">
    <div class="sbar draw">
      <p>{t`Curriculum vitae`}</p>
      <p>{CV.location[locale]}</p>
      <p>{t`Since`} {SITE.since}</p>
    </div>
    <Fit as="h1" id="cv-name" lines={[first, last]} motion="calm" />
    <div class="intro">
      <p class="role rise">{CV.title[locale]}</p>
      <p class="avail rise" style="--d:1">
        <span class="dot" aria-hidden="true"></span>
        {CV.availability[locale]}
      </p>
      <div class="ctas rise" style="--d:2">
        <a class="btn btn-acc" href={pdf} download data-umami-event="cv_download" data-umami-event-source="cv-page" data-umami-event-locale={locale}>
          <Icon name="tb:download" />
          {t`Download PDF`}
          {pdfSize && <small>{pdfSize}</small>}
        </a>
        <button class="btn btn-line" type="button" data-print>
          <Icon name="tb:file-text" />
          {t`Print`}
        </button>
        <a class="btn btn-line" href={links.contact} data-umami-event="cta" data-umami-event-id="contact" data-umami-event-source="cv-page">
          {t`Contact`}
          <Icon name="tb:arrow-right" class="nudge" />
        </a>
        <p class="pdf-note" role="status" data-pdf-note hidden>
          <Icon name="tb:circle-check" />
          {t`Your PDF is downloading. Nothing yet? Use the Download PDF button.`}
        </p>
      </div>
    </div>
  </section>
  <section class="sec field-alt sheet" aria-label={t`CV`}>
    <CvBody variant="page" siteUrl={new URL(links.home, site).href} />
  </section>
</BaseLayout>

<style>
  .top {
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .intro {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
    margin-top: clamp(1.25rem, 2.4vw, 2.25rem);
    padding-top: clamp(0.875rem, 1.6vw, 1.5rem);
    border-top: 3px solid currentColor;
  }
  .role {
    max-width: 16ch;
    margin: 0;
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    font-stretch: 62%;
  }
  .avail {
    display: flex;
    gap: 0.625rem;
    margin: 0;
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .dot {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.375rem;
    border-radius: 50%;
    background: #1fbf5b;
    box-shadow: 0 0 0 2px currentColor;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .pdf-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    flex-basis: 100%;
    max-width: 40ch;
    margin: 0.5rem 0 0;
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .pdf-note :global(.ico) {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.0625rem;
  }
  @media (max-width: 56.25rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media print {
    .top,
    :global(.site-header),
    :global(.site-footer),
    :global(.grain),
    :global(.skip) {
      display: none !important;
    }
    .sheet {
      padding: 0;
      background: #fff;
      color: #000;
    }
  }
</style>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => print());
  // Arrived from a CV button that already started the download: say so (the button above gets the file again).
  try {
    if (sessionStorage.getItem("cv-pdf")) {
      sessionStorage.removeItem("cv-pdf");
      document.querySelector<HTMLElement>("[data-pdf-note]")?.removeAttribute("hidden");
    }
  } catch {
    /* storage blocked: no note */
  }
</script>
