---
/**
 * The CV sheet, the source of the new CV PDF (`bun run cv:sheet` prints it with Playwright; design.md § CV sheet).
 * Same data as /cv/. Until the owner approves the sheet it lives next to the old print route and its PDFs go to
 * comps/cv/ [user 2026-10-08]. noindex and out of the sitemap; no site chrome, no motion, no global CSS: only the
 * sheet's static font instances (a variable font prints as Type 3 glyphs, scripts/cv-fonts.mjs).
 */
import "~/styles/cv-fonts.css";

import { createHash } from "node:crypto";

import { t } from "lingui-for-astro/macro";

import CvSheet from "~/components/cv/CvSheet.astro";
import { CV, cvDigestSource } from "~/data/cv";
import { SITE } from "~/data/site";
import { CV_FONT_FILES } from "~/lib/cv-fonts.gen";
import { localeStaticPaths, pathTo } from "~/lib/routes";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.locals.locale;
const site = Astro.site ?? new URL("http://localhost:4321");
const home = new URL(pathTo(locale), site).href;
const cvLabel = t`CV`;
// Which CV data this sheet shows; `bun run cv:sheet` records it next to the PDF.
const digest = createHash("sha256").update(cvDigestSource(locale)).digest("hex").slice(0, 16);
const keywords = CV.skills.flatMap((group) => group.items).join(", ");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${SITE.name} – ${cvLabel} – ${CV.title[locale]}`}</title>
    <meta name="author" content={SITE.name} />
    <meta name="description" content={CV.summary[locale]} />
    <meta name="keywords" content={keywords} />
    <meta name="cv-site" content={home} />
    <meta name="cv-digest" content={digest} />
    {CV_FONT_FILES.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <CvSheet siteUrl={home} />
  </body>
</html>

<style is:global>
  /* No side margins: Chrome clips anything drawn into a page margin, so the sheet keeps its 14 mm edges as padding
     and the bands bleed to the paper edge. Page 1 has no top margin and no margin text: the band opens it and the
     text layer must start with the name (ATS). Page 2+ carries a running head (the name as outlines, its `content`
     comes from cv-fonts.css: no second name in the text layer) and the page number, so a loose second sheet still
     says whose it is. */
  @page {
    size: A4;
    margin: 18mm 0 14mm;
    /* Same font size as the page number, so the outlines sit on the number's baseline. */
    @top-left {
      padding: 0 0 3.2mm 14mm;
      vertical-align: bottom;
      font-size: 7.6pt;
    }
    @top-right {
      padding: 0 14mm 3.2mm 0;
      content: counter(page) " / " counter(pages);
      vertical-align: bottom;
      font: 800 7.6pt "CV Label";
      color: #2433ff;
    }
  }
  @page :first {
    margin: 0 0 14mm;
    @top-left {
      content: none;
    }
    @top-right {
      content: none;
    }
  }
  :root {
    /* The sheet's density (CvSheet.astro); scripts/cv-sheet.mjs overrides it on <html> while it fits the pages. */
    --d: 0.6;
    color-scheme: light;
    background: #fff;
  }
  body {
    margin: 0;
    background: #fff;
  }
  /* The sheet sets every margin it wants; unscoped, so any class rule of the sheet wins. */
  :is(h1, h2, h3, p, ul) {
    margin: 0;
  }
</style>
