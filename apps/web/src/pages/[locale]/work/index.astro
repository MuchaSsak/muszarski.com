---
/**
 * All projects (structure.md § All projects, requirements.md F04). Three fields, each its own poster [user 2026-10-09:
 * the offset night catalogue was "hard to read", "i even liked the previous simpler version with grid better",
 * "perhaps even the background for them should be seperated so e.g. white"; the X-ray lens is gone ("i dont love
 * it"); the night catalogue is kept as `history/work-night-catalogue`, the TV + spy room as `history/work-tv-spyroom`]:
 * - the head (`work/WorkHero.astro`): the title over a dithered colour field, and a wall of every project as the index,
 * - the catalogue, on the light field: a grid of cards, the four chapters two to a row and the rest three to a row (two
 *   on tablets, one on phones). A card is a plate in the project's colour showing the real thing (a capture of the live
 *   site in a browser window rising from the plate's foot, a product reel, or real text where there is nothing to film:
 *   the CLI's run, Clockful's tests; no drawn scenes), then its number, kind and year, name, one line, the tools and
 *   the actions, the buttons level across a row.
 * - "There's more." (`work/PrivateRepos.astro`) on cobalt, between the catalogue and the footer.
 * No filters and no counts [user 2026-10-08]. Case studies live in the blog (open-questions Q43).
 */
import { t } from "lingui-for-astro/macro";

import BaseLayout from "~/components/layout/BaseLayout.astro";
import JsonLd from "~/components/seo/JsonLd.astro";
import Icon from "~/components/ui/Icon.astro";
import PrivateRepos from "~/components/work/PrivateRepos.astro";
import WorkHero, { type IndexItem, type Thumb } from "~/components/work/WorkHero.astro";
import { type Context, type Project, visibleProjects } from "~/data/projects";
import { SITE } from "~/data/site";
import { thisSitePath } from "~/lib/blog-paths";
import { inPublic } from "~/lib/media";
import { chromeLinks } from "~/lib/nav";
import { localeStaticPaths, pathTo } from "~/lib/routes";
import { pageGraph } from "~/lib/schema";
import { typo } from "~/lib/typography";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
/**
 * Flagships first (chapter order), then the archive in an order that alternates the kinds of plate (a capture, text,
 * a capture...), so neighbours never look alike; a project missing here goes last.
 */
const ARCHIVE = ["this-site", "lingui-translate-ai", "malatro", "yws", "lingotype"];
const rank = (project: Project) => (project.flagship ? project.flagship - 10 : ARCHIVE.indexOf(project.slug) + 1 || 99);
const CONTEXT: Record<Context, string> = {
  client: t`Client work`,
  internship: t`Internship`,
  product: t`Own product`,
  oss: t`Open source`,
  side: t`Personal`,
  course: t`Course`,
};

/**
 * What each plate shows. `shot`: a capture of the owner's live site (public/media/work, temporary captures:
 * design/assets.md), `tall` when it is a long page that scrolls in the window. `reel`: a product loop. `poster`:
 * this site's share card. `tests` / `cli`: real text (Clockful's test run, the CLI's run).
 */
type Media =
  | { kind: "shot"; src: string; url: string; height: number; tall?: boolean }
  | {
      kind: "reel";
      frame: "phone" | "browser";
      url?: string;
      poster: string;
      av1?: string | undefined;
      mp4: string;
      width: number;
      height: number;
      label: string;
    }
  | { kind: "poster" | "tests" | "cli" };
/**
 * A screen recording waiting for its files [user 2026-10-08: Clockful and the club screensaver get videos]: the reel
 * shows once `public/media/work/<slug>.mp4` and `<slug>-poster.webp` are there (`<slug>.av1.mp4` too, optional), and
 * the stand-in shows until then (design/assets.md). The owner's recordings are a 1920 × 942 browser view, cut to
 * 1280 × 628.
 */
const recording = (slug: string, url: string, label: string): Media | undefined => {
  const at = (file: string) => (inPublic(`media/work/${file}`) ? `/media/work/${file}` : undefined);
  const mp4 = at(`${slug}.mp4`);
  const poster = at(`${slug}-poster.webp`);
  return mp4 && poster
    ? { kind: "reel", frame: "browser", url, poster, av1: at(`${slug}.av1.mp4`), mp4, width: 1280, height: 628, label }
    : undefined;
};
const MEDIA: Record<string, Media> = {
  // The owner's recording, cut to the public landing page and the order form (design/assets.md).
  pstrykweb: recording(
    "pstrykweb",
    "pstrykweb.pl",
    t`PstrykWeb: the landing page, then a business owner filling in the order form`,
  ) ?? { kind: "shot", src: "/media/work/pstrykweb.webp", url: "pstrykweb.pl", height: 1800, tall: true },
  linkoglot: {
    kind: "reel",
    frame: "phone",
    poster: "/media/linkoglot/camera-poster.webp",
    av1: "/media/linkoglot/camera.av1.mp4",
    mp4: "/media/linkoglot/camera.mp4",
    width: 320,
    height: 694,
    label: t`Linkoglot camera mode: point the phone at a street, a room, breakfast, a book and a park to learn the words`,
  },
  // The test run is the dossier's (content/projects/neoteric-clockful.md): 49 Vitest + 69 Playwright, RLS on 5/5 tables.
  "neoteric-clockful": recording(
    "neoteric-clockful",
    "localhost:3000",
    t`Neoteric Clockful: a screen recording of the dashboard`,
  ) ?? { kind: "tests" },
  "space-portfolio": {
    kind: "reel",
    frame: "browser",
    url: "3d-space-folio.vercel.app",
    poster: "/media/space/folio-poster.webp",
    av1: "/media/space/folio.av1.mp4",
    mp4: "/media/space/folio.mp4",
    width: 1280,
    height: 628,
    label: t`The space portfolio: the camera flies from Earth past Mars and Jupiter to Neptune`,
  },
  "this-site": { kind: "poster" },
  yws: { kind: "shot", src: "/media/work/yws.webp", url: "yws.lu", height: 1800, tall: true },
  "lingui-translate-ai": { kind: "cli" },
  malatro: { kind: "shot", src: "/media/work/malatro.webp", url: "malatro.vercel.app", height: 450 },
  lingotype: { kind: "shot", src: "/media/work/lingotype.webp", url: "lingotype.vercel.app", height: 450 },
};
/**
 * Only projects with something to show: no "soon" stand-in on any build [owner 2026-10-11]. The club screensaver is
 * off this page for now and comes back with its recording (placeholders.md P24).
 */
const projects = visibleProjects()
  .filter((project) => MEDIA[project.slug])
  .sort((a, b) => rank(a) - rank(b));
const mediaOf = (project: Project) => MEDIA[project.slug] as Media;
/**
 * Each project's colour, light enough for navy text: its tab on the wall, its number chip, the head's accent while it
 * is in play, the primary button's shadow.
 */
const COLOR: Record<string, string> = {
  pstrykweb: "#ffd23f",
  linkoglot: "#ff5b1f",
  "neoteric-clockful": "#c9f24a",
  "space-portfolio": "#ff4fb8",
  "this-site": "#8c94ff",
  "lingui-translate-ai": "#eef0ff",
  malatro: "#ff5b1f",
  yws: "#ffd23f",
  lingotype: "#c9f24a",
};
const color = (project: Project) => COLOR[project.slug] ?? "#8c94ff";
/** The plate's field, where it differs from the colour: this site on its own cobalt, the screensaver on the night. */
const PLATE: Record<string, string> = {
  "this-site": "#2433ff",
  "lingui-translate-ai": "#8c94ff",
};
const plate = (project: Project) => PLATE[project.slug] ?? color(project);
/** The wall's tile for each project: a small capture (public/media/work/thumb), the app's poster, or real text. */
const thumb = (project: Project): Thumb => {
  const media = mediaOf(project);
  if (media.kind === "reel") {
    return media.frame === "phone" ? { src: media.poster, phone: true } : { src: `/media/work/thumb/${project.slug}.webp` };
  }
  if (media.kind === "shot") return { src: `/media/work/thumb/${project.slug}.webp` };
  if (media.kind === "poster") return { src: `/media/work/thumb/this-site-${locale}.webp` };
  return { text: media.kind };
};
/**
 * Each card's width out of six: the chapters two to a row, the rest three to a row, and a short last row of the rest
 * shares its width (two cards: halves; one card: the last four as two rows of halves), so no row ends in a hole. The
 * launch build shows only the projects cleared for it (rights, content/projects.md), so the counts vary.
 */
const flagships = projects.filter((project) => project.flagship);
const rest = projects.length - flagships.length;
const span = (project: Project, k: number) => {
  if (project.flagship) return 3;
  const i = k - flagships.length;
  const tail = rest % 3 === 2 ? 2 : rest % 3 === 1 && rest >= 4 ? 4 : 0;
  return i >= rest - tail ? 3 : 2;
};
const posterSrc = `/media/work/this-site-${locale}.webp`;
const shotAlt = (project: Project) => t`The ${project.name} website, the start of the page`;
const labelPause = t`Pause video`;
const labelPlay = t`Play video`;
const newTab = t`(opens in a new tab)`;

const site = Astro.site ?? new URL("http://localhost:4321");
const title = t`All projects`;
const description = t`Every project by Mateusz Muszarski: client work, his own products, open source and experiments, with the tools, the year and the links.`;
const url = new URL(pathTo(locale, "work"), site).href;
const index: IndexItem[] = projects.map((project) => ({
  slug: project.slug,
  name: project.name,
  color: color(project),
  thumb: thumb(project),
}));
---

<BaseLayout title={title} description={description} path="work" current="work" og="work">
  <JsonLd
    slot="head"
    data={pageGraph(site, url, "CollectionPage", `${title} – ${SITE.name}`, description, locale, [
      { name: SITE.name, url: new URL(links.home, site).href },
      { name: title, url },
    ])}
  />
  <WorkHero items={index} />

  <section class="sec field-alt pj-sec" aria-label={t`Projects`}>
    <ol class="pj-list" role="list">
      {projects.map((project, k) => {
        const media = mediaOf(project);
        const primary = project.anchor
          ? { href: links.project(project.anchor), label: t`Chapter`, external: false }
          : project.links.caseStudy
            ? { href: thisSitePath(locale), label: t`Case study`, external: false }
            : project.links.live
              ? { href: project.links.live, label: t`Live site`, external: true }
              : project.links.npm
                ? { href: project.links.npm, label: "npm", external: true }
                : project.links.code
                  ? { href: project.links.code, label: t`Code`, external: true }
                  : undefined;
        return (
          <li
            class:list={["pj", { wide: span(project, k) === 3, rv: k > 1 }]}
            id={`wk-${project.slug}`}
            style={`--c:${color(project)};--plate:${plate(project)};--span:${span(project, k)}`}
          >
            <div class:list={["pj-plate", `m-${media.kind}`, media.kind === "reel" && `f-${media.frame}`]}>
              {(media.kind === "shot" || media.kind === "poster") && (
                <div class:list={["pj-win", { tall: media.kind === "shot" && media.tall }]}>
                  <span class="w-bar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span class="w-url">{media.kind === "shot" ? media.url : "muszarski.com"}</span>
                  </span>
                  <span class="w-view">
                    {media.kind === "shot" ? (
                      <img
                        src={media.src}
                        alt={shotAlt(project)}
                        width="720"
                        height={media.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <img
                        src={posterSrc}
                        alt={t`This site's home page as a share card`}
                        width="960"
                        height="504"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                </div>
              )}
              {media.kind === "reel" && (
                <figure class="pj-reel" data-reel style={`--ar:${media.width} / ${media.height}`}>
                  <div class={media.frame === "phone" ? "w-phone" : "pj-win"}>
                    {media.frame === "browser" && (
                      <span class="w-bar" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                        <span class="w-url">{media.url}</span>
                      </span>
                    )}
                    <span class="w-view">
                      <img
                        class="r-poster"
                        src={media.poster}
                        alt=""
                        width={media.width}
                        height={media.height}
                        loading="lazy"
                        decoding="async"
                      />
                      <video
                        tabindex="-1"
                        muted
                        loop
                        playsinline
                        preload="none"
                        width={media.width}
                        height={media.height}
                        aria-label={media.label}
                      >
                        <template>
                          {media.av1 && <source src={media.av1} type='video/mp4; codecs="av01.0.05M.08"' />}
                          <source src={media.mp4} type="video/mp4" />
                        </template>
                      </video>
                      <span class="bigplay" aria-hidden="true">
                        <Icon name="tbf:player-play" />
                      </span>
                      <button
                        class="r-hit"
                        type="button"
                        data-toggle
                        aria-pressed="true"
                        aria-label={labelPlay}
                        data-label-pause={labelPause}
                        data-label-play={labelPlay}
                      />
                    </span>
                  </div>
                </figure>
              )}
              {media.kind === "tests" && (
                <div class="pj-win pj-term" aria-hidden="true">
                  <span class="w-bar">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="w-view pj-txt">
                    <span class="x-row">
                      <span>Vitest</span>
                      <b>49 passed</b>
                    </span>
                    <span class="x-row">
                      <span>Playwright</span>
                      <b>69 passed</b>
                    </span>
                    <span class="x-row">
                      <span>Row-level security</span>
                      <b>5/5 tables</b>
                    </span>
                    <span class="x-sum">
                      <Icon name="tb:circle-check" />
                      118 passed
                    </span>
                  </span>
                </div>
              )}
              {media.kind === "cli" && (
                <div class="pj-win pj-term" aria-hidden="true">
                  <span class="w-bar">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="w-view pj-txt">
                    <span class="x-cmd">
                      <b>$</b> npx lingui-translate-ai
                    </span>
                    <span class="x-dim">reading src/locales/en/messages.po</span>
                    {["pl", "es", "de"].map((code) => (
                      <span class="x-ok">
                        <Icon name="tb:check" /> {code}/messages.po
                      </span>
                    ))}
                    <span class="x-caret" />
                  </span>
                </div>
              )}
            </div>

            <div class="pj-cap">
              <p class="pj-meta">
                <span class="pj-n tabular" aria-hidden="true">
                  {String(k + 1).padStart(2, "0")}
                </span>
                <span>{CONTEXT[project.context]}</span>
                <span class="tabular">{project.year}</span>
              </p>
              <h2 class="pj-name">{project.name}</h2>
              <p class="pj-line">{typo(locale, project.line[locale])}</p>
              <p class="pj-tools">
                <span class="sr-only">{t`Tools`}: </span>
                {project.stack.join(" · ")}
              </p>
              <div class="pj-go">
                {primary && (
                  <a
                    class="btn btn-inv"
                    href={primary.href}
                    rel={primary.external ? "noopener" : undefined}
                    target={primary.external ? "_blank" : undefined}
                    data-umami-event={primary.external ? "outbound" : project.links.caseStudy ? "case_open" : "cta"}
                    data-umami-event-project={project.slug}
                  >
                    {primary.label}
                    <Icon name={primary.external ? "tb:arrow-up-right" : "tb:arrow-right"} class="nudge" />
                    {primary.external && <span class="sr-only"> {newTab}</span>}
                  </a>
                )}
                {project.anchor && project.links.live && (
                  <a
                    class="pj-link"
                    href={project.links.live}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="live"
                    data-umami-event-project={project.slug}
                  >
                    {t`Live`}
                    <Icon name="tb:arrow-up-right" />
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.appStore && (
                  <a
                    class="pj-link"
                    href={project.links.appStore}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="app-store"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:apple" />
                    App Store
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.googlePlay && (
                  <a
                    class="pj-link"
                    href={project.links.googlePlay}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="google-play"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:googleplay" />
                    Google Play
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.npm && primary?.label !== "npm" && (
                  <a
                    class="pj-link"
                    href={project.links.npm}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="npm"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:npm" />
                    npm
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.code && primary?.href !== project.links.code && (
                  <a
                    class="pj-link"
                    href={project.links.code}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="code"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:github" />
                    {t`Code`}
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.slug === "neoteric-clockful" && <span class="pj-note">{t`Code private · walkthrough on request`}</span>}
                {/* The reel shows Solar System Scope's planet textures: their CC BY credit goes where they are seen. */}
                {project.slug === "space-portfolio" && (
                  <span class="pj-note">
                    {t`Planet textures:`} <!-- prettier-ignore -->
                    <span><a href="https://www.solarsystemscope.com/textures/" rel="noopener" target="_blank">Solar System Scope<span class="sr-only"> {newTab}</span></a>, <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0<span class="sr-only"> {newTab}</span></a></span>
                  </span>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
  <PrivateRepos />
</BaseLayout>

<style>
  /* The light field: the catalogue reads on paper, apart from the night head and the cobalt end. */
  .pj-sec {
    --mute: #474b70; /* navy at ~75% on white, as a solid colour (no faded text), 8:1 */
    padding-top: clamp(3rem, 6vw, 6rem);
  }

  /* Six columns: a chapter takes three (two to a row), the rest two (three to a row). */
  .pj-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 3.5rem) clamp(1.25rem, 2.2vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* `--u` is about 1% of a plate's width, per layout: sizes inside the plate scale with it without making the plate a
     size container (a container inside the grid cost whole extra layouts on load, lessons.md). The card is its own
     white field, so its primary button reads --sbg / --sfg, with the project's colour as the shadow. */
  .pj {
    --u: min(0.3vw, 5.8px);
    --sbg: #fff;
    --sfg: var(--navy);
    --pop: var(--c);
    grid-column: span var(--span, 2);
    display: grid;
    grid-template-rows: auto 1fr;
    border: 2px solid var(--navy);
    background: #fff;
    color: var(--navy);
    box-shadow: 6px 6px 0 var(--navy);
    transition:
      translate 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .pj.wide {
    --u: min(0.46vw, 8.8px);
  }
  @media (hover: hover) and (pointer: fine) {
    .pj:hover {
      translate: -3px -3px;
      box-shadow: 9px 9px 0 var(--navy);
    }
  }

  /* The plate: a flat field in the project's colour; what it shows sits on its foot. */
  .pj-plate {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 2px solid var(--navy);
    background: var(--plate);
  }

  /* A browser window rising from the plate's foot: a thin bar (the Mac lights and the address), then the page. */
  .pj-win {
    position: absolute;
    inset: 10% 8% 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--navy);
    border-bottom: 0;
    border-radius: 0.625rem 0.625rem 0 0;
    background: #fff;
    transition: translate 0.45s var(--ease-out);
  }
  .w-bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: max(5px, calc(0.75 * var(--u)));
    height: max(1.625rem, calc(3.6 * var(--u)));
    padding: 0 max(0.625rem, calc(1.6 * var(--u)));
    background: var(--navy);
    color: #c9cbe0;
  }
  .w-bar i {
    width: max(7px, calc(0.95 * var(--u)));
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff5f57;
  }
  .w-bar i:nth-child(2) {
    background: #febc2e;
  }
  .w-bar i:nth-child(3) {
    background: #28c840;
  }
  .w-url {
    margin-left: max(0.5rem, calc(1.2 * var(--u)));
    font-weight: 700;
    font-size: max(0.6875rem, calc(1.3 * var(--u)));
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .w-view {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  .w-view img,
  .w-view video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  @media (hover: hover) and (pointer: fine) {
    .pj:is(:hover, :focus-within) .pj-win {
      translate: 0 -3%;
    }
  }
  /* A long page scrolls down in its window on hover or focus; on touch screens the scroll of the page drives it. */
  .tall .w-view img {
    transition: object-position 6s cubic-bezier(0.45, 0, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .pj:is(:hover, :focus-within) .tall .w-view img {
      object-position: 50% 100%;
    }
  }
  /* Longhands, never the shorthand: the minifier folds the timeline into `animation`, which Chrome rejects. Reduced
     motion keeps the top of the page: the global reduce rule shortens durations, which a scroll timeline ignores. */
  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .tall .w-view img {
        animation-name: pj-pan;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 15% cover 85%;
      }
      :global(.still) .tall .w-view img {
        animation: none !important;
      }
    }
  }
  @keyframes pj-pan {
    to {
