<script>
  import "~/scripts/reel";
  import { motionStill } from "~/scripts/motion";

  // Type pills: one pressed at a time; cards of other types hide. The change animates where view transitions exist.
  const filter = document.querySelector<HTMLElement>("[data-filter]");
  if (filter) {
    const cards = [...document.querySelectorAll<HTMLElement>("[data-grid] > .wk-card")];
    const pills = [...filter.querySelectorAll<HTMLButtonElement>("[data-value]")];
    for (const pill of pills) {
      pill.addEventListener("click", () => {
        const value = pill.dataset.value ?? "";
        const apply = () => {
          pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
          for (const card of cards) card.hidden = !!value && card.dataset.context !== value;
        };
        if ("startViewTransition" in document && !motionStill()) document.startViewTransition(apply);
        else apply();
      });
    }
  }
</script>
