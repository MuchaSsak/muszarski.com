---
/**
 * All projects (structure.md § All projects, requirements.md F04). The night catalogue [user 2026-10-08: the card
 * wall "has gone too much with illustrations and looks too vibe coded", "a better and different design, experiment
 * with shaders, and interesting components", "a different style and theme"; the TV + spy room version is kept in
 * `comps/history/work-tv-spyroom/`]. One ink field from the head to the end, hairlines instead of frames and hard
 * shadows, colour only where it means a project:
 * - the head (`work/WorkHero.astro`): a title on a live contour map, and an index of every project,
 * - the catalogue: every project as a plate and a caption, in an offset two-column rhythm (a wide plate beside a
 *   narrow one, the right column a step lower; one column on phones). A plate shows the real thing: a capture of the
 *   live site in a browser window rising from the plate's foot, a product reel, or real text where there is nothing
 *   to film (the CLI's run, Clockful's tests). No drawn scenes.
 * - the X-ray (`scripts/work-xray.ts`): a pointer over a capture opens a square inspector lens that shows the page's
 *   structure (its edges on a blueprint grid); on touch screens a scan line passes over the capture in the middle of
 *   the screen, and keyboard focus sends one too.
 * - "There's more." (`work/PrivateRepos.astro`).
 * No filters and no counts [user 2026-10-08]. Case studies live in the blog (open-questions Q43).
 */
import { t } from "lingui-for-astro/macro";

import BaseLayout from "~/components/layout/BaseLayout.astro";
import JsonLd from "~/components/seo/JsonLd.astro";
import Icon from "~/components/ui/Icon.astro";
import PrivateRepos from "~/components/work/PrivateRepos.astro";
import WorkHero, { type IndexItem } from "~/components/work/WorkHero.astro";
import { type Context, type Project, visibleProjects } from "~/data/projects";
import { SITE } from "~/data/site";
import { thisSitePath } from "~/lib/blog-paths";
import { inPublic } from "~/lib/media";
import { chromeLinks } from "~/lib/nav";
import { localeStaticPaths, pathTo } from "~/lib/routes";
import { pageGraph } from "~/lib/schema";
import { typo } from "~/lib/typography";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
/**
 * Flagships first (chapter order), then the archive in an order that alternates the kinds of plate (a capture, text,
 * a capture...), so neighbours never look alike; a project missing here goes last.
 */
const ARCHIVE = ["this-site", "lingui-translate-ai", "malatro", "yws", "lingotype", "club-screensaver"];
const rank = (project: Project) => (project.flagship ? project.flagship - 10 : ARCHIVE.indexOf(project.slug) + 1 || 99);
const projects = visibleProjects().sort((a, b) => rank(a) - rank(b));
const CONTEXT: Record<Context, string> = {
  client: t`Client work`,
  internship: t`Internship`,
  product: t`Own product`,
  oss: t`Open source`,
  side: t`Personal`,
  course: t`Course`,
};

/**
 * What each plate shows. `shot`: a capture of the owner's live site (public/media/work, temporary captures:
 * design/assets.md), `tall` when it is a long page that scrolls in the window. `reel`: a product loop. `poster`:
 * this site's share card. `tests` / `cli`: real text (Clockful's test run, the CLI's run). `soon`: nothing to show yet.
 */
type Media =
  | { kind: "shot"; src: string; url: string; height: number; tall?: boolean }
  | {
      kind: "reel";
      frame: "phone" | "browser";
      url?: string;
      poster: string;
      av1?: string | undefined;
      mp4: string;
      width: number;
      height: number;
      label: string;
    }
  | { kind: "poster" | "tests" | "cli" | "soon" };
/**
 * A screen recording waiting for its files [user 2026-10-08: Clockful and the club screensaver get videos]: the reel
 * shows once `public/media/work/<slug>.mp4` and `<slug>-poster.webp` are there (`<slug>.av1.mp4` too, optional), and
 * the stand-in shows until then (design/assets.md).
 */
const recording = (slug: string, url: string, label: string): Media | undefined => {
  const at = (file: string) => (inPublic(`media/work/${file}`) ? `/media/work/${file}` : undefined);
  const mp4 = at(`${slug}.mp4`);
  const poster = at(`${slug}-poster.webp`);
  return mp4 && poster
    ? { kind: "reel", frame: "browser", url, poster, av1: at(`${slug}.av1.mp4`), mp4, width: 1280, height: 720, label }
    : undefined;
};
const MEDIA: Record<string, Media> = {
  pstrykweb: { kind: "shot", src: "/media/work/pstrykweb.webp", url: "pstrykweb.pl", height: 1800, tall: true },
  linkoglot: {
    kind: "reel",
    frame: "phone",
    poster: "/media/linkoglot/camera-poster.webp",
    av1: "/media/linkoglot/camera.av1.mp4",
    mp4: "/media/linkoglot/camera.mp4",
    width: 320,
    height: 694,
    label: t`Linkoglot camera mode: point the phone at a street, a room, breakfast, a book and a park to learn the words`,
  },
  // The test run is the dossier's (content/projects/neoteric-clockful.md): 49 Vitest + 69 Playwright, RLS on 5/5 tables.
  "neoteric-clockful": recording(
    "neoteric-clockful",
    "localhost:3000",
    t`Neoteric Clockful: a screen recording of the dashboard`,
  ) ?? { kind: "tests" },
  "space-portfolio": {
    kind: "reel",
    frame: "browser",
    url: "3d-space-folio.vercel.app",
    // The cockpit's start screen (a capture of the live site) says more than the flight's first, mostly black frame.
    poster: "/media/work/space-portfolio.webp",
    av1: "/media/space/flight.av1.mp4",
    mp4: "/media/space/flight.mp4",
    width: 960,
    height: 540,
    label: t`The space portfolio: the camera flies past Mars to Jupiter`,
  },
  "this-site": { kind: "poster" },
  yws: { kind: "shot", src: "/media/work/yws.webp", url: "yws.lu", height: 1800, tall: true },
  "lingui-translate-ai": { kind: "cli" },
  malatro: { kind: "shot", src: "/media/work/malatro.webp", url: "malatro.vercel.app", height: 450 },
  lingotype: { kind: "shot", src: "/media/work/lingotype.webp", url: "lingotype.vercel.app", height: 450 },
  // PLACEHOLDER (placeholders.md P24): "Recording soon" until the screensaver's recording lands in its video slot.
  "club-screensaver": recording(
    "club-screensaver",
    "beniaminek03-screensaver.vercel.app",
    t`The club screensaver: the particles in motion`,
  ) ?? { kind: "soon" },
};
/** Each project's colour, readable on the ink: its number, its rule, its plate's tint, the button's shadow, the map. */
const COLOR: Record<string, string> = {
  pstrykweb: "#ffd23f",
  linkoglot: "#ff5b1f",
  "neoteric-clockful": "#c9f24a",
  "space-portfolio": "#ff4fb8",
  "this-site": "#8c94ff",
  "lingui-translate-ai": "#eef0ff",
  malatro: "#ff5b1f",
  yws: "#ffd23f",
  lingotype: "#c9f24a",
  "club-screensaver": "#8c94ff",
};
const color = (project: Project) => COLOR[project.slug] ?? "#8c94ff";
/** Where each plate's contour rings centre (x %, y %): every plate shows a different patch of the map. */
const MAP = [
  [18, 115],
  [92, -18],
  [112, 62],
  [-12, 30],
  [55, 122],
  [96, 108],
  [4, -22],
  [72, -28],
  [-16, 96],
  [118, 12],
] as const;
const posterSrc = `/media/work/this-site-${locale}.webp`;
const shotAlt = (project: Project) => t`The ${project.name} website, the start of the page`;
const labelPause = t`Pause video`;
const labelPlay = t`Play video`;
const newTab = t`(opens in a new tab)`;
const soon = t`Recording soon`;

const site = Astro.site ?? new URL("http://localhost:4321");
const title = t`All projects`;
const description = t`Every project by Mateusz Muszarski: client work, his own products, open source and experiments, with the tools, the year and the links.`;
const url = new URL(pathTo(locale, "work"), site).href;
const index: IndexItem[] = projects.map((project) => ({
  slug: project.slug,
  name: project.name,
  kind: CONTEXT[project.context],
  year: project.year,
  color: color(project),
}));
---

<BaseLayout title={title} description={description} path="work" current="work" og="work">
  <JsonLd
    slot="head"
    data={pageGraph(site, url, "CollectionPage", `${title} – ${SITE.name}`, description, locale, [
      { name: SITE.name, url: new URL(links.home, site).href },
      { name: title, url },
    ])}
  />
  <WorkHero items={index} />

  <section class="sec wk" aria-label={t`Projects`}>
    <ol class="wk-list" role="list">
      {projects.map((project, k) => {
        const media = MEDIA[project.slug] ?? { kind: "soon" as const };
        // Rows alternate a wide plate and a narrow one; the right column sits a step lower (wide screens only).
        const side = k % 2 ? "r" : "l";
        const wide = (Math.floor(k / 2) % 2 === 0) === (side === "l");
        const primary = project.anchor
          ? { href: links.project(project.anchor), label: t`Chapter`, external: false }
          : project.links.caseStudy
            ? { href: thisSitePath(locale), label: t`Case study`, external: false }
            : project.links.live
              ? { href: project.links.live, label: t`Live site`, external: true }
              : project.links.npm
                ? { href: project.links.npm, label: "npm", external: true }
                : project.links.code
                  ? { href: project.links.code, label: t`Code`, external: true }
                  : undefined;
        return (
          <li
            class:list={["wk-item", side, wide ? "wide" : "narrow", { rv: k > 1 }]}
            id={`wk-${project.slug}`}
            style={`--c:${color(project)};--ox:${MAP[k % MAP.length]![0]}%;--oy:${MAP[k % MAP.length]![1]}%`}
            data-wk
          >
            <div class:list={["wk-plate", `m-${media.kind}`, media.kind === "reel" && `f-${media.frame}`]}>
              {(media.kind === "shot" || media.kind === "poster") && (
                <div class:list={["wk-win", { tall: media.kind === "shot" && media.tall }]}>
                  <span class="w-bar" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span class="w-url">{media.kind === "shot" ? media.url : "muszarski.com"}</span>
                  </span>
                  <span class="w-view" data-xray>
                    {media.kind === "shot" ? (
                      <img
                        src={media.src}
                        alt={shotAlt(project)}
                        width="720"
                        height={media.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <img
                        src={posterSrc}
                        alt={t`This site's home page as a share card`}
                        width="960"
                        height="504"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                </div>
              )}
              {media.kind === "reel" && (
                <figure class="wk-reel" data-reel>
                  <div class={media.frame === "phone" ? "w-phone" : "wk-win"}>
                    {media.frame === "browser" && (
                      <span class="w-bar" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                        <span class="w-url">{media.url}</span>
                      </span>
                    )}
                    <span class="w-view">
                      <video
                        tabindex="-1"
                        muted
                        loop
                        playsinline
                        preload="none"
                        poster={media.poster}
                        width={media.width}
                        height={media.height}
                        aria-label={media.label}
                      >
                        {media.av1 && <source data-src={media.av1} type='video/mp4; codecs="av01.0.05M.08"' />}
                        <source data-src={media.mp4} type="video/mp4" />
                      </video>
                      <span class="bigplay" aria-hidden="true">
                        <Icon name="tbf:player-play" />
                      </span>
                      <button
                        class="r-hit"
                        type="button"
                        data-toggle
                        aria-pressed="true"
                        aria-label={labelPlay}
                        data-label-pause={labelPause}
                        data-label-play={labelPlay}
                      />
                    </span>
                  </div>
                </figure>
              )}
              {media.kind === "tests" && (
                <div class="wk-txt" aria-hidden="true">
                  <span class="x-row">
                    <span>Vitest</span>
                    <b>49 passed</b>
                  </span>
                  <span class="x-row">
                    <span>Playwright</span>
                    <b>69 passed</b>
                  </span>
                  <span class="x-row">
                    <span>Row-level security</span>
                    <b>5/5 tables</b>
                  </span>
                  <span class="x-sum">
                    <Icon name="tb:circle-check" />
                    118 passed
                  </span>
                </div>
              )}
              {media.kind === "cli" && (
                <div class="wk-txt" aria-hidden="true">
                  <span class="x-cmd">
                    <b>$</b> npx lingui-translate-ai
                  </span>
                  <span class="x-dim">reading src/locales/en/messages.po</span>
                  {["pl", "es", "de"].map((code) => (
                    <span class="x-ok">
                      <Icon name="tb:check" /> {code}/messages.po
                    </span>
                  ))}
                  <span class="x-caret" />
                </div>
              )}
              {media.kind === "soon" && (
                <div class="wk-soon">
                  <Icon name="tb:movie" />
                  <span>{soon}</span>
                </div>
              )}
            </div>

            <div class="wk-cap">
              <p class="wk-meta">
                <span class="wk-n tabular" aria-hidden="true">
                  {String(k + 1).padStart(2, "0")}
                </span>
                <span class="wk-rule" aria-hidden="true" />
                <span>{CONTEXT[project.context]}</span>
                <span class="tabular">{project.year}</span>
              </p>
              <h2 class="wk-name">{project.name}</h2>
              <p class="wk-line">{typo(locale, project.line[locale])}</p>
              <p class="wk-tools">
                <span class="sr-only">{t`Tools`}: </span>
                {project.stack.join(" · ")}
              </p>
              <div class="wk-go">
                {primary && (
                  <a
                    class="btn btn-inv"
                    href={primary.href}
                    rel={primary.external ? "noopener" : undefined}
                    target={primary.external ? "_blank" : undefined}
                    data-umami-event={primary.external ? "outbound" : project.links.caseStudy ? "case_open" : "cta"}
                    data-umami-event-project={project.slug}
                  >
                    {primary.label}
                    <Icon name={primary.external ? "tb:arrow-up-right" : "tb:arrow-right"} class="nudge" />
                    {primary.external && <span class="sr-only"> {newTab}</span>}
                  </a>
                )}
                {project.anchor && project.links.live && (
                  <a
                    class="wk-link"
                    href={project.links.live}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="live"
                    data-umami-event-project={project.slug}
                  >
                    {t`Live`}
                    <Icon name="tb:arrow-up-right" />
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.appStore && (
                  <a
                    class="wk-link"
                    href={project.links.appStore}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="app-store"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:apple" />
                    App Store
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.googlePlay && (
                  <a
                    class="wk-link"
                    href={project.links.googlePlay}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="google-play"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:googleplay" />
                    Google Play
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.npm && primary?.label !== "npm" && (
                  <a
                    class="wk-link"
                    href={project.links.npm}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="npm"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:npm" />
                    npm
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.links.code && primary?.href !== project.links.code && (
                  <a
                    class="wk-link"
                    href={project.links.code}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target="code"
                    data-umami-event-project={project.slug}
                  >
                    <Icon name="si:github" />
                    {t`Code`}
                    <span class="sr-only"> {newTab}</span>
                  </a>
                )}
                {project.slug === "neoteric-clockful" && <span class="wk-note">{t`Code private · walkthrough on request`}</span>}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
  <PrivateRepos />
</BaseLayout>

<style>
  /* The night field, shared by the catalogue (buttons read --sbg / --sfg). */
  .wk {
    --sbg: var(--space);
    --sfg: var(--ice);
    --hair: rgb(238 240 255 / 0.14);
    --mute: #b2b4c6; /* ice at 74% on the ink, as a solid colour (no faded text) */
    --stagger: clamp(3rem, 6vw, 7rem);
    padding-top: clamp(1rem, 3vw, 2.5rem);
    background: var(--space);
    color: var(--ice);
  }

  /* The rhythm: twelve columns; a row is a wide plate (7) and a narrow one (5), swapping sides each row, and the right
     column a step lower. */
  .wk-list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    gap: clamp(3.5rem, 5.5vw, 6.5rem) clamp(2rem, 4vw, 5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* `--u` is about 1% of a plate's width, per layout: sizes inside the plate scale with it without making the plate a
     size container (a container inside the grid cost whole extra layouts on load, lessons.md). */
  .wk-item {
    --u: 0.9vw;
    --pop: var(--c);
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }
  /* Wide screens only: the placements out-rank the tablet and phone grids, so they live behind the query. */
  @media (width > 64rem) {
    .wk-item.wide {
      --u: min(0.53vw, 10.2px);
    }
    .wk-item.narrow {
      --u: min(0.37vw, 7.1px);
    }
    .wk-item.l.wide {
      grid-column: 1 / span 7;
    }
    .wk-item.l.narrow {
      grid-column: 1 / span 5;
    }
    .wk-item.r.narrow {
      grid-column: 8 / span 5;
    }
    .wk-item.r.wide {
      grid-column: 6 / span 7;
    }
    .narrow .wk-plate.f-phone {
      aspect-ratio: 4 / 5;
    }
  }
  /* The step is layout, not a transform: a translated tall plate ran into the next row and covered its own buttons. */
  .wk-item.l {
    margin-bottom: var(--stagger);
  }
  .wk-item.r {
    margin-top: var(--stagger);
  }

  /* The plate: a dark field engraved with the head's contour lines in the project's colour, each plate its own patch
     of the map (`--ox`, `--oy`); what it shows sits on its foot. */
  .wk-plate {
    --ring: color-mix(in srgb, var(--c) 22%, transparent);
    --gap: clamp(1.25rem, 2.4vw, 3rem);
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      repeating-radial-gradient(
        circle at var(--ox, 18%) var(--oy, 115%),
        transparent 0 var(--gap),
        var(--ring) var(--gap) calc(var(--gap) + 1px)
      ),
      #0c0e2b;
    box-shadow: inset 0 0 0 1px var(--hair);
    transition: --ring 0.6s var(--ease-out);
  }
  @property --ring {
    syntax: "<color>";
    inherits: false;
    initial-value: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .wk-item:hover .wk-plate {
      --ring: color-mix(in srgb, var(--c) 42%, transparent);
    }
  }

  /* A browser window rising from the plate's foot: a thin bar (the Mac lights and the address), then the page. */
  .wk-win {
    position: absolute;
    inset: 9% 7% 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.625rem 0.625rem 0 0;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(238 240 255 / 0.22);
  }
  .w-bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: max(5px, calc(0.75 * var(--u)));
    height: max(1.625rem, calc(3.6 * var(--u)));
    padding: 0 max(0.625rem, calc(1.6 * var(--u)));
    background: #14173a;
    color: var(--mute);
  }
  .w-bar i {
    width: max(7px, calc(0.95 * var(--u)));
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff5f57;
  }
  .w-bar i:nth-child(2) {
    background: #febc2e;
  }
  .w-bar i:nth-child(3) {
    background: #28c840;
  }
  .w-url {
    margin-left: max(0.5rem, calc(1.2 * var(--u)));
    font-weight: 700;
    font-size: max(0.6875rem, calc(1.3 * var(--u)));
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .w-view {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  .w-view img,
  .w-view video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* A long page scrolls down in its window on hover or focus; on touch screens the scroll of the page drives it. */
  .tall .w-view img {
    transition: object-position 6s cubic-bezier(0.45, 0, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk-item:is(:hover, :focus-within) .tall .w-view img {
      object-position: 50% 100%;
    }
  }
  @media (hover: none) {
    @supports (animation-timeline: view()) {
      .tall .w-view img {
        animation: wk-pan linear both;
        animation-timeline: view();
        animation-range: cover 15% cover 85%;
      }
    }
  }
  @keyframes wk-pan {
    to {
      object-position: 50% 100%;
    }
  }
  /* The X-ray lens (scripts/work-xray.ts) lies over the page, under nothing. */
  .w-view :global(canvas.xr) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* The window rises into its plate as the plate comes into view (the first row is on the first screen: it never hides).
     Only the reveal transitions: hiding below the fold on load is instant (lessons.md). */
  .rv-ready:not(.still) .wk-item.rv:not(.in) .wk-win {
    translate: 0 14%;
  }
  .rv-ready:not(.still) .wk-item.rv.in .wk-win {
    transition: translate 0.9s var(--ease-out) 0.1s;
  }

  /* Reels: the phone rising from the foot, or the monitor window; the video plays near the screen after the first
     interaction (scripts/reel). */
  .wk-reel {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .w-phone {
    position: absolute;
    top: 9%;
    bottom: -12%;
    left: 50%;
    aspect-ratio: 320 / 694;
    translate: -50% 0;
