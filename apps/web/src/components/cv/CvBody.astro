---
/**
 * The CV content (content-model.md § CV), rendered from `~/data/cv` for both the /cv/ page and the print route the
 * PDF is made from: the same sections in the same order, so the page and the PDF can't say different things.
 * `variant="page"` lays it out as a poster sheet; `variant="print"` is one ATS-safe column.
 */
import { t } from "lingui-for-astro/macro";

import { type CertItem, type CvEntry, CV } from "~/data/cv";
import { PROFILES, SITE } from "~/data/site";

interface Props {
  variant: "page" | "print";
  siteUrl: string;
}

const { variant, siteUrl } = Astro.props;
const locale = Astro.locals.locale;
// Screen-reader note on links that open a new tab (none in the print/PDF variant).
const newTab = variant === "print" ? "" : t`(opens in a new tab)`;
const KIND = {
  qualification: t`Qualification`,
  course: t`Course`,
  volunteering: t`International`,
  hackathon: t`Teamwork`,
  knowledge: t`Knowledge`,
} as const;
const sections = {
  summary: t`Profile`,
  experience: t`Experience`,
  education: t`Education`,
  projects: t`Selected projects`,
  credentials: t`Qualifications and training`,
  skills: t`Skills`,
  languages: t`Languages`,
  interests: t`Interests`,
  contact: t`Contact`,
};
const entries = (list: CvEntry[]) => list;
---

<div class:list={["cv", variant]}>
  <section class="cv-sec summary" aria-labelledby="cv-summary">
    <h2 id="cv-summary">{sections.summary}</h2>
    <p>{CV.summary[locale]}</p>
  </section>

  <div class="cv-cols">
    <div class="cv-main">
      <section class="cv-sec" aria-labelledby="cv-experience">
        <h2 id="cv-experience">{sections.experience}</h2>
        {entries(CV.experience).map((entry) => (
          <article class="entry">
            <header>
              <h3>{entry.title[locale]}</h3>
              <p class="when">
                {entry.org && <span>{entry.org[locale]}</span>}
                <span>{entry.when[locale]}</span>
              </p>
            </header>
            <ul>
              {entry.bullets.map((bullet) => (
                <li>{bullet[locale]}</li>
              ))}
            </ul>
            {entry.links && (
              <p class="elinks">
                {entry.links.map((link) => (
                  <a href={link.href} rel="noopener" target="_blank">
                    {variant === "print" ? `${link.label}: ${link.href}` : link.label}
                    {newTab && <span class="sr-only"> {newTab}</span>}
                  </a>
                ))}
              </p>
            )}
          </article>
        ))}
      </section>

      <section class="cv-sec" aria-labelledby="cv-education">
        <h2 id="cv-education">{sections.education}</h2>
        {entries(CV.education).map((entry) => (
          <article class="entry">
            <header>
              <h3>{entry.title[locale]}</h3>
              <p class="when">
                {entry.org && <span>{entry.org[locale]}</span>}
                <span>{entry.when[locale]}</span>
              </p>
            </header>
            {entry.bullets.length > 0 && (
              <ul>
                {entry.bullets.map((bullet) => (
                  <li>{bullet[locale]}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </section>

      <section class="cv-sec" aria-labelledby="cv-projects">
        <h2 id="cv-projects">{sections.projects}</h2>
        {entries(CV.projects).map((entry) => (
          <article class="entry">
            <header>
              <h3>{entry.title[locale]}</h3>
              <p class="when">
                <span>{entry.when[locale]}</span>
              </p>
            </header>
            <ul>
              {entry.bullets.map((bullet) => (
                <li>{bullet[locale]}</li>
              ))}
            </ul>
            {entry.links && (
              <p class="elinks">
                {entry.links.map((link) => (
                  <a href={link.href} rel="noopener" target="_blank">
                    {variant === "print" ? `${link.label}: ${link.href}` : link.label}
                    {newTab && <span class="sr-only"> {newTab}</span>}
                  </a>
                ))}
              </p>
            )}
          </article>
        ))}
      </section>

      <section class="cv-sec" id="credentials" aria-labelledby="cv-credentials">
        <h2 id="cv-credentials">{sections.credentials}</h2>
        {
          // The home "Experience" card sums up the two sections above; the CV lists them in full.
          CV.credentials
            .filter((credential) => credential.kind !== "experience")
            .map((credential) => (
              <article class="entry">
                <header>
                  <h3>{credential.title[locale]}</h3>
                  <p class="when">
                    <span>{KIND[credential.kind as keyof typeof KIND]}</span>
                    <span>{credential.when[locale]}</span>
                  </p>
                </header>
                <p class="issuer">{credential.issuer[locale]}</p>
                {/* In the PDF the certificates themselves carry a card's facts; its summary would cost the second page. */}
                {!(variant === "print" && credential.items) && <p>{credential.summary[locale]}</p>}
                {credential.verifyUrl && (
                  <p class="elinks">
                    {variant === "print" ? (
                      credential.verifyUrl.replace(/^https:\/\/(www\.)?/, "")
                    ) : (
                      <>
                        <a href={credential.verifyUrl} rel="noopener" target="_blank">
                          {t`Certificate`} <span class="sr-only">{newTab}</span>
                        </a>
                        {credential.courseUrl && (
                          <a href={credential.courseUrl} rel="noopener" target="_blank">
                            {t`The course`} <span class="sr-only">{newTab}</span>
                          </a>
                        )}
                      </>
                    )}
                  </p>
                )}
                {credential.items &&
                  (variant === "print" ? (
                    // The PDF keeps every certificate on one run-on line (two pages in total), codes included.
                    <p class="certs-line">
                      {credential.items
                        .map((item: CertItem) => `${item.title} (${item.when[locale]}${item.code ? `, ${item.code}` : ""})`)
                        .join("; ")}
                    </p>
                  ) : (
                    <ul class="certs">
                      {credential.items.map((item: CertItem) => (
                        <li>
                          {item.href || item.site ? (
                            <a href={item.href ?? item.site} rel="noopener" target="_blank">
                              {item.title} <span class="sr-only">{newTab}</span>
                            </a>
                          ) : (
                            item.title
                          )}
                          <span class="cert-meta">
                            {" · "}
                            {item.when[locale]}
                            {item.code && ` · ${item.code}`}
                          </span>
                        </li>
                      ))}
                    </ul>
                  ))}
              </article>
            ))
        }
      </section>
    </div>

    <aside class="cv-side">
      <section class="cv-sec" aria-labelledby="cv-contact">
        <h2 id="cv-contact">{sections.contact}</h2>
        <ul class="plain">
          <li>{SITE.email}</li>
          <li>{CV.location[locale]}</li>
          <li>
            <a href={siteUrl}>{siteUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a>
          </li>
          {PROFILES.map((profile) => (
            <li>
              <a href={profile.href} rel="me noopener" target="_blank">
                {variant === "print" ? profile.href.replace(/^https:\/\/(www\.)?/, "") : `${profile.label}: ${profile.handle}`}
                {newTab && <span class="sr-only"> {newTab}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="cv-sec" aria-labelledby="cv-skills">
        <h2 id="cv-skills">{sections.skills}</h2>
        <dl class="skills">
          {CV.skills.map((group) => (
            <div>
              <dt>{group.group[locale]}</dt>
              <dd>{group.items.join(", ")}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="cv-sec" aria-labelledby="cv-languages">
        <h2 id="cv-languages">{sections.languages}</h2>
        <ul class="plain">
          {CV.languages.map((language) => (
            <li>
              {language.name[locale]}: {language.level[locale]}
            </li>
          ))}
        </ul>
      </section>
      <section class="cv-sec" aria-labelledby="cv-interests">
        <h2 id="cv-interests">{sections.interests}</h2>
        <p>{CV.interests[locale]}</p>
      </section>
    </aside>
  </div>
</div>

<style>
  .cv h2 {
    margin: 0 0 0.875rem;
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-stretch: 125%;
  }
  .cv h3 {
    margin: 0;
    font-weight: 850;
    font-size: 1.25rem;
    line-height: 1.15;
    font-stretch: 85%;
  }
  .cv p,
  .cv ul,
  .cv dl {
    margin: 0;
  }
  .cv-sec {
    margin-bottom: 2.25rem;
  }
  .summary p {
    max-width: 70ch;
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  .entry {
    margin-bottom: 1.5rem;
  }
  .entry header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .entry ul {
    padding-left: 1.1em;
    line-height: 1.5;
  }
  .entry li {
    margin: 0.25rem 0;
  }
  .issuer {
    font-weight: 700;
  }
  .elinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem !important;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .certs {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
  }
  .cert-meta {
    font-size: 0.875em;
  }
  .certs-line {
    margin-top: 2pt;
    font-size: 8pt;
  }
  .plain {
    padding: 0;
    list-style: none;
    line-height: 1.6;
  }
  .skills div {
    margin-bottom: 0.625rem;
  }
  .skills dt {
    font-weight: 800;
  }
  .skills dd {
    margin: 0;
    line-height: 1.5;
  }

  /* The poster sheet. */
  .page .cv-cols {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 4.5rem);
  }
  .page .cv-sec h2 {
    padding-bottom: 0.625rem;
    border-bottom: 3px solid currentColor;
  }
  .page .cv-side {
    align-self: start;
    padding: 1.25rem 1.25rem 0;
    box-shadow: inset 0 0 0 3px currentColor;
  }
  @media (max-width: 56.25rem) {
    .page .cv-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* One column for the PDF: plain, selectable, ATS-safe. */
  .print {
    overflow-wrap: anywhere;
    font-size: 9.5pt;
    line-height: 1.35;
  }
  .print .summary p {
    max-width: none;
  }
  /* Contact and languages run inline; each skill group is one line. */
  .print .plain {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
  }
  .print .skills div {
    display: flex;
    gap: 0.4em;
  }
  .print .skills dt::after {
    content: ":";
  }
  .print .cv-sec {
    margin-bottom: 10pt;
    break-inside: auto;
  }
  .print h2 {
    break-after: avoid;
    margin-bottom: 6pt;
    padding-bottom: 3pt;
    border-bottom: 1.5pt solid #0a0d33;
    font-size: 9.5pt;
  }
  .print h3 {
    font-size: 11pt;
  }
  .print .summary p {
    font-size: 10.5pt;
  }
  .print .entry {
    margin-bottom: 7pt;
    break-inside: avoid;
  }
  .print .entry ul {
    margin-top: 2pt;
  }
  .print .entry li {
    margin: 1pt 0;
  }
  .print .when {
    font-size: 9pt;
  }
  .print .cv-cols {
    display: block;
  }
  .print .skills div {
    margin-bottom: 2pt;
  }
  .print a {
    color: inherit;
  }
</style>
