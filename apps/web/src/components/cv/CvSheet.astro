---
/**
 * The CV sheet: the CV PDF's layout (design.md § CV sheet, content-model.md § CV). A poster on paper: a cobalt band
 * (photo, fitted name, sticker, role, availability), a navy contact bar with icons, then a ledger (section rows, dates
 * in a left rail, content on the right) over at most two A4 pages, closed by a pink contact slip with a QR code at the
 * foot of the last page.
 *
 * Built for two readers at once (research/2026-10-08-cv-recruiters-ats.md):
 * - a recruiter's skim: page 1 alone says who, what, where, how to reach him, the work and the projects;
 * - an ATS: real text in reading order, plain headings with tracking <= 0.05 em, static named TrueType fonts, links
 *   spelled out, decoration as outlines or images without text.
 *
 * Paint order is text order: Chrome writes the PDF's text in paint order, and a positioned or transformed box paints
 * after all in-flow content. So nothing that holds text is positioned or transformed: the rail is a grid column, the
 * bullet squares are in-flow boxes, the sticker (outlines, no text) is a grid item.
 *
 * Marks: no logos but GitHub's and LinkedIn's, only as links to his profiles, as their own artwork in white or black
 * (design/assets.md): tool brands don't allow theirs, and the owner dropped the project logos [user 2026-10-08].
 * Every other icon is a Tabler outline (MIT).
 *
 * Fluid: every size and gap in the body reads `--d` (0 = densest, 1 = roomiest); `scripts/cv-sheet.mjs` picks the
 * roomiest value that fits two pages, then sets `--end-gap` so the contact slip sits at the foot of the last page.
 * Entries never split across pages; sections may; an empty list renders nothing. `data-cv-*` hooks are for that
 * script.
 */
import { Image } from "astro:assets";
import { t } from "lingui-for-astro/macro";
import { encode } from "uqr";

import Icon from "~/components/ui/Icon.astro";
import { type CertItem, CV, type CvCredential, type CvEntry, cvQualifications, type Text } from "~/data/cv";
import { PROFILES, SITE } from "~/data/site";
import { CV_NAME, CV_STICKER } from "~/lib/cv-fonts.gen";
import { type IconName } from "~/lib/icons.gen";
import { photoFile } from "~/lib/photos";
import { pathTo } from "~/lib/routes";
import { typo } from "~/lib/typography";

interface Props {
  siteUrl: string;
}

const { siteUrl } = Astro.props;
const locale = Astro.locals.locale;
const NBSP = String.fromCharCode(160);
// Locale typography (one-letter words and numbers bind to the next word), and a range dash stays with the word before
// it, so a date never wraps into "– now" at the start of a line.
const tx = (text: string) => typo(locale, text).replace(/ – /g, `${NBSP}– `);
const l = (text: Text) => tx(text[locale]);
const photo = photoFile("mateusz-muszarski-cv");
const short = (href: string) => href.replace(/^(https?:\/\/)?(www\.)?/, "").replace(/\/$/, "");
const nameEm = Math.max(...CV_NAME.map((line) => line.em));
const github = PROFILES.find((profile) => profile.id === "github");
const linkedin = PROFILES.find((profile) => profile.id === "linkedin");
// The contact bar: who and where, then the profiles, and the portfolio apart in a pink tile on the right
// [user 2026-10-08: "differentiated from the other links"]. `icon: "in"` is LinkedIn's own artwork.
const contact: { text: string; href?: string | undefined; icon: IconName | "in"; web?: boolean }[] = [
  { text: SITE.email, href: `mailto:${SITE.email}`, icon: "tb:mail" },
  { text: l(CV.location), icon: "tb:map-pin" },
  // The domain alone reads better; the link opens the CV's own language.
  { text: new URL(siteUrl).host, href: siteUrl, icon: "tb:world", web: true },
  ...(github ? [{ text: short(github.href), href: github.href, icon: "si:github" as const }] : []),
  ...(linkedin ? [{ text: short(linkedin.href), href: linkedin.href, icon: "in" as const }] : []),
];
const sections = {
  summary: t`Profile`,
  experience: t`Experience`,
  projects: t`Selected projects`,
  skills: t`Skills and qualifications`,
  softSkills: t`Soft skills`,
  tools: t`Technologies`,
  education: t`Education`,
  languages: t`Languages`,
  interests: t`Interests`,
  contact: t`Contact`,
};
// The order [user 2026-10-08]: the work first, then skills and qualifications, Education just before the languages.
type Block = { kind: "list"; heading: string; entries: CvEntry[] } | { kind: "skills" };
const blocks: Block[] = [
  { kind: "list" as const, heading: sections.experience, entries: CV.experience },
  { kind: "list" as const, heading: sections.projects, entries: CV.projects },
  { kind: "skills" as const },
  { kind: "list" as const, heading: sections.education, entries: CV.education },
  // A list with nothing in it leaves no empty heading behind.
].filter((block) => block.kind !== "list" || block.entries.length > 0);
const credentials: CvCredential[] = cvQualifications();
// A repository reads best as its address (a paper reader can type it); a store badge by its name.
const linkText = (link: { label: string; href: string }) => (/github\.com\//.test(link.href) ? short(link.href) : link.label);
const certMeta = (item: CertItem) => tx(item.when[locale]);
const clause = (CV.clause as Partial<Record<string, string>>)[locale];
// Interests as tags, as on the /cv/ page [user 2026-10-08]: the line split at its commas, each behind its icon when the
// counts agree.
const interests = l(CV.interests).replace(/\.$/, "").split(/,\s+/);
const interestIcons = interests.length === CV.interestIcons.length ? CV.interestIcons : [];
// The web version of this CV: printed without the locale (vercel.json sends a typed address to the reader's
// language) [user 2026-10-08], linked to the same language as the sheet.
const webCv = new URL(pathTo(locale, "cv/"), siteUrl);
const bareCv = short(new URL("/cv/", siteUrl).href);
// The slip's QR code opens the portfolio in the CV's language: a printed sheet's one-step way to the work. One path
// of unit squares, no text.
const qr = encode(siteUrl, { ecc: "M", border: 0 });
const qrPath = qr.data.flatMap((row, y) => row.flatMap((on, x) => (on ? [`M${x} ${y}h1v1h-1z`] : []))).join("");
// Flags, drawn (Windows has no flag emoji, and an emoji font would print as Type 3): 3:2 with a hairline frame, so the
// Polish white reads on white paper. The Union Jack follows the public-domain construction, counterchange clipped.
const FLAGS: Record<"pl" | "gb", string> = {
  pl: '<path fill="#fff" d="M0 0h45v15H0z"/><path fill="#dc143c" d="M0 15h45v15H0z"/>',
  gb:
    '<clipPath id="cs-gb-t"><path d="M22.5 15h22.5v15zv15h-22.5zh-22.5v-15zv-15h22.5z"/></clipPath>' +
    '<path fill="#012169" d="M0 0h45v30H0z"/>' +
    '<path d="M0 0l45 30M45 0L0 30" stroke="#fff" stroke-width="6"/>' +
    '<path d="M0 0l45 30M45 0L0 30" clip-path="url(#cs-gb-t)" stroke="#c8102e" stroke-width="4"/>' +
    '<path d="M22.5 0v30M0 15h45" stroke="#fff" stroke-width="10"/>' +
    '<path d="M22.5 0v30M0 15h45" stroke="#c8102e" stroke-width="6"/>',
};
const FRAME = '<path fill="none" stroke="#0a0d33" stroke-width="1.2" d="M.6.6h43.8v28.8H.6z"/>';
---

<div class="cs" style={`--name-em: ${nameEm}`}>
  <header class="cs-band">
    {photo && (
      <div class="cs-photo">
        <Image src={photo} alt={SITE.name} width={Math.min(photo.width, 600)} format="webp" quality={92} />
      </div>
    )}
    <h1 class="cs-name">
      {CV_NAME.map((line, i) => (
        <>
          {i > 0 && <br />}
          {/* A kept space at the line end: without it the PDF bookmark reads "MATEUSZMUSZARSKI". */}
          <span style={`font-family: "${line.family}"`}>{i < CV_NAME.length - 1 ? `${line.text} ` : line.text}</span>
        </>
      ))}
    </h1>
    <svg class="cs-sticker" viewBox="0 0 200 200" aria-hidden="true">
      <circle cx="100" cy="100" r="96"></circle>
      <path d={CV_STICKER.ring}></path>
      <path d={CV_STICKER.core}></path>
    </svg>
    <div class="cs-id">
      <p class="cs-role" data-cv-must={CV.title[locale]}>
        {l(CV.title)}
      </p>
      <p class="cs-avail">{l(CV.availability)}</p>
    </div>
  </header>
  <ul class="cs-bar" aria-label={sections.contact}>
    {contact.map((item) => (
      <li class:list={[{ "cs-web": item.web }]}>
        {item.icon === "in" ? (
          <img class="cs-in" src="/media/cv/linkedin-in-white.webp" alt="" width="280" height="260" />
        ) : (
          <Icon name={item.icon} inline class="cs-ico" />
        )}
        {item.href ? (
          <a href={item.href} data-cv-link data-cv-must={item.text}>
            {item.text}
          </a>
        ) : (
          <span data-cv-must={item.text}>{item.text}</span>
        )}
      </li>
    ))}
  </ul>

  <section class="cs-sec">
    <h2 data-cv-heading>{sections.summary}</h2>
    <p class="cs-wide">{l(CV.summary)}</p>
  </section>

  {blocks.map((block) =>
    block.kind === "list" ? (
      <section class="cs-sec" data-cv-list>
        <h2 data-cv-heading>{block.heading}</h2>
        {block.entries.map((entry) => (
          <article class="cs-entry" data-cv-entry data-cv-placeholder={entry.placeholder ? l(entry.title) : undefined}>
            <h3>{l(entry.title)}</h3>
            {entry.org && <p class="cs-org">{l(entry.org)}</p>}
            <p class="cs-when">{l(entry.when)}</p>
            {entry.bullets.length > 0 && (
              <ul class="cs-bullets">
                {entry.bullets.map((bullet) => (
                  <li>{l(bullet)}</li>
                ))}
              </ul>
            )}
            {entry.links && (
              <p class="cs-links">
                {entry.links.map((link) => (
                  <a href={link.href}>{linkText(link)}</a>
                ))}
              </p>
            )}
          </article>
        ))}
      </section>
    ) : (
      <section class="cs-sec" data-cv-list>
        <h2 data-cv-heading>{sections.skills}</h2>
        {
          // Soft skills lead [user 2026-10-08], each with the line that shows it: skills, not a list of names.
          CV.softSkills.length > 0 && (
            <div class="cs-row">
              <p class="cs-when">{sections.softSkills}</p>
              <ul class="cs-soft">
                {CV.softSkills.map((skill) => (
                  <li>
                    <Icon name={skill.icon} inline class="cs-soft-ico" />
                    <strong>{l(skill.name)}</strong>
                    <span>{l(skill.line)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          // The tools, small ("small font"): one row per group, its icon, the group, the tools by name (an ATS reads
          // them). Rows, not tiles, so they don't repeat the soft skills' shape; a tool's name never breaks.
          CV.tools.length > 0 && (
            <div class="cs-row">
              <p class="cs-when">{sections.tools}</p>
              <ul class="cs-tools">
                {CV.tools.map((group) => (
                  <li>
                    <Icon name={group.icon} inline class="cs-tools-ico" />
                    <strong>{l(group.name)}:</strong>{" "}
                    {group.tools.map((tool) => (typeof tool === "string" ? tool : tool[locale]).replace(/ /g, NBSP)).join(" · ")}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          // Low weight with tech hiring (research): one head line (title · issuer), then the proof or one line.
          credentials.map((credential) => (
            <article
              class="cs-entry cs-cred"
              data-cv-entry
              data-cv-placeholder={credential.placeholder ? l(credential.title) : undefined}
            >
              <h3>
                {credential.verifyUrl ? <a href={credential.verifyUrl}>{l(credential.title)}</a> : l(credential.title)}
                <span class="cs-issuer"> · {l(credential.issuer)}</span>
              </h3>
              <p class="cs-when">{l(credential.when)}</p>
              {credential.items ? (
                <ul class="cs-certs">
                  {credential.items.map((item: CertItem) => (
                    <li>
                      {item.href || item.site ? <a href={item.href ?? item.site}>{item.title}</a> : item.title}
                      <span class="cs-meta"> · {certMeta(item)}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="cs-note">{l(credential.summary)}</p>
              )}
              {
                // What it gave him, on its own line in the accent colour, so it isn't buried in the description.
                credential.gain && (
                  <p class="cs-gain">
                    <Icon name="tb:trending-up" inline class="cs-gain-ico" />
                    {l(credential.gain)}
                  </p>
                )
              }
            </article>
          ))
        }
      </section>
    ),
  )}

  <section class="cs-sec cs-pair">
    {CV.languages.length > 0 && (
      <div>
        <h2 data-cv-heading>{sections.languages}</h2>
        <ul class="cs-langs">
          {CV.languages.map((language) => (
            <li>
              <svg class="cs-flag" viewBox="0 0 45 30" aria-hidden="true" set:html={FLAGS[language.flag] + FRAME} />
              <strong>{l(language.name)}:</strong> {l(language.level)}
            </li>
          ))}
        </ul>
      </div>
    )}
    {CV.interests[locale] && (
      <div>
        <h2 data-cv-heading>{sections.interests}</h2>
        <ul class="cs-likes">
          {interests.map((interest, i) => (
            <li>
              {interestIcons[i] && <Icon name={interestIcons[i]} inline class="cs-likes-ico" />}
              {interest.replace(/ /g, NBSP)}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <footer class="cs-end">
    <h2 data-cv-heading>{sections.contact}</h2>
    <p class="cs-end-mail">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <ul class="cs-end-web">
      <li>
        <Icon name="tb:file-cv" inline class="cs-ico" />
        <a href={webCv.href}>{bareCv}</a>
      </li>
      {github && (
        <li>
          <Icon name="si:github" inline class="cs-ico cs-gh" />
          <a href={github.href}>{short(github.href)}</a>
        </li>
      )}
    </ul>
    <div class="cs-qr">
      <svg viewBox={`-2 -2 ${qr.size + 4} ${qr.size + 4}`} aria-hidden="true">
        <rect x="-2" y="-2" width={qr.size + 4} height={qr.size + 4} fill="#fff"></rect>
        <path d={qrPath}></path>
      </svg>
    </div>
  </footer>

  {clause && <p class="cs-clause">{tx(clause)}</p>}
</div>

<style>
  /* Tokens: the Cobalt palette of global.css (this page loads no global CSS) plus one slate for meta text (7.8:1). */
  .cs {
    --cobalt: #2433ff;
    --ice: #eef0ff;
    --navy: #0a0d33;
    --pink: #ff4fb8;
    --slate: #4b4f78;
    /* The type scale, six steps (the name is fitted): every body step reads --d, set on the root (the print page's
       default, or scripts/cv-sheet.mjs while it fits the sheet): 0 = densest (body 10 pt, the floor of print
       guidance), 1 = roomiest (10.8 pt). Meta lines run at 0.9 (9-9.7 pt). Below 0 (a long locale's last resort) only
       the gaps tighten: the type and the leading stay at their floor. */
    --fs: calc(10pt + 0.8pt * max(var(--d), 0));
    --t-title: calc(var(--fs) * 1.2);
    --t-meta: calc(var(--fs) * 0.9);
    --t-label: 8.2pt;
    --t-band: 8.8pt;
    --lh: calc(1.3 + 0.1 * max(var(--d), 0));
    /* Room between sections and entries [user 2026-10-08: "slightly more living room"]; the page edges stay. */
    --sec: calc(5.4mm + 3.4mm * var(--d));
    --entry: calc(3.1mm + 1.8mm * var(--d));
    --rail: 27mm;
    --gutter: 5mm;
    --photo: 28mm;
    --stk: 26mm;
    --edge: 14mm;
    padding: 0 var(--edge);
    color: var(--navy);
    font: 400 var(--fs) / var(--lh) "CV Text";
    font-kerning: normal;
    font-variant-ligatures: none;
    /* A weight or style the static fonts lack must show, not get synthesised (Chrome prints a fake bold as Type 3). */
    font-synthesis: none;
    print-color-adjust: exact;
  }
  .cs a {
    color: inherit;
    text-decoration: none;
  }
  .cs strong {
    font-family: "CV Strong";
    font-weight: 700;
  }

  /* The band: full bleed. Photo, fitted name and sticker share the top row at one height; role and availability below. */
  .cs-band {
    display: grid;
    grid-template-columns: var(--photo) 1fr var(--stk);
    align-items: center;
    column-gap: var(--band-gap);
    margin: 0 calc(-1 * var(--edge));
    padding: 7.5mm var(--edge) 4.5mm;
    background: var(--cobalt);
    color: var(--ice);
    --band-gap: 6mm;
    --band-gaps: 12mm;
  }
  /* Without a photo (UK, Irish and US applications, content.md § 2) the name takes its column; `--no-photo` in
     scripts/cv-sheet.mjs prints that variant. The name's size stays capped so the band keeps its height. */
  .cs-band:not(:has(.cs-photo)) {
    --photo: 0mm;
    --band-gaps: 6mm;
    grid-template-columns: 1fr var(--stk);
  }
  .cs-photo {
    grid-column: 1;
    width: var(--photo);
    height: var(--photo);
    border: 0.6mm solid var(--ice);
    box-shadow: 1.8mm 1.8mm 0 var(--pink);
    background: var(--ice);
  }
  .cs-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-name {
    grid-column: 2;
    font-weight: 900;
    /* Each line is exactly as wide as its column: the width in em comes from scripts/cv-fonts.mjs. */
    font-size: min(
      calc((210mm - 2 * var(--edge) - var(--photo) - var(--stk) - var(--band-gaps)) / var(--name-em) * 0.995),
      18.2mm
    );
    line-height: 0.78;
    white-space: nowrap;
  }
  /* pre-wrap keeps the space at the end of a line (it hangs, so the fitted width doesn't change). */
  .cs-name span {
    white-space: pre-wrap;
  }
  .cs-band:not(:has(.cs-photo)) .cs-name {
    grid-column: 1;
  }
  .cs-band:not(:has(.cs-photo)) .cs-id {
    grid-column: 1 / -1;
  }
  /* The hero sticker's twin: outlines only (no text), so it may turn. */
  .cs-sticker {
    grid-column: -2;
    width: var(--stk);
    height: var(--stk);
    transform: rotate(-12deg);
  }
  .cs-sticker circle {
    fill: var(--pink);
  }
  .cs-sticker path {
    fill: var(--navy);
  }
  .cs-id {
    grid-column: 2 / -1;
    margin-top: 2.2mm;
    padding-top: 2mm;
    border-top: 0.8mm solid var(--ice);
  }
  .cs-role {
    font: 850 12pt / 1.12 "CV Head";
    text-transform: uppercase;
  }
  .cs-avail {
    margin-top: 1mm;
    font: 700 var(--t-meta) / 1.35 "CV Strong";
  }

  /* The contact bar: the site's navy bar field, links spelled out, each behind its icon. Two columns (who and where,
     then the profiles) and the portfolio's tile on the right across both rows. GitHub and LinkedIn marks stay white
     (their guidelines). */
  .cs-bar {
    display: grid;
    list-style: none;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    align-items: center;
    gap: 1.6mm 7mm;
    margin: 0 calc(-1 * var(--edge)) var(--sec);
    padding: 2.6mm var(--edge) 2.8mm;
    background: var(--navy);
    color: var(--ice);
    font: 700 var(--t-band) / 1.3 "CV Strong";
  }
  .cs-bar li {
    display: flex;
    align-items: center;
    gap: 1.8mm;
  }
  /* The portfolio, apart: a pink tile with a hard shadow, like the site's buttons, in the title face. */
  .cs-bar .cs-web {
    grid-column: 3;
    grid-row: 1 / span 2;
    justify-self: end;
    padding: 1.7mm 2.8mm 1.7mm 2.4mm;
    background: var(--pink);
    color: var(--navy);
    box-shadow: 0.9mm 0.9mm 0 var(--ice);
    font: 850 calc(var(--t-band) * 1.25) / 1.1 "CV Head";
  }
  .cs-ico,
  .cs-in {
    flex: none;
    width: 3.6mm;
    height: 3.6mm;
  }
  .cs-bar .cs-ico {
    color: #fff;
  }
  .cs-bar .cs-web .cs-ico {
    color: var(--navy);
  }
  .cs-in {
    width: auto;
    height: 3.2mm;
  }

  /* Sections: a heading row (pink tab, label, a rule to the edge), then the content. Tracking stays <= 0.05 em:
     wider tracking splits words in text extractors (ATS). */
  .cs-sec {
    margin-bottom: var(--sec);
  }
  .cs-sec h2,
  .cs-end h2 {
    font: 800 var(--t-label) / 1.2 "CV Label";
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .cs-sec h2 {
    display: flex;
    align-items: center;
    gap: 2.2mm;
    margin-bottom: calc(2mm + 1mm * var(--d));
    color: var(--cobalt);
    break-after: avoid;
  }
  .cs-sec h2::before {
    content: "";
    flex: none;
    width: 2.2mm;
    height: 2.2mm;
    background: var(--pink);
  }
  .cs-sec h2::after {
    content: "";
    flex: 1;
    height: 0.45mm;
    background: var(--navy);
  }
  .cs-wide {
    margin-left: calc(var(--rail) + var(--gutter));
  }

  /* Entries and skill rows: a grid of rail + column. Title, place and date come first (the reading order an ATS
     expects), then the bullets; grid items paint in DOM order. */
  .cs-entry,
  .cs-row {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--gutter);
    break-inside: avoid;
  }
  .cs-entry > *,
  .cs-row > * {
    grid-column: 2;
  }
  .cs-entry > .cs-when {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  .cs-row > .cs-when {
    grid-column: 1;
  }
  .cs-entry + .cs-entry,
  .cs-row + .cs-entry {
    margin-top: var(--entry);
  }
  .cs-row + .cs-row {
    margin-top: calc(2.6mm + 1.4mm * var(--d));
  }
  .cs-entry h3 {
    font: 850 var(--t-title) / 1.12 "CV Head";
  }
  .cs-org,
  .cs-issuer,
  .cs-when,
  .cs-links {
    font: 700 var(--t-meta) / 1.3 "CV Strong";
  }
  .cs-org,
  .cs-issuer,
  .cs-meta {
    color: var(--slate);
  }
  .cs-when {
    font-variant-numeric: tabular-nums;
    color: var(--cobalt);
  }
  /* The date shares the title's baseline: extractors (pdftotext -layout, ATS parsers) pair a date with the title on
     its row. scripts/cv-sheet.mjs checks it. */
  .cs-entry > h3,
  .cs-entry > .cs-when,
