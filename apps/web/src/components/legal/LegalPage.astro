---
/**
 * A legal document (structure.md § Legal, requirements.md F14, brand.md § Legal tone): formal text from
 * src/content/legal/<locale>/<doc>.md, numbered sections with a contents list, version and date on top, a language
 * note (Polish prevails), noindex,follow, no JSON-LD. Linked from the footer and the contact form, never the header.
 */
import "~/styles/prose.css";

import { getEntry, render } from "astro:content";
import { t } from "lingui-for-astro/macro";

import BaseLayout from "~/components/layout/BaseLayout.astro";
import AnalyticsOptOut from "~/components/legal/AnalyticsOptOut.astro";
import { pathTo } from "~/lib/routes";

interface Props {
  doc: "privacy" | "terms";
}

const { doc } = Astro.props;
const locale = Astro.locals.locale;
const entry = await getEntry("legal", `${locale}/${doc}`);
if (!entry) throw new Error(`Missing legal text ${locale}/${doc}`);
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const updated = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Warsaw" }).format(entry.data.updated);
const contents = t`Contents`;
---

<BaseLayout title={entry.data.title} description={entry.data.description} path={doc} noindex>
  <article class="legal">
    <header class="sec field-bar head">
      <p class="kick">{doc === "privacy" ? t`Legal · data protection` : t`Legal · terms of service`}</p>
      <h1 class="title">{entry.data.title}</h1>
      <p class="ver">
        {t`Version`} {entry.data.version} · {t`in force from`} <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{updated}</time>
      </p>
      {
        locale !== "pl" && (
          <p class="lang">
            {t`The Polish version of this document prevails.`}{" "}
            <a href={pathTo("pl", doc)} hreflang="pl" lang="pl">
              Wersja polska
            </a>
            {locale === "es" && <span> {t`This Spanish text is a machine-assisted translation pending review.`}</span>}
          </p>
        )
      }
    </header>
    <div class="sec field-alt body">
      <nav class="toc" aria-label={contents}>
        <p class="kick">{contents}</p>
        <ol>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="prose legal-text">
        {doc === "privacy" && <AnalyticsOptOut />}
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .title {
    max-width: 22ch;
    margin: 0.75rem 0 0;
    font-weight: 900;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    line-height: 0.92;
    text-transform: uppercase;
    font-stretch: 68%;
  }
  .ver {
    margin: 1.25rem 0 0;
    font-weight: 700;
  }
  .lang {
    max-width: 70ch;
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(13rem, 3fr) minmax(0, 9fr);
    gap: clamp(1.5rem, 4vw, 4.5rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 1.25rem);
    max-height: calc(100svh - var(--header-h) - 2.5rem);
    overflow-y: auto;
  }
  .toc .kick {
    margin: 0;
    padding-bottom: 0.625rem;
    border-bottom: 3px solid currentColor;
  }
  .toc ol {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .toc li {
    margin: 0.4375rem 0;
  }
  .toc a {
    text-decoration: none;
  }
  .toc a:hover {
    text-decoration: underline;
  }
  .legal-text {
    font-size: 1rem;
    line-height: 1.6;
  }
  .legal-text :global(h2) {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-stretch: 85%;
  }
  .legal-text :global(mark.tbd) {
    padding: 0 0.25em;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }
  @media (max-width: 64rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc {
      position: static;
      max-height: none;
    }
  }
</style>
