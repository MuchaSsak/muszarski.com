---
/**
 * My life, the head [user 2026-10-06: "something nuts and going big", "lightweight shaders"]: the title over a
 * full-bleed goo of the brand colours (a fragment shader, `life-gl.ts`): blobs drift, one follows the pointer (or a
 * finger) and swells on a poke. The title is real text, painted first; the shader starts at the first interaction or
 * pointer move over it, and the same colours sit behind it in CSS until then (or for good, without WebGL). Paused
 * or reduced motion: one still frame.
 */
import { t } from "lingui-for-astro/macro";

import { Image } from "astro:assets";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { GALLERY } from "~/data/gallery";
import { photoFile } from "~/lib/photos";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const [line1, line2] = t`My|life`.split("|") as [string, string];
// The owner's photos marked `hero` in `data/gallery.ts` [user 2026-10-06: "for my life, here is the pic you can use";
// 2026-10-07: more]. Fanned like prints; a tap, click or the button deals the next one on top. The pin board below
// shows them all.
const prints = GALLERY.filter((entry) => entry.hero)
  .map((entry) => ({ src: photoFile(entry.file), alt: entry.alt[locale], cap: entry.caption[locale] }))
  .filter((print): print is { src: NonNullable<typeof print.src>; alt: string; cap: string } => !!print.src);
---

<section class="hero" aria-labelledby="t-life" data-goo-host>
  <canvas class="goo" aria-hidden="true" data-goo></canvas>
  <div class="hero-in">
    <div class="sbar draw">
      <p>{t`My life`}</p>
      <p>{t`Off the clock`}</p>
      <p>{t`Poland`}</p>
    </div>
    <div class="h-grid">
      <div class="h-txt">
        <Fit as="h1" id="t-life" lines={[line1, line2]} base={[100, 140]} class="h-title" />
        <p class="lede rise" style="--d:2">
          {typo(locale, t`I'm Mateusz. Code is the job. This page is the rest.`)}
        </p>
        <p class="poke rise" style="--d:3" aria-hidden="true">
          <Icon name="tb:hand-click" />
          {t`Poke the goo.`}
        </p>
      </div>
      {prints.length ? (
        <div class="stack enter" data-stack>
          {/* The photos lie on top of each other on purpose (text-fit probe: data-textfit). */}
          <div class="deck" data-textfit="stack">
            {prints.map((print, i) => (
              <figure class="photo" data-print data-pos={i}>
                <Image
                  class="pic"
                  src={print.src}
                  alt={print.alt}
                  widths={[320, 640]}
                  sizes="(min-width: 48rem) 18rem, 60vw"
                  loading={i === 0 ? "eager" : "lazy"}
                />
                <figcaption>{print.cap}</figcaption>
              </figure>
            ))}
          </div>
          {prints.length > 1 && (
            <button type="button" class="deal js-only" data-deal>
              <Icon name="tb:refresh" />
              {t`Next photo`}
            </button>
          )}
        </div>
      ) : (
        <figure class="photo enter" aria-hidden="true">
          <div class="ph">
            <Icon name="tb:camera" />
            <span>{t`Photo soon`}</span>
          </div>
          <figcaption>{t`me, probably smiling`}</figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(56rem, 92svh);
    overflow: clip;
    background:
      radial-gradient(circle at 18% 30%, var(--pink) 0 9rem, transparent 9.1rem),
      radial-gradient(circle at 78% 62%, var(--cobalt) 0 11rem, transparent 11.1rem),
      radial-gradient(circle at 56% 18%, var(--yellow) 0 6rem, transparent 6.1rem),
      radial-gradient(circle at 34% 84%, var(--lime) 0 7rem, transparent 7.1rem), var(--navy);
    color: var(--ice);
    cursor: crosshair;
  }
  .goo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .goo:global(.on) {
    opacity: 1;
  }
  .hero-in {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 2rem;
    min-height: inherit;
    padding: clamp(1.75rem, 3vw, 2.75rem) var(--pad-x) clamp(2.5rem, 5vw, 4.5rem);
    pointer-events: none;
  }
  .hero-in :is(a, button) {
    pointer-events: auto;
  }
  .h-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }
  /* The title reads on any colour the goo brings: ice letters, a navy outline and a hard shadow. */
  :global(.h-title .fit) {
    color: var(--ice);
    -webkit-text-stroke: 0.045em var(--navy);
    paint-order: stroke fill;
    text-shadow: 0.07em 0.07em 0 var(--navy);
  }
  .lede {
    display: inline-block;
    max-width: 30ch;
    margin: clamp(1rem, 2.4vw, 2rem) 0 0;
    padding: 0.5rem 0.875rem 0.625rem;
    background: var(--ice);
    color: var(--navy);
    box-shadow: 6px 6px 0 var(--navy);
    font-weight: 700;
    font-size: clamp(1.25rem, 2vw, 1.875rem);
    line-height: 1.2;
    text-wrap: balance;
    rotate: -1deg;
  }
  .poke {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .poke :global(.ico) {
    width: 1.25rem;
    height: 1.25rem;
    animation: lh-poke 1.6s ease-in-out infinite;
  }
  @keyframes lh-poke {
    50% {
      transform: translate(-2px, -3px) rotate(-8deg);
    }
  }
  .photo {
    position: relative;
    justify-self: center;
    width: min(100%, 20rem);
    margin: 0;
    padding: 0.875rem 0.875rem 0;
    background: #fff;
    color: var(--navy);
    box-shadow: 10px 10px 0 var(--navy);
    rotate: 3deg;
  }
  .photo::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -0.75rem;
    width: 6rem;
    height: 1.5rem;
    background: color-mix(in srgb, var(--yellow) 80%, transparent);
    transform: translateX(-50%) rotate(-3deg);
  }
  /* The prints share one cell; --pos 0 is on top, the rest fan out behind it. */
  /* The fanned prints hang ~40 px below the deck's cell (a 9deg turn plus the 4% drop), so the button sits clear of them
     and above them (their corners covered the top of "ZDJĘCIE" / "FOTO", 2026-10-08). */
  .stack {
    display: grid;
    justify-items: center;
    gap: 3rem;
    justify-self: center;
    width: min(100%, 20rem);
    pointer-events: auto;
  }
  .deck {
    display: grid;
    width: 100%;
    cursor: pointer;
  }
  .deck .photo {
    grid-area: 1 / 1;
    width: 100%;
    rotate: 0deg;
    transition: transform 0.5s var(--ease-out);
  }
  .deck .photo[data-pos="0"] {
    z-index: 3;
    transform: rotate(3deg);
  }
  .deck .photo[data-pos="1"] {
    z-index: 2;
    transform: translate(-9%, 2%) rotate(-5deg);
  }
  .deck .photo[data-pos="2"] {
    z-index: 1;
    transform: translate(9%, 4%) rotate(9deg);
  }
  .deck .photo:not([data-pos="0"])::before {
    display: none;
  }
  .deal {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--navy);
    background: var(--ice);
    color: var(--navy);
    box-shadow: 4px 4px 0 var(--navy);
    font: inherit;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .deal:active {
    translate: 2px 2px;
    box-shadow: 2px 2px 0 var(--navy);
  }
  .deal :global(.ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .deck .photo {
      transition: none;
    }
  }
  :global(.still) .deck .photo {
    transition: none;
  }
  .ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    aspect-ratio: 4 / 5;
    background: repeating-linear-gradient(-45deg, rgb(10 13 51 / 0.1) 0 0.75rem, transparent 0.75rem 1.5rem), var(--ice);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .pic {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .ph :global(.ico) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .photo figcaption {
    padding: 0.75rem 0 1rem;
    text-align: center;
    font-weight: 700;
    font-size: 1.0625rem;
    font-style: italic;
    font-stretch: 85%;
  }
  @media (max-width: 48rem) {
    .h-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .photo,
    .stack {
      width: min(62%, 15rem);
    }
  }
</style>

<script>
  import { afterInteraction } from "~/scripts/motion";

  // highp where the GPU has it: Apple GPUs run mediump as 16-bit floats, and the cubed blob weights overflow those.
  const GOO = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 u_res;uniform float u_time;uniform vec2 u_mouse;uniform float u_burst;
float b(vec2 p,vec2 c,float r){vec2 d=p-c;return r*r/max(dot(d,d),1e-4);}
vec3 goo(vec2 p,float t,vec2 m,vec2 k,float s,out float f){
vec2 c0=k*vec2(sin(t*.31)*.8,cos(t*.23)*.6);
vec2 c1=k*vec2(cos(t*.19+1.)*.7,sin(t*.27+2.)*.7);
vec2 c2=k*vec2(sin(t*.17+4.)*.9,sin(t*.24)*.5-.1);
vec2 c3=k*vec2(cos(t*.25+3.)*.5,cos(t*.15+1.)*.75);
vec2 c4=k*vec2(sin(t*.13+5.)*.95,cos(t*.21+4.)*.55);
float f0=b(p,c0,.21*s),f1=b(p,c1,.18*s),f2=b(p,c2,.15*s),f3=b(p,c3,.13*s),f4=b(p,c4,.16*s),fm=b(p,m,(.12+.1*u_burst)*s);
f=f0+f1+f2+f3+f4+fm;
float w0=f0*f0*f0,w1=f1*f1*f1,w2=f2*f2*f2,w3=f3*f3*f3,w4=f4*f4*f4,wm=fm*fm*fm;
return(vec3(1.,.31,.72)*w0+vec3(.14,.2,1.)*w1+vec3(1.,.82,.25)*w2+vec3(.79,.95,.29)*w3+vec3(1.,.36,.12)*w4+vec3(.93,.94,1.)*wm)/(w0+w1+w2+w3+w4+wm);}
void main(){
float a=u_res.x/u_res.y;
vec2 p=(gl_FragCoord.xy-.5*u_res)/u_res.y;
vec2 m=(u_mouse-.5)*vec2(a,1.);
vec2 k=vec2(.5*a,.5);
float s=mix(.62,1.,clamp(a-.5,0.,1.));
float t=u_time;float f;float fs;
vec3 col=goo(p,t,m,k,s,f);
goo(p+vec2(-.02,.02),t,m,k,s,fs);
vec3 navy=vec3(.039,.051,.2);
vec3 c=mix(navy,vec3(.012,.016,.08),step(1.,fs)*(1.-step(1.,f)));
c=mix(c,col,smoothstep(.995,1.005,f));
c=mix(c,vec3(.93,.94,1.),(1.-smoothstep(.0,.012,abs(f-1.04)))*.85);
float g=fract(sin(dot(gl_FragCoord.xy,vec2(12.9898,78.233))+t)*43758.5453);
c+=(g-.5)*.035;
gl_FragColor=vec4(c,1.);}`;

  // The prints: deal the top one to the back. The click on the deck is the pointer shortcut; the button is the same
  // action for keyboards and screen readers.
  for (const stack of document.querySelectorAll<HTMLElement>("[data-stack]")) {
    const prints = [...stack.querySelectorAll<HTMLElement>("[data-print]")];
    if (prints.length < 2) continue;
    let top = 0;
    const deal = () => {
      top = (top + 1) % prints.length;
      prints.forEach((print, i) => (print.dataset.pos = String((i - top + prints.length) % prints.length)));
    };
    stack.querySelector("[data-deal]")?.addEventListener("click", deal);
    stack.querySelector(".deck")?.addEventListener("click", deal);
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("[data-goo]")) {
    const host = canvas.closest<HTMLElement>("[data-goo-host]")!;
    let started = false;
    const go = async () => {
      if (started) return;
      started = true;
      const { runShader } = await import("~/scripts/life-gl");
      runShader(canvas, GOO, { pointer: host, rest: [0.72, 0.4] });
    };
    // Text first: the goo starts at the reader's first interaction or pointer move over it; until then the same
    // colours stand in as CSS. Not on an idle timer: compiling the shader during load cost 150-350 ms of blocking
    // time and Lighthouse mobile fell to 83-91 (2026-10-07).
    afterInteraction(() => void go());
    host.addEventListener("pointermove", () => void go(), { once: true, passive: true });
  }
</script>
