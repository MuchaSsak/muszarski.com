---
/**
 * Faith: no toy, just light. Soft rays from above (a fragment shader, `life-gl.ts`) that lean towards the pointer or
 * a finger. A warm glow in CSS stands in until the shader runs, and stays without WebGL.
 */
---

<div class="light" data-light>
  <canvas class="rays" aria-hidden="true"></canvas>
  <span class="cross" aria-hidden="true"><i></i><i></i></span>
</div>

<style>
  .light {
    position: relative;
    flex: 1;
    min-height: 15rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 70% at 50% 0%, color-mix(in srgb, var(--yellow) 55%, transparent), transparent 70%),
      var(--navy);
    box-shadow: inset 0 0 0 3px var(--navy);
  }
  .rays {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }
  .rays:global(.on) {
    opacity: 1;
  }
  .cross {
    position: absolute;
    left: 50%;
    bottom: 14%;
    width: 2.75rem;
    height: 4.25rem;
    translate: -50% 0;
  }
  .cross i {
    position: absolute;
    background: var(--ice);
    box-shadow: 0 0 1.25rem color-mix(in srgb, var(--yellow) 70%, transparent);
  }
  .cross i:first-child {
    left: calc(50% - 0.25rem);
    top: 0;
    width: 0.5rem;
    height: 100%;
  }
  .cross i:last-child {
    left: 0;
    top: 26%;
    width: 100%;
    height: 0.5rem;
  }
</style>

<script>
  const RAYS = `precision mediump float;
uniform vec2 u_res;uniform float u_time;uniform vec2 u_mouse;uniform float u_burst;
void main(){
vec2 p=gl_FragCoord.xy/u_res.y;
float a=u_res.x/u_res.y;
vec2 src=vec2(mix(.2,.8,u_mouse.x)*a,1.25);
vec2 d=p-src;
float ang=atan(d.x,-d.y);
float r=length(d);
float t=u_time;
float rays=.55+.45*sin(ang*17.+t*.22)*sin(ang*9.-t*.15+1.3);
rays=pow(max(rays,0.),2.2);
float fall=exp(-r*1.25);
float glow=exp(-r*3.2);
float dust=fract(sin(dot(floor(gl_FragCoord.xy/3.),vec2(12.9898,78.233)))*43758.5453);
dust=step(.996,dust)*(.5+.5*sin(t*2.+dust*90.));
vec3 navy=vec3(.039,.051,.2);
vec3 gold=vec3(1.,.82,.36);
vec3 c=navy+gold*(rays*fall*.7+glow*.55)+gold*dust*fall*.6;
gl_FragColor=vec4(c,1.);}`;

  for (const root of document.querySelectorAll<HTMLElement>("[data-light]")) {
    const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
    new IntersectionObserver(
      async ([entry], observer) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        const { runShader } = await import("~/scripts/life-gl");
        runShader(canvas, RAYS, { pointer: root.closest<HTMLElement>(".tc") ?? root, dpr: 1.25 });
      },
      { rootMargin: "200px" },
    ).observe(root);
  }
</script>
