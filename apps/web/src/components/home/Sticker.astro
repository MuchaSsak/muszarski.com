---
/**
 * The hero sticker: a round accent label with a ring of availability text spinning around "since 2022"
 * (design.md § Hero). The ring text is fitted to the circle at build time from the font metrics, so every locale
 * closes the loop exactly. Decorative: the same facts are in the hero copy and the contact section.
 */
import { t } from "lingui-for-astro/macro";

import { SITE } from "~/data/site";
import { lineEm } from "~/lib/fit";

const locale = Astro.locals.locale;
// PLACEHOLDER: availability words (remote / hybrid, contract) wait for the owner (placeholders.md P4, Q3).
const ring = [t`Open to work`, t`Poland, CET`, t`Remote`].map((part) => part.toLocaleUpperCase(locale)).join(" • ") + " • ";
const RADIUS = 74;
const circumference = 2 * Math.PI * RADIUS;
// Letter spacing 0.18 em per character + the glyphs at wdth 115 fill the circle.
const em = lineEm(ring, 115) + 0.18 * [...ring].length;
const fontSize = Math.min(19, circumference / em);
---

<div class="sticker" aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <circle cx="100" cy="100" r="96"></circle>
    <path
      id="sticker-ring"
      d={`M100,100 m-${RADIUS},0 a${RADIUS},${RADIUS} 0 1,1 ${2 * RADIUS},0 a${RADIUS},${RADIUS} 0 1,1 -${2 * RADIUS},0`}
      fill="none"
    ></path>
    <text font-size={fontSize.toFixed(2)} textLength={circumference.toFixed(1)} lengthAdjust="spacing">
      <textPath href="#sticker-ring">{ring}</textPath>
    </text>
  </svg>
  <div class="core">
    <span>
      <small>{t`Shipping since`}</small>
      {SITE.since}
    </span>
  </div>
</div>

<style>
  .sticker {
    position: absolute;
    z-index: 2;
    width: clamp(6.25rem, 12vw, 11.25rem);
    aspect-ratio: 1;
    /* inside the 1920 content cap on ultrawide screens */
    right: calc(max(0px, (100% - 120rem) / 2) + clamp(0.5rem, 7vw, 7.5rem));
    top: clamp(1.5rem, 1vw, 2.75rem);
    color: var(--on-accent);
    container-type: inline-size;
    animation: pop 0.9s var(--ease-pop) 0.5s both;
  }
  @keyframes pop {
    from {
      transform: scale(0.4) rotate(-40deg);
      opacity: 0;
    }
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: spin 22s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  circle {
    fill: var(--accent);
  }
  text {
    fill: var(--on-accent);
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: 0.18em;
  }
  .core {
    position: absolute;
    inset: 27%;
    display: grid;
    place-items: center;
    text-align: center;
    font-weight: 900;
    font-size: 21cqi;
    line-height: 0.9;
    font-stretch: 70%;
  }
  .core small {
    display: block;
    margin-bottom: 0.2em;
    font-size: 0.3em;
    line-height: 1.05;
    font-weight: 700;
    font-stretch: 120%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Phones and tablets: the hero's .info is the anchor; the sticker sits beside the role line. */
  @media (max-width: 56.25rem) {
    .sticker {
      top: -0.5rem;
      right: 0;
      width: clamp(6.25rem, 18vw, 9rem);
    }
  }
</style>
