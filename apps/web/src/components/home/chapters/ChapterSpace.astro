---
/**
 * Chapter 04, the old 3D space portfolio (content/projects/space-portfolio.md): the honest "before" of this site.
 * The loop is cut from the owner's capture: only the Mars and Jupiter stops (planet textures by Solar System Scope,
 * CC BY 4.0, credited); the stops with third-party logos and the uncredited lens-dirt texture are left out
 * (design/assets.md, licences rule). No WebGL on this page: the site itself opens in a new tab, on desktop. Its
 * measured flaws (the Lighthouse numbers) live in the "how this site was built" post, not here [user 2026-10-06].
 */
import { t } from "lingui-for-astro/macro";

import ChapterBadge from "~/components/home/chapters/ChapterBadge.astro";
import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import StackList from "~/components/ui/StackList.astro";
import { WORK_LINKS } from "~/data/site";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const labelPause = t`Pause video`;
const labelPlay = t`Play video`;
---

<section class="sec chapter c-sp" id="space" aria-labelledby="t-sp">
  <div class="sky" aria-hidden="true">
    <div class="stars"></div>
    <div class="stars s2"></div>
    <div class="orbits">
      <span class="sun"></span>
      <span class="orbit r1"></span>
      <span class="orbit r2"></span>
      <span class="orbit r3"></span>
      <span class="orbit r4"></span>
      <span class="planet p1"></span>
      <span class="planet p2"></span>
      <span class="planet p3"></span>
      <span class="planet p4"></span>
    </div>
  </div>
  <ChapterBadge icon="tb:planet" label={t`Personal · solo · 2025`} />
  <div class="sp-grid grid-2">
    <figure class="reel stage-first" data-reel>
      <div class="frame">
        <div class="monitor">
          <div class="screen">
            <video
              tabindex="-1"
              muted
              loop
              playsinline
              preload="none"
              poster="/media/space/flight-poster.webp"
              width="960"
              height="540"
              aria-label={t`The space portfolio: the camera flies past Mars to Jupiter`}
            >
              <source data-src="/media/space/flight.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
              <source data-src="/media/space/flight.mp4" type="video/mp4" />
            </video>
            <span class="bigplay" aria-hidden="true">
              <Icon name="tbf:player-play" />
            </span>
            <button
              class="r-hit"
              type="button"
              data-toggle
              aria-pressed="true"
              aria-label={labelPlay}
              data-label-pause={labelPause}
              data-label-play={labelPlay}
            ></button>
          </div>
        </div>
        <div class="stand" aria-hidden="true"></div>
      </div>
      <figcaption class="credit">
        {t`Desktop · WebGL2 · ~14 MB.`}
        {t`Planet textures:`}{" "}
        <a href="https://www.solarsystemscope.com/textures/" rel="noopener" target="_blank">
          Solar System Scope<span class="sr-only"> {t`(opens in a new tab)`}</span>
        </a>
        ,{" "}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">
          CC BY 4.0<span class="sr-only"> {t`(opens in a new tab)`}</span>
        </a>
        .
      </figcaption>
    </figure>

    <div class="ch-info">
      <p class="outcome rv">{typo(locale, t`A portfolio you fly through: Earth to Neptune in 12 camera stops.`)}</p>
      <p class="desc rv" style="--d:1">
        {typo(
          locale,
          t`My previous portfolio: a scroll-driven flight through the solar system, where each planet holds one section. 13 shaders written by hand in GLSL. Best on a computer.`,
        )}
      </p>
      <div class="links rv" style="--d:2">
        <a
          class="btn btn-acc fine-only"
          href={WORK_LINKS.spaceLive}
          rel="noopener"
          target="_blank"
          data-umami-event="outbound"
          data-umami-event-target="space-live"
          data-umami-event-project="space-portfolio"
        >
          {t`Launch on desktop`}
          <Icon name="tb:arrow-up-right" class="nudge" />
          <span class="sr-only">{t`(opens in a new tab)`}</span>
        </a>
        <button
          class="btn btn-acc coarse-only"
          type="button"
          data-copy={WORK_LINKS.spaceLive}
          data-copied={t`Link copied. Open it on a computer.`}
        >
          <Icon name="tb:copy" />
          {t`Desktop only · copy link`}
        </button>
        <a
          class="btn btn-line"
          href={WORK_LINKS.spaceCode}
          rel="noopener"
          target="_blank"
          data-umami-event="outbound"
          data-umami-event-target="space-code"
          data-umami-event-project="space-portfolio"
        >
          <Icon name="si:github" />
          {t`Code`}
          <span class="sr-only">{t`(opens in a new tab)`}</span>
        </a>
      </div>
      <StackList
        class="rv"
        style="--d:3"
        items={[
          { icon: "si:threedotjs", name: "three.js" },
          { icon: "si:react", name: "React Three Fiber" },
          { icon: "si:gsap", name: "GSAP" },
          { icon: "si:vite", name: "Vite" },
        ]}
      />
    </div>
  </div>
  <Fit as="h2" id="t-sp" lines={["Space folio"]} class="sp-title" />
</section>

<style>
  .c-sp {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .c-sp > :not(.sky) {
    position: relative;
    z-index: 1;
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .stars {
    position: absolute;
    inset: 0;
    opacity: 0.85;
    background-image:
      radial-gradient(1.6px 1.6px at 20px 30px, #fff 50%, transparent 52%),
      radial-gradient(1.1px 1.1px at 120px 80px, #fff 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 60px 150px, #cfd3ff 50%, transparent 52%),
      radial-gradient(2.2px 2.2px at 160px 120px, #ffd23f 50%, transparent 52%);
    background-size:
      180px 180px,
      230px 230px,
      140px 140px,
      410px 410px;
  }
  .stars.s2 {
    background-position:
      70px 40px,
      10px 110px,
      90px 20px,
      200px 260px;
    animation: twinkle 3.4s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.1;
    }
  }

  /* An orrery: planets ride ellipses (CSS motion path); without support they rest at the start of their orbit. */
  .orbits {
    position: absolute;
    left: 35%;
    top: 52%;
    width: 0;
    height: 0;
    opacity: 0.6;
    transform: rotate(-12deg);
  }
  .orbit,
  .planet,
  .sun {
    position: absolute;
    left: 0;
    top: 0;
  }
  .orbit {
    width: var(--w);
    height: calc(var(--w) * 0.34);
    border: 1.5px dashed rgb(238 240 255 / 0.28);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .r1 {
    --w: 30vw;
  }
  .r2 {
    --w: 55vw;
  }
  .r3 {
    --w: 83vw;
  }
  .r4 {
    --w: 116vw;
  }
  .sun {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--yellow);
    transform: translate(-50%, -50%);
  }
  .planet {
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border-radius: 50%;
    background: var(--c);
    offset-path: ellipse(calc(var(--w) / 2) calc(var(--w) * 0.17) at 0 0);
    offset-rotate: 0deg;
    offset-anchor: center;
    animation: orbit var(--d) linear infinite;
    animation-delay: var(--ph);
  }
  .p1 {
    --w: 30vw;
    --s: 0.75rem;
    --c: var(--ice);
    --d: 20s;
    --ph: -3s;
  }
  .p2 {
    --w: 55vw;
    --s: 1.25rem;
    --c: var(--pink);
    --d: 30s;
    --ph: -19s;
  }
  .p3 {
    --w: 83vw;
    --s: 1.625rem;
    --c: var(--cobalt);
    --d: 45s;
    --ph: -30s;
    box-shadow: 0 0 0 2px var(--ice);
  }
  .p4 {
    --w: 116vw;
    --s: 1.125rem;
    --c: var(--yellow);
    --d: 70s;
    --ph: -12s;
  }
  @keyframes orbit {
    to {
      offset-distance: 100%;
    }
  }

  .sp-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: center;
    margin-top: clamp(1.75rem, 3vw, 3rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .monitor {
    padding: 0.875rem 0.875rem 1rem;
    border-radius: 1rem;
    background: #15173a;
    box-shadow:
      0 0 0 2px rgb(238 240 255 / 0.18),
      18px 18px 0 0 var(--pink);
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.375rem;
    background: #000;
  }
  .screen video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stand {
    width: 22%;
    height: 2.5rem;
    margin: 0 auto;
    background: #11132f;
    clip-path: polygon(22% 0, 78% 0, 100% 100%, 0 100%);
  }
  .credit {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.75;
  }
  /* The orrery passes behind the copy: a halo in the sky colour keeps every letter clear of a planet. */
  .ch-info :is(.outcome, .desc) {
    text-shadow:
      0 0 0.5rem var(--space),
      0 0 0.1875rem var(--space);
  }

  @media (max-width: 40rem) {
    .monitor {
      padding: 0.5rem 0.5rem 0.625rem;
      border-radius: 0.625rem;
      box-shadow:
        0 0 0 2px rgb(238 240 255 / 0.18),
        10px 10px 0 0 var(--pink);
    }
    .stand {
      height: 1.5rem;
    }
    .orbits {
      opacity: 0.45;
    }
  }
</style>
