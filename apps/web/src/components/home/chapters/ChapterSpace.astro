---
/**
 * Chapter 04, the old 3D space portfolio (content/projects/space-portfolio.md): the honest "before" of this site.
 * The loop is cut from the owner's capture: only the Mars and Jupiter stops (planet textures by Solar System Scope,
 * CC BY 4.0, credited); the stops with third-party logos and the uncredited lens-dirt texture are left out
 * (design/assets.md, licences rule). No WebGL on this page: the site itself opens in a new tab, on desktop.
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import ReelControls from "~/components/ui/ReelControls.astro";
import { WORK_LINKS } from "~/data/site";
import { thisSitePath } from "~/lib/blog-paths";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const caseStudy = thisSitePath(locale);

interface Props {
  /** "01 / 04": this chapter's place among the visible ones. */
  counter: string;
}
const { counter } = Astro.props;
---

<section class="sec chapter c-sp" id="space" aria-labelledby="t-sp">
  <div class="sky" aria-hidden="true">
    <div class="stars"></div>
    <div class="stars s2"></div>
    <div class="orbits">
      <span class="sun"></span>
      <span class="orbit r1"></span><span class="orbit r2"></span><span class="orbit r3"></span><span class="orbit r4"></span>
      <span class="planet p1"></span><span class="planet p2"></span><span class="planet p3"></span><span class="planet p4"></span>
    </div>
  </div>
  <div class="sbar draw">
    <p>{counter} · {t`Selected work`}</p>
    <p>{t`Personal · creative`}</p>
    <p>2025</p>
  </div>
  <div class="sp-grid grid-2">
    <figure class="reel stage-first" data-reel>
      <div class="frame">
        <div class="monitor">
          <div class="screen">
            <video
              muted
              loop
              playsinline
              preload="none"
              poster="/media/space/flight-poster.webp"
              width="960"
              height="540"
              aria-label={t`The space portfolio: the camera flies past Mars to Jupiter`}
            >
              <source data-src="/media/space/flight.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
              <source data-src="/media/space/flight.mp4" type="video/mp4" />
            </video>
            <button class="r-btn bigplay" type="button" data-play aria-label={t`Play video`}>
              <Icon name="tbf:player-play" />
            </button>
          </div>
        </div>
        <div class="stand" aria-hidden="true"></div>
      </div>
      <ReelControls
        chips={[
          { label: t`Mars`, at: 0, time: "0:00" },
          { label: t`Jupiter`, at: 3.6, time: "0:04" },
        ]}
      />
      <figcaption class="credit">
        {t`Desktop · WebGL2 · ~14 MB.`}
        {t`Planet textures:`} <a href="https://www.solarsystemscope.com/textures/" rel="noopener">Solar System Scope</a>, <a
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="license noopener">CC BY 4.0</a
        >.
      </figcaption>
    </figure>

    <div class="ch-info">
      <p class="tag-chip">{t`Personal · creative · 2025`}</p>
      <p class="outcome rv">{typo(locale, t`A portfolio you fly through: Earth to Neptune in 12 camera stops.`)}</p>
      <ul class="cfacts rv" style="--d:1">
        <li><span class="ib"><Icon name="si:webgl" /></span><span><b data-count="13">13</b>{t`GLSL shaders, by hand`}</span></li>
        <li><span class="ib"><Icon name="tb:planet" /></span><span><b data-count="12">12</b>{t`camera stops`}</span></li>
      </ul>
      <ul class="stackrow rv" style="--d:2" aria-label={t`Stack`}>
        <li><Icon name="si:threedotjs" />three.js</li>
        <li><Icon name="si:react" />React Three Fiber</li>
        <li><Icon name="si:gsap" />GSAP</li>
        <li><Icon name="si:vite" />Vite</li>
      </ul>
      <div class="links rv" style="--d:3">
        <a
          class="btn btn-acc fine-only"
          href={WORK_LINKS.spaceLive}
          rel="noopener"
          target="_blank"
          data-umami-event="outbound"
          data-umami-event-target="space-live"
          data-umami-event-project="space-portfolio"
        >
          {t`Launch on desktop`}
          <Icon name="tb:arrow-up-right" class="nudge" />
          <span class="sr-only">{t`(opens in a new tab)`}</span>
        </a>
        <button
          class="btn btn-acc coarse-only"
          type="button"
          data-copy={WORK_LINKS.spaceLive}
          data-copied={t`Link copied. Open it on a computer.`}
        >
          <Icon name="tb:copy" />
          {t`Desktop only · copy link`}
        </button>
        <a
          class="btn btn-line"
          href={WORK_LINKS.spaceCode}
          rel="noopener"
          target="_blank"
          data-umami-event="outbound"
          data-umami-event-target="space-code"
          data-umami-event-project="space-portfolio"
        >
          <Icon name="si:github" />{t`Code`}<span class="sr-only">{t`(opens in a new tab)`}</span>
        </a>
      </div>
      <a class="receipt rv" style="--d:4" href={caseStudy} data-umami-event="cta" data-umami-event-id="this-site" data-umami-event-source="space">
        <span class="r-h">Lighthouse · 2026-10-05</span>
        <span class="r-l">{t`Mobile performance`}<b data-count="34">34</b></span>
        <span class="r-l">{t`Desktop performance`}<b data-count="60">60</b></span>
        <span class="r-l">{t`Before the start button`}<b>13.8 MB</b></span>
        <span class="r-t">{t`So I rebuilt it. Read how`} →</span>
      </a>
    </div>
  </div>
  <Fit as="h2" id="t-sp" lines={["Space folio"]} class="sp-title" />
</section>

<style>
  .c-sp {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .c-sp > :not(.sky) {
    position: relative;
    z-index: 1;
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .stars {
    position: absolute;
    inset: 0;
    opacity: 0.85;
    background-image:
      radial-gradient(1.6px 1.6px at 20px 30px, #fff 50%, transparent 52%),
      radial-gradient(1.1px 1.1px at 120px 80px, #fff 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 60px 150px, #cfd3ff 50%, transparent 52%),
      radial-gradient(2.2px 2.2px at 160px 120px, #ffd23f 50%, transparent 52%);
    background-size:
      180px 180px,
      230px 230px,
      140px 140px,
      410px 410px;
  }
  .stars.s2 {
    background-position:
      70px 40px,
      10px 110px,
      90px 20px,
      200px 260px;
    animation: twinkle 3.4s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.1;
    }
  }

  /* An orrery: planets ride ellipses (CSS motion path); without support they rest at the start of their orbit. */
  .orbits {
    position: absolute;
    left: 35%;
    top: 52%;
    width: 0;
    height: 0;
    opacity: 0.6;
    transform: rotate(-12deg);
  }
  .orbit,
  .planet,
  .sun {
    position: absolute;
    left: 0;
    top: 0;
  }
  .orbit {
    width: var(--w);
    height: calc(var(--w) * 0.34);
    border: 1.5px dashed rgb(238 240 255 / 0.28);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .r1 {
    --w: 30vw;
  }
  .r2 {
    --w: 55vw;
  }
  .r3 {
    --w: 83vw;
  }
  .r4 {
    --w: 116vw;
  }
  .sun {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--yellow);
    transform: translate(-50%, -50%);
  }
  .planet {
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border-radius: 50%;
    background: var(--c);
    offset-path: ellipse(calc(var(--w) / 2) calc(var(--w) * 0.17) at 0 0);
    offset-rotate: 0deg;
    offset-anchor: center;
    animation: orbit var(--d) linear infinite;
    animation-delay: var(--ph);
  }
  .p1 {
    --w: 30vw;
    --s: 0.75rem;
    --c: var(--ice);
    --d: 20s;
    --ph: -3s;
  }
  .p2 {
    --w: 55vw;
    --s: 1.25rem;
    --c: var(--pink);
    --d: 30s;
    --ph: -19s;
  }
  .p3 {
    --w: 83vw;
    --s: 1.625rem;
    --c: var(--cobalt);
    --d: 45s;
    --ph: -30s;
    box-shadow: 0 0 0 2px var(--ice);
  }
  .p4 {
    --w: 116vw;
    --s: 1.125rem;
    --c: var(--yellow);
    --d: 70s;
    --ph: -12s;
  }
  @keyframes orbit {
    to {
      offset-distance: 100%;
    }
  }

  .sp-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: center;
    margin-top: clamp(1.75rem, 3vw, 3rem);
  }
  .monitor {
    padding: 0.875rem 0.875rem 1rem;
    border-radius: 1rem;
    background: #15173a;
    box-shadow:
      0 0 0 2px rgb(238 240 255 / 0.18),
      18px 18px 0 0 var(--pink);
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.375rem;
    background: #000;
  }
  .screen video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stand {
    width: 22%;
    height: 2.5rem;
    margin: 0 auto;
    background: #11132f;
    clip-path: polygon(22% 0, 78% 0, 100% 100%, 0 100%);
  }
  .credit {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .c-sp .tag-chip {
    background: var(--pink);
  }
  .sp-title {
    margin-top: clamp(2.5rem, 5vw, 5rem);
  }
  .sp-title :global(.fit) {
    color: transparent;
    -webkit-text-stroke: 2px var(--ice);
  }

  @media (max-width: 40rem) {
    .monitor {
      padding: 0.5rem 0.5rem 0.625rem;
      border-radius: 0.625rem;
      box-shadow:
        0 0 0 2px rgb(238 240 255 / 0.18),
        10px 10px 0 0 var(--pink);
    }
    .stand {
      height: 1.5rem;
    }
    .sp-title :global(.fit) {
      -webkit-text-stroke-width: 1.5px;
    }
    .orbits {
      opacity: 0.45;
    }
  }
</style>
