---
/**
 * Chapter 01, PstrykWeb (content/projects/pstrykweb.md). PUBLIC INFO ONLY [user 2026-10-05]: the product as its public
 * pages describe it, that he built it for Cetuspro (never "solo" or "team"), tech visible from outside. Never the pipeline, AI generation,
 * internal tools or counts. The stage is the owner's recording, cut to the public landing page and the order form
 * (design/assets.md; the team panel and client sites stay out). Rights status `check` (P10): hidden at launch until OK.
 */
import { t } from "lingui-for-astro/macro";

import ChapterBadge from "~/components/home/chapters/ChapterBadge.astro";
import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import StackList from "~/components/ui/StackList.astro";
import { WORK_LINKS } from "~/data/site";
import { lineEm } from "~/lib/fit";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const ring = [t`Latest`, t`My favourite`, t`Commercial`].map((part) => part.toLocaleUpperCase(locale)).join(" • ") + " • ";
const labelPause = t`Pause video`;
const labelPlay = t`Play video`;
const RADIUS = 62;
const circumference = 2 * Math.PI * RADIUS;
const fontSize = Math.min(14, circumference / (lineEm(ring, 120) + 0.16 * [...ring].length));
---

<section class="sec chapter c-pw" id="pstrykweb" aria-labelledby="t-pw">
  <div class="ch-bg" aria-hidden="true"></div>
  <ChapterBadge icon="tb:school" label={t`Internship · Cetuspro · 2026`} />
  <Fit as="h2" id="t-pw" lines={["PstrykWeb"]} />
  <div class="pw-grid grid-2">
    <div class="ch-info">
      <p class="outcome rv">{typo(locale, t`Bespoke websites for local businesses, ordered through one online form.`)}</p>
      <p class="desc rv" style="--d:1">
        {typo(
          locale,
          t`A local business owner answers a few questions in one online form and orders a website made for their business. I built PstrykWeb for Cetuspro, a Polish software house.`,
        )}
      </p>
      <div class="links rv" style="--d:2">
        <a
          class="btn btn-inv"
          href={WORK_LINKS.pstrykweb}
          rel="noopener"
          target="_blank"
          data-umami-event="outbound"
          data-umami-event-target="pstrykweb-site"
          data-umami-event-project="pstrykweb"
        >
          {t`Visit pstrykweb.pl`}
          <Icon name="tb:arrow-up-right" class="nudge" />
          <span class="sr-only">{t`(opens in a new tab)`}</span>
        </a>
      </div>
      <p class="status live">{t`Live`}</p>
      <StackList
        class="rv"
        style="--d:3"
        items={[
          { icon: "si:nextdotjs", name: "Next.js" },
          { icon: "si:typescript", name: "TypeScript" },
          { icon: "si:vercel", name: "Vercel" },
        ]}
      />
    </div>

    <figure class="reel pw-stage stage-first" data-reel>
      <div class="frame">
        <div class="award" aria-hidden="true">
          <div class="pw-spin">
            <svg viewBox="0 0 200 200">
              <polygon
                class="burst"
                points="100,0 113,20 135,8 140,32 164,28 160,52 184,58 172,79 194,92 176,108 190,128 168,136 172,160 148,160 144,184 122,174 110,196 96,178 78,194 70,170 46,176 46,152 22,148 32,126 10,112 28,96 12,78 34,68 26,46 50,44 52,20 74,28 86,6"
              ></polygon>
              <path
                id="pw-ring"
                d={`M100,100 m-${RADIUS},0 a${RADIUS},${RADIUS} 0 1,1 ${2 * RADIUS},0 a${RADIUS},${RADIUS} 0 1,1 -${2 * RADIUS},0`}
                fill="none"
              ></path>
              <text font-size={fontSize.toFixed(2)} textLength={circumference.toFixed(1)} lengthAdjust="spacing">
                <textPath href="#pw-ring">{ring}</textPath>
              </text>
            </svg>
          </div>
          <div class="core">
            <span>
              #1<small>{t`Featured`}</small>
            </span>
          </div>
        </div>
        <div class="browser">
          <div class="b-top" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <span class="b-url"></span>
          </div>
          <div class="b-view">
            <img
              class="r-poster"
              src="/media/work/pstrykweb-poster.webp"
              alt=""
              width="1280"
              height="628"
              loading="lazy"
              decoding="async"
            />
            <video
              tabindex="-1"
              muted
              loop
              playsinline
              preload="none"
              width="1280"
              height="628"
              aria-label={t`PstrykWeb: the landing page, then a business owner filling in the order form`}
            >
              <template>
                <source src="/media/work/pstrykweb.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
                <source src="/media/work/pstrykweb.mp4" type="video/mp4" />
              </template>
            </video>
            <span class="bigplay" aria-hidden="true">
              <Icon name="tbf:player-play" />
            </span>
            <button
              class="r-hit"
              type="button"
              data-toggle
              aria-pressed="true"
              aria-label={labelPlay}
              data-label-pause={labelPause}
              data-label-play={labelPlay}
            ></button>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .pw-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.75rem, 4vw, 4.5rem);
    margin-top: clamp(1.375rem, 2.6vw, 2.5rem);
    align-items: start;
  }
  .pw-stage {
    position: relative;
    z-index: 1;
    padding-left: clamp(0rem, 2vw, 1.5rem);
  }

  .award {
    position: absolute;
    z-index: 6;
    left: clamp(-3rem, -3vw, -0.75rem);
    top: clamp(-5rem, -5vw, -2.5rem);
    width: clamp(6.5rem, 10.5vw, 10rem);
    aspect-ratio: 1;
    color: var(--ice);
    container-type: inline-size;
  }
  /* Turns on an HTML wrapper so the compositor runs it (an SVG's own transform re-lays out the page every frame). */
  .award .pw-spin {
    width: 100%;
    height: 100%;
    animation: spin 26s linear infinite reverse;
  }
  .award svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .award .burst {
    fill: var(--cobalt);
  }
  .award text {
    fill: var(--ice);
    font-weight: 800;
    font-stretch: 120%;
  }
  .award .core {
    position: absolute;
    inset: 22%;
    display: grid;
    place-items: center;
    text-align: center;
    font-weight: 900;
    line-height: 0.85;
    font-size: 30cqi;
    font-stretch: 62%;
  }
  .award .core small {
    display: block;
    font-size: 0.26em;
    font-weight: 800;
    letter-spacing: 0.06em;
    font-stretch: 115%;
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .award {
      width: 5.75rem;
      left: -0.625rem;
      top: -2.75rem;
    }
  }
</style>
