---
/**
 * Chapter 03, Neoteric Clockful (content/projects/neoteric-clockful.md): internship work, rights `check` (P10), code
 * private. The stage is the owner's walkthrough recording (mock data): clients, projects, the timer, the reports.
 */
import { t } from "lingui-for-astro/macro";

import ChapterBadge from "~/components/home/chapters/ChapterBadge.astro";
import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import StackList from "~/components/ui/StackList.astro";
import { chromeLinks } from "~/lib/nav";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const links = chromeLinks(Astro.locals.locale);
const labelPause = t`Pause video`;
const labelPlay = t`Play video`;
---

<section class="sec chapter c-cf" id="clockful" aria-labelledby="t-cf">
  <div class="ch-bg" aria-hidden="true"></div>
  <ChapterBadge icon="tb:school" label={t`Internship · Neoteric · 2026`} />
  <Fit as="h2" id="t-cf" lines={["Clockful"]} />
  <div class="cf-grid grid-2">
    <figure class="reel stage-first" data-reel>
      <div class="frame">
        <div class="browser">
          <div class="b-top" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <span class="b-url"></span>
          </div>
          <div class="b-view">
            <img
              class="r-poster"
              src="/media/work/neoteric-clockful-poster.webp"
              alt=""
              width="1280"
              height="628"
              loading="lazy"
              decoding="async"
            />
            <video
              tabindex="-1"
              muted
              loop
              playsinline
              preload="none"
              width="1280"
              height="628"
              aria-label={t`Neoteric Clockful: a screen recording of the dashboard`}
            >
              <template>
                <source src="/media/work/neoteric-clockful.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
                <source src="/media/work/neoteric-clockful.mp4" type="video/mp4" />
              </template>
            </video>
            <span class="bigplay" aria-hidden="true">
              <Icon name="tbf:player-play" />
            </span>
            <button
              class="r-hit"
              type="button"
              data-toggle
              aria-pressed="true"
              aria-label={labelPlay}
              data-label-pause={labelPause}
              data-label-play={labelPlay}
            ></button>
          </div>
        </div>
      </div>
      <ul class="mstats rv">
        <li>
          <span class="top">
            <Icon name="tb:test-pipe" />
            <b>118</b>
          </span>
          {t`automated tests: 49 Vitest, 69 Playwright`}
        </li>
        <li>
          <span class="top">
            <Icon name="tb:shield-lock" />
            <b>5/5</b>
          </span>
          {t`tables behind row-level security`}
        </li>
        <li>
          <span class="top">
            <Icon name="tb:checklist" />
            <b>15</b>
          </span>
          {t`requirements in the spec`}
        </li>
        <li>
          <span class="top">
            <Icon name="tb:calendar" />
            <b>9</b>
          </span>
          {t`days from spec to hand-in (an estimate)`}
        </li>
      </ul>
    </figure>

    <div class="ch-info">
      <p class="outcome rv">{typo(locale, t`A role-based time tracker, built with AI agents under a deadline.`)}</p>
      <p class="desc rv" style="--d:1">
        {typo(
          locale,
          t`An internship brief from Neoteric, a Polish software house: a time tracker where employees log their hours and admins see the reports. The rule was to build it only with AI agents, against a deadline. I directed them and verified what they built, from the database rules to the tests.`,
        )}
      </p>
      <div class="links rv" style="--d:2">
        <a
          class="btn btn-inv"
          href={links.contact}
          data-umami-event="cta"
          data-umami-event-id="walkthrough"
          data-umami-event-source="clockful"
        >
          {t`Ask for a walkthrough`}
          <Icon name="tb:arrow-right" class="nudge" />
        </a>
      </div>
      <p class="status">{t`Code private · no public deployment`}</p>
      <StackList
        class="rv"
        style="--d:3"
        items={[
          { icon: "si:nextdotjs", name: "Next.js" },
          { icon: "si:supabase", name: "Supabase" },
          { icon: "si:reactquery", name: "TanStack Query" },
          { icon: "si:vitest", name: "Vitest" },
          { icon: "mk:playwright", name: "Playwright" },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .cf-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.75rem, 4vw, 4.5rem);
    margin-top: clamp(1.375rem, 2.6vw, 2.5rem);
    align-items: start;
  }
</style>
