---
/**
 * A chapter's backdrop [user 2026-10-06: subtle illustrations behind the projects, like Space's stars]: the project's
 * own motifs as faint line icons that drift slowly, over a faint pattern (`chapters.css` § Backdrop). Decorative only;
 * it sits under everything in the chapter and pauses offscreen like every loop.
 */
import Icon from "~/components/ui/Icon.astro";
import { type IconName } from "~/lib/icons.gen";

interface Props {
  icons: IconName[];
}

const { icons } = Astro.props;
// Spots along the edges and corners, clear of the text column's middle (x, y in %, size in rem, tilt in deg).
const SPOTS = [
  [3, 9, 4.5, -14],
  [91, 5, 6.5, 12],
  [58, 3, 3.5, -6],
  [94, 46, 5, 18],
  [2, 56, 5.5, 10],
  [44, 90, 4.5, -10],
  [84, 84, 7, -18],
  [20, 94, 3.5, 8],
] as const;
---

<div class="ch-bg" aria-hidden="true">
  {SPOTS.map(([x, y, size, tilt], i) => (
    <span style={`--x:${x}%;--y:${y}%;--s:${size}rem;--r:${tilt}deg;--i:${i}`}>
      <Icon name={icons[i % icons.length]!} />
    </span>
  ))}
</div>
