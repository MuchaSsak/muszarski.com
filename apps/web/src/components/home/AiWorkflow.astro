---
/**
 * AI workflow (structure.md § Home 4, requirements.md F07, brand.md pillar 3) as an org chart [user 2026-10-06: "I run
 * AI like a team"]: I lead, Claude Code builds, and a crew of ID badges hangs under it on lanyards: the wiki (memory),
 * hooks (rules), subagents (research), MCP servers (tools), skills (playbooks) and the quality gates. Each badge says
 * what it does with examples, never a count [user 2026-10-06: "dont give precise numbers"], and wears enamel pins with
 * the tools' marks. PstrykWeb is not evidence here (public info only). One CTA: the "how this site was built" post.
 * No JS: the wires flow and the badges swing in CSS, and pause like every loop.
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { thisSitePath } from "~/lib/blog-paths";
import { type IconName } from "~/lib/icons.gen";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;

/** An enamel pin on a badge: a tool's mark (Simple Icons, nominative use) or a two-letter monogram. */
type Pin = { icon: IconName } | { mono: string };
interface Member {
  icon: IconName;
  role: string;
  name: string;
  line: string;
  examples: string[];
  pins: Pin[];
}
const CREW: Member[] = [
  {
    icon: "tb:notebook",
    role: t`Memory`,
    name: t`Project wiki`,
    line: t`A Karpathy-style LLM wiki the agent reads first and updates after.`,
    examples: [t`goals`, t`design`, t`decisions`, t`lessons`],
    pins: [{ icon: "si:markdown" }],
  },
  {
    icon: "tb:plug",
    role: t`Rules`,
    name: t`Hooks`,
    line: t`Guardrails and scripts that run on their own.`,
    examples: [t`safety`, t`rules each session`, t`finish check`],
    pins: [{ icon: "tb:shield-lock" }, { icon: "tb:terminal-2" }],
  },
  {
    icon: "tb:users-group",
    role: t`Research`,
    name: t`Subagents`,
    line: t`Research in parallel. I get conclusions, not file dumps.`,
    examples: [t`docs`, t`references`, t`audits`],
    pins: [{ icon: "si:claude" }],
  },
  {
    icon: "tb:puzzle",
    role: t`Tools`,
    name: t`MCP servers`,
    line: t`Real data in place of guesses.`,
    examples: ["Mobbin", t`component registry`, "Playwright"],
    pins: [{ icon: "si:modelcontextprotocol" }, { mono: "Pw" }],
  },
  {
    icon: "tb:stack-2",
    role: t`Playbooks`,
    name: t`Skills`,
    line: t`Routines I start with one command.`,
    examples: [t`screenshot QA`, "Lighthouse", t`design research`, t`commits`],
    pins: [{ icon: "si:lighthouse" }],
  },
  {
    icon: "tb:checklist",
    role: t`Quality`,
    name: t`Gates`,
    line: t`Every change runs them. Nothing ships red.`,
    examples: ["TypeScript", "ESLint", t`tests`, "axe", "Lighthouse"],
    pins: [{ icon: "si:typescript" }, { icon: "si:eslint" }, { icon: "si:vitest" }],
  },
];
const TILT = [-2, 1.5, -1, 2, -1.5, 1];
const PIN_TILT = [-12, 9, -6];
---

<section class="sec field-deep ai" id="ai" aria-labelledby="t-ai">
  <div class="sbar draw">
    <p>{t`AI workflow`}</p>
    <p>{t`How I build with AI`}</p>
    <p>{t`The real setup behind this site`}</p>
  </div>
  <Fit as="h2" id="t-ai" lines={[t`I run AI like a team.`]} />
  <p class="lede rv">
    {typo(locale, t`I lead, Claude Code builds. Around it works a crew of memory, rules, tools and checks, and I review every change before it ships.`)}
  </p>

  <div class="org">
    <div class="heads">
      <div class="idb me rv" style="--r:-2deg">
        <span class="slot" aria-hidden="true"></span>
        <span class="role">{t`Lead`}</span>
        <Icon name="tb:user" class="idb-i" />
        <span class="nm">{t`Me`}</span>
        <span class="duty">{t`I brief, review every change and decide.`}</span>
      </div>
      <span class="wire w-x" aria-hidden="true"></span>
      <div class="idb agent rv" style="--d:1;--r:1.5deg">
        <span class="slot" aria-hidden="true"></span>
        <span class="role">{t`Builder`}</span>
        <Icon name="si:claude" class="idb-i spark" />
        <span class="nm">Claude Code</span>
        <span class="duty">{t`Writes the code, inside the rules of the crew below.`}</span>
      </div>
    </div>
    <span class="wire w-y" aria-hidden="true"></span>
    <ul class="crew" role="list" aria-label={t`The crew`}>
      {
        CREW.map((member, i) => (
          <li class="idb rv" style={`--d:${i + 2};--r:${TILT[i]}deg`}>
            <span class="slot" aria-hidden="true" />
            <span class="pins" aria-hidden="true">
              {member.pins.map((pin, k) => (
                <span class="pin" style={`--k:${k};--pr:${PIN_TILT[(i + k) % PIN_TILT.length]}deg`}>
                  {"icon" in pin ? <Icon name={pin.icon} /> : <b>{pin.mono}</b>}
                </span>
              ))}
            </span>
            <span class="role">{member.role}</span>
            <Icon name={member.icon} class="idb-i" />
            <span class="nm">{member.name}</span>
            <span class="duty">{typo(locale, member.line)}</span>
            <ul class="ex" role="list">
              {member.examples.map((example) => (
                <li>{example}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="go">
    <a class="btn btn-inv" href={thisSitePath(locale)} data-umami-event="cta" data-umami-event-id="this-site" data-umami-event-source="ai">
      {t`How this site was built`}
      <Icon name="tb:arrow-right" class="nudge" />
    </a>
  </div>
</section>

<style>
  .ai {
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }
  .lede {
    max-width: 52ch;
    margin: clamp(1rem, 2vw, 1.75rem) auto 0;
    text-align: center;
    font-size: clamp(1.1875rem, 1.5vw, 1.4375rem);
    line-height: 1.4;
  }

  /* The org chart: two heads in a row, a wire down, a bus over the crew with a drop to each badge. */
  .org {
    --wire: color-mix(in srgb, currentColor 70%, transparent);
    position: relative;
    margin-top: clamp(1.75rem, 3.4vw, 3rem);
  }
  .heads {
    display: grid;
    grid-template-columns: minmax(0, 17rem) 4.5rem minmax(0, 17rem);
    justify-content: center;
    align-items: center;
  }
  .wire {
    display: block;
    background: repeating-linear-gradient(90deg, var(--wire) 0 10px, transparent 10px 18px);
    animation: flow 1s linear infinite;
  }
  .w-x {
    height: 3px;
  }
  .w-y {
    width: 3px;
    height: 2.25rem;
    margin: 0 auto;
    margin-left: calc(50% + (17rem + 4.5rem) / 2 - 1.5px);
    background: repeating-linear-gradient(180deg, var(--wire) 0 10px, transparent 10px 18px);
    animation-name: flow-y;
  }
  @keyframes flow {
    to {
      background-position: 18px 0;
    }
  }
  @keyframes flow-y {
    to {
      background-position: 0 18px;
    }
  }
  .crew {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    margin: 0;
    padding: 2.25rem 0 0;
    list-style: none;
  }
  /* The bus over the crew and a drop to each badge. */
  .crew::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(100% / 12);
    right: calc(100% / 12);
    height: 3px;
    background: repeating-linear-gradient(90deg, var(--wire) 0 10px, transparent 10px 18px);
    animation: flow 1s linear infinite;
  }
  .crew > li::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -2.25rem;
    width: 3px;
    height: 2.25rem;
    margin-left: -1.5px;
    background: repeating-linear-gradient(180deg, var(--wire) 0 10px, transparent 10px 18px);
    animation: flow-y 1s linear infinite;
  }

  /* An ID badge on a lanyard: a slot, pins, the role, an icon, the name, one line and examples. It swings a little
     (the `rotate` property, so the reveal and the hover lift keep `transform`). */
  .idb {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 0.375rem 0.5rem;
    padding: 1.375rem 1rem 1.125rem;
    background: var(--ice);
    color: var(--navy);
    box-shadow: 6px 6px 0 var(--navy);
    rotate: var(--r, 0deg);
    transform-origin: 50% 0;
    animation: ai-swing 5s ease-in-out infinite;
    animation-delay: calc(var(--d, 0) * -0.85s);
    transition: transform 0.5s var(--ease-pop);
  }
  @keyframes ai-swing {
    0%,
    100% {
      rotate: var(--r, 0deg);
    }
    50% {
      rotate: calc(var(--r, 0deg) * -0.5);
    }
  }
  .slot {
    position: absolute;
    left: 50%;
    top: 0.5rem;
    width: 2.25rem;
    height: 0.4375rem;
    margin-left: -1.125rem;
    border-radius: 1rem;
    background: var(--deep-bg);
    box-shadow: inset 0 0 0 2px var(--navy);
  }
  .role {
    align-self: center;
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-stretch: 125%;
  }
  .idb :global(.idb-i) {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.45s var(--ease-pop);
  }
  .nm {
    grid-column: 1 / -1;
    font-weight: 900;
    font-size: clamp(1.25rem, 1.5vw, 1.625rem);
    line-height: 0.95;
    font-stretch: 72%;
    text-transform: uppercase;
  }
  .duty {
    grid-column: 1 / -1;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .ex {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ex li {
    padding: 0.1875rem 0.4375rem;
    background: rgb(10 13 51 / 0.08);
    box-shadow: inset 0 0 0 1.5px rgb(10 13 51 / 0.25);
    font-weight: 800;
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.03em;
  }

  /* Enamel pins: round, tilted, each its own colour, stuck over the badge's top right corner. */
  .pins {
    position: absolute;
    top: -1.375rem;
    right: -0.625rem;
    z-index: 1;
    display: flex;
    flex-direction: row-reverse;
  }
  .pin {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    margin-left: -0.625rem;
    border-radius: 50%;
    background: var(--pin, var(--yellow));
    color: var(--navy);
    box-shadow:
      inset 0 0 0 2px var(--navy),
      inset 0 0 0 4px rgb(255 255 255 / 0.45),
      2px 3px 0 var(--navy);
    rotate: var(--pr);
    transition: transform 0.45s var(--ease-pop);
    transition-delay: calc(var(--k) * 60ms);
  }
  .pin:nth-child(3n + 2) {
    --pin: var(--lime);
  }
  .pin:nth-child(3n + 3) {
    --pin: var(--pink);
  }
  .pin :global(.ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .pin b {
    font-weight: 900;
    font-size: 0.8125rem;
    font-stretch: 80%;
  }
  .me {
    background: var(--accent);
    color: var(--on-accent);
  }
  .agent :global(.spark) {
    animation: ai-pulse 2.4s ease-in-out infinite;
  }
  @keyframes ai-pulse {
    50% {
      transform: scale(1.18);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .idb:hover {
      transform: translateY(-4px);
      animation-play-state: paused;
    }
    .idb:hover :global(.idb-i) {
      transform: rotate(-10deg) scale(1.15);
    }
    .idb:hover .pin {
      transform: translateY(-3px) rotate(14deg) scale(1.1);
    }
  }
  .go {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 3.6vw, 3rem);
  }

  /* Tablets: the crew in three columns, one bus per row is too busy, so the bus becomes a frame line on top. */
  @media (max-width: 75rem) {
    .crew {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: clamp(1.75rem, 3vw, 2.5rem);
    }
    .crew::before {
      left: calc(100% / 6);
      right: calc(100% / 6);
    }
    .crew > li:nth-child(n + 4)::before {
      display: none;
    }
  }
  /* Phones: the heads stack with a wire between them; the crew in two columns without wires. */
  @media (max-width: 40rem) {
    .lede {
      text-align: left;
    }
    .heads {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
      max-width: 22rem;
      margin-inline: auto;
    }
    .w-x {
      width: 3px;
      height: 1.5rem;
      margin: 0 auto;
      background: repeating-linear-gradient(180deg, var(--wire) 0 10px, transparent 10px 18px);
      animation-name: flow-y;
    }
    .w-y {
      margin-left: auto;
      height: 1.5rem;
    }
    .crew {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 0.875rem;
      padding-top: 1.25rem;
    }
    .crew::before,
    .crew > li::before {
      display: none;
    }
    .idb {
      padding: 1.25rem 0.75rem 0.875rem;
      box-shadow: 4px 4px 0 var(--navy);
    }
    .pins {
      right: -0.375rem;
    }
    .pin {
      width: 2rem;
      height: 2rem;
    }
    .nm {
      font-size: 1.25rem;
    }
    .duty {
      font-size: 0.8125rem;
    }
  }
</style>
