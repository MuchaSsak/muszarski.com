---
/**
 * AI workflow (structure.md § Home 4, requirements.md F07, brand.md pillar 3): how one change gets made, told as a
 * story in seven beats [user 2026-10-06: "explainer animations ... how that workflow looks like in practice step by
 * step", the crew as Claude Code agents and me leading them; less text than the badges]. The team sits on top (me and
 * the agents, each with its job); each beat lights up who works, plays a drawn scene and says one line, with the real
 * tools as marks. Never counts [user 2026-10-06]. PstrykWeb is not evidence here (public info only).
 * Every beat's text is in the HTML (crawlable, readable without JS, then all seven read as a list); the script shows
 * one beat at a time and advances while the section is visible, like a story [user 2026-10-06: "click on any step and
 * go to it, and also pause upon clicking on the illustration"]: a step plays from its start; the drawing or the corner
 * chip pauses and plays; the site's pause button and reduced motion stop it. One CTA: the "how this site was built" post.
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { thisSitePath } from "~/lib/blog-paths";
import { type IconName } from "~/lib/icons.gen";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;

type Actor = "me" | "lead" | "memory" | "research" | "tools" | "rules" | "checks";
type Scene = "brief" | "wiki" | "research" | "tools" | "build" | "checks" | "review";
/**
 * The team: me, the lead agent and the agents around it, each with its job. A click on one jumps to the step that
 * shows that job (`scene`) [user 2026-10-07].
 */
const TEAM: { id: Actor; name: string; job: string; icon: IconName; scene: Scene }[] = [
  { id: "me", name: t`Me`, job: t`lead`, icon: "tb:user", scene: "brief" },
  { id: "lead", name: "Claude Code", job: t`builds`, icon: "tb:code", scene: "build" },
  { id: "memory", name: t`Wiki`, job: t`remembers`, icon: "tb:notebook", scene: "wiki" },
  { id: "research", name: t`Subagents`, job: t`research`, icon: "tb:users-group", scene: "research" },
  { id: "tools", name: t`MCP`, job: t`bring data`, icon: "tb:plug", scene: "tools" },
  { id: "rules", name: t`Hooks`, job: t`guard`, icon: "tb:shield-lock", scene: "build" },
  { id: "checks", name: t`Skills + gates`, job: t`check`, icon: "tb:checklist", scene: "checks" },
];
interface Beat {
  scene: Scene;
  name: string;
  line: string;
  color: string;
  actors: Actor[];
  /** The real tools behind the beat: a mark where one exists, a plain chip where not. */
  marks: { label: string; icon?: IconName }[];
}
const BEATS: Beat[] = [
  {
    scene: "brief",
    name: t`Brief`,
    line: t`I brief the lead agent: the goal, the limits, what done looks like.`,
    color: "var(--yellow)",
    actors: ["me", "lead"],
    marks: [{ label: t`goal` }, { label: t`limits` }, { label: t`definition of done` }],
  },
  {
    scene: "wiki",
    name: t`Memory`,
    line: t`It reads the wiki the agents keep. A hook picks the pages this task needs.`,
    color: "var(--lime)",
    actors: ["lead", "memory"],
    marks: [
      { label: t`Karpathy-style LLM wiki`, icon: "si:markdown" },
      { label: t`routing hook`, icon: "tb:route" },
      { label: t`decisions` },
      { label: t`lessons` },
    ],
  },
  {
    scene: "research",
    name: t`Research`,
    line: t`Subagents research in parallel and bring back conclusions.`,
    color: "var(--pink)",
    actors: ["lead", "research"],
    marks: [{ label: t`subagents`, icon: "si:claude" }, { label: t`docs` }, { label: t`references` }, { label: t`audits` }],
  },
  {
    scene: "tools",
    name: t`Tools`,
    line: t`MCP servers bring real data: real app screens, components, a browser.`,
    color: "var(--orange)",
    actors: ["lead", "tools"],
    marks: [
      { label: "MCP", icon: "si:modelcontextprotocol" },
      { label: "Mobbin" },
      { label: t`shadcn registry`, icon: "si:shadcnui" },
      { label: "Playwright", icon: "mk:playwright" },
    ],
  },
  {
    scene: "build",
    name: t`Build`,
    line: t`It builds inside the rules. Hooks stop the risky moves.`,
    color: "var(--ice)",
    actors: ["lead", "rules"],
    marks: [
      { label: t`safety hooks`, icon: "tb:shield-lock" },
      { label: t`scripts`, icon: "tb:terminal-2" },
    ],
  },
  {
    scene: "checks",
    name: t`Check`,
    line: t`Skills and gates check every change: types, tests, accessibility, speed.`,
    color: "var(--yellow)",
    actors: ["checks"],
    marks: [
      { label: "TypeScript", icon: "si:typescript" },
      { label: "ESLint", icon: "si:eslint" },
      { label: "Vitest", icon: "si:vitest" },
      { label: "axe", icon: "tb:accessible" },
      { label: "Lighthouse", icon: "si:lighthouse" },
    ],
  },
  {
    scene: "review",
    name: t`Review`,
    line: t`I review and decide. What we learned goes back into the wiki.`,
    color: "var(--lime)",
    actors: ["me", "memory"],
    marks: [
      { label: t`code review`, icon: "tb:git-pull-request" },
      { label: t`lessons`, icon: "tb:bulb" },
    ],
  },
];
/** The brief as real words, and the lead agent's reply [user 2026-10-07: small actual text, Claude acknowledging]. */
const BRIEF = [
  { key: t`Goal`, value: t`A one-step contact form` },
  { key: t`Limits`, value: t`No new libraries` },
  { key: t`Done`, value: t`Tests pass, I review it` },
];
const reply = t`On it. Briefing the team.`;
/**
 * Memory: the real wiki folder (.claude/project-info/), the routing hook matching the brief's task to its pages, and
 * the agent reading only those [user 2026-10-07: explain the LLM wiki and project-info better].
 */
const WIKI: { file: string; note?: string; pick?: boolean }[] = [
  { file: "README.md", note: t`map` },
  { file: "brand.md" },
  { file: "design.md" },
  { file: "structure.md", pick: true },
  { file: "lessons.md", pick: true },
];
const task = t`task: contact form`;
const read = t`read`;
/** Research: each subagent searches its own source [user 2026-10-07: show the searching, not only check marks]. */
const SOURCES: { icon: IconName; query: string }[] = [
  { icon: "tb:book-2", query: t`form docs` },
  { icon: "tb:world", query: t`form examples` },
  { icon: "tb:list-check", query: t`WCAG rules` },
];
const findings = t`Findings`;
/** The MCP servers in the Tools step, named [user 2026-10-07: the bare icons weren't obvious]. */
const TOOLS: { icon: IconName; name: string; what: string }[] = [
  { icon: "tb:device-mobile", name: "Mobbin", what: t`app screens` },
  { icon: "si:shadcnui", name: "shadcn", what: t`components` },
  { icon: "mk:playwright", name: "Playwright", what: t`a browser` },
];
/** The wires from each tool to the MCP plug, in the scene's own units (1 = 1cqw). */
const WIRES = ["M10.5 9 L31 19.5", "M36 9 L36 19.5", "M61.5 9 L41 19.5"];
/** The checks a change passes, each named in words [user 2026-10-07: the logos alone weren't obvious]. */
const CHECKS: { icon: IconName; label: string }[] = [
  { icon: "si:typescript", label: t`Types` },
  { icon: "si:eslint", label: t`Lint` },
  { icon: "si:vitest", label: t`Unit tests` },
  { icon: "mk:playwright", label: t`Browser tests` },
  { icon: "tb:accessible", label: t`Accessibility` },
  { icon: "si:lighthouse", label: t`Speed` },
];
/** The step that shows a scene: a click on a team member jumps there. */
const beatOf = (scene: Scene) => Math.max(0, BEATS.findIndex((beat) => beat.scene === scene));
const pad = (n: number) => String(n).padStart(2, "0");
const blocked = t`blocked by a hook`;
const approved = t`approved`;
/** A real lesson from the wiki, written back after a review. */
const lesson = t`Test focus in Safari too`;
---

<section class="sec field-deep ai" id="ai" aria-labelledby="t-ai">
  <div class="sbar draw">
    <p>{t`AI workflow`}</p>
    <p>{t`How I build with AI`}</p>
    <p>{t`The real setup behind this site`}</p>
  </div>
  <Fit as="h2" id="t-ai" lines={[t`I run AI like a team.`]} />
  <p class="lede rv">
    {typo(locale, t`I lead. Claude Code agents do the work, each with its own job, and nothing ships before I review it.`)}
  </p>

  <div class="story rv" data-story data-on={BEATS[0]!.actors.join(" ")}>
    <ul class="team" role="list" aria-label={t`The team`}>
      {TEAM.map((member) => (
        <li class={`tm tm-${member.id}`}>
          <button class="tm-btn" type="button" data-jump={beatOf(member.scene)} aria-controls={`beat-${beatOf(member.scene)}`}>
            <span class:list={["av", { "av-me": member.id === "me" }]} aria-hidden="true">
              <Icon name={member.id === "me" ? "tb:user" : "si:claude"} />
              {member.id !== "me" && (
                <i>
                  <Icon name={member.icon} />
                </i>
              )}
            </span>
            <b>{member.name}</b>
            <small>{member.job}</small>
          </button>
        </li>
      ))}
    </ul>

    <ol class="beats" aria-label={t`One change, step by step`}>
      {BEATS.map((beat, i) => (
        <li>
          <button class="beat" type="button" aria-pressed={i === 0 ? "true" : "false"} aria-controls={`beat-${i}`} data-beat={i}>
            <span class="prog" aria-hidden="true">
              <i />
            </span>
            <span class="bn tabular">{pad(i + 1)}</span>
            <span class="bl">{beat.name}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="shows">
      <button class="ai-pp js-only" type="button" data-pp>
        <Icon name="tbf:player-pause" class="pp-pause" />
        <Icon name="tbf:player-play" class="pp-play" />
        <span class="pp-pause">{t`Pause`}</span>
        <span class="pp-play">{t`Play`}</span>
      </button>
      {BEATS.map((beat, i) => (
        <div class="bt" id={`beat-${i}`} data-bt={i} data-actors={beat.actors.join(" ")}>
          <div class={`sc sc-${beat.scene}`} style={`--c:${beat.color}`} aria-hidden="true">
            {beat.scene === "brief" && (
              <div class="row">
                <span class="av av-me">
                  <Icon name="tb:user" />
                </span>
                <span class="paper">
                  <Icon name="tb:target" />
                  {BRIEF.map((line, k) => (
                    <span class="bl-line" style={`--k:${k}`}>
                      <b>{line.key}</b>
                      {line.value}
                    </span>
                  ))}
                </span>
                <span class="av nod">
                  <Icon name="si:claude" />
                  <span class="reply">{reply}</span>
                </span>
              </div>
            )}
            {beat.scene === "wiki" && (
              <div class="row">
                <span class="av wk-av">
                  <Icon name="si:claude" />
                </span>
                <span class="beam">
                  <i class="doc" style="--k:0">
                    <Icon name="tb:file-text" />
                  </i>
                  <i class="doc" style="--k:1">
                    <Icon name="tb:file-text" />
                  </i>
                </span>
                <span class="wk">
                  <span class="wk-head">
                    <Icon name="tb:notebook" />
                    project-info/
                  </span>
                  <span class="wk-task">
                    <Icon name="tb:route" />
                    {task}
                  </span>
                  {WIKI.map((page, k) => (
                    <span class:list={["wk-row", { pick: page.pick }]} style={`--k:${k}`}>
                      <Icon name="tb:file-text" />
                      <span class="wk-file">{page.file}</span>
                      {page.note && <small>{page.note}</small>}
                      {page.pick && (
                        <b>
                          <Icon name="tb:check" />
                          {read}
                        </b>
                      )}
                    </span>
                  ))}
                </span>
              </div>
            )}
            {beat.scene === "research" && (
              <div class="row">
                <span class="av">
                  <Icon name="si:claude" />
                </span>
                <span class="fan">
                  {SOURCES.map((source, k) => (
                    <span class="lane" style={`--k:${k}`}>
                      <span class="av">
                        <Icon name="si:claude" />
                      </span>
                      <span class="query">
                        <Icon name="tb:search" />
                        <span>{source.query}</span>
                      </span>
                      <span class="src">
                        <Icon name={source.icon} />
                        <i class="find" />
                      </span>
                    </span>
                  ))}
                </span>
                <span class="sum">
                  <b class="sum-title">{findings}</b>
                  <i class="note" style="--k:0" />
                  <i class="note" style="--k:1" />
                  <span class="bars">
                    <i style="--h:45%;--k:0" />
                    <i style="--h:80%;--k:1" />
                    <i style="--h:60%;--k:2" />
                  </span>
                </span>
              </div>
            )}
            {beat.scene === "tools" && (
              <div class="plug">
                <svg class="wires" viewBox="0 0 72 35">
                  {WIRES.map((d, k) => (
                    <g style={`--k:${k}`}>
                      <path class="wire" d={d} pathLength="100" />
                      <path class="pulse pulse-o" d={d} pathLength="100" />
                      <path class="pulse" d={d} pathLength="100" />
                    </g>
                  ))}
                  <path class="wire wire-in" d="M36 23 L36 27" pathLength="100" />
                </svg>
                {TOOLS.map((tool, k) => (
                  <span class="tool" style={`--k:${k}`}>
                    <small class="tool-name">{tool.name}</small>
                    <Icon name={tool.icon} />
                    <span class="tool-what">{tool.what}</span>
                  </span>
                ))}
                <span class="mcp-plug">
                  <Icon name="si:modelcontextprotocol" />
                  MCP
                </span>
                <span class="av">
                  <Icon name="si:claude" />
                </span>
              </div>
            )}
            {beat.scene === "build" && (
              <div class="row">
                <span class="av">
                  <Icon name="si:claude" />
                </span>
                <span class="term">
                  <span class="tl" style="--k:0">
                    edit ContactForm.astro
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="tl" style="--k:1">
                    edit contact.ts
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="tl bad" style="--k:2">
                    <s>$ git push --force</s>
                    <span class="stamp no">
                      <Icon name="tb:shield-lock" />
                      {blocked}
                    </span>
                  </span>
                  <span class="tl" style="--k:3">
                    format + lint
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                </span>
              </div>
            )}
            {beat.scene === "checks" && (
              <div class="row">
                <span class="change">
                  <Icon name="tb:git-pull-request" />
                  <i class="add" />
                  <i class="add" />
                  <i class="del" />
                </span>
                <span class="flow" />
                <span class="checklist">
                  {CHECKS.map((check, k) => (
                    <span class="ck" style={`--k:${k}`}>
                      <span class="ck-ico">
                        <Icon name={check.icon} />
                      </span>
                      <b>{check.label}</b>
                      <i>
                        <Icon name="tb:check" />
                      </i>
                    </span>
                  ))}
                </span>
              </div>
            )}
            {beat.scene === "review" && (
              <div class="row">
                <span class="av av-me">
                  <Icon name="tb:user" />
                </span>
                <span class="pr">
                  <Icon name="tb:git-pull-request" />
                  <i class="add" />
                  <i class="add" />
                  <i class="del" />
                  <i class="add" />
                  <span class="stamp yes">{approved}</span>
                </span>
                <span class="wiki">
                  <span class="wk-head">
                    <Icon name="tb:file-text" />
                    lessons.md
                  </span>
                  <i class="w-ln" />
                  <i class="w-ln" />
                  <span class="w-new">+ {lesson}</span>
                  <span class="lesson">
                    <Icon name="tb:bulb" />
                  </span>
                </span>
              </div>
            )}
          </div>
          <p class="cap">
            <span class="cap-n tabular">{pad(i + 1)}</span>
            <span>{typo(locale, beat.line)}</span>
          </p>
          <ul class="marks" role="list">
            {beat.marks.map((mark) => (
              <li>
                {mark.icon && <Icon name={mark.icon} />}
                {mark.label}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="go">
    <a
      class="btn btn-inv"
      href={thisSitePath(locale)}
      data-umami-event="cta"
      data-umami-event-id="this-site"
      data-umami-event-source="ai"
    >
      {t`How this site was built`}
      <Icon name="tb:arrow-right" class="nudge" />
    </a>
  </div>
</section>

<style>
  .ai {
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }
  .lede {
    max-width: 52ch;
    margin: clamp(1rem, 2vw, 1.75rem) auto 0;
    text-align: center;
    font-size: clamp(1.1875rem, 1.5vw, 1.4375rem);
    line-height: 1.4;
  }

  /* The story: the team on top, the beats as story bars, one scene at a time. */
  .story {
    --beat: 4.6s;
    display: grid;
    gap: 1.25rem;
    /* On a short laptop screen (768 px) the story narrows a little, so team, stage and caption fit one screen. */
    max-width: min(68rem, max(30rem, (100svh - var(--header-h)) * 1.44));
    margin: clamp(1.5rem, 2.6vw, 2.25rem) auto 0;
  }

  /* The team: me and the agents. Who works in the current beat steps forward; the others wait, a little faded. */
  .team {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tm {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.375rem;
    text-align: center;
    transition: transform 0.45s var(--ease-pop);
  }
  /* Each member is a button: a click jumps to the step that shows that member's job. */
  .tm-btn {
    display: grid;
    justify-items: center;
    gap: 0.375rem;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }
  .tm-btn:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.js) .tm-btn:hover .av {
      opacity: 1;
    }
    .tm-btn:hover b {
      color: var(--yellow);
    }
  }
  /* Room under the avatar for the ring it wears while it works. */
  .tm .av {
    --av: 3rem;
    margin-bottom: 0.625rem;
    transition:
      opacity var(--dur-base),
      box-shadow var(--dur-base);
  }
  .tm b {
    font-weight: 900;
    font-size: 0.9375rem;
    line-height: 1.05;
    font-stretch: 75%;
    text-transform: uppercase;
  }
  .tm small {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }
  :global(.js) .tm .av {
    opacity: 0.5;
  }
  .story[data-on~="me"] .tm-me,
  .story[data-on~="lead"] .tm-lead,
  .story[data-on~="memory"] .tm-memory,
  .story[data-on~="research"] .tm-research,
  .story[data-on~="tools"] .tm-tools,
  .story[data-on~="rules"] .tm-rules,
  .story[data-on~="checks"] .tm-checks {
    transform: translateY(-0.375rem);
  }
  .story[data-on~="me"] .tm-me .av,
  .story[data-on~="lead"] .tm-lead .av,
  .story[data-on~="memory"] .tm-memory .av,
  .story[data-on~="research"] .tm-research .av,
  .story[data-on~="tools"] .tm-tools .av,
  .story[data-on~="rules"] .tm-rules .av,
  .story[data-on~="checks"] .tm-checks .av {
    opacity: 1;
    box-shadow:
      0 0 0 3px var(--navy),
      0 0 0 6px var(--yellow),
      5px 5px 0 6px var(--navy);
  }

  /* An avatar: an agent is a tile with the Claude mark and its job's badge; I am the pink circle. */
  /* Sized by --av: a percentage padding would resolve against the parent's width. */
  .av {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--av, 3rem);
    aspect-ratio: 1;
    padding: calc(var(--av, 3rem) * 0.2);
    border-radius: 22%;
    background: var(--ice);
    color: #d97757;
    box-shadow:
      0 0 0 3px var(--navy),
      4px 4px 0 3px var(--navy);
  }
  .av > :global(.ico) {
    width: 100%;
    height: 100%;
  }
  .av-me {
    border-radius: 50%;
    background: var(--pink);
    color: var(--navy);
  }
  .av i {
    position: absolute;
    right: -18%;
    bottom: -18%;
    display: grid;
    place-items: center;
    width: 48%;
    aspect-ratio: 1;
    padding: calc(var(--av, 3rem) * 0.08);
    border-radius: 50%;
    background: var(--navy);
    color: var(--ice);
  }
  .av i :global(.ico) {
    width: 100%;
    height: 100%;
  }

  /* Story bars: one per beat; the current one fills while it plays. */
  .beats {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .beat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.375rem 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0 0 0.25rem;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .prog {
    grid-column: 1 / -1;
    height: 0.375rem;
    background: color-mix(in srgb, currentColor 28%, transparent);
    overflow: hidden;
  }
  .prog i {
    display: block;
    height: 100%;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .beat.done .prog i,
  :global(.still) .beat[aria-pressed="true"] .prog i {
    transform: none;
  }
  .beat[aria-pressed="true"] .prog i {
    animation: ai-fill var(--beat) linear both;
  }
  :global(.still) .beat .prog i {
    animation: none;
  }
  .story.paused .beat[aria-pressed="true"] .prog i {
    animation-play-state: paused;
  }
  @media (hover: hover) and (pointer: fine) {
    .beat:hover :is(.bn, .bl) {
      color: var(--yellow);
    }
    .beat:hover .prog {
      background: color-mix(in srgb, currentColor 50%, transparent);
    }
  }
  @keyframes ai-fill {
    to {
      transform: none;
    }
  }
  .bn {
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .bl {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 900;
    font-size: 0.9375rem;
    font-stretch: 78%;
    text-transform: uppercase;
  }
  .beat[aria-pressed="true"] :is(.bn, .bl) {
    color: var(--yellow);
  }
  .beat:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  /* With the script, one beat at a time; without it, all seven read as a list. */
  .shows {
    display: grid;
    gap: 2.5rem;
  }
  :global(.js) .bt:not(.on) {
    display: none;
  }
  :global(.js) .bt.on {
    animation: ai-swap 0.45s var(--ease-out);
  }
  @keyframes ai-swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .bt {
    display: grid;
    gap: 0.875rem;
  }
  .cap {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0.25rem 0 0;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.12;
    font-stretch: 85%;
    text-wrap: balance;
  }
  .cap-n {
    flex: none;
    padding: 0.125rem 0.4375rem;
    background: var(--yellow);
    color: var(--navy);
    font-size: 0.875rem;
    font-stretch: 100%;
  }
  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marks li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.375rem 0.625rem;
    background: var(--ice);
    color: var(--navy);
    font-weight: 800;
    font-size: 0.8125rem;
    line-height: 1.2;
  }
  .marks :global(.ico) {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  /* ---- The scenes: drawn in container units so each scales as one picture. Paused or reduced motion shows the
     finished picture at once. Keyframes carry the ai- prefix (Astro does not scope them). 16:6 keeps the whole story
     on a laptop screen; the tallest drawing (the wiki pages) is 33.3cqw of the 37.5cqw frame. */
  .sc {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 6;
    overflow: hidden;
    container-type: inline-size;
    background: var(--c);
    color: var(--navy);
    box-shadow:
      0 0 0 3px var(--navy),
      12px 12px 0 3px var(--navy);
  }
  .sc::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(10 13 51 / 0.16) 1.2px, transparent 1.7px) 0 0 / 2.8cqw 2.8cqw;
  }
  :global(.still) .sc *,
  :global(.still) .sc *::before,
  :global(.still) .sc *::after {
    animation: none !important;
  }
  /* Pause / play the story: the chip in the stage's corner, or a click on the drawing itself. Paused, the scene
     freezes where it is and the bar stops filling; a click on a step always plays from that step. */
  .shows {
    position: relative;
  }
  :global(.js) .sc {
    cursor: pointer;
  }
  .ai-pp {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.875rem 0.25rem 0.625rem;
    border: 0;
    border-radius: 999px;
    background: var(--navy);
    color: var(--ice);
    font-weight: 900;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      scale 0.3s var(--ease-pop),
      background-color 0.2s var(--ease-out);
  }
  .ai-pp :global(.ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .ai-pp:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }
  .ai-pp :global(.pp-play),
  .story.paused .ai-pp :global(.pp-pause) {
    display: none;
  }
  .story.paused .ai-pp :global(.pp-play) {
    display: block;
  }
  .story.paused .ai-pp {
    background: var(--yellow);
    color: var(--navy);
    scale: 1.08;
  }
  @media (hover: hover) and (pointer: fine) {
    .ai-pp:hover {
      scale: 1.06;
    }
  }
  .story.paused .sc *,
  .story.paused .sc *::before,
  .story.paused .sc *::after {
    animation-play-state: paused !important;
  }
  /* Nothing to pause when motion is already still. */
  :global(.still) .ai-pp {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-pp {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc *,
    .sc *::before,
    .sc *::after {
      animation: none !important;
    }
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5cqw;
  }
  .sc .av {
    --av: 11cqw;
    box-shadow:
      0 0 0 0.45cqw var(--navy),
      1.1cqw 1.1cqw 0 0.45cqw var(--navy);
  }
  .sc :global(.ico) {
    width: 100%;
    height: 100%;
  }
  .paper,
  .wk,
  .src,
  .sum,
  .tool,
  .pr,
  .wiki {
    background: var(--ice);
    box-shadow:
      0 0 0 0.45cqw var(--navy),
      1.1cqw 1.1cqw 0 0.45cqw var(--navy);
  }
  @keyframes ai-pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes ai-type {
    from {
      background-size: 0 100%;
    }
  }
  @keyframes ai-nod {
    0%,
    100% {
      transform: none;
    }
    40% {
      transform: translateY(-1.2cqw) rotate(-6deg);
    }
  }

  /* 1. Brief: the brief flies from me to the lead agent and fills in line by line; the agent nods and answers. */
  .paper {
    display: grid;
    grid-template-columns: auto auto;
    gap: 1.4cqw;
    max-width: 46cqw;
    padding: 2.4cqw 2.6cqw;
    transform: rotate(-3deg);
    animation: ai-fly 0.9s var(--ease-out) 0.15s both;
  }
  .paper > :global(.ico) {
    grid-column: 1 / -1;
    width: 4.4cqw;
    height: 4.4cqw;
  }
  .bl-line {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding-bottom: 0.8cqw;
    border-bottom: 0.3cqw solid rgb(10 13 51 / 0.2);
    font-weight: 700;
    font-size: 2.3cqw;
    line-height: 1.15;
    clip-path: inset(0 0 0 0);
    animation: ai-line 0.5s steps(14, end) both;
    animation-delay: calc(0.9s + var(--k) * 0.35s);
  }
  .bl-line b {
    font-weight: 900;
    font-size: 1.8cqw;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @keyframes ai-fly {
    from {
      transform: translateX(-24cqw) scale(0.3) rotate(-20deg);
    }
  }
  .nod {
    margin-left: 6cqw;
    animation: ai-nod 0.6s ease-in-out 2.1s;
  }
  /* The agent's answer: a speech bubble under it, on two short lines (the corner above holds the play chip). */
  .reply {
    position: absolute;
    top: calc(100% + 2.6cqw);
    left: 50%;
    width: max-content;
    max-width: 24cqw;
    padding: 1cqw 1.6cqw;
    background: var(--navy);
    color: var(--ice);
    font-weight: 800;
    font-size: 2.2cqw;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    translate: -50% 0;
    rotate: 3deg;
    animation: ai-pop 0.4s var(--ease-pop) 2.3s both;
  }
  .reply::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 2cqw;
    height: 1.6cqw;
    margin-left: -1cqw;
    background: var(--navy);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  /* 2. Memory: the wiki folder; the routing hook matches the task to its pages, they light up as read, and copies of
     them travel to the agent. The other pages stay unread. */
  .beam {
    position: relative;
    width: 9cqw;
    height: 0.6cqw;
    background: repeating-linear-gradient(90deg, var(--navy) 0 1.4cqw, transparent 1.4cqw 2.6cqw);
    transform-origin: 100% 50%;
    animation: ai-grow-x 0.45s ease-out 1.6s both;
  }
  @keyframes ai-grow-x {
    from {
      transform: scaleX(0);
    }
  }
  .doc {
    position: absolute;
    right: 0;
    top: 50%;
    display: grid;
    width: 3.6cqw;
    height: 3.6cqw;
    margin-top: -1.8cqw;
    padding: 0.5cqw;
    background: var(--yellow);
    box-shadow: 0 0 0 0.35cqw var(--navy);
    opacity: 0;
    animation: ai-doc 0.8s ease-in both;
    animation-delay: calc(2s + var(--k) * 0.35s);
  }
  @keyframes ai-doc {
    0% {
      opacity: 0;
      transform: translateX(5cqw);
    }
    10%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(-9cqw);
    }
  }
  .wk-av {
    animation: ai-nod 0.6s ease-in-out 3s;
  }
  .wk {
    position: relative;
    display: grid;
    gap: 0.7cqw;
    width: 40cqw;
    padding: 2cqw 2.2cqw;
  }
  .wk-head {
    display: flex;
    align-items: center;
    gap: 1cqw;
    margin-bottom: 0.5cqw;
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-weight: 700;
    font-size: 2.3cqw;
  }
  .wk-head > :global(.ico) {
    flex: none;
    width: 3cqw;
    height: 3cqw;
  }
  /* The routing hook: the task from the brief, pinned to the folder's corner. */
  .wk-task {
    position: absolute;
    top: -3.4cqw;
    left: -3cqw;
    display: flex;
    align-items: center;
    gap: 0.8cqw;
    padding: 0.7cqw 1.4cqw;
    background: var(--navy);
    color: var(--ice);
    font-weight: 900;
    font-size: 2cqw;
    letter-spacing: 0.03em;
    white-space: nowrap;
    rotate: -3deg;
    animation: ai-pop 0.4s var(--ease-pop) 0.5s both;
  }
  .wk-task > :global(.ico) {
    flex: none;
    width: 2.4cqw;
    height: 2.4cqw;
  }
  .wk-row {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 0.45cqw 0.8cqw;
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 2.1cqw;
    line-height: 1.2;
    white-space: nowrap;
  }
  .wk-row > :global(.ico) {
    flex: none;
    width: 2.5cqw;
    height: 2.5cqw;
  }
  .wk-row small {
    padding: 0.1cqw 0.8cqw;
    border: 0.25cqw solid currentColor;
    font-family: var(--font-sans, inherit);
    font-weight: 800;
    font-size: 1.6cqw;
    text-transform: uppercase;
  }
  /* Picked by the hook: highlighted, then marked as read. The rest dim. */
  .wk-row.pick {
    background: linear-gradient(var(--yellow), var(--yellow)) 0 0 / 100% 100% no-repeat;
    box-shadow: 0 0 0 0.3cqw var(--navy);
    animation: ai-type 0.4s ease-out both;
    animation-delay: calc(0.9s + (var(--k) - 3) * 0.35s);
  }
  .wk-row:not(.pick) {
    animation: ai-dim 0.4s ease-out 1.7s both;
  }
  @keyframes ai-dim {
    to {
      opacity: 0.4;
    }
  }
  .wk-row b {
    display: flex;
    align-items: center;
    gap: 0.5cqw;
    margin-left: auto;
    padding: 0.2cqw 0.9cqw;
    background: var(--navy);
    color: var(--lime);
    font-family: var(--font-sans, inherit);
    font-weight: 900;
    font-size: 1.6cqw;
    text-transform: uppercase;
    animation: ai-pop 0.35s var(--ease-pop) both;
    animation-delay: calc(1.3s + (var(--k) - 3) * 0.35s);
  }
  .wk-row b :global(.ico) {
    width: 2cqw;
    height: 2cqw;
    stroke-width: 3;
  }

  /* 3. Research: three subagents fan out, each types its query and scans its source; findings fly into one summary
     of notes and numbers. */
  .fan {
    display: grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: 2cqw 1.6cqw;
  }
  .lane {
    display: contents;
  }
  .sc .lane .av {
    --av: 6.5cqw;
    animation: ai-out 0.7s var(--ease-pop) both;
    animation-delay: calc(0.2s + var(--k) * 0.15s);
  }
  @keyframes ai-out {
    from {
      transform: translate(-14cqw, calc((1 - var(--k)) * 9cqw)) scale(0.2);
    }
  }
  .query {
    display: flex;
    align-items: center;
    gap: 0.8cqw;
    padding: 0.9cqw 1.6cqw 0.9cqw 1.4cqw;
    border-radius: 99px;
    background: var(--ice);
    box-shadow: 0 0 0 0.45cqw var(--navy);
    font-weight: 700;
    font-size: 1.9cqw;
    white-space: nowrap;
    overflow: hidden;
  }
  .query > :global(.ico) {
    flex: none;
    width: 2.4cqw;
    height: 2.4cqw;
  }
  .query span {
    clip-path: inset(0 0 0 0);
    animation: ai-line 0.6s steps(16, end) both;
    animation-delay: calc(0.7s + var(--k) * 0.2s);
  }
  .src {
    position: relative;
    display: grid;
    place-items: center;
    width: 6.5cqw;
    aspect-ratio: 1;
    padding: 1.5cqw;
    border-radius: 50%;
    animation: ai-pop 0.4s var(--ease-pop) both;
    animation-delay: calc(0.5s + var(--k) * 0.15s);
  }
  /* A finding leaves the source for the summary, again and again while the step plays. */
  .find {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.2cqw;
    height: 2.2cqw;
    margin: -1.1cqw 0 0 -1.1cqw;
    background: var(--yellow);
    box-shadow: 0 0 0 0.35cqw var(--navy);
    opacity: 0;
    animation: ai-find 1.4s ease-in infinite;
    animation-delay: calc(1.4s + var(--k) * 0.3s);
  }
  @keyframes ai-find {
    0% {
      opacity: 1;
      transform: none;
    }
    85% {
      opacity: 1;
      transform: translate(11cqw, calc((1 - var(--k)) * 8cqw)) rotate(90deg) scale(0.8);
    }
    100% {
      opacity: 0;
      transform: translate(11cqw, calc((1 - var(--k)) * 8cqw)) rotate(90deg) scale(0.4);
    }
  }
  .sum {
    display: grid;
    gap: 1.3cqw;
    width: 19cqw;
    padding: 2.2cqw;
    transform: rotate(3deg);
    animation: ai-pop-r 0.5s var(--ease-pop) 1.2s both;
  }
  @keyframes ai-pop-r {
    from {
      transform: rotate(3deg) scale(0);
    }
  }
  .sum-title {
    font-weight: 900;
    font-size: 2.2cqw;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .note {
    height: 1.2cqw;
    background: linear-gradient(rgb(10 13 51 / 0.35), rgb(10 13 51 / 0.35)) 0 0 / 100% 100% no-repeat;
    animation: ai-type 0.5s ease-out both;
    animation-delay: calc(2s + var(--k) * 0.4s);
  }
  .note:nth-of-type(2) {
    width: 75%;
  }
  .bars {
    display: flex;
    align-items: end;
    gap: 1.2cqw;
    height: 6cqw;
    padding-top: 0.6cqw;
    border-bottom: 0.4cqw solid var(--navy);
  }
  .bars i {
    flex: 1;
    height: var(--h);
    background: var(--pink);
    box-shadow: 0 0 0 0.3cqw var(--navy);
    transform-origin: 50% 100%;
    animation: ai-grow-y 0.45s var(--ease-pop) both;
    animation-delay: calc(2.6s + var(--k) * 0.15s);
  }

  /* 4. Tools: three MCP servers, each named with what it brings; their wires meet at the MCP plug above the agent
     and data pulses down them. Laid out in the scene's own units: the SVG's 1 unit is 1cqw. */
  .plug {
    position: relative;
    width: 72cqw;
    height: 35cqw;
  }
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .wire,
  .pulse {
    fill: none;
    stroke-linecap: round;
  }
  .wire {
    stroke: var(--navy);
    stroke-width: 0.6;
    stroke-dasharray: 100;
    animation: ai-wire 0.5s ease-out both;
    animation-delay: calc(0.45s + var(--k, 3) * 0.15s);
  }
  @keyframes ai-wire {
    from {
      stroke-dashoffset: 100;
    }
  }
  .pulse {
    stroke: var(--ice);
    stroke-width: 1.5;
    stroke-dasharray: 9 200;
    stroke-dashoffset: 9;
    animation: ai-pulse 1.2s ease-in infinite;
    animation-delay: calc(1.1s + var(--k) * 0.3s);
  }
  .pulse-o {
    stroke: var(--navy);
    stroke-width: 2.6;
  }
  @keyframes ai-pulse {
    to {
      stroke-dashoffset: -100;
    }
  }
  .tool {
    position: absolute;
    top: 3.4cqw;
    left: calc(var(--k) * 25.5cqw);
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.7cqw;
    width: 21cqw;
    height: 10cqw;
    animation: ai-pop 0.45s var(--ease-pop) both;
    animation-delay: calc(var(--k) * 0.15s);
  }
  .tool > :global(.ico) {
    width: 4.4cqw;
    height: 4.4cqw;
  }
  .tool-what {
    font-weight: 800;
    font-size: 2cqw;
    line-height: 1;
    white-space: nowrap;
  }
  @keyframes ai-grow-y {
    from {
      transform: scaleY(0);
    }
  }
  /* Names: a tab on each tool, so the picture reads without knowing the logos. */
  .tool-name {
    position: absolute;
    bottom: calc(100% + 0.45cqw);
    left: 50%;
    padding: 0.5cqw 1.2cqw;
    background: var(--navy);
    color: var(--ice);
    font-weight: 900;
    font-size: 2.2cqw;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    translate: -50% 0;
  }
  .mcp-plug {
    position: absolute;
    left: 50%;
    top: 19.5cqw;
    display: flex;
    align-items: center;
    gap: 0.8cqw;
    height: 4cqw;
    padding: 0 1.6cqw 0 1.2cqw;
    border-radius: 99px;
    background: var(--navy);
    color: var(--ice);
    font-weight: 900;
    font-size: 2.2cqw;
    letter-spacing: 0.06em;
    translate: -50% 0;
    animation: ai-pop 0.4s var(--ease-pop) 0.35s both;
  }
  .mcp-plug > :global(.ico) {
    width: 2.6cqw;
    height: 2.6cqw;
  }
  .plug .av {
    --av: 8cqw;
    position: absolute;
    left: 50%;
    top: 26.5cqw;
    translate: -50% 0;
  }

  /* 5. Build: the agent writes; a risky command meets a hook and is stopped; the work goes on. */
  .term {
    position: relative;
    display: grid;
    gap: 1.3cqw;
    padding: 2.4cqw 2.6cqw;
    background: var(--navy);
    color: var(--ice);
    box-shadow: 1.1cqw 1.1cqw 0 rgb(10 13 51 / 0.35);
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 2.6cqw;
    white-space: nowrap;
  }
  .tl {
    display: flex;
    align-items: center;
    gap: 2cqw;
    clip-path: inset(0 0 0 0);
    animation: ai-line 0.45s steps(12, end) both;
    animation-delay: calc(0.3s + var(--k) * 0.5s);
  }
  @keyframes ai-line {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
  .tl b {
    display: grid;
    width: 3cqw;
    height: 3cqw;
    margin-left: auto;
    color: var(--lime);
  }
  .tl.bad {
    color: #ff8a8a;
    /* Room for the tag's tilt and shadow outside the line's typing clip. */
    clip-path: inset(-2cqw -4cqw -2cqw 0);
  }
  .tl.bad s {
    text-decoration-thickness: 0.4cqw;
  }
  .stamp {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 1cqw;
    padding: 1cqw 1.8cqw;
    font-family: var(--font-sans, inherit);
    font-weight: 900;
    font-size: 3cqw;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .stamp :global(.ico) {
    width: 3.4cqw;
    height: 3.4cqw;
  }
  .stamp.no {
    position: relative;
    margin-left: 2cqw;
    padding: 0.6cqw 1.2cqw;
    background: var(--pink);
    color: var(--navy);
    box-shadow: 0.6cqw 0.6cqw 0 var(--ice);
    font-size: 2cqw;
    transform: rotate(-3deg);
    animation: ai-stamp 0.4s var(--ease-pop) 1.45s both;
  }
  .stamp.no :global(.ico) {
    width: 2.6cqw;
    height: 2.6cqw;
  }
  @keyframes ai-stamp {
    from {
      opacity: 0;
      transform: rotate(-3deg) scale(2.2);
    }
  }

  /* 6. Check: the change runs down a checklist; each named check ticks green in turn. */
  .change {
    display: grid;
    gap: 1.4cqw;
    width: 14cqw;
    padding: 2cqw;
    background: var(--ice);
    box-shadow:
      0 0 0 0.45cqw var(--navy),
      1.1cqw 1.1cqw 0 0.45cqw var(--navy);
    rotate: -3deg;
  }
  .change > :global(.ico) {
    width: 4.4cqw;
    height: 4.4cqw;
  }
  .change i {
    height: 1.2cqw;
  }
  .change .add {
    background: #0a8a4a;
  }
  .change .del {
    width: 60%;
    background: #e8331f;
  }
  .flow {
    width: 6cqw;
    height: 0.6cqw;
    background: repeating-linear-gradient(90deg, var(--navy) 0 1.2cqw, transparent 1.2cqw 2.2cqw);
    transform-origin: 0 50%;
    animation: ai-grow-x 0.45s ease-out 0.2s both;
  }
  .checklist {
    display: grid;
    grid-template-columns: repeat(2, 27cqw);
    gap: 1.6cqw 2cqw;
    padding: 2.2cqw;
    background: var(--ice);
    box-shadow:
      0 0 0 0.45cqw var(--navy),
      1.1cqw 1.1cqw 0 0.45cqw var(--navy);
  }
  .ck {
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    min-width: 0;
  }
  .ck-ico {
    flex: none;
    display: grid;
    width: 5cqw;
    height: 5cqw;
    padding: 1cqw;
    background: var(--navy);
    color: var(--ice);
  }
  .ck b {
    flex: 1;
    min-width: 0;
    font-weight: 900;
    font-size: 2.2cqw;
    line-height: 1.05;
    text-transform: uppercase;
    font-stretch: 80%;
  }
  .ck i {
    flex: none;
    display: grid;
    width: 4cqw;
    height: 4cqw;
    padding: 0.7cqw;
    border-radius: 50%;
    background: var(--lime);
    color: var(--navy);
    box-shadow: 0 0 0 0.4cqw var(--navy);
    animation: ai-pop 0.35s var(--ease-pop) both;
    animation-delay: calc(0.6s + var(--k) * 0.32s);
  }
  .ck i :global(.ico) {
    stroke-width: 3;
  }

  /* 7. Review: I approve the change; a lesson flies back into the wiki. */
  .pr {
    position: relative;
    display: grid;
    gap: 1.5cqw;
    width: 25cqw;
    padding: 2.6cqw;
  }
  .pr > :global(.ico) {
    width: 5cqw;
    height: 5cqw;
  }
  .pr i {
    height: 1.4cqw;
  }
  .pr .add {
    width: 80%;
    background: #0a8a4a;
  }
  .pr .del {
    width: 55%;
    background: #e8331f;
  }
  .stamp.yes {
    right: -4cqw;
    top: 2.6cqw;
    background: var(--ice);
    color: #0a8a4a;
    box-shadow: inset 0 0 0 0.5cqw #0a8a4a;
    transform: rotate(-10deg);
    animation: ai-stamp-y 0.4s var(--ease-pop) 0.7s both;
  }
  @keyframes ai-stamp-y {
    from {
      opacity: 0;
      transform: rotate(-10deg) scale(2.2);
    }
  }
  .wiki {
    position: relative;
    display: grid;
    gap: 1.2cqw;
    width: 27cqw;
    padding: 2.2cqw;
  }
  .w-ln {
    height: 1.2cqw;
    background: rgb(10 13 51 / 0.3);
  }
  .w-ln + .w-ln {
    width: 70%;
  }
  .w-new {
    padding: 0.6cqw 0.9cqw;
    background: var(--pink);
    box-shadow: 0 0 0 0.3cqw var(--navy);
    font-weight: 800;
    font-size: 2cqw;
    line-height: 1.15;
    clip-path: inset(-1cqw);
    animation: ai-write 0.7s steps(18, end) 2.2s both;
  }
  @keyframes ai-write {
    from {
      clip-path: inset(-1cqw 100% -1cqw -1cqw);
    }
  }
  .lesson {
    position: absolute;
    right: -2.4cqw;
    top: -2.4cqw;
    display: grid;
    width: 6cqw;
    height: 6cqw;
    padding: 1.2cqw;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 0.4cqw var(--navy);
    animation: ai-learn 0.9s var(--ease-out) 1.4s both;
  }
  @keyframes ai-learn {
    from {
      transform: translate(-22cqw, 4cqw) scale(0.4);
    }
  }

  .go {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 3.6vw, 3rem);
  }

  /* Tablets and phones: the team in four columns, the beats as numbers only; the scene grows taller. */
  @media (max-width: 56.25rem) {
    .team {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 1.25rem;
    }
    .bl {
      display: none;
    }
    .beat {
      grid-template-columns: minmax(0, 1fr);
    }
    .sc {
      aspect-ratio: 2 / 1;
    }
  }
  @media (max-width: 40rem) {
    .lede {
      text-align: left;
    }
    .team {
      gap: 1.125rem 0.375rem;
    }
    .tm .av {
      --av: 2.75rem;
    }
    .tm b {
      font-size: 0.8125rem;
    }
    .tm small {
      font-size: 0.6875rem;
    }
    .beats {
      gap: 0.3125rem;
    }
    .sc {
      aspect-ratio: 4 / 3;
      box-shadow:
        0 0 0 3px var(--navy),
        7px 7px 0 3px var(--navy);
    }
    /* The taller frame leaves room: the picture grows a third; the widest scenes drop a secondary piece (the agent
       is already named in the caption) and grow by half. */
    .sc > * {
      scale: var(--ps, 1.3);
    }
    .row {
      gap: 3.5cqw;
    }
    .sc-wiki {
      --ps: 1.4;
    }
    /* Brief: the agent steps under the brief and answers from the side, so the bubble stays inside the frame. */
    .sc-brief {
      --ps: 1.45;
    }
    .sc-brief > * {
      translate: 0 6.5cqw;
    }
    .sc-brief .row {
      display: grid;
      grid-template-columns: auto auto;
      align-items: center;
      gap: 1.5cqw 3.5cqw;
    }
    .sc-brief .nod {
      grid-column: 2;
      justify-self: end;
      margin: 0 1cqw 0 0;
    }
    .sc-brief .reply {
      left: auto;
      right: calc(100% + 2.6cqw);
      top: 50%;
      max-width: 28cqw;
      translate: 0 -50%;
      rotate: -2deg;
    }
    .sc-brief .reply::after {
      left: 100%;
      top: 50%;
      bottom: auto;
      width: 1.6cqw;
      height: 2cqw;
      margin: -1cqw 0 0;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }
    .sc-build,
    .sc-checks {
      --ps: 1.5;
    }
    .sc-research {
      --ps: 1.4;
    }
    .sc-research .row > .av,
    .sc-build .row > .av,
    .sc-checks :is(.change, .flow) {
      display: none;
    }
  }
</style>

<script>
  import { motionStill } from "~/scripts/motion";

  for (const story of document.querySelectorAll<HTMLElement>("[data-story]")) {
    const buttons = [...story.querySelectorAll<HTMLButtonElement>("[data-beat]")];
    const beats = [...story.querySelectorAll<HTMLElement>("[data-bt]")];
    const pp = story.querySelector<HTMLButtonElement>("[data-pp]");
    const step = parseFloat(getComputedStyle(story).getPropertyValue("--beat")) * 1000 || 4600;
    let current = 0;
    let visible = false;
    let paused = false;
    let pausedAt = 0;
    let shownAt = performance.now();

    // Paused: the scene freezes and the bar stops; playing again carries on from the same moment.
    const setPaused = (on: boolean) => {
      if (on === paused) return;
      paused = on;
      const now = performance.now();
      if (on) pausedAt = now;
      else shownAt += now - pausedAt;
      story.classList.toggle("paused", on);
    };
    const show = (i: number) => {
      current = i;
      // Re-showing the same beat restarts its scene and its bar.
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      beats.forEach((d) => d.classList.remove("on"));
      void story.offsetWidth;
      buttons.forEach((b, j) => {
        b.setAttribute("aria-pressed", String(j === i));
        b.classList.toggle("done", j < i);
      });
      beats[i]!.classList.add("on");
      story.dataset.on = beats[i]!.dataset.actors;
      shownAt = performance.now();
    };
    // A step: go there and play it from the start.
    buttons.forEach((b, i) =>
      b.addEventListener("click", () => {
        setPaused(false);
        show(i);
      }),
    );
    // A team member: jump to the step that shows their job, and play it.
    for (const jump of story.querySelectorAll<HTMLButtonElement>("[data-jump]")) {
      jump.addEventListener("click", () => {
        setPaused(false);
        show(Number(jump.dataset.jump));
      });
    }
    // The chip, or a click anywhere on the drawing, pauses and plays.
    pp?.addEventListener("click", () => setPaused(!paused));
    for (const scene of story.querySelectorAll<HTMLElement>(".sc")) {
      scene.addEventListener("click", () => {
        if (!motionStill()) setPaused(!paused);
      });
    }
    show(0);

    new IntersectionObserver(
      ([entry]) => {
        const was = visible;
        visible = !!entry?.isIntersecting;
        // Coming into view restarts the current beat, so its scene plays where it can be seen.
        if (visible && !was && !paused) show(current);
      },
      { threshold: 0.35 },
    ).observe(story);
    setInterval(() => {
      const now = performance.now();
      if (!visible || paused || motionStill() || document.hidden || now - shownAt < step) return;
      show((current + 1) % buttons.length);
    }, 250);
  }
</script>
