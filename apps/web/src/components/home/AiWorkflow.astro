---
/**
 * AI workflow (structure.md § Home 4, requirements.md F07, brand.md pillar 3): how one change gets made, told as a
 * story in seven beats [user 2026-10-06: "explainer animations ... how that workflow looks like in practice step by
 * step", the crew as Claude Code agents and me leading them; less text than the badges]. The team sits on top (me and
 * the agents, each with its job); each beat lights up who works, plays a drawn scene and says one line, with the real
 * tools as marks. Never counts [user 2026-10-06]. PstrykWeb is not evidence here (public info only).
 * Every beat's text is in the HTML (crawlable, readable without JS, then all seven read as a list); the script shows
 * one beat at a time and advances while the section is visible, like a story [user 2026-10-06: "click on any step and
 * go to it, and also pause upon clicking on the illustration"]: a step plays from its start; the drawing or the corner
 * chip pauses and plays; the site's pause button and reduced motion stop it. One CTA: the "how this site was built" post.
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { thisSitePath } from "~/lib/blog-paths";
import { type IconName } from "~/lib/icons.gen";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;

type Actor = "me" | "lead" | "memory" | "research" | "tools" | "rules" | "checks";
/** The team: me, the lead agent and the agents around it, each with its job. */
const TEAM: { id: Actor; name: string; job: string; icon: IconName }[] = [
  { id: "me", name: t`Me`, job: t`lead`, icon: "tb:user" },
  { id: "lead", name: "Claude Code", job: t`builds`, icon: "tb:code" },
  { id: "memory", name: t`Wiki`, job: t`remembers`, icon: "tb:notebook" },
  { id: "research", name: t`Subagents`, job: t`research`, icon: "tb:users-group" },
  { id: "tools", name: t`MCP`, job: t`bring data`, icon: "tb:plug" },
  { id: "rules", name: t`Hooks`, job: t`guard`, icon: "tb:shield-lock" },
  { id: "checks", name: t`Skills + gates`, job: t`check`, icon: "tb:checklist" },
];

type Scene = "brief" | "wiki" | "research" | "tools" | "build" | "checks" | "review";
interface Beat {
  scene: Scene;
  name: string;
  line: string;
  color: string;
  actors: Actor[];
  /** The real tools behind the beat: a mark where one exists, a plain chip where not. */
  marks: { label: string; icon?: IconName }[];
}
const BEATS: Beat[] = [
  {
    scene: "brief",
    name: t`Brief`,
    line: t`I brief the lead agent: the goal, the limits, what done looks like.`,
    color: "var(--yellow)",
    actors: ["me", "lead"],
    marks: [{ label: t`goal` }, { label: t`limits` }, { label: t`definition of done` }],
  },
  {
    scene: "wiki",
    name: t`Memory`,
    line: t`It reads the project wiki first, so no session starts from zero.`,
    color: "var(--lime)",
    actors: ["lead", "memory"],
    marks: [{ label: t`Karpathy-style LLM wiki`, icon: "si:markdown" }, { label: t`decisions` }, { label: t`lessons` }],
  },
  {
    scene: "research",
    name: t`Research`,
    line: t`Subagents research in parallel and bring back conclusions.`,
    color: "var(--pink)",
    actors: ["lead", "research"],
    marks: [{ label: t`subagents`, icon: "si:claude" }, { label: t`docs` }, { label: t`references` }, { label: t`audits` }],
  },
  {
    scene: "tools",
    name: t`Tools`,
    line: t`MCP servers bring real data: real app screens, components, a browser.`,
    color: "var(--orange)",
    actors: ["lead", "tools"],
    marks: [
      { label: "MCP", icon: "si:modelcontextprotocol" },
      { label: "Mobbin" },
      { label: t`shadcn registry`, icon: "si:shadcnui" },
      { label: "Playwright", icon: "mk:playwright" },
    ],
  },
  {
    scene: "build",
    name: t`Build`,
    line: t`It builds inside the rules. Hooks stop the risky moves.`,
    color: "var(--ice)",
    actors: ["lead", "rules"],
    marks: [
      { label: t`safety hooks`, icon: "tb:shield-lock" },
      { label: t`scripts`, icon: "tb:terminal-2" },
    ],
  },
  {
    scene: "checks",
    name: t`Check`,
    line: t`Skills and gates check every change: types, tests, accessibility, speed.`,
    color: "var(--yellow)",
    actors: ["checks"],
    marks: [
      { label: "TypeScript", icon: "si:typescript" },
      { label: "ESLint", icon: "si:eslint" },
      { label: "Vitest", icon: "si:vitest" },
      { label: "axe", icon: "tb:accessible" },
      { label: "Lighthouse", icon: "si:lighthouse" },
    ],
  },
  {
    scene: "review",
    name: t`Review`,
    line: t`I review and decide. What we learned goes back into the wiki.`,
    color: "var(--lime)",
    actors: ["me", "memory"],
    marks: [
      { label: t`code review`, icon: "tb:git-pull-request" },
      { label: t`lessons`, icon: "tb:bulb" },
    ],
  },
];
const SOURCES: IconName[] = ["tb:book-2", "tb:world", "tb:list-check"];
const TOOLS: IconName[] = ["tb:device-mobile", "si:shadcnui", "mk:playwright"];
const CHECKS: IconName[] = ["si:typescript", "si:eslint", "si:vitest", "mk:playwright", "tb:accessible", "si:lighthouse"];
const pad = (n: number) => String(n).padStart(2, "0");
const blocked = t`blocked`;
const approved = t`approved`;
---

<section class="sec field-deep ai" id="ai" aria-labelledby="t-ai">
  <div class="sbar draw">
    <p>{t`AI workflow`}</p>
    <p>{t`How I build with AI`}</p>
    <p>{t`The real setup behind this site`}</p>
  </div>
  <Fit as="h2" id="t-ai" lines={[t`I run AI like a team.`]} />
  <p class="lede rv">
    {typo(locale, t`I lead. Claude Code agents do the work, each with its own job, and nothing ships before I review it.`)}
  </p>

  <div class="story rv" data-story data-on={BEATS[0]!.actors.join(" ")}>
    <ul class="team" role="list" aria-label={t`The team`}>
      {TEAM.map((member) => (
        <li class={`tm tm-${member.id}`}>
          <span class:list={["av", { "av-me": member.id === "me" }]} aria-hidden="true">
            <Icon name={member.id === "me" ? "tb:user" : "si:claude"} />
            {member.id !== "me" && (
              <i>
                <Icon name={member.icon} />
              </i>
            )}
          </span>
          <b>{member.name}</b>
          <small>{member.job}</small>
        </li>
      ))}
    </ul>

    <ol class="beats" aria-label={t`One change, step by step`}>
      {BEATS.map((beat, i) => (
        <li>
          <button class="beat" type="button" aria-pressed={i === 0 ? "true" : "false"} aria-controls={`beat-${i}`} data-beat={i}>
            <span class="prog" aria-hidden="true">
              <i />
            </span>
            <span class="bn tabular">{pad(i + 1)}</span>
            <span class="bl">{beat.name}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="shows">
      <button class="ai-pp js-only" type="button" data-pp>
        <Icon name="tbf:player-pause" class="pp-pause" />
        <Icon name="tbf:player-play" class="pp-play" />
        <span class="pp-pause">{t`Pause`}</span>
        <span class="pp-play">{t`Play`}</span>
      </button>
      {BEATS.map((beat, i) => (
        <div class="bt" id={`beat-${i}`} data-bt={i} data-actors={beat.actors.join(" ")}>
          <div class={`sc sc-${beat.scene}`} style={`--c:${beat.color}`} aria-hidden="true">
            {beat.scene === "brief" && (
              <div class="row">
                <span class="av av-me">
                  <Icon name="tb:user" />
                </span>
                <span class="paper">
                  <Icon name="tb:target" />
                  <i style="--k:0" />
                  <i style="--k:1" />
                  <i style="--k:2" />
                </span>
                <span class="av nod">
                  <Icon name="si:claude" />
                </span>
              </div>
            )}
            {beat.scene === "wiki" && (
              <div class="row">
                <span class="av">
                  <Icon name="si:claude" />
                </span>
                <span class="beam" />
                <span class="pages">
                  <i style="--k:2" />
                  <i style="--k:1" />
                  <span class="page">
                    <Icon name="si:markdown" />
                    <i class="hl" />
                    <i class="ln2" />
                    <i class="add" />
                  </span>
                </span>
              </div>
            )}
            {beat.scene === "research" && (
              <div class="row">
                <span class="av">
                  <Icon name="si:claude" />
                </span>
                <span class="fan">
                  {SOURCES.map((icon, k) => (
                    <span class="lane" style={`--k:${k}`}>
                      <span class="av">
                        <Icon name="si:claude" />
                      </span>
                      <span class="src">
                        <Icon name={icon} />
                      </span>
                    </span>
                  ))}
                </span>
                <span class="sum">
                  {[0, 1, 2].map(() => (
                    <i>
                      <Icon name="tb:check" />
                    </i>
                  ))}
                </span>
              </div>
            )}
            {beat.scene === "tools" && (
              <div class="plug">
                <span class="tools">
                  {TOOLS.map((icon, k) => (
                    <span class="tool" style={`--k:${k}`}>
                      <Icon name={icon} />
                      <i class="cable">
                        <b />
                      </i>
                    </span>
                  ))}
                </span>
                <span class="hub">
                  <span class="av">
                    <Icon name="si:claude" />
                  </span>
                  <span class="mcp">
                    <Icon name="si:modelcontextprotocol" />
                  </span>
                </span>
              </div>
            )}
            {beat.scene === "build" && (
              <div class="row">
                <span class="av">
                  <Icon name="si:claude" />
                </span>
                <span class="term">
                  <span class="tl" style="--k:0">
                    write Hero.astro
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="tl" style="--k:1">
                    write hero.css
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="tl bad" style="--k:2">
                    $ git push --force
                  </span>
                  <span class="tl" style="--k:3">
                    format + lint
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="stamp no">
                    <Icon name="tb:shield-lock" />
                    {blocked}
                  </span>
                </span>
              </div>
            )}
            {beat.scene === "checks" && (
              <div class="row">
                <span class="cam">
                  <Icon name="tb:camera" />
                </span>
                <span class="gates">
                  {CHECKS.map((icon, k) => (
                    <span class="gate" style={`--k:${k}`}>
                      <Icon name={icon} />
                      <i>
                        <Icon name="tb:check" />
                      </i>
                    </span>
                  ))}
                  <span class="snap" />
                </span>
              </div>
            )}
            {beat.scene === "review" && (
              <div class="row">
                <span class="av av-me">
                  <Icon name="tb:user" />
                </span>
                <span class="pr">
                  <Icon name="tb:git-pull-request" />
                  <i class="add" />
                  <i class="add" />
                  <i class="del" />
                  <i class="add" />
                  <span class="stamp yes">{approved}</span>
                </span>
                <span class="wiki">
                  <Icon name="si:markdown" />
                  <span class="lesson">
                    <Icon name="tb:bulb" />
                  </span>
                </span>
              </div>
            )}
          </div>
          <p class="cap">
            <span class="cap-n tabular">{pad(i + 1)}</span>
            <span>{typo(locale, beat.line)}</span>
          </p>
          <ul class="marks" role="list">
            {beat.marks.map((mark) => (
              <li>
                {mark.icon && <Icon name={mark.icon} />}
                {mark.label}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="go">
    <a
      class="btn btn-inv"
      href={thisSitePath(locale)}
      data-umami-event="cta"
      data-umami-event-id="this-site"
      data-umami-event-source="ai"
    >
      {t`How this site was built`}
      <Icon name="tb:arrow-right" class="nudge" />
    </a>
  </div>
</section>

<style>
  .ai {
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }
  .lede {
    max-width: 52ch;
    margin: clamp(1rem, 2vw, 1.75rem) auto 0;
    text-align: center;
    font-size: clamp(1.1875rem, 1.5vw, 1.4375rem);
    line-height: 1.4;
  }

  /* The story: the team on top, the beats as story bars, one scene at a time. */
  .story {
    --beat: 4.6s;
    display: grid;
    gap: 1.75rem;
    max-width: 68rem;
    margin: clamp(1.75rem, 3.4vw, 3rem) auto 0;
  }

  /* The team: me and the agents. Who works in the current beat steps forward; the others wait, a little faded. */
  .team {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tm {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.375rem;
    text-align: center;
    transition: transform 0.45s var(--ease-pop);
  }
  .tm .av {
    --av: 3.5rem;
    margin-bottom: 0.25rem;
    transition:
      opacity var(--dur-base),
      box-shadow var(--dur-base);
  }
  .tm b {
    font-weight: 900;
    font-size: 0.9375rem;
    line-height: 1.05;
    font-stretch: 75%;
    text-transform: uppercase;
  }
  .tm small {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }
  :global(.js) .tm .av {
    opacity: 0.5;
  }
  .story[data-on~="me"] .tm-me,
  .story[data-on~="lead"] .tm-lead,
  .story[data-on~="memory"] .tm-memory,
  .story[data-on~="research"] .tm-research,
  .story[data-on~="tools"] .tm-tools,
  .story[data-on~="rules"] .tm-rules,
  .story[data-on~="checks"] .tm-checks {
    transform: translateY(-0.375rem);
  }
  .story[data-on~="me"] .tm-me .av,
  .story[data-on~="lead"] .tm-lead .av,
  .story[data-on~="memory"] .tm-memory .av,
  .story[data-on~="research"] .tm-research .av,
  .story[data-on~="tools"] .tm-tools .av,
  .story[data-on~="rules"] .tm-rules .av,
  .story[data-on~="checks"] .tm-checks .av {
    opacity: 1;
    box-shadow:
      0 0 0 3px var(--navy),
      0 0 0 6px var(--yellow),
      5px 5px 0 6px var(--navy);
  }

  /* An avatar: an agent is a tile with the Claude mark and its job's badge; I am the pink circle. */
  /* Sized by --av: a percentage padding would resolve against the parent's width. */
  .av {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--av, 3rem);
    aspect-ratio: 1;
    padding: calc(var(--av, 3rem) * 0.2);
    border-radius: 22%;
    background: var(--ice);
    color: #d97757;
    box-shadow:
      0 0 0 3px var(--navy),
      4px 4px 0 3px var(--navy);
  }
  .av > :global(.ico) {
    width: 100%;
    height: 100%;
  }
  .av-me {
    border-radius: 50%;
    background: var(--pink);
    color: var(--navy);
  }
  .av i {
    position: absolute;
    right: -18%;
    bottom: -18%;
    display: grid;
    place-items: center;
    width: 48%;
    aspect-ratio: 1;
    padding: calc(var(--av, 3rem) * 0.08);
    border-radius: 50%;
    background: var(--navy);
    color: var(--ice);
  }
  .av i :global(.ico) {
    width: 100%;
    height: 100%;
  }

  /* Story bars: one per beat; the current one fills while it plays. */
  .beats {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .beat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.375rem 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0 0 0.25rem;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .prog {
    grid-column: 1 / -1;
    height: 0.375rem;
    background: color-mix(in srgb, currentColor 28%, transparent);
    overflow: hidden;
  }
  .prog i {
    display: block;
    height: 100%;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .beat.done .prog i,
  :global(.still) .beat[aria-pressed="true"] .prog i {
    transform: none;
  }
  .beat[aria-pressed="true"] .prog i {
    animation: ai-fill var(--beat) linear both;
  }
  :global(.still) .beat .prog i {
    animation: none;
  }
  .story.paused .beat[aria-pressed="true"] .prog i {
    animation-play-state: paused;
  }
  @media (hover: hover) and (pointer: fine) {
    .beat:hover :is(.bn, .bl) {
      color: var(--yellow);
    }
    .beat:hover .prog {
      background: color-mix(in srgb, currentColor 50%, transparent);
    }
  }
  @keyframes ai-fill {
    to {
      transform: none;
    }
  }
  .bn {
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .bl {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 900;
    font-size: 0.9375rem;
    font-stretch: 78%;
    text-transform: uppercase;
  }
  .beat[aria-pressed="true"] :is(.bn, .bl) {
    color: var(--yellow);
  }
  .beat:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  /* With the script, one beat at a time; without it, all seven read as a list. */
  .shows {
    display: grid;
    gap: 2.5rem;
  }
  :global(.js) .bt:not(.on) {
    display: none;
  }
  :global(.js) .bt.on {
    animation: ai-swap 0.45s var(--ease-out);
  }
  @keyframes ai-swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .bt {
    display: grid;
    gap: 1.125rem;
  }
  .cap {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.12;
    font-stretch: 85%;
    text-wrap: balance;
  }
  .cap-n {
    flex: none;
    padding: 0.125rem 0.4375rem;
    background: var(--yellow);
    color: var(--navy);
    font-size: 0.875rem;
    font-stretch: 100%;
  }
  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marks li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.375rem 0.625rem;
    background: var(--ice);
    color: var(--navy);
    font-weight: 800;
    font-size: 0.8125rem;
    line-height: 1.2;
  }
  .marks :global(.ico) {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  /* ---- The scenes: drawn in container units so each scales as one picture. Paused or reduced motion shows the
     finished picture at once. Keyframes carry the ai- prefix (Astro does not scope them). */
  .sc {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    container-type: inline-size;
    background: var(--c);
    color: var(--navy);
    box-shadow:
      0 0 0 3px var(--navy),
      12px 12px 0 3px var(--navy);
  }
  .sc::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(10 13 51 / 0.16) 1.2px, transparent 1.7px) 0 0 / 2.8cqw 2.8cqw;
  }
  :global(.still) .sc *,
  :global(.still) .sc *::before,
  :global(.still) .sc *::after {
    animation: none !important;
  }
  /* Pause / play the story: the chip in the stage's corner, or a click on the drawing itself. Paused, the scene
     freezes where it is and the bar stops filling; a click on a step always plays from that step. */
  .shows {
    position: relative;
  }
  :global(.js) .sc {
    cursor: pointer;
  }
  .ai-pp {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.875rem 0.25rem 0.625rem;
    border: 0;
    border-radius: 999px;
    background: var(--navy);
    color: var(--ice);
    font-weight: 900;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      scale 0.3s var(--ease-pop),
      background-color 0.2s var(--ease-out);
  }
  .ai-pp :global(.ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .ai-pp:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }
  .ai-pp :global(.pp-play),
  .story.paused .ai-pp :global(.pp-pause) {
    display: none;
  }
  .story.paused .ai-pp :global(.pp-play) {
    display: block;
  }
  .story.paused .ai-pp {
    background: var(--yellow);
    color: var(--navy);
    scale: 1.08;
  }
  @media (hover: hover) and (pointer: fine) {
    .ai-pp:hover {
      scale: 1.06;
    }
  }
  .story.paused .sc *,
  .story.paused .sc *::before,
  .story.paused .sc *::after {
    animation-play-state: paused !important;
  }
  /* Nothing to pause when motion is already still. */
  :global(.still) .ai-pp {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-pp {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc *,
