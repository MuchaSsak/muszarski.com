</style>

<script>
  import { motionStill } from "~/scripts/motion";

  for (const story of document.querySelectorAll<HTMLElement>("[data-story]")) {
    const buttons = [...story.querySelectorAll<HTMLButtonElement>("[data-beat]")];
    const beats = [...story.querySelectorAll<HTMLElement>("[data-bt]")];
    const pp = story.querySelector<HTMLButtonElement>("[data-pp]");
    const step = parseFloat(getComputedStyle(story).getPropertyValue("--beat")) * 1000 || 4600;
    let current = 0;
    let visible = false;
    let paused = false;
    let pausedAt = 0;
    let shownAt = performance.now();

    // Paused: the scene freezes and the bar stops; playing again carries on from the same moment.
    const setPaused = (on: boolean) => {
      if (on === paused) return;
      paused = on;
      const now = performance.now();
      if (on) pausedAt = now;
      else shownAt += now - pausedAt;
      story.classList.toggle("paused", on);
    };
    const show = (i: number) => {
      current = i;
      // Re-showing the same beat restarts its scene and its bar.
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      beats.forEach((d) => d.classList.remove("on"));
      void story.offsetWidth;
      buttons.forEach((b, j) => {
        b.setAttribute("aria-pressed", String(j === i));
        b.classList.toggle("done", j < i);
      });
      beats[i]!.classList.add("on");
      story.dataset.on = beats[i]!.dataset.actors;
      shownAt = performance.now();
    };
    // A step: go there and play it from the start.
    buttons.forEach((b, i) =>
      b.addEventListener("click", () => {
        setPaused(false);
        show(i);
      }),
    );
    // The chip, or a click anywhere on the drawing, pauses and plays.
    pp?.addEventListener("click", () => setPaused(!paused));
    for (const scene of story.querySelectorAll<HTMLElement>(".sc")) {
      scene.addEventListener("click", () => {
        if (!motionStill()) setPaused(!paused);
      });
    }
    show(0);

    new IntersectionObserver(
      ([entry]) => {
        const was = visible;
        visible = !!entry?.isIntersecting;
        // Coming into view restarts the current beat, so its scene plays where it can be seen.
        if (visible && !was && !paused) show(current);
      },
      { threshold: 0.35 },
    ).observe(story);
    setInterval(() => {
      const now = performance.now();
      if (!visible || paused || motionStill() || document.hidden || now - shownAt < step) return;
      show((current + 1) % buttons.length);
    }, 250);
  }
</script>
