---
/**
 * The tool band under the hero (design.md § Tool marks): the tools he ships with as one-colour marks WITH their
 * names, running as a slow marquee on the bar field. The list is real HTML (crawlable, readable); with JS a hidden
 * copy is appended for a seamless loop. The row is one line from the first paint (the head script sets `.js`), so
 * starting the loop shifts nothing; without JS or under reduced motion it wraps into rows.
 * It never stops on hover [user 2026-10-05]; the site-wide Pause motion control (menu, footer) stops it (WCAG 2.2.2).
 */
import { t } from "lingui-for-astro/macro";

import Icon from "~/components/ui/Icon.astro";
import { type IconName } from "~/lib/icons.gen";

const TOOLS: { icon: IconName; name: string }[] = [
  { icon: "si:typescript", name: "TypeScript" },
  { icon: "si:react", name: "React" },
  { icon: "si:nextdotjs", name: "Next.js" },
  { icon: "si:astro", name: "Astro" },
  { icon: "si:expo", name: "Expo" },
  { icon: "si:supabase", name: "Supabase" },
  { icon: "si:postgresql", name: "PostgreSQL" },
  { icon: "si:tailwindcss", name: "Tailwind" },
  { icon: "si:threedotjs", name: "three.js" },
  { icon: "si:gsap", name: "GSAP" },
  { icon: "si:vercel", name: "Vercel" },
  { icon: "si:claude", name: "Claude Code" },
  { icon: "si:modelcontextprotocol", name: "MCP" },
];
---

<section class="sec field-bar band" aria-label={t`Tools I ship with`}>
  <div class="view" data-band>
    <div class="track">
      <ul class="tools" role="list">
        {TOOLS.map((tool) => (
          <li>
            <Icon name={tool.icon} />
            {tool.name}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .band {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    /* the marquee runs edge to edge, or to the 1920 cap on ultrawide screens */
    padding-block: 0;
    padding-inline: max(0px, (100% - 120rem) / 2);
    overflow: hidden;
  }
  /* Ink paints the hero and the bar the same near-black: a rule keeps the two fields apart. */
  :global(:root[data-theme="ink"]) .band {
    box-shadow:
      inset 0 2px 0 color-mix(in srgb, var(--sfg) 22%, transparent),
      inset 0 -2px 0 color-mix(in srgb, var(--sfg) 22%, transparent);
  }
  .view {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
  }
  .tools {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.75rem clamp(1.875rem, 3.4vw, 3.25rem);
    margin: 0;
    padding: 1.25rem clamp(1.875rem, 3.4vw, 3.25rem);
    list-style: none;
  }
  .tools li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
    font-weight: 800;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color var(--dur-base);
  }
  .tools :global(.ico) {
    width: clamp(1.75rem, 2.5vw, 2.375rem);
    height: clamp(1.75rem, 2.5vw, 2.375rem);
    transition: transform 0.45s var(--ease-pop);
  }

  /* No JS or reduced motion: every tool visible, wrapped into rows (no hidden overflow, no scroll region). */
  :global(html:not(.js)) .track {
    width: auto;
  }
  :global(html:not(.js)) .tools {
    flex-wrap: wrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .view {
      mask: none;
    }
    .track {
      width: auto;
    }
    .tools {
      flex-wrap: wrap;
    }
  }

  /* Running: a seamless loop of the list and its copy. */
  .view.running .track {
    animation: marquee 50s linear infinite;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .tools li:hover {
      color: var(--accent);
    }
    .tools li:hover :global(.ico) {
      transform: rotate(-8deg) scale(1.18);
    }
  }
</style>

<script>
  import { prefersReducedMotion } from "~/scripts/motion";

  for (const view of document.querySelectorAll<HTMLElement>("[data-band]")) {
    if (prefersReducedMotion()) continue;
    const list = view.querySelector("ul")!;
    const copy = list.cloneNode(true) as HTMLElement;
    copy.setAttribute("aria-hidden", "true");
    list.after(copy);
    view.classList.add("running");
  }
</script>
