---
/**
 * Latest writing (structure.md § Home 6): the three newest posts as a compact teaser [user 2026-10-06: smaller, like
 * the pstryk landing], a plain heading with "All posts" beside it and small cards (cover thumbnail, date, title), in the
 * page's blog locale (Spanish pages show the English posts, marked as English). Hidden when there are no posts.
 * The field carries a faint dot grid (notebook paper), the title a drawn underline, and the cards are taped notes
 * [user 2026-10-06: too flat].
 */
import { t } from "lingui-for-astro/macro";

import PostCard from "~/components/blog/PostCard.astro";
import Icon from "~/components/ui/Icon.astro";
import { chromeLinks } from "~/lib/nav";
import { postsIn } from "~/lib/posts";

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const posts = (await postsIn(links.blogLocale === "pl" ? "pl" : "en")).slice(0, 3);
const english = links.blogLocale !== locale;
---

{
  posts.length > 0 && (
    <section class="sec field-hero writing" id="writing" aria-labelledby="t-wr">
      <div class="w-head">
        <div>
          <p class="kick">
            {t`Writing`}
            {english && ` · ${t`In English`}`}
          </p>
          <h2 id="t-wr" class="w-title">
            {t`Notes from the work`}
          </h2>
          <svg class="w-line" viewBox="0 0 320 16" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 11 C 50 3, 90 15, 140 8 S 230 2, 317 9" />
          </svg>
        </div>
        <a class="btn btn-line" href={links.blog} data-umami-event="cta" data-umami-event-id="blog" data-umami-event-source="home">
          {t`All posts`}
          {english && " (EN)"}
          <Icon name="tb:arrow-right" class="nudge" />
        </a>
      </div>
      <div class="grid">
        {posts.map((post, i) => (
          <PostCard post={post} tone={i * 2} compact />
        ))}
      </div>
    </section>
  )
}

<style>
  .writing {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5.5rem);
    background-image: radial-gradient(color-mix(in srgb, var(--sfg) 13%, transparent) 1.2px, transparent 1.7px);
    background-size: 1.5rem 1.5rem;
  }
  .w-line {
    display: block;
    width: min(100%, 16rem);
    height: 0.875rem;
    margin-top: 0.5rem;
    overflow: visible;
  }
  .w-line path {
    fill: none;
    stroke: var(--pink);
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .w-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .kick {
    margin: 0 0 0.5rem;
  }
  /* "Todos los artículos (EN)" is wider than a 320 px column: let it wrap there instead of overflowing. */
  .w-head .btn {
    max-width: 100%;
    white-space: normal;
  }
  .w-title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 0.92;
    text-transform: uppercase;
    font-stretch: 70%;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.4vw, 2.25rem);
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
  }
  /* Each note its own tape colour and tilt. */
  .grid > :global(.card:nth-child(2)) {
    --tape: var(--lime);
    --tilt: 1deg;
  }
  .grid > :global(.card:nth-child(3)) {
    --tape: var(--pink);
    --tilt: -0.75deg;
  }
  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
