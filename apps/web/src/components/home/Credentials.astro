---
/**
 * Credentials (structure.md § Home 5, requirements.md F08): qualifications, courses and teamwork from the CV data
 * (`~/data/cv`, the same source as /cv/ and the PDF). Cards open on tap, focus or hover (fine pointers) and only then
 * load their media. Instructors appear as text credits, never photos (compliance-and-data.md). Placeholder media and
 * dates are logged (placeholders.md P11, P18).
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { CV } from "~/data/cv";
import { chromeLinks } from "~/lib/nav";

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const KIND = {
  qualification: t`Qualification`,
  course: t`Course`,
  volunteering: t`International`,
  hackathon: t`Teamwork`,
} as const;
const TONE: Record<string, string> = { inf: "k-fg", "threejs-journey": "k-acc", jonas: "k-fg", erasmus: "k-line", hackathons: "k-line", "short-courses": "k-acc" };
const MEDIA_SOON: Record<string, string> = {
  jonas: t`Certificate image soon`,
  erasmus: t`Photo from an exchange soon`,
  hackathons: t`Photo from a hackathon soon`,
  "short-courses": t`Certificate images soon`,
};
---

<section class="sec field-alt creds" id="credentials" aria-labelledby="t-cr">
  <div class="sbar draw">
    <p>{t`Credentials`}</p>
    <p>{t`Qualifications · training · teams`}</p>
    <p>{t`Open a card`}</p>
  </div>
  <Fit as="h2" id="t-cr" lines={[t`Credentials`]} motion="calm" base={[100, 140]} />
  <ul class="xcards" data-xcards>
    {
      CV.credentials.map((credential, i) => (
        <li class:list={["xc", TONE[credential.id], { open: i === 0 }]}>
          <h3 class="xc-h">
            <button class="xc-btn" type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`xc-${credential.id}`}>
              <Icon name={credential.icon} class="xc-i" />
              <span class="xc-k">{KIND[credential.kind]}</span>
              <span class="xc-t">{credential.title[locale]}</span>
              <Icon name="tb:chevron-down" class="chev" />
            </button>
          </h3>
          <div class="xc-body enter" id={`xc-${credential.id}`}>
            {credential.id === "inf" ? (
              <div class="xc-media stamps" aria-hidden="true">
                <span class="stamp enter" style="--r:-8deg;--i:0">
                  INF<b>.02</b>
                  <small>CKE</small>
                </span>
                <span class="stamp enter" style="--r:5deg;--i:1">
                  INF<b>.03</b>
                  <small>CKE</small>
                </span>
                <span class="stamp enter" style="--r:-3deg;--i:2">
                  INF<b>.04</b>
                  <small>CKE</small>
                </span>
              </div>
            ) : credential.id === "threejs-journey" ? (
              <figure class="xc-media">
                <video muted loop playsinline preload="none" poster="/media/space/flight-poster.webp" width="960" height="540" aria-label={t`My space portfolio, built with what the course taught`}>
                  <source data-src="/media/space/flight.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
                  <source data-src="/media/space/flight.mp4" type="video/mp4" />
                </video>
                <figcaption>{t`Built with it: my space portfolio`}</figcaption>
              </figure>
            ) : (
              <div class="xc-media ph" aria-hidden="true">
                <Icon name="tb:camera" />
                {MEDIA_SOON[credential.id]}
              </div>
            )}
            <div class="xc-foot">
              <p>
                <b>{credential.issuer[locale]}</b>
                <span class="when">{credential.when[locale]}</span>
                {credential.summary[locale]}
              </p>
              {credential.verifyUrl ? (
                <a class="xc-link" href={credential.verifyUrl} rel="noopener" data-umami-event="outbound" data-umami-event-target={`verify-${credential.id}`}>
                  {t`Certificate`}
                  <Icon name="tb:arrow-up-right" />
                </a>
              ) : (
                <a class="xc-link" href={`${links.cv}#credentials`}>
                  {t`Details on the CV`}
                  <Icon name="tb:arrow-right" />
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .xcards {
    display: flex;
    gap: 0.625rem;
    height: clamp(28rem, 37vw, 34rem);
    margin: clamp(1.5rem, 3vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .xc {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: flex-grow 0.6s var(--ease-out);
  }
  .k-fg {
    background: var(--sfg);
    color: var(--sbg);
  }
  .k-acc {
    background: var(--accent);
    color: var(--on-accent);
  }
  .k-line {
    box-shadow: inset 0 0 0 3px currentColor;
  }
  .xc.open {
    flex-grow: 4.4;
  }
  .xc-h {
    display: flex;
    flex: 1;
    margin: 0;
    font: inherit;
  }
  .xc.open .xc-h {
    flex: none;
  }
  .xc-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    min-height: 0;
    overflow: hidden;
    padding: 1.125rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .xc-btn :global(.xc-i) {
    width: 2.125rem;
    height: 2.125rem;
  }
  .xc-k {
    display: none;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-stretch: 125%;
  }
  .xc-t {
    max-height: 100%;
    margin-top: auto;
    font-weight: 900;
    font-size: clamp(1.375rem, 1.9vw, 2.125rem);
    line-height: 0.92;
    text-transform: uppercase;
    white-space: normal;
    font-stretch: 80%;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .xc-btn :global(.chev) {
    display: none;
  }
  .xc.open .xc-btn {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem 0.875rem;
  }
  .xc.open .xc-btn :global(.xc-i) {
    grid-row: span 2;
  }
  .xc.open .xc-k {
    display: block;
  }
  .xc.open .xc-t {
    margin: 0;
    white-space: normal;
    writing-mode: horizontal-tb;
    transform: none;
  }
  .xc-body {
    display: none;
  }
  .xc.open .xc-body {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.875rem;
    flex: 1;
    min-height: 0;
    padding: 0 1.125rem 1.125rem;
    animation: swap 0.55s var(--ease-out) 0.1s both;
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .xc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.625rem 1rem;
  }
  .xc-foot p {
    max-width: 46ch;
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  .xc-foot b,
  .when {
    display: block;
  }
  .when {
    margin-bottom: 0.25rem;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .xc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .xc-link :global(.ico) {
    width: 1rem;
    height: 1rem;
  }
  .xc-media {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: rgb(0 0 0 / 0.18);
  }
  .xc-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .xc-media figcaption {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    padding: 0.3125rem 0.5625rem;
    background: var(--navy);
    color: var(--ice);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    background: repeating-linear-gradient(-45deg, rgb(0 0 0 / 0.1) 0 14px, transparent 14px 28px) 0 0 / 40px 40px;
    animation: stripes 2.4s linear infinite;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @keyframes stripes {
    to {
      background-position: 40px 0;
    }
  }
  .ph :global(.ico) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .stamps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4%;
    background: transparent;
  }
  .stamp {
    display: grid;
    place-content: center;
    width: 30%;
    max-width: 10rem;
    aspect-ratio: 1;
    border-radius: 50%;
    text-align: center;
    box-shadow:
      inset 0 0 0 3px currentColor,
      inset 0 0 0 7px transparent,
      inset 0 0 0 9px currentColor;
    font-weight: 900;
    font-size: clamp(0.875rem, 1.3vw, 1.25rem);
    line-height: 1;
    font-stretch: 110%;
    transform: rotate(var(--r));
  }
  .stamp b {
    display: block;
    font-size: 1.9em;
    font-stretch: 62%;
  }
  .stamp small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.5em;
    letter-spacing: 0.08em;
  }
  .xc.open .stamp {
    animation: stamp-in 0.5s var(--ease-pop) both;
    animation-delay: calc(var(--i) * 0.14s + 0.2s);
  }
  @keyframes stamp-in {
    from {
      transform: rotate(var(--r)) scale(2.2);
      opacity: 0;
    }
  }

  /* Without the script every card is open, stacked. */
  :global(html:not(.js)) .xcards {
    flex-direction: column;
    height: auto;
  }
  :global(html:not(.js)) .xc-body {
    display: grid;
    gap: 0.875rem;
    padding: 0 1.125rem 1.125rem;
  }
  :global(html:not(.js)) .xc-media {
    aspect-ratio: 16 / 10;
  }

  /* Phones and tablets: a vertical accordion. */
  @media (max-width: 56.25rem) {
    .xcards {
      flex-direction: column;
      height: auto;
    }
    .xc {
      flex: none;
    }
    .xc-btn,
    .xc.open .xc-btn {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.125rem 0.875rem;
      padding: 1rem;
    }
    .xc-btn :global(.xc-i) {
      grid-row: span 2;
    }
    .xc-k {
      display: block;
    }
    .xc-t {
      margin: 0;
      font-size: 1.75rem;
      white-space: normal;
      writing-mode: horizontal-tb;
      transform: none;
    }
    .xc-btn :global(.chev) {
      display: block;
      grid-row: 1 / span 2;
      grid-column: 3;
      width: 1.625rem;
      height: 1.625rem;
      transition: transform var(--dur-base) var(--ease-out);
    }
    .xc.open .xc-btn :global(.chev) {
      transform: rotate(180deg);
    }
    .xc.open .xc-body {
      grid-template-rows: auto auto;
      padding: 0 1rem 1rem;
    }
    .xc-media {
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script>
  import { motionStill } from "~/scripts/motion";

  for (const list of document.querySelectorAll<HTMLElement>("[data-xcards]")) {
    const cards = [...list.querySelectorAll<HTMLElement>(".xc")];
    const wide = matchMedia("(min-width: 56.3125rem)");
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");

    const loadMedia = (card: HTMLElement) => {
      const video = card.querySelector("video");
      if (!video) return;
      if (!video.dataset.loaded) {
        video.dataset.loaded = "1";
        for (const source of video.querySelectorAll<HTMLSourceElement>("source[data-src]")) source.src = source.dataset.src!;
        video.load();
      }
      if (!motionStill()) video.play().catch(() => {});
    };
    const open = (card: HTMLElement, toggle = false) => {
      const isOpen = card.classList.contains("open");
      // On wide screens one card is always open; on phones a tap toggles.
      if (isOpen && !(toggle && !wide.matches)) return;
      for (const other of cards) {
        const on = other === card && !isOpen;
        other.classList.toggle("open", on);
        other.querySelector(".xc-btn")!.setAttribute("aria-expanded", String(on));
        if (!on) other.querySelector("video")?.pause();
      }
      if (!isOpen) loadMedia(card);
    };
    for (const card of cards) {
      const button = card.querySelector<HTMLButtonElement>(".xc-btn")!;
      button.addEventListener("click", () => open(card, true));
      button.addEventListener("focus", () => wide.matches && open(card));
      card.addEventListener("pointerenter", () => wide.matches && finePointer.matches && open(card));
    }
  }
</script>
