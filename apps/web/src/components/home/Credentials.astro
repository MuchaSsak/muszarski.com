---
/**
 * Competences (structure.md § Home 5, requirements.md F08) [user 2026-10-06: "why call section Credentials and not
 * something like Competences"]: experience first, then qualifications, courses and teamwork, all from the CV data
 * (`~/data/cv`, the same source as /cv/ and the PDF). The Experience card [user 2026-10-06: "at the top so most
 * important"] lists school and internships from the CV's education and experience entries (their `short` lines). Wide screens: a readable list on the left and the open card's
 * media and details on the right [user 2026-10-06: collapsed cards with vertical titles were unreadable]; a row opens on
 * tap, focus or hover (fine pointers). Phones: an accordion. Each credential has its own poster colour: its icon tile in
 * the list, the open row and the detail panel [user 2026-10-06: the coloured cards were nicer, the plain list too
 * flat]. Wide screens also run a quiet tour: after a few idle seconds (no hover, focus or click in the list or panel,
 * section in view, motion not paused) a drawn cursor flies in, clicks the next row and leaves [user 2026-10-06].
 * Media loads only when its card opens. Cards with certificates show them as tickets with a check link or code
 * [owner's certificates 2026-10-06]. Instructors appear as text credits, never photos (compliance-and-data.md).
 * Placeholders left are logged (placeholders.md P11).
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { type CertItem, CV } from "~/data/cv";
import { uxPsychologyPath } from "~/lib/blog-paths";
import { chromeLinks } from "~/lib/nav";
import { type IconName } from "~/lib/icons.gen";

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const KIND = {
  experience: t`Start here`,
  qualification: t`Qualification`,
  course: t`Course`,
  volunteering: t`International`,
  hackathon: t`Teamwork`,
  knowledge: t`Knowledge`,
} as const;
// Colour pairs from the palette (design.md § Colour); every pair passes AA for its text.
const TONE: Record<string, [bg: string, fg: string]> = {
  experience: ["pink", "navy"],
  inf: ["cobalt", "ice"],
  "threejs-journey": ["navy", "ice"],
  jonas: ["yellow", "navy"],
  erasmus: ["lime", "navy"],
  hackathons: ["orange", "navy"],
  "short-courses": ["space", "ice"],
};
/** The state exams as three marked papers, each with a picture of its subject [user 2026-10-07: show what they are
 * about and that he passed them]. */
const EXAMS: { code: string; topic: string; icons: IconName[] }[] = [
  { code: "INF.02", topic: t`Systems and networks`, icons: ["tb:server", "tb:network"] },
  { code: "INF.03", topic: t`Websites and databases`, icons: ["tb:browser", "tb:database"] },
  { code: "INF.04", topic: t`Apps and testing`, icons: ["tb:code", "tb:test-pipe"] },
];
const passed = t`Passed`;
/** Marketing, psychology and UX as the path a visitor takes to a conversion [user 2026-10-07: an illustration that
 * explains what it is about]. */
const FUNNEL: { label: string; icon: IconName }[] = [
  { label: t`Notice`, icon: "tb:eye" },
  { label: t`Trust`, icon: "tb:heart" },
  { label: t`Act`, icon: "tb:hand-click" },
];
const converts = t`Converts`;
/** The Experience card's timeline: school and internships, from the CV entries that carry a `short` line. */
const steps = [...CV.education, ...CV.experience].flatMap((entry) => (entry.short ? [{ ...entry.short, when: entry.when }] : []));
const tone = (id: string) => {
  const [bg, fg] = TONE[id] ?? ["navy", "ice"];
  return `--tbg:var(--${bg});--tfg:var(--${fg});--tsh:var(--${bg === "navy" ? "cobalt" : "navy"})`;
};
---

<section class="sec field-alt creds" id="credentials" aria-labelledby="t-cr">
  <div class="sbar draw">
    <p>{t`Competences`}</p>
    <p>{t`Experience · qualifications · training · teams`}</p>
    <p>{t`Pick one`}</p>
  </div>
  <Fit as="h2" id="t-cr" lines={[t`Competences`]} motion="calm" base={[100, 140]} />
  <ul class="xcards" data-xcards>
    {CV.credentials.map((credential, i) => (
      <li class:list={["xc", { open: i === 0 }]} style={tone(credential.id)}>
        <h3 class="xc-h">
          <button class="xc-btn" type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`xc-${credential.id}`}>
            <span class="xc-i">
              <Icon name={credential.icon} />
            </span>
            <span class="xc-k">{KIND[credential.kind]}</span>
            <span class="xc-t">{credential.title[locale]}</span>
            <Icon name="tb:arrow-right" class="arr" />
            <Icon name="tb:chevron-down" class="chev" />
          </button>
        </h3>
        <div class="xc-body enter" id={`xc-${credential.id}`}>
          {credential.kind === "experience" ? (
            <ol class="xc-media steps" role="list">
              {steps.map((step, k) => (
                <li class="step enter" style={`--i:${k}`}>
                  <span class="st-txt">
                    <b>{step.name}</b>
                    <span>{step.note[locale]}</span>
                  </span>
                  <small>{step.when[locale]}</small>
                </li>
              ))}
            </ol>
          ) : credential.id === "inf" ? (
            <div class="xc-media exams" aria-hidden="true">
              {EXAMS.map((exam, k) => (
                <span class="sheet" style={`--i:${k};--r:${[-5, 2, 6][k]}deg`}>
                  <span class="sh-top">
                    <b>{exam.code}</b>
                    <small>CKE</small>
                  </span>
                  <span class="sh-pic">
                    {exam.icons.map((icon) => (
                      <Icon name={icon} />
                    ))}
                  </span>
                  <span class="sh-topic">{exam.topic}</span>
                  <i />
                  <i />
                  <span class="sh-stamp">
                    <Icon name="tb:check" />
                    {passed}
                  </span>
                </span>
              ))}
            </div>
          ) : credential.id === "threejs-journey" ? (
            <figure class="xc-media">
              <video
                tabindex="-1"
                muted
                loop
                playsinline
                preload="none"
                poster="/media/space/flight-poster.webp"
                width="960"
                height="540"
                aria-label={t`My space portfolio, built with what the course taught`}
              >
                <source data-src="/media/space/flight.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
                <source data-src="/media/space/flight.mp4" type="video/mp4" />
              </video>
            </figure>
          ) : (
            <div class="xc-media art">
              {credential.id === "short-courses" && (
                <div class="scene mind" aria-hidden="true">
                  <span class="mind-user">
                    <Icon name="tb:user" />
                  </span>
                  <ol class="funnel">
                    {FUNNEL.map((stage, k) => (
                      <li style={`--i:${k}`}>
                        <Icon name={stage.icon} />
                        {stage.label}
                      </li>
                    ))}
                  </ol>
                  <span class="mind-goal">
                    <Icon name="tb:trending-up" />
                    {converts}
                  </span>
                </div>
              )}
              {credential.id === "jonas" && (
                <div class="scene course" aria-hidden="true">
                  <span class="player">
                    <span class="pl-play">
                      <Icon name="tbf:player-play" />
                    </span>
                    <b>135 h</b>
                    <i class="pl-bar">
                      <i />
                    </i>
                  </span>
                  <span class="editor">
                    <span class="ed-top">
                      <Icon name="si:javascript" />
                      <Icon name="si:react" />
                    </span>
                    <i style="--w:72%" />
                    <i style="--w:48%;--x:1" />
                    <i style="--w:60%;--x:1" />
                    <i style="--w:36%" />
                  </span>
                  <span class="tasks">
                    {[0, 1, 2].map((k) => (
                      <span style={`--i:${k}`}>
                        <Icon name="tb:check" />
                      </span>
                    ))}
                  </span>
                </div>
              )}
              {credential.id === "erasmus" && (
                <div class="scene trip" aria-hidden="true">
                  <span class="hellos">
                    {["Sveiki!", "Labas!", "Gamarjoba!", "Merhaba!"].map((word, k) => (
                      <span style={`--i:${k}`}>{word}</span>
                    ))}
                  </span>
                  <span class="route">
                    <span class="plane">
                      <Icon name="tb:plane" />
                    </span>
                    {(credential.places ?? []).map((place, k: number) => (
                      <span class:list={["pin", { low: k % 2 === 1 }]} style={`--i:${k}`}>
                        <Icon name="tb:map-pin" />
                        <small>{place[locale]}</small>
                      </span>
                    ))}
                  </span>
                </div>
              )}
              {credential.id === "hackathons" && (
                <div class="scene hack" aria-hidden="true">
                  <span class="timer">
                    <Icon name="tb:clock-hour-4" />
                  </span>
                  <span class="desk">
                    <span class="mates">
                      {[0, 1, 2].map((k) => (
                        <span style={`--i:${k}`}>
                          <Icon name="tb:user" />
                        </span>
                      ))}
                    </span>
                    <span class="laptop">
                      <Icon name="tb:device-laptop" />
                    </span>
                  </span>
                  <span class="cities">
                    {["Kraków", "Gdańsk", "Rzeszów"].map((city, k) => (
                      <span style={`--i:${k}`}>{city}</span>
                    ))}
                  </span>
                </div>
              )}
              {credential.id !== "erasmus" && (
                <ul class="proofs" role="list">
                  {(credential.items ?? []).map((item: CertItem, k: number) => {
                    const href = item.href ?? item.site;
                    const label = item.label?.[locale] ?? item.title;
                    return (
                      <li>
                        <a
                          class="proof"
                          href={href}
                          rel="noopener"
                          target="_blank"
                          data-umami-event="outbound"
                          data-umami-event-target={`${item.site ? "event" : "verify"}-${credential.id}-${k + 1}`}
                        >
                          <Icon name={item.site ? "tb:world" : "tb:certificate"} />
                          {label}
                          <Icon name="tb:arrow-up-right" />
                          <span class="sr-only">
                            : {item.title}
                            {item.code && `, ${item.code}`} {t`(opens in a new tab)`}
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          )}
          <div class="xc-foot">
            <p>
              <b>{credential.issuer[locale]}</b>
              <span class="when">{credential.when[locale]}</span>
              {credential.summary[locale]}
            </p>
            {credential.verifyUrl ? (
              <span class="xc-links">
                {credential.courseUrl && (
                  <a
                    class="xc-link"
                    href={credential.courseUrl}
                    rel="noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target={`course-${credential.id}`}
                  >
                    {t`The course`}
                    <Icon name="tb:arrow-up-right" />
                    <span class="sr-only">{t`(opens in a new tab)`}</span>
                  </a>
                )}
                <a
                  class="xc-link"
                  href={credential.verifyUrl}
                  rel="noopener"
                  target="_blank"
                  data-umami-event="outbound"
                  data-umami-event-target={`verify-${credential.id}`}
                >
                  {t`Certificate`}
                  <Icon name="tb:arrow-up-right" />
                  <span class="sr-only">{t`(opens in a new tab)`}</span>
                </a>
              </span>
            ) : credential.kind === "knowledge" ? (
              /* The knowledge card's main action: the post on psychology in UX [user 2026-10-07]. */
              <a
                class="btn btn-acc xc-read"
                href={uxPsychologyPath(locale)}
                data-umami-event="cta"
                data-umami-event-id="ux-psychology"
                data-umami-event-source="credentials"
              >
                {t`Read: psychology in UX`}
                <Icon name="tb:arrow-right" class="nudge" />
              </a>
            ) : (
              <a class="xc-link" href={`${links.cv}#${credential.kind === "experience" ? "experience" : "qualifications"}`}>
                {t`Details on the CV`}
                <Icon name="tb:arrow-right" />
              </a>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
  <span class="ghost" data-ghost hidden aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path d="M4 2.5 20 11l-7 1.6-3.4 6.4z"></path>
    </svg>
  </span>
</section>

<style>
  /* Wide screens: the rows stack in the left column; the open card's body fills the right column, as tall as the list. */
  .xcards {
    --gap: clamp(1rem, 2.4vw, 2.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--gap);
    align-content: start;
    min-height: 30rem;
    margin: clamp(1.5rem, 3vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .xc {
    grid-column: 1;
    min-width: 0;
    border-bottom: 2px solid currentColor;
  }
  .xc:first-child {
    border-top: 2px solid currentColor;
  }
  .xc-h {
    margin: 0;
    font: inherit;
  }
  .xc-btn {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.125rem 0.875rem;
    width: 100%;
    min-height: 4.5rem;
    padding: 0.75rem 0.875rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-base),
      color var(--dur-base),
      padding var(--dur-base) var(--ease-out);
  }
  .xc-i {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--tbg);
    color: var(--tfg);
    box-shadow: 3px 3px 0 var(--sfg);
    transform: rotate(-4deg);
    transition: transform 0.35s var(--ease-pop);
  }
  .xc-i :global(.ico) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .xc-k {
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-stretch: 125%;
  }
  .xc-t {
    grid-column: 2;
    font-weight: 900;
    font-size: clamp(1.125rem, 1.4vw, 1.5rem);
    line-height: 1;
    text-transform: uppercase;
    font-stretch: 78%;
  }
  .xc-btn :global(:is(.arr, .chev)) {
    grid-row: 1 / span 2;
    grid-column: 3;
    width: 1.375rem;
    height: 1.375rem;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .xc-btn :global(.chev) {
    display: none;
  }
  .xc-btn :global(.arr) {
    opacity: 0;
    transform: translateX(-0.5rem);
  }
  .xc.open .xc-btn {
    padding-left: 1.25rem;
    background: var(--tbg);
    color: var(--tfg);
  }
  .xc.open .xc-i {
    background: var(--tfg);
    color: var(--tbg);
    box-shadow: none;
    transform: rotate(0deg);
  }
  .xc.open .xc-btn :global(.arr) {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .xc:not(.open) .xc-btn:hover {
      padding-left: 1.125rem;
    }
    .xc:not(.open) .xc-btn:hover .xc-i {
      transform: rotate(3deg) scale(1.06);
    }
  }

  .xc-body {
    display: none;
  }
  .xc.open .xc-body {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((100% - var(--gap)) * 5 / 12 + var(--gap));
    right: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1.125rem;
    background: var(--tbg);
    color: var(--tfg);
    box-shadow:
      0 0 0 3px var(--sfg),
      14px 14px 0 3px var(--tsh);
  }
  /* Only a real change of card fades in: the card open on load must not wait, half transparent, in an offscreen
     section whose animations are paused (axe read it at 1.6:1). */
  [data-swapped] .xc.open .xc-body {
    animation: swap 0.5s var(--ease-out) both;
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .xc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.625rem 1rem;
  }
  .xc-foot p {
    max-width: 58ch;
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }
  .xc-foot b,
  .when {
    display: block;
  }
  .xc-foot b {
    font-size: 1.125rem;
  }
  .when {
    margin-bottom: 0.25rem;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .xc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  .xc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .xc-link :global(.ico) {
    width: 1rem;
    height: 1rem;
  }
  .xc-media {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: rgb(0 0 0 / 0.18);
  }
  .xc-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .xc-media figcaption {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    padding: 0.3125rem 0.5625rem;
    background: var(--navy);
    color: var(--ice);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* The state exams: three marked papers fanned on the card, each with its subject drawn and a "passed" stamp that
     lands when the card opens (finished at once when still). Sized by the card's width (container units). */
  .exams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
    padding: 1rem;
    container-type: inline-size;
    background: radial-gradient(color-mix(in srgb, currentColor 22%, transparent) 1.2px, transparent 1.7px) 0 0 / 1.125rem
      1.125rem;
  }
  .sheet {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1.6cqw;
    width: 27cqw;
    aspect-ratio: 3 / 4;
    padding: 2.4cqw;
    background: var(--ice);
    color: var(--navy);
    box-shadow:
      0 0 0 2px var(--navy),
      1.2cqw 1.2cqw 0 2px var(--navy);
    transform: rotate(var(--r));
  }
  .sh-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1cqw;
    padding-bottom: 1cqw;
    border-bottom: 2px solid currentColor;
  }
  .sh-top b {
    font-weight: 900;
    font-size: 4.2cqw;
    line-height: 1;
    font-stretch: 70%;
  }
  .sh-top small {
    font-weight: 800;
    font-size: 1.7cqw;
    letter-spacing: 0.08em;
  }
  .sh-pic {
    display: flex;
    justify-content: center;
    gap: 1.6cqw;
    padding: 1.8cqw 0;
    background: var(--tbg);
    color: var(--tfg);
  }
  .sh-pic :global(.ico) {
    width: 7cqw;
    height: 7cqw;
  }
  .sh-topic {
    font-weight: 800;
    font-size: 1.9cqw;
    line-height: 1.15;
    text-transform: uppercase;
    font-stretch: 85%;
  }
  .sheet > i {
    height: 0.9cqw;
    background: rgb(10 13 51 / 0.25);
  }
  .sheet > i:last-of-type {
    width: 65%;
  }
  .sh-stamp {
    position: absolute;
    right: -3cqw;
    bottom: 3.5cqw;
    display: inline-flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.7cqw 1.4cqw;
    background: var(--lime);
    color: var(--navy);
    box-shadow:
      0 0 0 2px var(--navy),
      0.6cqw 0.6cqw 0 2px var(--navy);
    font-weight: 900;
    font-size: 2.3cqw;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: rotate(-12deg);
  }
  .sh-stamp :global(.ico) {
    width: 2.6cqw;
    height: 2.6cqw;
    stroke-width: 3;
  }
  .xc.open .sh-stamp {
    animation: cr-stamp 0.45s var(--ease-pop) both;
    animation-delay: calc(var(--i) * 0.22s + 0.35s);
  }
  @keyframes cr-stamp {
    from {
      transform: rotate(-12deg) scale(2.4);
      opacity: 0;
    }
  }
  /* A phone-width card: bigger papers and type, so the subjects and the stamps stay readable. */
  @container (max-width: 34rem) {
    .sheet {
      width: 31cqw;
      padding: 2cqw;
    }
    .sh-top b {
      font-size: 5.4cqw;
    }
    .sh-top small {
      font-size: 2.3cqw;
    }
    .sh-pic :global(.ico) {
      width: 8cqw;
      height: 8cqw;
    }
    .sh-topic {
      font-size: 3cqw;
    }
    .sh-stamp {
      font-size: 3.3cqw;
    }
    .sh-stamp :global(.ico) {
      width: 3.4cqw;
      height: 3.4cqw;
    }
  }
  /* Paused or reduced motion: the papers are already stamped (an entrance must never stay hidden; lessons.md). */
  :global(.still) .xc.open .sh-stamp {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .xc.open .sh-stamp {
      animation: none;
    }
  }

  /* Course, exchange, hackathon and knowledge cards: a drawn scene of what it was, and the proofs as a row of chips
     under it [user 2026-10-07: no white cards every time, good illustrations]. Scenes are drawn in container units of
     the card's media area, so each scales as one picture. */
  .art {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: clamp(0.875rem, 2vw, 1.5rem);
    overflow: visible;
    container-type: inline-size;
    background: radial-gradient(color-mix(in srgb, currentColor 22%, transparent) 1.2px, transparent 1.7px) 0 0 / 1.125rem
      1.125rem;
  }
  .scene {
    align-self: center;
