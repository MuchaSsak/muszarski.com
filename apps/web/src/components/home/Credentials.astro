---
/**
 * Competences (structure.md § Home 5, requirements.md F08) [user 2026-10-06: "why call section Credentials and not
 * something like Competences"]: experience first, then qualifications, courses and teamwork, all from the CV data
 * (`~/data/cv`, the same source as /cv/ and the PDF). The Experience card [user 2026-10-06: "at the top so most
 * important"] lists school and internships from the CV's education and experience entries (their `short` lines). Wide screens: a readable list on the left and the open card's
 * media and details on the right [user 2026-10-06: collapsed cards with vertical titles were unreadable]; a row opens on
 * tap, focus or hover (fine pointers). Phones: an accordion. Each credential has its own poster colour: its icon tile in
 * the list, the open row and the detail panel [user 2026-10-06: the coloured cards were nicer, the plain list too
 * flat]. Wide screens also run a quiet tour: after a few idle seconds (no hover, focus or click in the list or panel,
 * section in view, motion not paused) a drawn cursor flies in, clicks the next row and leaves [user 2026-10-06].
 * Media loads only when its card opens. Instructors appear
 * as text credits, never photos (compliance-and-data.md). Placeholder media and dates are logged (placeholders.md P11,
 * P18).
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { CV } from "~/data/cv";
import { chromeLinks } from "~/lib/nav";

const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const KIND = {
  experience: t`Start here`,
  qualification: t`Qualification`,
  course: t`Course`,
  volunteering: t`International`,
  hackathon: t`Teamwork`,
} as const;
// Colour pairs from the palette (design.md § Colour); every pair passes AA for its text.
const TONE: Record<string, [bg: string, fg: string]> = {
  experience: ["pink", "navy"],
  inf: ["cobalt", "ice"],
  "threejs-journey": ["navy", "ice"],
  jonas: ["yellow", "navy"],
  erasmus: ["lime", "navy"],
  hackathons: ["orange", "navy"],
  "short-courses": ["space", "ice"],
};
/** The Experience card's timeline: school and internships, from the CV entries that carry a `short` line. */
const steps = [...CV.education, ...CV.experience].flatMap((entry) => (entry.short ? [{ ...entry.short, when: entry.when }] : []));
const tone = (id: string) => {
  const [bg, fg] = TONE[id] ?? ["navy", "ice"];
  return `--tbg:var(--${bg});--tfg:var(--${fg});--tsh:var(--${bg === "navy" ? "cobalt" : "navy"})`;
};
const MEDIA_SOON: Record<string, string> = {
  jonas: t`Certificate image soon`,
  erasmus: t`Photo from an exchange soon`,
  hackathons: t`Photo from a hackathon soon`,
  "short-courses": t`Certificate images soon`,
};
---

<section class="sec field-alt creds" id="credentials" aria-labelledby="t-cr">
  <div class="sbar draw">
    <p>{t`Competences`}</p>
    <p>{t`Experience · qualifications · training · teams`}</p>
    <p>{t`Pick one`}</p>
  </div>
  <Fit as="h2" id="t-cr" lines={[t`Competences`]} motion="calm" base={[100, 140]} />
  <ul class="xcards" data-xcards>
    {CV.credentials.map((credential, i) => (
      <li class:list={["xc", { open: i === 0 }]} style={tone(credential.id)}>
        <h3 class="xc-h">
          <button class="xc-btn" type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`xc-${credential.id}`}>
            <span class="xc-i">
              <Icon name={credential.icon} />
            </span>
            <span class="xc-k">{KIND[credential.kind]}</span>
            <span class="xc-t">{credential.title[locale]}</span>
            <Icon name="tb:arrow-right" class="arr" />
            <Icon name="tb:chevron-down" class="chev" />
          </button>
        </h3>
        <div class="xc-body enter" id={`xc-${credential.id}`}>
          {credential.kind === "experience" ? (
            <ol class="xc-media steps" role="list">
              {steps.map((step, k) => (
                <li class="step enter" style={`--i:${k}`}>
                  <b>{step.name}</b>
                  <span>{step.note[locale]}</span>
                  <small>{step.when[locale]}</small>
                </li>
              ))}
            </ol>
          ) : credential.id === "inf" ? (
            <div class="xc-media stamps" aria-hidden="true">
              <span class="stamp enter" style="--r:-8deg;--i:0">
                INF<b>.02</b>
                <small>CKE</small>
              </span>
              <span class="stamp enter" style="--r:5deg;--i:1">
                INF<b>.03</b>
                <small>CKE</small>
              </span>
              <span class="stamp enter" style="--r:-3deg;--i:2">
                INF<b>.04</b>
                <small>CKE</small>
              </span>
            </div>
          ) : credential.id === "threejs-journey" ? (
            <figure class="xc-media">
              <video
                tabindex="-1"
                muted
                loop
                playsinline
                preload="none"
                poster="/media/space/flight-poster.webp"
                width="960"
                height="540"
                aria-label={t`My space portfolio, built with what the course taught`}
              >
                <source data-src="/media/space/flight.av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
                <source data-src="/media/space/flight.mp4" type="video/mp4" />
              </video>
              <figcaption>{t`Built with it: my space portfolio`}</figcaption>
            </figure>
          ) : (
            <div class="xc-media ph" aria-hidden="true">
              <span class="ph-sticker">
                <Icon name={credential.icon} />
              </span>
              <span class="ph-soon">
                <Icon name="tb:camera" />
                {MEDIA_SOON[credential.id]}
              </span>
            </div>
          )}
          <div class="xc-foot">
            <p>
              <b>{credential.issuer[locale]}</b>
              <span class="when">{credential.when[locale]}</span>
              {credential.summary[locale]}
            </p>
            {credential.verifyUrl ? (
              <a
                class="xc-link"
                href={credential.verifyUrl}
                rel="noopener"
                target="_blank"
                data-umami-event="outbound"
                data-umami-event-target={`verify-${credential.id}`}
              >
                {t`Certificate`}
                <Icon name="tb:arrow-up-right" />
                <span class="sr-only">{t`(opens in a new tab)`}</span>
              </a>
            ) : (
              <a class="xc-link" href={`${links.cv}#${credential.kind === "experience" ? "cv-experience" : "credentials"}`}>
                {t`Details on the CV`}
                <Icon name="tb:arrow-right" />
              </a>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
  <span class="ghost" data-ghost hidden aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path d="M4 2.5 20 11l-7 1.6-3.4 6.4z"></path>
    </svg>
  </span>
</section>

<style>
  /* Wide screens: the rows stack in the left column; the open card's body fills the right column, as tall as the list. */
  .xcards {
    --gap: clamp(1rem, 2.4vw, 2.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--gap);
    align-content: start;
    min-height: 30rem;
    margin: clamp(1.5rem, 3vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .xc {
    grid-column: 1;
    min-width: 0;
    border-bottom: 2px solid currentColor;
  }
  .xc:first-child {
    border-top: 2px solid currentColor;
  }
  .xc-h {
    margin: 0;
    font: inherit;
  }
  .xc-btn {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.125rem 0.875rem;
    width: 100%;
    min-height: 4.5rem;
    padding: 0.75rem 0.875rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-base),
      color var(--dur-base),
      padding var(--dur-base) var(--ease-out);
  }
  .xc-i {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--tbg);
    color: var(--tfg);
    box-shadow: 3px 3px 0 var(--sfg);
    transform: rotate(-4deg);
    transition: transform 0.35s var(--ease-pop);
  }
  .xc-i :global(.ico) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .xc-k {
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-stretch: 125%;
  }
  .xc-t {
    grid-column: 2;
    font-weight: 900;
    font-size: clamp(1.125rem, 1.4vw, 1.5rem);
    line-height: 1;
    text-transform: uppercase;
    font-stretch: 78%;
  }
  .xc-btn :global(:is(.arr, .chev)) {
    grid-row: 1 / span 2;
    grid-column: 3;
    width: 1.375rem;
    height: 1.375rem;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .xc-btn :global(.chev) {
    display: none;
  }
  .xc-btn :global(.arr) {
    opacity: 0;
    transform: translateX(-0.5rem);
  }
  .xc.open .xc-btn {
    padding-left: 1.25rem;
    background: var(--tbg);
    color: var(--tfg);
  }
  .xc.open .xc-i {
    background: var(--tfg);
    color: var(--tbg);
    box-shadow: none;
    transform: rotate(0deg);
  }
  .xc.open .xc-btn :global(.arr) {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .xc:not(.open) .xc-btn:hover {
      padding-left: 1.125rem;
    }
    .xc:not(.open) .xc-btn:hover .xc-i {
      transform: rotate(3deg) scale(1.06);
    }
  }

  .xc-body {
    display: none;
  }
  .xc.open .xc-body {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((100% - var(--gap)) * 5 / 12 + var(--gap));
    right: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1.125rem;
    background: var(--tbg);
    color: var(--tfg);
    box-shadow:
      0 0 0 3px var(--sfg),
      14px 14px 0 3px var(--tsh);
  }
  /* Only a real change of card fades in: the card open on load must not wait, half transparent, in an offscreen
     section whose animations are paused (axe read it at 1.6:1). */
  [data-swapped] .xc.open .xc-body {
    animation: swap 0.5s var(--ease-out) both;
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .xc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.625rem 1rem;
  }
  .xc-foot p {
    max-width: 58ch;
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }
  .xc-foot b,
  .when {
    display: block;
  }
  .xc-foot b {
    font-size: 1.125rem;
  }
  .when {
    margin-bottom: 0.25rem;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .xc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .xc-link :global(.ico) {
    width: 1rem;
    height: 1rem;
  }
  .xc-media {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: rgb(0 0 0 / 0.18);
  }
  .xc-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .xc-media figcaption {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    padding: 0.3125rem 0.5625rem;
    background: var(--navy);
    color: var(--ice);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Media still to come (P18): the credential's icon as a big sticker on a faint dot grid, and a small "soon" chip. */
  .ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    padding: 1rem;
    text-align: center;
    background: radial-gradient(color-mix(in srgb, currentColor 22%, transparent) 1.2px, transparent 1.7px) 0 0 / 1.125rem
      1.125rem;
  }
  .ph-sticker {
    display: grid;
    place-items: center;
    width: clamp(6rem, 11vw, 9rem);
    aspect-ratio: 1;
    background: var(--ice);
    color: var(--navy);
    box-shadow:
      0 0 0 3px var(--navy),
      8px 8px 0 3px var(--navy);
    animation: cr-bob 5s ease-in-out infinite;
  }
  .ph-sticker :global(.ico) {
    width: 55%;
    height: 55%;
  }
  @keyframes cr-bob {
    0%,
    100% {
      transform: rotate(-6deg) translateY(0);
    }
    50% {
      transform: rotate(-2deg) translateY(-0.375rem);
    }
  }
  .ph-soon {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.3125rem 0.625rem;
    background: var(--tfg);
    color: var(--tbg);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .ph-soon :global(.ico) {
    width: 1rem;
    height: 1rem;
  }
  .stamps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4%;
    background: transparent;
  }
  .stamp {
    display: grid;
    place-content: center;
    width: 26%;
    max-width: 10rem;
    aspect-ratio: 1;
    border-radius: 50%;
    text-align: center;
    box-shadow:
      inset 0 0 0 3px currentColor,
      inset 0 0 0 7px transparent,
      inset 0 0 0 9px currentColor;
    font-weight: 900;
    font-size: clamp(0.875rem, 1.3vw, 1.25rem);
    line-height: 1;
    font-stretch: 110%;
    transform: rotate(var(--r));
  }
  .stamp b {
    display: block;
    font-size: 1.9em;
    font-stretch: 62%;
  }
  .stamp small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.5em;
    letter-spacing: 0.08em;
  }
  .xc.open .stamp {
    animation: stamp-in 0.5s var(--ease-pop) both;
    animation-delay: calc(var(--i) * 0.14s + 0.2s);
  }
  @keyframes stamp-in {
    from {
      transform: rotate(var(--r)) scale(2.2);
      opacity: 0;
    }
  }

  /* Experience: school and internships as a short stack of tickets on the card's colour. They slide in only on a
     real change of card (never from transparent: the open card must read at once). */
  .xc-media.steps {
    display: grid;
    align-content: center;
    gap: 0.875rem;
    margin: 0;
    padding: clamp(1rem, 2vw, 1.75rem);
    overflow: visible;
    list-style: none;
    background: radial-gradient(color-mix(in srgb, currentColor 22%, transparent) 1.2px, transparent 1.7px) 0 0 / 1.125rem
      1.125rem;
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.125rem 1rem;
    padding: 0.625rem 0.875rem 0.6875rem 1rem;
    background: var(--ice);
    color: var(--navy);
    box-shadow:
      0 0 0 2px var(--navy),
      5px 5px 0 2px var(--navy);
    rotate: calc((var(--i) - 1.5) * 0.7deg);
  }
  .step b {
    font-weight: 900;
    font-size: 1.0625rem;
    line-height: 1.1;
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .step span {
    grid-column: 1;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .step small {
    grid-column: 2;
    grid-row: 1 / span 2;
    padding: 0.25rem 0.5rem;
    background: var(--navy);
    color: var(--ice);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  [data-swapped] .xc.open .step {
    animation: cr-step 0.5s var(--ease-pop) both;
    animation-delay: calc(var(--i) * 0.08s + 0.15s);
  }
  @keyframes cr-step {
    from {
      transform: translateX(-1.5rem);
    }
  }

  /* The tour's cursor: moved by the script (Web Animations), never in the way of the real pointer. */
  .ghost {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    width: 2.75rem;
    height: 2.75rem;
    pointer-events: none;
  }
  .ghost svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ghost path {
    fill: var(--ice);
    stroke: var(--navy);
    stroke-width: 1.8;
    stroke-linejoin: round;
    filter: drop-shadow(2px 2px 0 var(--navy));
  }
  .ghost::before {
    content: "";
    position: absolute;
    left: -0.875rem;
    top: -0.875rem;
    width: 1.75rem;
    height: 1.75rem;
    border: 4px solid var(--pink);
    border-radius: 50%;
    opacity: 0;
  }
  .ghost.click::before {
    animation: cr-ripple 0.55s var(--ease-out);
  }
  @keyframes cr-ripple {
    from {
      transform: scale(0.3);
      opacity: 1;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* Without the script every card is open, stacked. */
  :global(html:not(.js)) .xcards {
    display: block;
  }
  :global(html:not(.js)) .xc-body {
    position: static;
    display: grid;
    gap: 0.875rem;
    padding: 0 1.125rem 1.125rem;
  }
  :global(html:not(.js)) .xc-media:not(.steps) {
    aspect-ratio: 16 / 10;
  }

  /* Phones and tablets: an accordion, each body under its row. */
  @media (max-width: 56.25rem) {
    .xcards {
      display: block;
      min-height: 0;
    }
    .xc-btn :global(.arr) {
      display: none;
    }
    .xc-btn :global(.chev) {
      display: block;
    }
    .xc.open .xc-btn {
      padding-left: 0.875rem;
    }
    .xc.open .xc-btn :global(.chev) {
      transform: rotate(180deg);
    }
    .xc.open .xc-body {
      position: static;
      grid-template-rows: auto auto;
      margin: 0 0.5rem 1.25rem 0;
      padding: 0.875rem;
      box-shadow:
        0 0 0 3px var(--sfg),
        8px 8px 0 3px var(--tsh);
      animation: none;
    }
    .xc-media:not(.steps) {
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script>
  import { motionStill } from "~/scripts/motion";

  // Media plays only after the visitor has interacted with the page (a load-time loop cost TBT; lessons.md).
  let interacted = false;
  for (const type of ["pointerdown", "keydown"]) addEventListener(type, () => (interacted = true), { once: true, capture: true });
  const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));

  for (const list of document.querySelectorAll<HTMLElement>("[data-xcards]")) {
    const section = list.closest<HTMLElement>("section")!;
    const ghost = section.querySelector<HTMLElement>("[data-ghost]")!;
    const cards = [...list.querySelectorAll<HTMLElement>(".xc")];
    const wide = matchMedia("(min-width: 56.3125rem)");
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");

    const loadMedia = (card: HTMLElement) => {
      const video = card.querySelector("video");
      if (!video) return;
      if (!video.dataset.loaded) {
        video.dataset.loaded = "1";
        for (const source of video.querySelectorAll<HTMLSourceElement>("source[data-src]")) source.src = source.dataset.src!;
        video.load();
      }
      if (!motionStill()) video.play().catch(() => {});
    };
    const open = (card: HTMLElement, toggle = false, auto = false) => {
      const isOpen = card.classList.contains("open");
      // On wide screens one card is always open; on phones a tap toggles.
      if (isOpen && !(toggle && !wide.matches)) return;
      for (const other of cards) {
        const on = other === card && !isOpen;
        other.classList.toggle("open", on);
        other.querySelector(".xc-btn")!.setAttribute("aria-expanded", String(on));
        if (!on) other.querySelector("video")?.pause();
      }
      if (!isOpen && (!auto || interacted)) loadMedia(card);
      list.dataset.swapped = "";
    };
    for (const card of cards) {
      const button = card.querySelector<HTMLButtonElement>(".xc-btn")!;
      button.addEventListener("click", () => open(card, true));
      button.addEventListener("focus", () => wide.matches && open(card));
      card.addEventListener("pointerenter", () => wide.matches && finePointer.matches && open(card));
    }

    // The tour: 1.5 s after the visitor leaves the list (or it comes into view) [user 2026-10-06: "1 or 2 seconds"],
    // the cursor opens the next card; between its own clicks it waits longer, so each card can be read.
    let idleSince = performance.now();
    let idleFor = 1500;
    let inside = false;
    let visible = false;
    let touring = false;
    const poke = (ms = 1500) => ((idleSince = performance.now()), (idleFor = ms));
    list.addEventListener("pointerenter", () => ((inside = true), poke()));
    list.addEventListener("pointerleave", () => ((inside = false), poke()));
    list.addEventListener("focusin", () => poke());
    list.addEventListener("click", () => poke());
    new IntersectionObserver(([entry]) => ((visible = !!entry?.isIntersecting), poke()), { threshold: 0.6 }).observe(list);

    const idle = () =>
      visible && !inside && wide.matches && !motionStill() && !document.hidden && !list.contains(document.activeElement);
    const tour = async (card: HTMLElement) => {
      const area = section.getBoundingClientRect();
      const row = card.querySelector(".xc-btn")!.getBoundingClientRect();
      const x = row.left - area.left + Math.min(row.width * 0.4, 240);
      const y = row.top - area.top + row.height * 0.55;
      const at = (dx: number, dy: number, scale = 1) => `translate(${x + dx}px, ${y + dy}px) scale(${scale})`;
      const easing = "cubic-bezier(0.2, 0.75, 0.1, 1)";
      ghost.hidden = false;
      await ghost.animate(
        [
          { transform: at(-140, 190), opacity: 0 },
          { opacity: 1, offset: 0.4 },
          { transform: at(0, 0), opacity: 1 },
        ],
        {
          duration: 950,
          easing,
          fill: "forwards",
        },
      ).finished;
      await ghost.animate([{ transform: at(0, 0) }, { transform: at(0, 0, 0.8) }, { transform: at(0, 0) }], {
        duration: 260,
        fill: "forwards",
      }).finished;
      ghost.classList.add("click");
      if (idle()) open(card, false, true);
      await wait(550);
      ghost.classList.remove("click");
      await ghost.animate(
        [
          { transform: at(0, 0), opacity: 1 },
          { transform: at(110, 160), opacity: 0 },
        ],
        { duration: 700, easing, fill: "forwards" },
      ).finished;
      ghost.hidden = true;
    };
    setInterval(() => {
      if (touring || !idle() || performance.now() - idleSince < idleFor) return;
      const current = cards.findIndex((card) => card.classList.contains("open"));
      touring = true;
      tour(cards[(current + 1) % cards.length]!).finally(() => ((touring = false), poke(4500)));
    }, 250);
  }
</script>
