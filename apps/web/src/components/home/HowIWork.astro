  @keyframes hw-pop-tilt-r {
    from {
      transform: rotate(5deg) scale(0);
    }
  }

  /* Ship: build, test, deploy light up in turn; then the release lands on the web, both stores and Google. */
  .launch {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 5cqw;
  }
  .pipe {
    display: flex;
    gap: 7cqw;
