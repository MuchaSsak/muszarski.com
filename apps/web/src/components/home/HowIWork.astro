---
/**
 * How I work (structure.md § Home 3, requirements.md F06): the loop I run on every project, web, mobile or backend.
 * Seven stops on a ring, code is one of them. Each stop is a drawn scene (the stop as a picture, so it reads without
 * reading), one line and the practices behind it. Generic on purpose [user 2026-10-06: "more general", no project
 * receipts; shipping is pipelines, the web and the stores, not only app review]. Every stop's text is in the HTML
 * (crawlable, readable without JS); the script shows one at a time, moves the dot along the ring and advances while
 * the section is visible (pauses on tap, the pause button and reduced motion).
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { type IconName } from "~/lib/icons.gen";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;

type Scene = "client" | "users" | "conversion" | "revenue" | "code" | "ship" | "measure";
interface Stop {
  icon: IconName;
  scene: Scene;
  /** The scene's colour. */
  color: string;
  name: string;
  line: string;
  /** What I do at this stop, as short chips; a tool's mark where a real tool does the job. */
  does: { label: string; icon?: IconName }[];
  code?: boolean;
}

const STOPS: Stop[] = [
  {
    icon: "tb:briefcase",
    scene: "client",
    color: "var(--yellow)",
    name: t`Client`,
    line: t`I start with the person paying for it, and what they need to earn.`,
    does: [{ label: t`goals in numbers` }, { label: t`budget` }, { label: t`deadline` }],
  },
  {
    icon: "tb:users",
    scene: "users",
    color: "var(--orange)",
    name: t`Users`,
    line: t`Who uses it, what they want done, and where they give up.`,
    does: [{ label: t`user flows` }, { label: t`real app references` }, { label: t`drop-off points` }],
  },
  {
    icon: "tb:target",
    scene: "conversion",
    color: "var(--pink)",
    name: t`Conversion`,
    line: t`Fewer steps between interest and action.`,
    does: [{ label: t`one clear CTA` }, { label: t`short forms` }, { label: t`fast pages` }],
  },
  {
    icon: "tb:coins",
    scene: "revenue",
    color: "var(--lime)",
    name: t`Revenue`,
    line: t`How it earns is designed in from day one.`,
    does: [{ label: t`pricing` }, { label: t`payments`, icon: "tb:credit-card" }, { label: "RevenueCat", icon: "si:revenuecat" }],
  },
  {
    icon: "tb:code",
    scene: "code",
    color: "var(--cobalt)",
    name: t`Code`,
    line: t`Then the code: web, mobile and backend, end to end, tested.`,
    does: [
      { label: "TypeScript", icon: "si:typescript" },
      { label: t`automated tests`, icon: "tb:test-pipe" },
      { label: t`code review`, icon: "tb:git-pull-request" },
    ],
    code: true,
  },
  {
    icon: "tb:rocket",
    scene: "ship",
    color: "var(--yellow)",
    name: t`Ship`,
    line: t`Shipping is part of the job: pipelines, deploys, store releases.`,
    does: [
      { label: "GitLab CI/CD", icon: "si:gitlab" },
      { label: "Vercel", icon: "si:vercel" },
      { label: t`App Store and Google Play`, icon: "tb:device-mobile" },
      { label: "Search Console", icon: "si:googlesearchconsole" },
    ],
  },
  {
    icon: "tb:chart-line",
    scene: "measure",
    color: "var(--pink)",
    name: t`Measure`,
    line: t`Measure, then decide what changes next.`,
    does: [
      { label: t`analytics`, icon: "si:umami" },
      { label: "Lighthouse", icon: "si:lighthouse" },
      { label: t`user feedback` },
    ],
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
const stopLabel = t({ message: "Stop", context: "a stop on the product loop, as in a bus stop" });
const [line1, line2] = t`Product|engineer`.split("|") as [string, string];
/** Client: what I write down while they talk. */
const BRIEF: { icon: IconName; label: string }[] = [
  { icon: "tb:target", label: t`goal` },
  { icon: "tb:coins", label: t`budget` },
  { icon: "tb:calendar", label: t`deadline` },
];
/** Users: the flow one person walks through, on one phone. */
const FLOW: { icon: IconName; label: string }[] = [
  { icon: "tb:browser", label: t`landing` },
  { icon: "tb:forms", label: t`sign-up` },
  { icon: "tb:circle-check", label: t`done` },
];
/** Conversion: the steps that stood between interest and action, and get cut. */
const DETOURS: { icon: IconName; label: string }[] = [
  { icon: "tb:user", label: t`account` },
  { icon: "tb:forms", label: t`long form` },
  { icon: "tb:mail", label: t`confirm email` },
  { icon: "tb:shield-lock", label: t`password` },
];
/** The ship scene's pipeline. */
const pipeline: { icon: IconName; label: string }[] = [
  { icon: "tb:hammer", label: t`build` },
  { icon: "tb:test-pipe", label: t`test` },
  { icon: "tb:rocket", label: t`deploy` },
];
/** Measure: what gets measured. A funnel (bar widths are a drawing, not data), page quality, what people say. */
const FUNNEL = [t`visits`, t`sign-ups`, t`purchases`];
const VITALS = [t`speed`, t`accessibility`, "SEO"];
---

<section class="sec field-alt how" id="how-i-work" aria-labelledby="t-how">
  <div class="sbar draw">
    <p>{t`How I work`}</p>
    <p>{t`Code is one stop of seven`}</p>
    <p>{t`The same loop on every project`}</p>
  </div>
  <Fit as="h2" id="t-how" lines={[line1, line2]} motion="calm" base={[90, 130]} />
  <div class="loop" data-loop>
    <div class="lp-ring" aria-hidden="true">
      <svg class="lp-svg" viewBox="0 0 500 500">
        <circle class="track" cx="250" cy="250" r="200"></circle>
        <circle class="trail" cx="250" cy="250" r="200" pathLength="700" transform="rotate(-90 250 250)"></circle>
        <g class="dot-arm">
          <circle class="dot" r="11" cx="250" cy="50"></circle>
        </g>
      </svg>
      <div class="core">
        <span class="n tabular" data-core-n>
          01 / {pad(STOPS.length)}
        </span>
        {STOPS.map((stop, i) => (
          <Icon name={stop.icon} data-core-icon={i} hidden={i > 0} />
        ))}
        <span class="nm" data-core-nm>
          {STOPS[0]!.name}
        </span>
      </div>
    </div>
    <ol class="stops" aria-label={t`The loop`}>
      {STOPS.map((stop, i) => (
        <li class:list={["stop", { code: stop.code }]} style={`--i:${i}`}>
          <button class="stn" type="button" aria-pressed={i === 0 ? "true" : "false"} aria-controls={`stop-${i}`} data-stop={i}>
            <Icon name={stop.icon} />
            <span class="lbl">{stop.name}</span>
          </button>
        </li>
      ))}
    </ol>
    <div class="panel">
      {STOPS.map((stop, i) => (
        <div class:list={["pd enter", { "on timing": i === 0 }]} id={`stop-${i}`} data-pd={i}>
          <div class="k-row">
            <p class="kick k">
              {stopLabel} {pad(i + 1)} · {stop.name}
            </p>
            <span class="k-bar js-only" aria-hidden="true">
              <i />
            </span>
          </div>
          <div class={`scene sc-${stop.scene}`} style={`--c:${stop.color}`} aria-hidden="true">
            {stop.scene === "client" && (
              <div class="call">
                <span class="c-prob">
                  <span class="c-av">
                    <Icon name="tb:building-store" />
                  </span>
                  <span class="c-chart">
                    <svg class="c-svg" viewBox="0 0 100 60">
                      <path class="c-grid" d="M0 15H100M0 30H100M0 45H100" />
                      <polyline class="c-down" points="5,10 24,16 40,13 58,30 76,36 94,52" pathLength="100" />
                    </svg>
                    <i class="c-alarm">
                      <Icon name="tb:trending-down" />
                    </i>
                  </span>
                  <span class="c-ring">
                    <Icon name="tb:phone-call" />
                  </span>
                </span>
                <span class="c-half c-them">
                  <span class="c-who">
                    <span class="c-av">
                      <Icon name="tb:building-store" />
                    </span>
                    <i class="c-tel">
                      <Icon name="tb:phone-call" />
                    </i>
                  </span>
                  <span class="c-say" style="--k:0">
                    {t`Sales are dropping.`}
                  </span>
                  <span class="c-say" style="--k:1">
                    {t`Can you help?`}
                  </span>
                </span>
                <span class="c-half c-me">
                  <span class="c-who">
                    <span class="c-av c-av-me">
                      <Icon name="tb:user" />
                    </span>
                    <i class="c-tel">
                      <Icon name="tb:headphones" />
                    </i>
                  </span>
                  <span class="c-note">
                    {BRIEF.map((item, k) => (
                      <span class="c-row" style={`--k:${k}`}>
                        <Icon name={item.icon} />
                        <span class="c-l">{item.label}</span>
                        <b>
                          <Icon name="tb:check" />
                        </b>
                      </span>
                    ))}
                  </span>
                </span>
              </div>
            )}
            {stop.scene === "users" && (
              <div class="row u-row">
                <span class="phone enter">
                  <span class="scrn s-a">
                    <i class="s-hero" />
                    <i class="s-bar" />
                    <i class="s-bar s-short" />
                    <i class="s-btn" />
                  </span>
                  <span class="scrn s-b">
                    <i class="s-bar s-title" />
                    {[0, 1, 2, 3, 4].map(() => (
                      <i class="s-field" />
                    ))}
                    <i class="s-btn" />
                  </span>
                  <span class="scrn s-c">
                    <i class="s-bar s-title" />
                    <i class="s-field" />
                    <i class="s-btn" />
                  </span>
                  <span class="scrn s-d">
                    <span class="s-done">
                      <Icon name="tb:check" />
                    </span>
                    <i class="s-bar" />
                  </span>
                  <i class="notch" />
                  <span class="finger">
                    <Icon name="tb:hand-click" />
                  </span>
                </span>
                <span class="flow">
                  {FLOW.map((step, k) => (
                    <span class={`f-step f-${k}`}>
                      <i class="f-ico">
                        <Icon name={step.icon} />
                      </i>
                      <span class="f-l">{step.label}</span>
                      {k === 1 && <em class="f-tag">{t`drop-off`}</em>}
                      <b class="f-ok">
                        <Icon name="tb:check" />
                      </b>
                      {k === 1 && (
                        <b class="f-x">
                          <Icon name="tb:x" />
                        </b>
                      )}
                    </span>
                  ))}
                </span>
              </div>
            )}
            {stop.scene === "conversion" && (
              <div class="path">
                <span class="p-node p-end">
                  <span class="p-ico">
                    <Icon name="tb:eye" />
                  </span>
                  <small>{t`interest`}</small>
                </span>
                {DETOURS.map((step, k) => (
                  <span class="p-mid" style={`--k:${k}`}>
                    <span class="p-node">
                      <span class="p-ico">
                        <Icon name={step.icon} />
                        <b class="p-x">
                          <Icon name="tb:x" />
                        </b>
                      </span>
                      <small>{step.label}</small>
                    </span>
                  </span>
                ))}
                <span class="p-cta">
                  <b>{t`Get started`}</b>
                  <Icon name="tb:hand-click" class="p-tap" />
                </span>
                <span class="p-node p-end p-act">
                  <span class="p-ico">
                    <Icon name="tb:check" />
                  </span>
                  <small>{t`action`}</small>
                </span>
              </div>
            )}
            {stop.scene === "revenue" && (
              <div class="row">
                <span class="plan enter">
                  <b class="plan-t">
                    {t`Pro`}
                    <Icon name="tbf:star" />
                  </b>
                  <i class="plan-p" />
                  <i class="plan-f" />
                  <i class="plan-f" />
                  <span class="ccard">
                    <i />
                  </span>
                  <em class="plan-paid">{t`paid`}</em>
                </span>
                <span class="money">
                  {[0, 1, 2].map((k) => (
                    <span class="fly" style={`--k:${k}`}>
                      <Icon name="tb:coins" />
                    </span>
                  ))}
                </span>
                <span class="biz">
                  <span class="c-av">
                    <Icon name="tb:building-store" />
                  </span>
                  <span class="bars">
                    {[0, 1, 2, 3].map((k) => (
                      <i style={`--k:${k}`} />
                    ))}
                    <Icon name="tb:trending-up" class="up" />
                  </span>
                  <small class="biz-l">{stop.name}</small>
                </span>
              </div>
            )}
            {stop.scene === "code" && (
              <div class="row">
                <span class="term enter">
                  <span class="tbar">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="ln" style="--k:0">
                    <Icon name="si:typescript" />
                    typecheck
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="ln" style="--k:1">
                    <Icon name="tb:test-pipe" />
                    unit tests
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="ln" style="--k:2">
                    <Icon name="mk:playwright" />
                    e2e + a11y
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                </span>
                <span class="pr enter">
                  <Icon name="tb:git-pull-request" />
                  <i>
                    <Icon name="tb:check" />
                  </i>
                </span>
              </div>
            )}
            {stop.scene === "ship" && (
              <div class="launch">
                <span class="pipe">
                  {pipeline.map((step, k) => (
                    <span class="step" style={`--k:${k}`}>
                      <span class="stage">
                        <Icon name={step.icon} />
                      </span>
                      <small>{step.label}</small>
                    </span>
                  ))}
                </span>
                <span class="ship-live">
                  <span class="serp">
                    <span class="q">
                      <Icon name="si:google" class="q-g" />
                      <span class="q-t">{t`your product`}</span>
                      <Icon name="tb:search" class="q-s" />
                    </span>
                    <span class="hit">
                      <span class="hit-url">
                        <i class="fav">
                          <Icon name="tb:world" />
                        </i>
                        <i class="bar-g" />
                        <em class="on-air">{t`Live`}</em>
                      </span>
                      <i class="hit-t" />
                      <i class="bar-g" />
                      <i class="bar-g bar-s" />
                    </span>
                  </span>
                  <span class="store">
                    <span class="st-marks">
                      <Icon name="si:apple" />
                      <Icon name="si:googleplay" />
                    </span>
                    <span class="app">
                      <i class="app-ico">
                        <Icon name="tb:sparkles" />
                      </i>
                      <span class="app-n">
                        <i class="bar-g" />
                        <span class="st-stars">
                          {[0, 1, 2, 3, 4].map(() => (
                            <Icon name="tbf:star" />
                          ))}
                        </span>
                      </span>
                    </span>
                    <b class="get">
                      <span>{t`Install`}</span>
                    </b>
                  </span>
                </span>
              </div>
            )}
            {stop.scene === "measure" && (
              <div class="dash">
                <span class="d-card d-fun">
                  {FUNNEL.map((label, k) => (
                    <span class="fun" style={`--k:${k};--w:${[100, 58, 30][k]}%`}>
                      <small>{label}</small>
                      <i />
                    </span>
                  ))}
                </span>
                <span class="d-card d-vit">
                  {VITALS.map((label, k) => (
                    <span class="vit" style={`--k:${k}`}>
                      <svg class="g-ring" viewBox="0 0 40 40">
                        <circle class="g-bg" cx="20" cy="20" r="15" />
                        <circle class="g-fg" cx="20" cy="20" r="15" pathLength="100" transform="rotate(-90 20 20)" />
                      </svg>
                      <small>{label}</small>
                    </span>
                  ))}
                </span>
                <span class="d-card d-say">
                  <span class="d-av">
                    <Icon name="tb:user" />
                  </span>
                  <span class="d-q">
                    <Icon name="tb:quote" />
                    {t`Can't find the price.`}
                  </span>
                </span>
                <span class="d-next">
                  <Icon name="tb:bulb" />
                  {t`next change`}
                  <Icon name="tb:arrow-right" />
                </span>
              </div>
            )}
          </div>
          <p class="s">{typo(locale, stop.line)}</p>
          <ul class="does" role="list">
            {stop.does.map((item) => (
              <li>
                {item.icon && <Icon name={item.icon} />}
                {item.label}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .loop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "ring panel";
    gap: clamp(1.75rem, 4vw, 5rem);
    align-items: center;
    margin-top: clamp(1.75rem, 3vw, 3rem);
  }
  .lp-ring,
  .stops {
    grid-area: ring;
    position: relative;
    width: min(100%, 35rem);
    aspect-ratio: 1;
    justify-self: center;
  }
  .lp-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .track {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-dasharray: 2 11;
    stroke-linecap: round;
    opacity: 0.55;
    animation: dash 30s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -260;
    }
  }
  .trail {
    fill: none;
    stroke: var(--loop-c);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: var(--frac, 0) 700;
    transition: stroke-dasharray 0.8s var(--ease-out);
  }
  .dot-arm {
    transform-origin: 250px 250px;
    transform: rotate(var(--ang, 0deg));
    transition: transform 0.8s var(--ease-out);
  }
  .dot {
    fill: var(--loop-c);
    stroke: currentColor;
    stroke-width: 3;
  }
  .how {
    --loop-c: var(--cobalt);
  }
  .core {
    position: absolute;
    inset: 24%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.375rem;
    text-align: center;
  }
  .core .n {
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    font-stretch: 125%;
  }
  .core :global(.ico) {
    width: clamp(2.125rem, 3.4vw, 3.25rem);
    height: clamp(2.125rem, 3.4vw, 3.25rem);
  }
  .core .nm {
    font-weight: 900;
    font-size: clamp(1.875rem, 3.6vw, 3.625rem);
    line-height: 0.85;
    font-stretch: 58%;
    text-transform: uppercase;
  }
  /* Polish and Spanish capitals carry marks (Ę, Ż, Í) that the tight poster leading let touch the next line
     (2026-10-08). */
  .core .nm:is(:lang(pl), :lang(es)) {
    line-height: 0.96;
  }
  .stops {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stop {
    --a: calc(-90deg + var(--i) * 360deg / 7);
    position: absolute;
    left: calc(50% + 40% * cos(var(--a)));
    top: calc(50% + 40% * sin(var(--a)));
    transform: translate(-50%, -50%);
  }
  .stn {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(3.25rem, 5.4vw, 4.875rem);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--sbg);
    color: var(--sfg);
    box-shadow: inset 0 0 0 3px currentColor;
    cursor: pointer;
    transition:
      transform 0.45s var(--ease-pop),
      background-color var(--dur-base),
      color var(--dur-base);
  }
  .stn :global(.ico) {
    width: 46%;
    height: 46%;
  }
  .lbl {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.375rem);
    padding: 0.125rem 0.375rem;
    background: var(--sbg);
    color: var(--sfg);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: uppercase;
    font-stretch: 110%;
    transform: translateX(-50%);
  }
  .stn[aria-pressed="true"] {
    background: var(--sfg);
    color: var(--sbg);
    transform: scale(1.14);
  }
  .stn[aria-pressed="true"] :global(.ico) {
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-3px) rotate(-6deg);
    }
  }
  @media (hover: hover) {
    .stn:hover {
      transform: scale(1.08);
    }
  }
  .stop.code .stn {
    box-shadow:
      inset 0 0 0 3px currentColor,
      0 0 0 6px var(--sbg),
      0 0 0 8px currentColor;
  }

  .panel {
    grid-area: panel;
    display: grid;
    gap: 1.125rem;
    min-width: 0;
  }
  .pd {
    display: grid;
    gap: 1.125rem;
  }
  /* With the script, one stop at a time; without it, all seven read as a list. */
  :global(.js) .pd:not(.on) {
    display: none;
  }
  :global(.js) .pd.on {
    animation: swap 0.5s var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .k-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .k {
    flex: none;
    margin: 0;
  }
  /* Time to the next stop: fills while the stop plays (--dwell, set by the script); full when a click holds it,
     hidden when motion is paused. */
  .k-bar {
    flex: 1;
    max-width: 12rem;
    height: 0.3125rem;
    margin-left: auto;
    background: color-mix(in srgb, currentColor 18%, transparent);
    overflow: hidden;
  }
  .k-bar i {
    display: block;
    height: 100%;
    background: currentColor;
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .pd.on.timing .k-bar i {
    animation: hw-dwell var(--dwell, 6.4s) linear both;
  }
  @keyframes hw-dwell {
    to {
      transform: none;
    }
  }
  :global(.still) .k-bar {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .k-bar {
      visibility: hidden;
    }
  }
  .s {
    margin: clamp(0.5rem, 1vw, 0.875rem) 0 0;
    font-weight: 800;
    font-size: clamp(1.375rem, 2vw, 2.125rem);
    line-height: 1.08;
    font-stretch: 85%;
    text-wrap: balance;
  }

  /* The scene: a drawn moment of the stop in its project's colour. Sized in container units, so it scales as one
     picture. Entrances carry `.enter` (paused motion shows their last frame); text moves, it never fades. */
  .scene {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    container-type: inline-size;
    background: var(--c);
    color: var(--navy);
    box-shadow:
      0 0 0 3px var(--navy),
      12px 12px 0 3px var(--navy);
    font-size: 2.6cqw;
  }
  /* Paused or reduced motion: every scene shows its finished picture at once. */
  :global(.still) .scene * {
    animation: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .scene * {
      animation: none !important;
    }
  }
  .scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(10 13 51 / 0.16) 1.2px, transparent 1.7px) 0 0 / 3.5cqw 3.5cqw;
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5cqw;
  }
  .scene :global(.ico) {
    width: 100%;
    height: 100%;
  }
  .arw {
    flex: none;
    width: 6cqw !important;
    height: 6cqw !important;
  }
  /* Paper pieces: ice with the navy outline and a hard shadow. */
  .c-av,
  .c-chart,
  .c-say,
  .c-note,
  .flow,
  .p-ico,
  .plan,
  .serp,
  .store,
  .pr,
  .d-card {
    background: var(--ice);
    box-shadow:
      0 0 0 0.5cqw var(--navy),
      1.2cqw 1.2cqw 0 0.5cqw var(--navy);
  }
  /* Navy pieces cast a see-through shadow (a navy one would read as a second box). */
  .term,
  .stage,
  .c-ring,
  .p-cta,
  .d-next {
    box-shadow: 1.2cqw 1.2cqw 0 rgb(10 13 51 / 0.35);
  }
  /* Small labels: what each piece of a scene is [user 2026-10-06: icons alone are not always recognised]. */
  .scene small,
  .f-l {
    font-weight: 800;
    font-size: 2.3cqw;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @keyframes hw-pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes hw-press {
    50% {
      transform: scale(0.9);
    }
  }
  @keyframes hw-buzz {
    0%,
    100% {
      rotate: 0deg;
    }
    20% {
      rotate: -14deg;
    }
    40% {
      rotate: 12deg;
    }
    60% {
      rotate: -10deg;
    }
    80% {
      rotate: 8deg;
    }
  }

  /* Client: a business has a problem and calls; the screen splits: they explain, I listen and write the brief. */
  .call {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  /* The split, drawn top to bottom as the call starts. */
  .call::after {
    content: "";
    position: absolute;
    left: calc(50% - 0.3cqw);
    top: 5cqw;
    bottom: 5cqw;
    width: 0.6cqw;
    background: var(--navy);
    transform-origin: 50% 0;
    animation: hw-grow-y 0.35s ease-out 1.9s both;
  }
  @keyframes hw-grow-y {
    from {
      transform: scaleY(0);
    }
  }
  .c-av {
    display: grid;
    place-items: center;
    width: 15cqw;
    aspect-ratio: 1;
    padding: 3cqw;
  }
  .c-av-me {
    border-radius: 50%;
    background: var(--pink);
  }
  /* The problem, alone on stage until the call: gone in the finished picture. */
  .c-prob {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5cqw;
    visibility: hidden;
    animation: hw-prob 2.1s var(--ease-out) both;
  }
  @keyframes hw-prob {
    0% {
      visibility: visible;
      opacity: 0;
      transform: scale(0.7);
    }
    12%,
    84% {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    100% {
      visibility: hidden;
      opacity: 0;
      transform: scale(0.9);
    }
  }
  .c-chart {
    position: relative;
    width: 30cqw;
    padding: 2cqw;
  }
  .c-svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .c-grid {
    fill: none;
    stroke: rgb(10 13 51 / 0.14);
    stroke-width: 1;
  }
  .c-down {
    fill: none;
    stroke: var(--pink);
    stroke-width: 3.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    animation: hw-draw 0.9s var(--ease-out) 0.3s both;
  }
  @keyframes hw-draw {
    from {
      stroke-dashoffset: 100;
    }
  }
  .c-alarm {
    position: absolute;
    right: -2.6cqw;
    top: -2.6cqw;
    display: grid;
    width: 7cqw;
    height: 7cqw;
    padding: 1.3cqw;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 0 0.5cqw var(--navy);
    animation: hw-pop 0.4s var(--ease-pop) 1s both;
  }
  .c-ring {
    display: grid;
    place-items: center;
    width: 11cqw;
    aspect-ratio: 1;
    padding: 2.4cqw;
    border-radius: 50%;
    background: var(--navy);
    color: var(--lime);
    animation:
      hw-pop 0.4s var(--ease-pop) 1.15s both,
      hw-buzz 0.5s linear 1.4s 2;
  }
  .c-half {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 2.2cqw;
    padding: 0 3cqw 0 6.5cqw;
    animation: hw-in-l 0.5s var(--ease-pop) 1.9s both;
  }
  .c-me {
    animation-name: hw-in-r;
  }
  @keyframes hw-in-l {
    from {
      transform: translateX(-60cqw);
    }
  }
  @keyframes hw-in-r {
    from {
      transform: translateX(60cqw);
    }
  }
  .c-who {
    position: relative;
    margin-bottom: 0.6cqw;
  }
  .c-half .c-av {
    width: 11cqw;
    padding: 2.2cqw;
  }
  .c-tel {
    position: absolute;
    right: -2.6cqw;
    bottom: -2cqw;
    display: grid;
    width: 6cqw;
    height: 6cqw;
    padding: 1.2cqw;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 0.5cqw var(--navy);
    animation: hw-buzz 0.6s linear 2.4s 3;
  }
  .c-say {
    max-width: 38cqw;
    padding: 1.3cqw 2.2cqw;
    border-radius: 2.4cqw 2.4cqw 2.4cqw 0.4cqw;
    font-weight: 800;
    font-size: 2.9cqw;
    line-height: 1.15;
    font-stretch: 85%;
    transform-origin: 0 100%;
    animation: hw-pop 0.4s var(--ease-pop) both;
    animation-delay: calc(2.4s + var(--k) * 0.75s);
  }
  .c-note {
    display: grid;
    gap: 1.3cqw;
    min-width: 30cqw;
    padding: 3cqw 2.4cqw 2.2cqw;
    background:
      linear-gradient(var(--navy), var(--navy)) 0 0 / 100% 1.2cqw no-repeat,
      var(--ice);
    transform-origin: 0 0;
    animation: hw-pop 0.4s var(--ease-pop) 2.9s both;
  }
  .c-row {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    font-weight: 800;
    font-size: 2.6cqw;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    /* The typing reveal ends a little outside the row, so the check's ring isn't cut flat on the right. */
    clip-path: inset(-1cqw);
    animation: hw-line 0.45s steps(10, end) both;
    animation-delay: calc(3.3s + var(--k) * 0.5s);
  }
  .c-row :global(.ico) {
    flex: none;
    width: 3.6cqw;
    height: 3.6cqw;
  }
  /* A long label ("presupuesto") keeps clear of its check. */
  .c-l {
    margin-right: 1.6cqw;
  }
  .c-row b {
    flex: none;
    display: grid;
    margin-left: auto;
    width: 3.8cqw;
    height: 3.8cqw;
    padding: 0.6cqw;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 0.4cqw var(--navy);
  }
  .c-row b :global(.ico) {
    width: 100%;
    height: 100%;
  }

  /* Users: one person, one phone. The landing, then a long sign-up form where they give up; the form is cut down
     and they get through. The flow beside it ticks each screen off. */
  .u-row {
    gap: 7cqw;
  }
  .phone {
    position: relative;
    width: 20cqw;
    height: 40cqw;
    overflow: hidden;
    border-radius: 3cqw;
    background: var(--ice);
    box-shadow:
      0 0 0 0.9cqw var(--navy),
      1.6cqw 1.6cqw 0 0.9cqw var(--navy);
  }
  .notch {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 2;
    width: 7cqw;
    height: 1.8cqw;
    border-radius: 0 0 1.2cqw 1.2cqw;
    background: var(--navy);
    translate: -50% 0;
  }
  .scrn {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 4cqw 2cqw 2.4cqw;
    background: var(--ice);
    translate: 105% 0;
    animation: 4.4s var(--ease-out) both;
  }
  .scrn i {
    display: block;
    flex: none;
  }
  .s-a {
    animation-name: hw-sa;
  }
  .s-b {
    gap: 1.2cqw;
    animation-name: hw-sb;
  }
  .s-c {
    animation-name: hw-sc;
  }
  .s-d {
    align-items: center;
    justify-content: center;
    translate: 0 0;
    animation-name: hw-sd;
  }
  @keyframes hw-sa {
    0%,
    22% {
      translate: 0 0;
    }
    28%,
    100% {
      translate: -105% 0;
    }
  }
  @keyframes hw-sb {
    0%,
    22% {
      translate: 105% 0;
    }
    28%,
    58% {
      translate: 0 0;
    }
    64%,
    100% {
      translate: -105% 0;
    }
  }
  @keyframes hw-sc {
    0%,
    58% {
      translate: 105% 0;
    }
    64%,
    77% {
      translate: 0 0;
    }
    83%,
    100% {
      translate: -105% 0;
    }
  }
  @keyframes hw-sd {
    0%,
    77% {
      translate: 105% 0;
    }
    83%,
    100% {
      translate: 0 0;
    }
  }
  .s-hero {
    height: 12cqw;
    background: var(--c);
    box-shadow: inset 0 0 0 0.4cqw var(--navy);
  }
  .s-bar {
    width: 80%;
    height: 1.3cqw;
    background: rgb(10 13 51 / 0.3);
  }
  .s-short {
    width: 55%;
  }
  .s-title {
    width: 60%;
    height: 1.8cqw;
    background: var(--navy);
  }
  .s-field {
    height: 3cqw;
    box-shadow: inset 0 0 0 0.4cqw var(--navy);
  }
  .s-b .s-field {
    height: 2.6cqw;
  }
  .s-btn {
    height: 3.8cqw;
    margin-top: auto;
    background: var(--navy);
  }
  .s-done {
    display: grid;
    width: 11cqw;
    aspect-ratio: 1;
    padding: 2.4cqw;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 0.5cqw var(--navy);
  }
  .s-d .s-bar {
    width: 60%;
  }
  /* The person's finger: taps "next", hovers over the long form, gives up; comes back and gets through. */
  .finger {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: 7cqw;
    height: 7cqw;
    color: var(--navy);
    filter: drop-shadow(0.4cqw 0.4cqw 0 var(--ice));
    opacity: 0;
    animation: hw-finger 4.4s ease-in-out both;
  }
  @keyframes hw-finger {
    0% {
      opacity: 0;
      translate: 14cqw 44cqw;
    }
    10% {
      opacity: 1;
      translate: 7cqw 32cqw;
      scale: 1;
    }
    15% {
      scale: 0.8;
    }
    19% {
      scale: 1;
      translate: 7cqw 32cqw;
    }
    30% {
      opacity: 1;
      translate: 9cqw 18cqw;
    }
    38% {
      translate: 6cqw 22cqw;
    }
    44% {
      opacity: 0;
      translate: 24cqw 26cqw;
    }
    60% {
      opacity: 0;
      translate: 14cqw 44cqw;
    }
    68% {
      opacity: 1;
      translate: 7cqw 32cqw;
      scale: 1;
    }
    73% {
      scale: 0.8;
    }
    77% {
      opacity: 1;
      scale: 1;
      translate: 7cqw 32cqw;
    }
    84%,
    100% {
      opacity: 0;
      translate: 7cqw 32cqw;
    }
  }
  .flow {
    display: grid;
    gap: 2.6cqw;
    min-width: 44cqw;
    padding: 3cqw 3.4cqw;
  }
  .f-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.6cqw;
  }
  .f-ico {
    display: grid;
    flex: none;
    width: 5.4cqw;
    height: 5.4cqw;
    padding: 1.1cqw;
    background: var(--navy);
    color: var(--ice);
  }
  .f-l {
    font-size: 2.6cqw;
  }
  .f-ok,
  .f-x {
    display: grid;
    width: 4.6cqw;
    height: 4.6cqw;
    padding: 0.8cqw;
    border-radius: 50%;
    box-shadow: 0 0 0 0.45cqw var(--navy);
  }
  .f-ok {
    margin-left: auto;
    background: var(--lime);
    animation: hw-pop 0.4s var(--ease-pop) both;
  }
  .f-0 .f-ok {
    animation-delay: 1s;
  }
  .f-1 .f-ok {
    animation-delay: 2.8s;
  }
  .f-2 .f-ok {
    animation-delay: 3.6s;
  }
  .f-x {
    position: absolute;
    right: 0;
    background: var(--pink);
    transform: scale(0);
    animation: hw-x 4.4s both;
  }
  @keyframes hw-x {
    0%,
    42% {
      transform: scale(0);
    }
    46%,
    58% {
      transform: scale(1) rotate(-8deg);
    }
    62%,
    100% {
      transform: scale(0);
    }
  }
  /* Where they gave up: tagged, then struck through once fixed. */
  /* Clear of the check on its right, whatever the locale's word ("porzucenia" nearly touched it, 2026-10-08). */
  .f-tag {
    position: relative;
    margin-right: 1.6cqw;
    margin-left: 1cqw;
    padding: 0.2cqw 1cqw;
    background: var(--pink);
    font-style: normal;
    font-weight: 800;
    font-size: 2cqw;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    transform-origin: 0 50%;
    animation: hw-pop 0.35s var(--ease-pop) 1.9s both;
  }
  .f-tag::after {
    content: "";
    position: absolute;
    left: -0.4cqw;
    right: -0.4cqw;
    top: calc(50% - 0.2cqw);
    height: 0.45cqw;
    background: var(--navy);
    transform-origin: 0 50%;
    animation: hw-fill-x 0.3s ease-out 2.7s both;
  }

  /* Conversion: the steps between interest and action are struck out and fold away; one clear button is left. */
  .path {
    position: relative;
    display: flex;
    align-items: flex-start;
  }
  .path::before {
    content: "";
    position: absolute;
    left: 7cqw;
    right: 7cqw;
    top: 5.2cqw;
    height: 0.6cqw;
    background: repeating-linear-gradient(90deg, var(--navy) 0 1.6cqw, transparent 1.6cqw 3cqw);
  }
  /* The label clears the tile's hard shadow (1.7cqw), so accents ("interés", "acción") don't merge into its edge. */
  .p-node {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2.8cqw;
    width: 14cqw;
  }
  .p-ico {
    position: relative;
    display: grid;
    width: 11cqw;
    aspect-ratio: 1;
    padding: 2.6cqw;
  }
  .p-node small {
    max-width: 13cqw;
    text-align: center;
  }
  .p-x {
    position: absolute;
    right: -2cqw;
    top: -2cqw;
    display: grid;
    width: 5.4cqw;
    height: 5.4cqw;
    padding: 1cqw;
    border-radius: 50%;
    background: var(--navy);
    color: var(--c);
    animation: hw-pop 0.35s var(--ease-pop) both;
    animation-delay: calc(0.7s + var(--k) * 0.16s);
  }
  .p-mid {
    display: flex;
    justify-content: center;
    width: 0;
    opacity: 0;
    animation: hw-fold 3.4s var(--ease-out) both;
  }
  @keyframes hw-fold {
    0%,
    50% {
      width: 14cqw;
      opacity: 1;
      transform: none;
    }
    68%,
    100% {
      width: 0;
      opacity: 0;
      transform: scale(0.4);
    }
  }
  .p-cta {
    position: relative;
    display: flex;
    align-items: center;
    margin: 2cqw 1.5cqw 0;
    padding: 1.4cqw 2.6cqw;
    background: var(--navy);
    color: var(--ice);
    font-weight: 900;
    font-size: 2.8cqw;
    font-stretch: 80%;
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-transform: uppercase;
    animation: hw-cta 3.4s var(--ease-pop) both;
  }
  @keyframes hw-cta {
    0%,
    68% {
      max-width: 0;
      opacity: 0;
      transform: scale(0.5);
    }
    78%,
    100% {
      max-width: 40cqw;
      opacity: 1;
      transform: none;
    }
  }
  .p-cta :global(.p-tap) {
    position: absolute;
    right: -2.6cqw;
    bottom: -4cqw;
    width: 6cqw;
    height: 6cqw;
    color: var(--ice);
    filter: drop-shadow(0.35cqw 0.35cqw 0 var(--navy));
    animation:
      hw-pop 0.3s var(--ease-pop) 2.8s both,
      hw-press 0.3s ease-in-out 3.1s both;
  }
  .p-act .p-ico {
    background: var(--lime);
    animation: hw-lit 0.01s steps(1) 3.3s both;
  }
  .p-act .p-ico :global(.ico) {
    animation: hw-pop 0.4s var(--ease-pop) 3.3s both;
  }

  /* Revenue: a customer picks the paid plan and pays; the money lands with the business and its revenue grows. */
  .plan {
    position: relative;
    display: grid;
    gap: 1.6cqw;
    width: 22cqw;
    padding: 2.4cqw 2.4cqw 7cqw;
  }
  .plan-t {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 900;
    font-size: 3.4cqw;
    line-height: 1;
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .plan-t :global(.ico) {
    width: 3.6cqw;
    height: 3.6cqw;
    color: var(--orange);
  }
  .plan i {
    display: block;
  }
  .plan-p {
    width: 55%;
    height: 3cqw;
    background: var(--navy);
  }
  .plan-f {
    height: 1.2cqw;
    background: rgb(10 13 51 / 0.3);
  }
  .plan-f + .plan-f {
    width: 70%;
  }
  .ccard {
    position: absolute;
    left: 30%;
    bottom: -4cqw;
    width: 17cqw;
    aspect-ratio: 1.6;
    border-radius: 1.4cqw;
    background:
      linear-gradient(var(--navy), var(--navy)) 0 2.2cqw / 100% 2.4cqw no-repeat,
      var(--yellow);
    box-shadow: 0 0 0 0.45cqw var(--navy);
    rotate: -8deg;
    animation: hw-pay 1.1s var(--ease-pop) 0.4s both;
  }
  .ccard i {
    position: absolute;
    left: 1.6cqw;
    top: 5.8cqw;
    width: 3.4cqw;
    height: 2.6cqw;
    border-radius: 0.5cqw;
    background: var(--ice);
    box-shadow: inset 0 0 0 0.35cqw var(--navy);
  }
  @keyframes hw-pay {
    0% {
      transform: translate(-40cqw, 12cqw) rotate(-20deg);
    }
    60% {
      transform: translate(0, -2cqw);
    }
    75% {
      transform: translate(0, 1cqw);
    }
    100% {
      transform: none;
    }
  }
  .plan-paid {
    position: absolute;
    right: -3.4cqw;
    top: -3cqw;
    padding: 0.6cqw 1.6cqw;
