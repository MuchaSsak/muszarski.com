  /* Revenue: a card pays, the bars grow, a coin hops. */
  .ccard {
    position: relative;
    width: 26cqw;
    aspect-ratio: 1.6;
    border-radius: 1.8cqw;
    background:
      linear-gradient(var(--navy), var(--navy)) 0 3cqw / 100% 3.4cqw no-repeat,
