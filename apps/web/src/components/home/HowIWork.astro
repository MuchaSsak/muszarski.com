---
/**
 * How I work (structure.md § Home 3, requirements.md F06): the product loop. Seven stops on a ring, code is one of
 * them; each stop has a drawn scene (what the stop looks like in a real project, so it reads without reading [user
 * 2026-10-06]), one line and a receipt that links to its chapter. Every stop's text is in
 * the HTML (crawlable, readable without JS); the script shows one at a time, moves the dot along the ring and
 * advances while the section is visible (pauses on tap, the pause button and reduced motion).
 * A receipt whose project is hidden by the rights gate falls back to another true one.
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { visibleFlagships } from "~/data/projects";
import { type IconName } from "~/lib/icons.gen";
import { thisSitePath } from "~/lib/blog-paths";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const visible = new Set(visibleFlagships().map((project) => project.slug));
const caseStudy = thisSitePath(locale);

interface Receipt {
  project: string;
  text: string;
  href: string;
  color: string;
}
type Scene = "client" | "users" | "conversion" | "revenue" | "code" | "ship" | "measure";
interface Stop {
  icon: IconName;
  scene: Scene;
  name: string;
  line: string;
  receipt: Receipt;
  fallback?: Receipt;
  code?: boolean;
}

const STOPS: Stop[] = [
  {
    icon: "tb:briefcase",
    scene: "client",
    name: t`Client`,
    line: t`I start with the person paying for it, and what they need to earn.`,
    receipt: { project: "pstrykweb", text: t`PstrykWeb: built for Cetuspro and the businesses it serves.`, href: "#pstrykweb", color: "var(--yellow)" },
    fallback: { project: "linkoglot", text: t`Linkoglot: built for learners who pay for a plan.`, href: "#linkoglot", color: "var(--orange)" },
  },
  {
    icon: "tb:users",
    scene: "users",
    name: t`Users`,
    line: t`Who uses it, what they want done, and where they give up.`,
    receipt: { project: "linkoglot", text: t`Linkoglot: snap a photo, get flashcards and quizzes.`, href: "#linkoglot", color: "var(--orange)" },
  },
  {
    icon: "tb:target",
    scene: "conversion",
    name: t`Conversion`,
    line: t`Fewer steps between interest and a paid order.`,
    receipt: { project: "pstrykweb", text: t`PstrykWeb: a website, ordered through one online form.`, href: "#pstrykweb", color: "var(--yellow)" },
    fallback: { project: "linkoglot", text: t`Linkoglot: a free trial that leads into a plan.`, href: "#linkoglot", color: "var(--orange)" },
  },
  {
    icon: "tb:coins",
    scene: "revenue",
    name: t`Revenue`,
    line: t`How it earns is designed in from day one.`,
    receipt: {
      project: "linkoglot",
      text: t`Linkoglot: free trial, then monthly or yearly plans through RevenueCat.`,
      href: "#linkoglot",
      color: "var(--orange)",
    },
  },
  {
    icon: "tb:code",
    scene: "code",
    name: t`Code`,
    line: t`Then the code: web, mobile and backend, end to end, tested.`,
    receipt: {
      project: "neoteric-clockful",
      text: t`Clockful: 118 automated tests, row-level security on every table.`,
      href: "#clockful",
      color: "var(--lime)",
    },
    fallback: { project: "site", text: t`This site: checked on every change, 99+ on mobile Lighthouse.`, href: caseStudy, color: "var(--cobalt)" },
    code: true,
  },
  {
    icon: "tb:rocket",
    scene: "ship",
    name: t`Ship`,
    line: t`Shipping is part of the job: stores, reviews, releases.`,
    receipt: { project: "linkoglot", text: t`Linkoglot: through App Store and Google Play review.`, href: "#linkoglot", color: "var(--orange)" },
  },
  {
    icon: "tb:chart-line",
    scene: "measure",
    name: t`Measure`,
    line: t`Measure, then decide what changes next.`,
    receipt: { project: "space-portfolio", text: t`My old site scored 34 on mobile. So I rebuilt it.`, href: "#space", color: "var(--pink)" },
  },
];

const stops = STOPS.map((stop) => ({
  ...stop,
  receipt: visible.has(stop.receipt.project) || !stop.fallback ? stop.receipt : stop.fallback,
}));
const pad = (n: number) => String(n).padStart(2, "0");
const stopLabel = t({ message: "Stop", context: "a stop on the product loop, as in a bus stop" });
const [line1, line2] = t`Product|engineer`.split("|") as [string, string];
const plan = { trial: t`Free trial`, monthly: t`Monthly`, yearly: t`Yearly` };
---

<section class="sec field-alt how" id="how-i-work" aria-labelledby="t-how">
  <div class="sbar draw">
    <p>{t`How I work`}</p>
    <p>{t`Code is one stop of seven`}</p>
    <p>{t`Each with a receipt`}</p>
  </div>
  <Fit as="h2" id="t-how" lines={[line1, line2]} motion="calm" base={[90, 130]} />
  <div class="loop" data-loop>
    <div class="lp-ring" aria-hidden="true">
      <svg class="lp-svg" viewBox="0 0 500 500">
        <circle class="track" cx="250" cy="250" r="200"></circle>
        <circle class="trail" cx="250" cy="250" r="200" pathLength="700" transform="rotate(-90 250 250)"></circle>
        <g class="dot-arm"><circle class="dot" r="11" cx="250" cy="50"></circle></g>
      </svg>
      <div class="core">
        <span class="n tabular" data-core-n>01 / {pad(stops.length)}</span>
        {stops.map((stop, i) => <Icon name={stop.icon} data-core-icon={i} hidden={i > 0} />)}
        <span class="nm" data-core-nm>{stops[0]!.name}</span>
      </div>
    </div>
    <ol class="stops" aria-label={t`The loop`}>
      {
        stops.map((stop, i) => (
          <li class:list={["stop", { code: stop.code }]} style={`--i:${i}`}>
            <button class="stn" type="button" aria-pressed={i === 0 ? "true" : "false"} aria-controls={`stop-${i}`} data-stop={i}>
              <Icon name={stop.icon} />
              <span class="lbl">{stop.name}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <div class="panel">
      {
        stops.map((stop, i) => (
          <div class="pd enter" id={`stop-${i}`} data-pd={i}>
            <p class="kick k">
              {stopLabel} {pad(i + 1)} · {stop.name}
            </p>
            <div class={`scene sc-${stop.scene}`} style={`--c:${stop.receipt.color}`} aria-hidden="true">
              {stop.scene === "client" && (
                <div class="row">
                  <span class="tile enter">
                    <Icon name="tb:building-store" />
                  </span>
                  <span class="bubble enter">
                    <Icon name="tb:coins" class="coin" />
                    <Icon name="tb:trending-up" />
                  </span>
                </div>
              )}
              {stop.scene === "users" && (
                <div class="row">
                  <span class="phone enter">
                    <i class="vf" />
                    <Icon name="tb:camera" />
                    <i class="flash" />
                  </span>
                  <span class="fc">
                    {[0, 1, 2].map((k) => (
                      <i class="enter" style={`--k:${k}`} />
                    ))}
                  </span>
                </div>
              )}
              {stop.scene === "conversion" && (
                <div class="row">
                  <span class="form enter">
                    {[0, 1, 2].map((k) => (
                      <i style={`--k:${k}`} />
                    ))}
                    <b>
                      <Icon name="tb:hand-click" />
                    </b>
                  </span>
                  <span class="done enter">
                    <Icon name="tb:check" />
                  </span>
                </div>
              )}
              {stop.scene === "revenue" && (
                <div class="row">
                  <span class="chip enter">{plan.trial}</span>
                  <Icon name="tb:arrow-right" class="arw" />
                  <span class="plans">
                    <span class="plan enter" style="--k:0">
                      {plan.monthly}
                    </span>
                    <span class="plan best enter" style="--k:1">
                      {plan.yearly}
                    </span>
                  </span>
                  <span class="mark">
                    <Icon name="si:revenuecat" />
                  </span>
                </div>
              )}
              {stop.scene === "code" && (
                <div class="row">
                  <span class="term enter">
                    <span class="tbar">
                      <i />
                      <i />
                      <i />
                    </span>
                    {stop.receipt.project === "neoteric-clockful" ? (
                      <>
                        <span class="ln" style="--k:0">
                          <Icon name="si:vitest" />
                          vitest<b>49 <Icon name="tb:check" /></b>
                        </span>
                        <span class="ln" style="--k:1">
                          <span class="pw">Pw</span>
                          playwright<b>69 <Icon name="tb:check" /></b>
                        </span>
                        <span class="ln" style="--k:2">
                          <Icon name="tb:shield-lock" />
                          RLS<b>5/5</b>
                        </span>
                      </>
                    ) : (
                      <>
                        <span class="ln" style="--k:0">
                          <Icon name="si:typescript" />
                          typecheck<b><Icon name="tb:check" /></b>
                        </span>
                        <span class="ln" style="--k:1">
                          <span class="pw">Pw</span>
                          e2e + axe<b><Icon name="tb:check" /></b>
                        </span>
                        <span class="ln" style="--k:2">
                          <Icon name="tb:chart-line" />
                          Lighthouse<b>99+</b>
                        </span>
                      </>
                    )}
                  </span>
                  {stop.receipt.project === "neoteric-clockful" && <span class="big enter">118</span>}
                </div>
              )}
              {stop.scene === "ship" && (
                <div class="row">
                  <span class="stores">
                    <span class="store enter" style="--k:0">
                      <Icon name="si:apple" />
                      App Store
                      <i>
                        <Icon name="tb:check" />
                      </i>
                    </span>
                    <span class="store enter" style="--k:1">
                      <Icon name="si:googleplay" />
                      Google Play
                      <i>
                        <Icon name="tb:check" />
                      </i>
                    </span>
                  </span>
                  <span class="rocket">
                    <Icon name="tb:rocket" />
                  </span>
                </div>
              )}
              {stop.scene === "measure" && (
                <div class="row">
                  <span class="gauge low enter" style="--v:34">
                    <svg viewBox="0 0 40 40">
                      <circle class="g-bg" cx="20" cy="20" r="16" />
                      <circle class="g-fg" cx="20" cy="20" r="16" pathLength="100" transform="rotate(-90 20 20)" />
                    </svg>
                    <b class="tabular">34</b>
                  </span>
                  <Icon name="tb:arrow-right" class="arw" />
                  <span class="gauge high enter" style="--v:99">
                    <svg viewBox="0 0 40 40">
                      <circle class="g-bg" cx="20" cy="20" r="16" />
                      <circle class="g-fg" cx="20" cy="20" r="16" pathLength="100" transform="rotate(-90 20 20)" />
                    </svg>
                    <b class="tabular">99</b>
                  </span>
                </div>
              )}
            </div>
            <p class="s">{typo(locale, stop.line)}</p>
            <a class="receipt-row" href={stop.receipt.href} style={`--c:${stop.receipt.color}`}>
              <i aria-hidden="true" />
              <span>{stop.receipt.text}</span>
              <Icon name="tb:arrow-right" />
            </a>
          </div>
        ))
      }
      <p class="after">
        <Icon name="tb:refresh" />
        {t`Then back to the client, with numbers.`}
      </p>
    </div>
  </div>
</section>

<style>
  .loop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "ring panel";
    gap: clamp(1.75rem, 4vw, 5rem);
    align-items: center;
    margin-top: clamp(1.75rem, 3vw, 3rem);
  }
  .lp-ring,
  .stops {
    grid-area: ring;
    position: relative;
    width: min(100%, 35rem);
    aspect-ratio: 1;
    justify-self: center;
  }
  .lp-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .track {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-dasharray: 2 11;
    stroke-linecap: round;
    opacity: 0.55;
    animation: dash 30s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -260;
    }
  }
  .trail {
    fill: none;
    stroke: var(--loop-c);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: var(--frac, 0) 700;
    transition: stroke-dasharray 0.8s var(--ease-out);
  }
  .dot-arm {
    transform-origin: 250px 250px;
    transform: rotate(var(--ang, 0deg));
    transition: transform 0.8s var(--ease-out);
  }
  .dot {
    fill: var(--loop-c);
    stroke: currentColor;
    stroke-width: 3;
  }
  .how {
    --loop-c: var(--cobalt);
  }
  .core {
    position: absolute;
    inset: 24%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.375rem;
    text-align: center;
  }
  .core .n {
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    font-stretch: 125%;
  }
  .core :global(.ico) {
    width: clamp(2.125rem, 3.4vw, 3.25rem);
    height: clamp(2.125rem, 3.4vw, 3.25rem);
  }
  .core .nm {
    font-weight: 900;
    font-size: clamp(1.875rem, 3.6vw, 3.625rem);
    line-height: 0.85;
    font-stretch: 58%;
    text-transform: uppercase;
  }
  .stops {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stop {
    --a: calc(-90deg + var(--i) * 360deg / 7);
    position: absolute;
    left: calc(50% + 40% * cos(var(--a)));
    top: calc(50% + 40% * sin(var(--a)));
    transform: translate(-50%, -50%);
  }
  .stn {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(3.25rem, 5.4vw, 4.875rem);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--sbg);
    color: var(--sfg);
    box-shadow: inset 0 0 0 3px currentColor;
    cursor: pointer;
    transition:
      transform 0.45s var(--ease-pop),
      background-color var(--dur-base),
      color var(--dur-base);
  }
  .stn :global(.ico) {
    width: 46%;
    height: 46%;
  }
  .lbl {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.375rem);
    padding: 0.125rem 0.375rem;
    background: var(--sbg);
    color: var(--sfg);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: uppercase;
    font-stretch: 110%;
    transform: translateX(-50%);
  }
  .stn[aria-pressed="true"] {
    background: var(--sfg);
    color: var(--sbg);
    transform: scale(1.14);
  }
  .stn[aria-pressed="true"] :global(.ico) {
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-3px) rotate(-6deg);
    }
  }
  @media (hover: hover) {
    .stn:hover {
      transform: scale(1.08);
    }
  }
  .stop.code .stn {
    box-shadow:
      inset 0 0 0 3px currentColor,
      0 0 0 6px var(--sbg),
      0 0 0 8px currentColor;
  }

  .panel {
    grid-area: panel;
    display: grid;
    gap: 1.125rem;
    min-width: 0;
  }
  .pd {
    display: grid;
    gap: 1.125rem;
  }
  /* With the script, one stop at a time; without it, all seven read as a list. */
  :global(.js) .pd:not(.on) {
    display: none;
  }
  :global(.js) .pd.on {
    animation: swap 0.5s var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .k {
    margin: 0;
  }
  .s {
    margin: 0;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.7vw, 1.75rem);
    line-height: 1.1;
    font-stretch: 85%;
    text-wrap: balance;
  }

  /* The scene: a drawn moment of the stop in its project's colour. Sized in container units, so it scales as one
     picture. Entrances carry `.enter` (paused motion shows their last frame); text moves, it never fades. */
  .scene {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    container-type: inline-size;
    background: var(--c);
    color: var(--navy);
    box-shadow:
      0 0 0 3px var(--navy),
      12px 12px 0 3px var(--navy);
    font-size: 2.6cqw;
  }
  /* Paused or reduced motion: every scene shows its finished picture at once. */
  :global(.still) .scene * {
    animation: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .scene * {
      animation: none !important;
    }
  }
  .scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(10 13 51 / 0.16) 1.2px, transparent 1.7px) 0 0 / 3.5cqw 3.5cqw;
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5cqw;
  }
  .scene :global(.ico) {
    width: 100%;
    height: 100%;
  }
  .arw {
    flex: none;
    width: 6cqw !important;
    height: 6cqw !important;
  }
  .tile,
  .bubble,
  .phone,
  .fc i,
  .form,
  .chip,
  .plan,
  .term,
  .store,
  .gauge {
    background: var(--ice);
    box-shadow:
      0 0 0 0.5cqw var(--navy),
      1.4cqw 1.4cqw 0 0.5cqw var(--navy);
  }

  /* Client: the business, and what it needs to earn. */
  .tile {
    display: grid;
    place-items: center;
    width: 20cqw;
    aspect-ratio: 1;
    padding: 4cqw;
    animation: hw-pop 0.6s var(--ease-pop) both;
  }
  .bubble {
    position: relative;
    display: flex;
    gap: 2cqw;
    padding: 2.6cqw 3.4cqw;
    border-radius: 3cqw;
    transform-origin: 0 100%;
    animation: hw-pop 0.6s var(--ease-pop) 0.35s both;
  }
  .bubble :global(.ico) {
    width: 9cqw;
    height: 9cqw;
  }
  .bubble :global(.coin) {
    animation: hw-hop 1.4s ease-in-out 1s infinite;
  }
  .bubble::after {
    content: "";
    position: absolute;
    left: -2.6cqw;
    bottom: 1.8cqw;
    border: 1.6cqw solid transparent;
    border-right: 2.4cqw solid var(--navy);
    border-left: 0;
  }
  /* Navy pieces cast a see-through shadow (a navy one would read as a second box). */
  .phone,
  .term,
  .store {
    box-shadow: 1.4cqw 1.4cqw 0 rgb(10 13 51 / 0.35);
  }
  @keyframes hw-pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes hw-hop {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(-1.2cqw) rotate(-10deg);
    }
  }

  /* Users: snap a photo, get flashcards. */
  .phone {
    position: relative;
    display: grid;
    place-items: center;
    width: 15cqw;
    aspect-ratio: 9 / 16;
    padding: 4cqw 3.5cqw;
    border-radius: 2.4cqw;
    background: var(--navy);
    color: var(--ice);
    animation: hw-pop 0.5s var(--ease-pop) both;
  }
  .vf {
    position: absolute;
    inset: 3.5cqw 2.5cqw;
    background:
      linear-gradient(var(--ice), var(--ice)) 0 0 / 2.4cqw 0.5cqw no-repeat,
      linear-gradient(var(--ice), var(--ice)) 0 0 / 0.5cqw 2.4cqw no-repeat,
      linear-gradient(var(--ice), var(--ice)) 100% 100% / 2.4cqw 0.5cqw no-repeat,
      linear-gradient(var(--ice), var(--ice)) 100% 100% / 0.5cqw 2.4cqw no-repeat;
  }
  .flash {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #fff;
    opacity: 0;
    animation: hw-flash 0.5s ease-out 0.55s;
  }
  @keyframes hw-flash {
    20% {
      opacity: 0.95;
    }
  }
  .fc {
    position: relative;
    width: 30cqw;
    height: 22cqw;
  }
  .fc i {
    --r: calc((var(--k) - 1) * 8deg);
    position: absolute;
    left: 4cqw;
    top: 3cqw;
    width: 22cqw;
    height: 14cqw;
    background:
      linear-gradient(var(--navy), var(--navy)) 2.5cqw 3cqw / 10cqw 1cqw no-repeat,
      linear-gradient(rgb(10 13 51 / 0.35), rgb(10 13 51 / 0.35)) 2.5cqw 6.5cqw / 15cqw 0.8cqw no-repeat,
      linear-gradient(rgb(10 13 51 / 0.35), rgb(10 13 51 / 0.35)) 2.5cqw 9cqw / 12cqw 0.8cqw no-repeat,
      var(--ice);
    transform: translate(calc(var(--k) * 2.5cqw), calc((var(--k) - 1) * 2.5cqw)) rotate(var(--r));
    animation: hw-deal 0.6s var(--ease-pop) both;
    animation-delay: calc(0.9s + var(--k) * 0.16s);
  }
  @keyframes hw-deal {
    from {
      transform: translateX(-22cqw) scale(0) rotate(0deg);
    }
  }

  /* Conversion: one short form, one tap, done. */
  .form {
    display: grid;
    gap: 2.2cqw;
    width: 34cqw;
    padding: 3.4cqw;
    animation: hw-pop 0.5s var(--ease-pop) both;
  }
  .form i {
    height: 3.4cqw;
    box-shadow: inset 0 0 0 0.45cqw var(--navy);
    background: linear-gradient(rgb(10 13 51 / 0.35), rgb(10 13 51 / 0.35)) 1.4cqw 50% / 60% 1cqw no-repeat;
    animation: hw-type 0.5s ease-out both;
    animation-delay: calc(0.35s + var(--k) * 0.35s);
  }
  @keyframes hw-type {
    from {
      background-size: 0 1cqw;
    }
  }
  .form b {
    display: grid;
    place-items: center;
    height: 6cqw;
    background: var(--navy);
    color: var(--c);
    animation: hw-press 0.4s ease-in-out 1.5s both;
  }
  .form b :global(.ico) {
    width: 4cqw;
    height: 4cqw;
