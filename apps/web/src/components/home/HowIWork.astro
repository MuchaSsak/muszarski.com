  .dest {
    display: grid;
    place-items: center;
    width: 8.5cqw;
    height: 8.5cqw;
    padding: 2cqw;
    border-radius: 50%;
    animation: hw-pop 0.45s var(--ease-pop) both;
    animation-delay: calc(1.55s + var(--k) * 0.12s);
