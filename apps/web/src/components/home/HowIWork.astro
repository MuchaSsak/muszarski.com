  .ln {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 0 2.6cqw;
    clip-path: inset(0 0 0 0);
    animation: hw-line 0.45s steps(12, end) both;
    animation-delay: calc(0.45s + var(--k) * 0.4s);
  }
  .ln :global(.ico) {
    flex: none;
    width: 3.4cqw;
    height: 3.4cqw;
