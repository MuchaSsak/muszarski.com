  .pr {
    position: relative;
    width: 15cqw;
    height: 15cqw;
    padding: 3cqw;
    transform: rotate(5deg);
    animation: hw-pop-tilt-r 0.6s var(--ease-pop) 1.75s both;
  }
  .pr i {
    position: absolute;
    right: -2.4cqw;
    bottom: -2.4cqw;
    width: 6.4cqw;
    height: 6.4cqw;
    padding: 1.1cqw;
