---
/**
 * How I work (structure.md § Home 3, requirements.md F06): the loop I run on every project, web, mobile or backend.
 * Seven stops on a ring, code is one of them. Each stop is a drawn scene (the stop as a picture, so it reads without
 * reading), one line and the practices behind it. Generic on purpose [user 2026-10-06: "more general", no project
 * receipts; shipping is pipelines, the web and the stores, not only app review]. Every stop's text is in the HTML
 * (crawlable, readable without JS); the script shows one at a time, moves the dot along the ring and advances while
 * the section is visible (pauses on tap, the pause button and reduced motion).
 */
import { t } from "lingui-for-astro/macro";

import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { type IconName } from "~/lib/icons.gen";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;

type Scene = "client" | "users" | "conversion" | "revenue" | "code" | "ship" | "measure";
interface Stop {
  icon: IconName;
  scene: Scene;
  /** The scene's colour. */
  color: string;
  name: string;
  line: string;
  /** What I do at this stop, as short chips; a tool's mark where a real tool does the job. */
  does: { label: string; icon?: IconName }[];
  code?: boolean;
}

const STOPS: Stop[] = [
  {
    icon: "tb:briefcase",
    scene: "client",
    color: "var(--yellow)",
    name: t`Client`,
    line: t`I start with the person paying for it, and what they need to earn.`,
    does: [{ label: t`goals in numbers` }, { label: t`budget` }, { label: t`deadline` }],
  },
  {
    icon: "tb:users",
    scene: "users",
    color: "var(--orange)",
    name: t`Users`,
    line: t`Who uses it, what they want done, and where they give up.`,
    does: [{ label: t`user flows` }, { label: t`real app references` }, { label: t`drop-off points` }],
  },
  {
    icon: "tb:target",
    scene: "conversion",
    color: "var(--pink)",
    name: t`Conversion`,
    line: t`Fewer steps between interest and action.`,
    does: [{ label: t`one clear CTA` }, { label: t`short forms` }, { label: t`fast pages` }],
  },
  {
    icon: "tb:coins",
    scene: "revenue",
    color: "var(--lime)",
    name: t`Revenue`,
    line: t`How it earns is designed in from day one.`,
    does: [{ label: t`pricing` }, { label: t`payments`, icon: "tb:credit-card" }, { label: "RevenueCat", icon: "si:revenuecat" }],
  },
  {
    icon: "tb:code",
    scene: "code",
    color: "var(--cobalt)",
    name: t`Code`,
    line: t`Then the code: web, mobile and backend, end to end, tested.`,
    does: [
      { label: "TypeScript", icon: "si:typescript" },
      { label: t`automated tests`, icon: "tb:test-pipe" },
      { label: t`code review`, icon: "tb:git-pull-request" },
    ],
    code: true,
  },
  {
    icon: "tb:rocket",
    scene: "ship",
    color: "var(--yellow)",
    name: t`Ship`,
    line: t`Shipping is part of the job: pipelines, deploys, store releases.`,
    does: [
      { label: "GitLab CI/CD", icon: "si:gitlab" },
      { label: "Vercel", icon: "si:vercel" },
      { label: t`App Store and Google Play`, icon: "tb:device-mobile" },
      { label: "Search Console", icon: "si:googlesearchconsole" },
    ],
  },
  {
    icon: "tb:chart-line",
    scene: "measure",
    color: "var(--pink)",
    name: t`Measure`,
    line: t`Measure, then decide what changes next.`,
    does: [
      { label: t`analytics`, icon: "si:umami" },
      { label: "Lighthouse", icon: "si:lighthouse" },
      { label: t`user feedback` },
    ],
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
const stopLabel = t({ message: "Stop", context: "a stop on the product loop, as in a bus stop" });
const [line1, line2] = t`Product|engineer`.split("|") as [string, string];
/** The ship scene's pipeline. */
const pipeline: { icon: IconName; label: string }[] = [
  { icon: "tb:hammer", label: t`build` },
  { icon: "tb:test-pipe", label: t`test` },
  { icon: "tb:rocket", label: t`deploy` },
];
/** Where a release lands: the web, both stores, Google. */
const DESTS: IconName[] = ["tb:world", "si:apple", "si:googleplay", "si:google"];
---

<section class="sec field-alt how" id="how-i-work" aria-labelledby="t-how">
  <div class="sbar draw">
    <p>{t`How I work`}</p>
    <p>{t`Code is one stop of seven`}</p>
    <p>{t`The same loop on every project`}</p>
  </div>
  <Fit as="h2" id="t-how" lines={[line1, line2]} motion="calm" base={[90, 130]} />
  <div class="loop" data-loop>
    <div class="lp-ring" aria-hidden="true">
      <svg class="lp-svg" viewBox="0 0 500 500">
        <circle class="track" cx="250" cy="250" r="200"></circle>
        <circle class="trail" cx="250" cy="250" r="200" pathLength="700" transform="rotate(-90 250 250)"></circle>
        <g class="dot-arm">
          <circle class="dot" r="11" cx="250" cy="50"></circle>
        </g>
      </svg>
      <div class="core">
        <span class="n tabular" data-core-n>
          01 / {pad(STOPS.length)}
        </span>
        {STOPS.map((stop, i) => (
          <Icon name={stop.icon} data-core-icon={i} hidden={i > 0} />
        ))}
        <span class="nm" data-core-nm>
          {STOPS[0]!.name}
        </span>
      </div>
    </div>
    <ol class="stops" aria-label={t`The loop`}>
      {STOPS.map((stop, i) => (
        <li class:list={["stop", { code: stop.code }]} style={`--i:${i}`}>
          <button class="stn" type="button" aria-pressed={i === 0 ? "true" : "false"} aria-controls={`stop-${i}`} data-stop={i}>
            <Icon name={stop.icon} />
            <span class="lbl">{stop.name}</span>
          </button>
        </li>
      ))}
    </ol>
    <div class="panel">
      {STOPS.map((stop, i) => (
        <div class="pd enter" id={`stop-${i}`} data-pd={i}>
          <p class="kick k">
            {stopLabel} {pad(i + 1)} · {stop.name}
          </p>
          <div class={`scene sc-${stop.scene}`} style={`--c:${stop.color}`} aria-hidden="true">
            {stop.scene === "client" && (
              <div class="row">
                <span class="tile enter">
                  <Icon name="tb:building-store" />
                </span>
                <span class="bubble enter">
                  <Icon name="tb:coins" class="coin" />
                  <Icon name="tb:trending-up" />
                </span>
              </div>
            )}
            {stop.scene === "users" && (
              <div class="journey">
                {[0, 1, 2].map((k) => (
                  <span class="scr enter" style={`--k:${k};--ok:${[0.6, 2.05, 3.45][k]}s`}>
                    {k === 1 && <Icon name="tb:alert-triangle" class="warn" />}
                    <Icon name="tb:check" class="ok" />
                  </span>
                ))}
                <span class="walker">
                  <Icon name="tb:user" />
                </span>
              </div>
            )}
            {stop.scene === "conversion" && (
              <div class="row">
                <span class="form enter">
                  {[0, 1, 2].map((k) => (
                    <i style={`--k:${k}`} />
                  ))}
                  <b>
                    <Icon name="tb:hand-click" />
                  </b>
                </span>
                <span class="done enter">
                  <Icon name="tb:check" />
                </span>
              </div>
            )}
            {stop.scene === "revenue" && (
              <div class="row">
                <span class="ccard enter">
                  <i />
                </span>
                <Icon name="tb:arrow-right" class="arw" />
                <span class="bars">
                  {[0, 1, 2, 3].map((k) => (
                    <i style={`--k:${k}`} />
                  ))}
                  <Icon name="tb:coins" class="coin" />
                </span>
              </div>
            )}
            {stop.scene === "code" && (
              <div class="row">
                <span class="term enter">
                  <span class="tbar">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="ln" style="--k:0">
                    <Icon name="si:typescript" />
                    typecheck
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="ln" style="--k:1">
                    <Icon name="tb:test-pipe" />
                    unit tests
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                  <span class="ln" style="--k:2">
                    <Icon name="mk:playwright" />
                    e2e + a11y
                    <b>
                      <Icon name="tb:check" />
                    </b>
                  </span>
                </span>
                <span class="pr enter">
                  <Icon name="tb:git-pull-request" />
                  <i>
                    <Icon name="tb:check" />
                  </i>
                </span>
              </div>
            )}
            {stop.scene === "ship" && (
              <div class="launch">
                <span class="pipe">
                  {pipeline.map((step, k) => (
                    <span class="step" style={`--k:${k}`}>
                      <span class="stage">
                        <Icon name={step.icon} />
                      </span>
                      <small>{step.label}</small>
                    </span>
                  ))}
                </span>
                <span class="dests">
                  {DESTS.map((icon, k) => (
                    <span class="dest" style={`--k:${k}`}>
                      <Icon name={icon} />
                    </span>
                  ))}
                </span>
              </div>
            )}
            {stop.scene === "measure" && (
              <div class="row">
                <span class="chart enter">
                  <svg class="c-svg" viewBox="0 0 100 60">
                    <path class="c-grid" d="M0 15H100M0 30H100M0 45H100" />
                    <polyline class="c-line" points="5,52 22,43 38,46 55,30 72,25 93,9" pathLength="100" />
                    <circle class="c-dot" cx="93" cy="9" r="3.4" />
                  </svg>
                </span>
                <span class="gauge enter" style="--v:96">
                  <svg class="g-ring" viewBox="0 0 40 40">
                    <circle class="g-bg" cx="20" cy="20" r="16" />
                    <circle class="g-fg" cx="20" cy="20" r="16" pathLength="100" transform="rotate(-90 20 20)" />
                  </svg>
                  <Icon name="tb:check" class="g-ok" />
                </span>
              </div>
            )}
          </div>
          <p class="s">{typo(locale, stop.line)}</p>
          <ul class="does" role="list">
            {stop.does.map((item) => (
              <li>
                {item.icon && <Icon name={item.icon} />}
                {item.label}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="after">
        <Icon name="tb:refresh" />
        {t`Then back to the client, with numbers.`}
      </p>
    </div>
  </div>
</section>

<style>
  .loop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "ring panel";
    gap: clamp(1.75rem, 4vw, 5rem);
    align-items: center;
    margin-top: clamp(1.75rem, 3vw, 3rem);
  }
  .lp-ring,
  .stops {
    grid-area: ring;
    position: relative;
    width: min(100%, 35rem);
    aspect-ratio: 1;
    justify-self: center;
  }
  .lp-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .track {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-dasharray: 2 11;
    stroke-linecap: round;
    opacity: 0.55;
    animation: dash 30s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -260;
    }
  }
  .trail {
    fill: none;
    stroke: var(--loop-c);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: var(--frac, 0) 700;
    transition: stroke-dasharray 0.8s var(--ease-out);
  }
  .dot-arm {
    transform-origin: 250px 250px;
    transform: rotate(var(--ang, 0deg));
    transition: transform 0.8s var(--ease-out);
  }
  .dot {
    fill: var(--loop-c);
    stroke: currentColor;
    stroke-width: 3;
  }
  .how {
    --loop-c: var(--cobalt);
  }
  .core {
    position: absolute;
    inset: 24%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.375rem;
    text-align: center;
  }
  .core .n {
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    font-stretch: 125%;
  }
  .core :global(.ico) {
    width: clamp(2.125rem, 3.4vw, 3.25rem);
    height: clamp(2.125rem, 3.4vw, 3.25rem);
  }
  .core .nm {
    font-weight: 900;
    font-size: clamp(1.875rem, 3.6vw, 3.625rem);
    line-height: 0.85;
    font-stretch: 58%;
    text-transform: uppercase;
  }
  .stops {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stop {
    --a: calc(-90deg + var(--i) * 360deg / 7);
    position: absolute;
    left: calc(50% + 40% * cos(var(--a)));
    top: calc(50% + 40% * sin(var(--a)));
    transform: translate(-50%, -50%);
  }
  .stn {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(3.25rem, 5.4vw, 4.875rem);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--sbg);
    color: var(--sfg);
    box-shadow: inset 0 0 0 3px currentColor;
    cursor: pointer;
    transition:
      transform 0.45s var(--ease-pop),
      background-color var(--dur-base),
      color var(--dur-base);
  }
  .stn :global(.ico) {
    width: 46%;
    height: 46%;
  }
  .lbl {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.375rem);
    padding: 0.125rem 0.375rem;
    background: var(--sbg);
    color: var(--sfg);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: uppercase;
    font-stretch: 110%;
    transform: translateX(-50%);
  }
  .stn[aria-pressed="true"] {
    background: var(--sfg);
    color: var(--sbg);
    transform: scale(1.14);
  }
  .stn[aria-pressed="true"] :global(.ico) {
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-3px) rotate(-6deg);
    }
  }
  @media (hover: hover) {
    .stn:hover {
      transform: scale(1.08);
    }
  }
  .stop.code .stn {
    box-shadow:
      inset 0 0 0 3px currentColor,
      0 0 0 6px var(--sbg),
      0 0 0 8px currentColor;
  }

  .panel {
    grid-area: panel;
    display: grid;
    gap: 1.125rem;
    min-width: 0;
  }
  .pd {
    display: grid;
    gap: 1.125rem;
  }
  /* With the script, one stop at a time; without it, all seven read as a list. */
  :global(.js) .pd:not(.on) {
    display: none;
  }
  :global(.js) .pd.on {
    animation: swap 0.5s var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .k {
    margin: 0;
  }
  .s {
    margin: 0;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.7vw, 1.75rem);
    line-height: 1.1;
    font-stretch: 85%;
    text-wrap: balance;
  }

  /* The scene: a drawn moment of the stop in its project's colour. Sized in container units, so it scales as one
     picture. Entrances carry `.enter` (paused motion shows their last frame); text moves, it never fades. */
  .scene {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    container-type: inline-size;
    background: var(--c);
    color: var(--navy);
    box-shadow:
      0 0 0 3px var(--navy),
      12px 12px 0 3px var(--navy);
    font-size: 2.6cqw;
  }
  /* Paused or reduced motion: every scene shows its finished picture at once. */
  :global(.still) .scene * {
    animation: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .scene * {
      animation: none !important;
    }
  }
  .scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(10 13 51 / 0.16) 1.2px, transparent 1.7px) 0 0 / 3.5cqw 3.5cqw;
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5cqw;
  }
  .scene :global(.ico) {
    width: 100%;
    height: 100%;
  }
  .arw {
    flex: none;
    width: 6cqw !important;
    height: 6cqw !important;
  }
  .tile,
  .bubble,
  .scr,
  .form,
  .ccard,
  .pr,
  .dest,
  .chart,
  .gauge {
    background: var(--ice);
    box-shadow:
      0 0 0 0.5cqw var(--navy),
      1.4cqw 1.4cqw 0 0.5cqw var(--navy);
  }

  /* Client: the business, and what it needs to earn. */
  .tile {
    display: grid;
    place-items: center;
    width: 20cqw;
    aspect-ratio: 1;
    padding: 4cqw;
    animation: hw-pop 0.6s var(--ease-pop) both;
  }
  .bubble {
    position: relative;
    display: flex;
    gap: 2cqw;
    padding: 2.6cqw 3.4cqw;
    border-radius: 3cqw;
    transform-origin: 0 100%;
    animation: hw-pop 0.6s var(--ease-pop) 0.35s both;
  }
  .bubble :global(.ico) {
    width: 9cqw;
    height: 9cqw;
  }
  .bubble :global(.coin) {
    animation: hw-hop 1.4s ease-in-out 1s infinite;
  }
  .bubble::after {
    content: "";
    position: absolute;
    left: -2.6cqw;
    bottom: 1.8cqw;
    border: 1.6cqw solid transparent;
    border-right: 2.4cqw solid var(--navy);
    border-left: 0;
  }
  /* Navy pieces cast a see-through shadow (a navy one would read as a second box). */
  .term,
  .walker,
  .stage {
    box-shadow: 1.4cqw 1.4cqw 0 rgb(10 13 51 / 0.35);
  }
  @keyframes hw-pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes hw-hop {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(-1.2cqw) rotate(-10deg);
    }
  }

  /* Users: someone walks through three screens; the middle one stops them, then it is fixed. */
  .journey {
    position: relative;
    display: flex;
    gap: 7cqw;
    padding-top: 10cqw;
  }
  .journey::before {
    content: "";
    position: absolute;
    left: 7.5cqw;
    right: 7.5cqw;
    top: calc(10cqw + 11cqw);
    height: 0.6cqw;
    background: repeating-linear-gradient(90deg, var(--navy) 0 1.6cqw, transparent 1.6cqw 3cqw);
  }
  .scr {
    position: relative;
    width: 15cqw;
    height: 22cqw;
    border-radius: 1.4cqw;
    background:
      linear-gradient(var(--navy), var(--navy)) 0 0 / 100% 3.2cqw no-repeat,
      linear-gradient(rgb(10 13 51 / 0.3), rgb(10 13 51 / 0.3)) 2cqw 6.2cqw / 9cqw 1cqw no-repeat,
      linear-gradient(rgb(10 13 51 / 0.3), rgb(10 13 51 / 0.3)) 2cqw 9cqw / 6.5cqw 1cqw no-repeat,
      linear-gradient(var(--c), var(--c)) 2cqw 15cqw / 11cqw 3.6cqw no-repeat,
      var(--ice);
    animation: hw-pop 0.45s var(--ease-pop) both;
    animation-delay: calc(var(--k) * 0.14s);
  }
  .scr :global(.ico) {
    position: absolute;
    right: -2.4cqw;
    top: -2.4cqw;
    width: 6.4cqw;
    height: 6.4cqw;
    padding: 1.1cqw;
    border-radius: 50%;
    color: var(--navy);
    box-shadow: 0 0 0 0.5cqw var(--navy);
  }
  .scr :global(.ok) {
    background: var(--lime);
    animation: hw-pop 0.45s var(--ease-pop) var(--ok) both;
  }
  .scr :global(.warn) {
    z-index: 1;
    background: var(--pink);
    transform: scale(0);
    animation: hw-warn 0.95s ease-in-out 1.15s both;
  }
  @keyframes hw-warn {
    0% {
      transform: scale(0);
    }
    18%,
    78% {
      transform: scale(1) rotate(-8deg);
    }
    100% {
      transform: scale(0);
    }
  }
  .walker {
    position: absolute;
    left: 3cqw;
    top: 0;
    display: grid;
    place-items: center;
    width: 9cqw;
    height: 9cqw;
    padding: 2cqw;
    border-radius: 50%;
    background: var(--navy);
    color: var(--ice);
    transform: translateX(44cqw);
    animation: hw-walk 3s ease-in-out 0.45s both;
  }
  @keyframes hw-walk {
    0% {
      transform: translateX(0);
    }
    25%,
    58% {
      transform: translateX(22cqw);
    }
    100% {
      transform: translateX(44cqw);
    }
  }

  /* Conversion: one short form, one tap, done. */
  .form {
    display: grid;
    gap: 2.2cqw;
    width: 34cqw;
    padding: 3.4cqw;
    animation: hw-pop 0.5s var(--ease-pop) both;
  }
  .form i {
    height: 3.4cqw;
    box-shadow: inset 0 0 0 0.45cqw var(--navy);
    background: linear-gradient(rgb(10 13 51 / 0.35), rgb(10 13 51 / 0.35)) 1.4cqw 50% / 60% 1cqw no-repeat;
    animation: hw-type 0.5s ease-out both;
    animation-delay: calc(0.35s + var(--k) * 0.35s);
  }
  @keyframes hw-type {
    from {
      background-size: 0 1cqw;
    }
  }
  .form b {
    display: grid;
    place-items: center;
    height: 6cqw;
    background: var(--navy);
    color: var(--c);
    animation: hw-press 0.4s ease-in-out 1.5s both;
  }
  .form b :global(.ico) {
    width: 4cqw;
    height: 4cqw;
  }
  @keyframes hw-press {
    50% {
