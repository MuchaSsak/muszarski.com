<script>
  import { motionStill } from "~/scripts/motion";

  for (const loop of document.querySelectorAll<HTMLElement>("[data-loop]")) {
    const buttons = [...loop.querySelectorAll<HTMLButtonElement>("[data-stop]")];
    const details = [...loop.querySelectorAll<HTMLElement>("[data-pd]")];
    const icons = [...loop.querySelectorAll<SVGElement>("[data-core-icon]")];
    const coreN = loop.querySelector<HTMLElement>("[data-core-n]")!;
    const coreNm = loop.querySelector<HTMLElement>("[data-core-nm]")!;
    const n = buttons.length;
    const pad = (v: number) => String(v).padStart(2, "0");
    let current = 0;
    let turns = 0;
    let visible = false;
    let holdUntil = 0;
    let shownAt = performance.now();
    const DWELL = 6400;

    const show = (i: number, byUser: boolean) => {
      if (i < current) turns += 1;
      current = i;
      buttons.forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
      // Re-showing a stop restarts its scene.
      details.forEach((d) => d.classList.remove("on"));
      void loop.offsetWidth;
      details[i]!.classList.add("on");
      icons.forEach((icon, j) => icon.toggleAttribute("hidden", j !== i));
      coreN.textContent = `${pad(i + 1)} / ${pad(n)}`;
      coreNm.textContent = buttons[i]!.querySelector(".lbl")!.textContent;
      loop.style.setProperty("--ang", `${(turns * n + i) * (360 / n)}deg`);
      loop.style.setProperty("--frac", String((i / n) * 700 + 0.001));
      shownAt = performance.now();
      if (byUser) holdUntil = shownAt + 9000;
      // The bar under the kicker counts down to the next stop.
      const pd = details[i]!;
      pd.classList.remove("timing");
      void pd.offsetWidth;
      loop.style.setProperty("--dwell", `${byUser ? 9 : DWELL / 1000}s`);
      pd.classList.add("timing");
    };
    buttons.forEach((b, i) => b.addEventListener("click", () => show(i, true)));
    // The first stop is already shown in the markup; nothing runs on load (a `show` here forced two layouts and
    // restyled the section while it was still offscreen). Coming into view plays it from its start.

    // Coming into view plays the current stop from its start, so its story and its bar are seen whole.
    new IntersectionObserver(
      ([entry]) => {
        const was = visible;
        visible = !!entry?.isIntersecting;
        if (visible && !was && performance.now() > holdUntil) show(current, false);
      },
      { threshold: 0.4 },
    ).observe(loop);
    // Each stop's scene is a short story (up to ~5 s): it stays up a little longer than that.
    setInterval(() => {
      const now = performance.now();
      if (!visible || motionStill() || document.hidden || now < holdUntil || now - shownAt < DWELL) return;
      show((current + 1) % n, false);
    }, 250);
  }
</script>
