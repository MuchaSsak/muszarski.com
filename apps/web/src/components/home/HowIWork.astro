  /* The link to the next stage fills in as the work moves on. */
  .step + .step::before {
    content: "";
    position: absolute;
    right: calc(100% + 0.8cqw);
    top: 5.4cqw;
    width: 5.4cqw;
    height: 0.8cqw;
    background: var(--navy);
    transform-origin: 0 50%;
    animation: hw-fill-x 0.3s ease-out both;
    animation-delay: calc(var(--k) * 0.5s);
  }
  @keyframes hw-fill-x {
    from {
      transform: scaleX(0);
    }
  }
  .stage {
    display: grid;
    place-items: center;
    width: 11cqw;
    height: 11cqw;
    padding: 2.6cqw;
    background: var(--navy);
    color: var(--lime);
    animation:
      hw-pop 0.4s var(--ease-pop) both,
      hw-lit 0.01s steps(1) both;
    animation-delay: calc(var(--k) * 0.5s), calc(0.35s + var(--k) * 0.5s);
  }
  @keyframes hw-lit {
    from {
      background: var(--ice);
      color: var(--navy);
    }
  }
  .dests {
    display: flex;
    gap: 3cqw;
    padding-top: 3cqw;
    border-top: 0.6cqw dashed var(--navy);
