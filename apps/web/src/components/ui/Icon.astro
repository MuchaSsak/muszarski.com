---
/**
 * One icon. Names come from `bun run icons` (scripts/icons.mjs):
 * `si:*` tool marks (Simple Icons, CC0; one colour, unaltered, nominative use) and `tb:*` UI icons (Tabler, MIT).
 * Decorative by default; pass `label` when the icon is the only content of a control.
 * By default the icon is a `<use>` reference into the site sprite (`~/lib/sprite`): one cached file instead of paths
 * in every page's HTML. Icons on the first screen (header, hero) pass `inline`, so they paint with the page and never
 * wait for the sprite.
 */
import type { HTMLAttributes } from "astro/types";

import { type IconName, ICONS } from "~/lib/icons.gen";
import { SPRITE_HREF, symbolId } from "~/lib/sprite";

interface Props extends Omit<HTMLAttributes<"svg">, "name" | "class"> {
  name: IconName;
  class?: string | undefined;
  label?: string | undefined;
  hidden?: boolean | undefined;
  /** Inline the path instead of referencing the sprite: for icons on the first screen. */
  inline?: boolean;
  [key: `data-${string}`]: unknown;
}

const { name, class: className, label, inline = false, ...rest } = Astro.props;
const icon = ICONS[name];
const paint = icon.stroke
  ? ({
      fill: "none",
      stroke: "currentColor",
      "stroke-width": "1.8",
      "stroke-linecap": "round",
      "stroke-linejoin": "round",
    } as const)
  : ({ fill: "currentColor" } as const);
---

<svg
  class:list={["ico", className]}
  viewBox={icon.viewBox}
  focusable="false"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  {...paint}
  {...rest}
  set:html={inline ? icon.body : `<use href="${SPRITE_HREF}#${symbolId(name)}"></use>`}
/>
