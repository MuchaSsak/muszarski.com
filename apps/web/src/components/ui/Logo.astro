---
/**
 * The logo [user 2026-10-06: "make logo consistent"; 2026-10-08: the Jinx pixel-art avatar he uses on his social
 * accounts replaces the M tile]: one mark everywhere (header, footer, favicon, share images, the blog's author box).
 * The picture is public/favicon.svg itself, loaded as a cached image so the pixel paths stay out of every page's HTML.
 * Decorative: the link around it carries the name.
 */
interface Props {
  class?: string | undefined;
}
const { class: className } = Astro.props;
---

<img class:list={["logo", className]} src="/favicon.svg" alt="" width="64" height="64" decoding="async" />
