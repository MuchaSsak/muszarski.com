---
/**
 * Applies the reader's stored theme before first paint (no flash). The choice is a per-viewer
 * convenience in localStorage; without it the system preference wins (design.md § Theme switch).
 * Storage can throw (private mode, blocked site data), so every access is guarded.
 */
---

<script is:inline>
  (() => {
    try {
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    } catch {}
  })();
</script>
