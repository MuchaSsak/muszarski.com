---
/**
 * Light (drafting paper) ↔ dark (cyanotype). Default = the system preference; a click stores the
 * choice (ThemeScript applies it before paint). Hidden but space-holding until its script runs, so
 * readers without JS never see a dead button and nothing shifts. Event: `theme_toggle` (analytics.md).
 */
import { t } from "lingui-for-astro/macro";
---

<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" title={t`Dark theme`}>
  <span class="sr-only">{t`Dark theme`}</span>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"></circle>
    <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
    <path d="M12 1v2.5M12 20.5V23M1 12h2.5M20.5 12H23" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink);
    border-radius: 2px;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:not([data-ready]) {
    visibility: hidden;
  }
  .theme-toggle:hover {
    color: var(--accent);
  }
  .theme-toggle[aria-pressed="true"] svg {
    transform: rotate(180deg);
  }
  .theme-toggle svg {
    transition: transform var(--dur-base) var(--ease-out);
  }
</style>

<script>
  const root = document.documentElement;
  const media = matchMedia("(prefers-color-scheme: dark)");
  const effective = () => root.dataset.theme ?? (media.matches ? "dark" : "light");

  const paintThemeColor = () => {
    const paper = getComputedStyle(root).getPropertyValue("--paper").trim();
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) meta.content = paper;
  };

  const apply = (to: "light" | "dark") => {
    root.dataset.theme = to;
    try {
      localStorage.setItem("theme", to);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    paintThemeColor();
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const sync = () => button.setAttribute("aria-pressed", String(effective() === "dark"));
    sync();
    if (root.dataset.theme) paintThemeColor();
    media.addEventListener("change", sync);
    button.addEventListener("click", () => {
      const to = effective() === "dark" ? "light" : "dark";
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      // A short cross-fade where supported; instant otherwise and under reduced motion.
      if (document.startViewTransition && !reduce) document.startViewTransition(() => apply(to));
      else apply(to);
      sync();
      window.umami?.track("theme_toggle", { to });
    });
    button.dataset.ready = "";
  }
</script>
