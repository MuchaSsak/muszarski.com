---
/**
 * The split CV CTA (requirements.md F11, structure.md § CTA inventory): "CV" opens the web CV, "PDF" downloads this
 * locale's PDF directly (no auto-download: iOS). Events: `cta` id=cv and `cv_download` with the source
 * (analytics.md). `narrow` drops the PDF half on small phones (the header, where the menu carries the PDF then).
 */
import { t } from "lingui-for-astro/macro";

import Icon from "~/components/ui/Icon.astro";
import { cvPdfHref } from "~/data/site";
import { chromeLinks } from "~/lib/nav";

interface Props {
  source: "header" | "hero" | "contact" | "cv-page" | "menu" | "footer";
  narrow?: boolean;
  class?: string;
}

const { source, narrow = false, class: className } = Astro.props;
const locale = Astro.locals.locale;
const links = chromeLinks(locale);
---

<span class:list={["cv-split", { narrow }, className]}>
  <a
    href={links.cv}
    class="btn btn-line cv-split-page"
    data-umami-event="cta"
    data-umami-event-id="cv"
    data-umami-event-source={source}
  >
    {t`CV`}
  </a>
  <a
    href={cvPdfHref(locale)}
    download
    class="btn btn-line cv-split-pdf"
    aria-label={t`Download CV (PDF)`}
    data-umami-event="cv_download"
    data-umami-event-source={source}
    data-umami-event-locale={locale}
  >
    <Icon name="tb:download" class="nudge-down" />
    <span aria-hidden="true">PDF</span>
  </a>
</span>

<style>
  .cv-split {
    display: inline-flex;
  }
  .cv-split-pdf {
    margin-left: -2px;
  }
  @media (max-width: 29.9375rem) {
    .narrow .cv-split-pdf {
      display: none;
    }
  }
</style>
