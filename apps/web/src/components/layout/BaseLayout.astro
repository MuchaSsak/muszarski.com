---
/**
 * Every page's document: head (SEO, hreflang, theme, fonts, analytics), skip link, header, main.
 * Wiki: site/seo.md § Metadata rules, site/i18n.md, design/design.md § Themes, § Motion.
 */
import "~/styles/global.css";

import { type Locale, LOCALES, OG_LOCALES } from "@package/shared/locales";
import { PUBLIC_UMAMI_SCRIPT_URL, PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/client";
import { IS_FULL_PRODUCTION, PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/server";
import { t } from "lingui-for-astro/macro";

import SiteFooter from "~/components/layout/SiteFooter.astro";
import SiteHeader from "~/components/layout/SiteHeader.astro";
import ThemeScript from "~/components/layout/ThemeScript.astro";
import UmamiLoader from "~/components/layout/UmamiLoader.astro";
import { SITE } from "~/data/site";
import { FONT_FILES } from "~/lib/fonts.gen";

import { SITE_HOSTS } from "../../../scripts/launch.mjs";
import { alternates, type LocalizedPath, localesOf, pathTo } from "~/lib/routes";

interface Props {
  /** The page part of the title; the home page passes `home` and gets "Name – title". */
  title: string;
  description: string;
  /** The locale-free path of this page ("" = home); null = no canonical or hreflang (404). */
  path?: LocalizedPath | null;
  /** Locales this page exists in (default: all). */
  locales?: readonly Locale[];
  home?: boolean;
  /** Indexable at launch? Legal pages are noindex,follow (seo.md). */
  noindex?: boolean;
  /** The main-nav item this page belongs to. */
  current?: "work" | "blog";
  /** The share image key: `/og/<locale>/<og>.png` (generated by `bun run og`, checked by the launch gate). */
  og?: string;
  /** The image's own locale when it differs (an English post read from /es/ has no es image). */
  ogLocale?: Locale;
  /** Open Graph type and, for posts, the article dates. */
  article?: { published: Date; updated?: Date | undefined; tags: readonly string[] } | undefined;
  /** A page whose `<title>` is written in full (posts), without the " – name" suffix. */
  rawTitle?: boolean;
  /** Where the language switch sends a reader when this page has no version in a locale (default: home). */
  fallback?: LocalizedPath;
}

const {
  title,
  description,
  path = "",
  locales = LOCALES,
  home = false,
  noindex = false,
  current,
  og = "home",
  ogLocale,
  article,
  rawTitle = false,
  fallback = "",
} = Astro.props;
const locale = Astro.locals.locale;
const site = Astro.site ?? new URL("http://localhost:4321");
const canonical = path === null ? null : new URL(pathTo(locale, path), site).href;
const links = path === null ? [] : alternates(site, path, locales);
const otherLocales = path === null ? [] : localesOf(path, locales).filter((other) => other !== locale);
// The separator is typography, not copy: it stays out of the catalogs.
const fullTitle = rawTitle ? title : home ? `${SITE.name} – ${title}` : `${title} – ${SITE.name}`;
const ogImage = new URL(`/og/${ogLocale ?? locale}/${og}.png`, site).href;
// Every build but the launch is noindex (scripts/launch.mjs); legal pages stay out of the index.
const robots = !IS_FULL_PRODUCTION ? "noindex, nofollow" : noindex ? "noindex, follow" : "index, follow, max-image-preview:large";
const preloads = FONT_FILES.filter((font) => font.preload);
// Umami counts visits on the production domain only, apex or www (site/analytics.md): never a preview or localhost.
// The build's own origin is no good here: a production deploy built before the domain existed baked in its preview
// host, and every real visit was dropped.
const umamiDomains = SITE_HOSTS.flatMap((host) => [host, `www.${host}`]).join(",");
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2433ff" />
    <ThemeScript />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {links.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    {preloads.map((font) => (
      <link rel="preload" href={font.href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {otherLocales.map((other) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[other]} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={(article.updated ?? article.published).toISOString()} />}
    {article && <meta property="article:author" content={SITE.name} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} – Blog`} href={`/${locale === "pl" ? "pl" : "en"}/rss.xml`} />
    {PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    {PUBLIC_UMAMI_WEBSITE_ID && <UmamiLoader src={PUBLIC_UMAMI_SCRIPT_URL} id={PUBLIC_UMAMI_WEBSITE_ID} domains={umamiDomains} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip sr-only-focusable">{t`Skip to content`}</a>
    <div class="grain" aria-hidden="true"></div>
    <SiteHeader path={path ?? ""} locales={locales} current={current} home={home} fallback={fallback} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <SiteFooter path={path ?? ""} locales={locales} fallback={fallback} />
    <script>
      import "~/scripts/motion";
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 800;
  }
  /* Print grain over every field: one fixed, pre-rasterised noise tile, no repaint on scroll. */
  .grain {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 0.13;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
</style>
