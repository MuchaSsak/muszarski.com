---
/**
 * The footer (structure.md § Navigation and footer, requirements.md F10; design.md § Footer): a last-chance contact
 * line, the 4 link columns (this list owns the footer links), the language codes, credits for the marks, icons and
 * font, a pause-motion button, the build revision, and the surname fitted edge to edge as the poster's last line.
 */
import { type Locale } from "@package/shared/locales";
import { t } from "lingui-for-astro/macro";

import LocaleCodes from "~/components/layout/LocaleCodes.astro";
import MotionToggle from "~/components/layout/MotionToggle.astro";
import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import { visibleFlagships } from "~/data/projects";
import { PROFILES, SITE } from "~/data/site";
import { BUILD_INFO } from "~/lib/build-info";
import { type IconName } from "~/lib/icons.gen";
import { chromeLinks } from "~/lib/nav";
import { type LocalizedPath } from "~/lib/routes";
import { typo } from "~/lib/typography";

interface Props {
  path: LocalizedPath;
  locales?: readonly Locale[] | undefined;
}

const { path, locales } = Astro.props;
const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const english = links.blogLocale === locale ? "" : " (EN)";
const year = BUILD_INFO.date.slice(0, 4);
const PROFILE_ICONS: Record<string, IconName> = { github: "si:github", linkedin: "tb:brand-linkedin", npm: "si:npm" };
const surname = SITE.name.split(" ").at(-1)!;

const columns = [
  {
    id: "work",
    title: t`Work`,
    items: [
      ...visibleFlagships().map((project) => ({ label: project.name, href: links.project(project.slug) })),
      { label: t`All projects`, href: links.workIndex },
    ],
  },
  {
    id: "site",
    title: t`Site`,
    items: [
      { label: t`Blog` + english, href: links.blog },
      { label: t`CV`, href: links.cv },
      { label: t`My life`, href: links.myLife },
      { label: t`How this site was built`, href: links.thisSite },
      { label: t`RSS` + english, href: links.rss },
    ],
  },
  {
    id: "elsewhere",
    title: t`Elsewhere`,
    items: PROFILES.map((profile) => ({ label: profile.label, href: profile.href, outbound: profile.id })),
  },
  {
    id: "legal",
    title: t`Legal`,
    items: [
      { label: t`Privacy policy`, href: links.privacy },
      { label: t`Terms`, href: links.terms },
    ],
  },
] as const;
---

<footer class="sec field-bar site-footer">
  <div class="cols">
    <div class="say-col">
      <!-- PLACEHOLDER: draft line; the owner rewrites it in his voice (placeholders.md P6). -->
      <p class="say">{typo(locale, t`Let's talk about what you're building.`)}</p>
      <a
        href={links.contact}
        class="btn btn-acc"
        data-umami-event="cta"
        data-umami-event-id="contact"
        data-umami-event-source="footer"
      >
        {t`Contact`}
        <Icon name="tb:arrow-right" class="nudge" />
      </a>
    </div>
    <nav class="link-cols" aria-label={t`Footer`}>
      {columns.map((column) => (
        <div>
          <h2 class="kick col-title">{column.title}</h2>
          <ul role="list">
            {column.items.map((item) =>
              "outbound" in item ? (
                <li>
                  <a href={item.href} rel="me" data-umami-event="outbound" data-umami-event-target={item.outbound}>
                    {PROFILE_ICONS[item.outbound] && <Icon name={PROFILE_ICONS[item.outbound]!} />}
                    {item.label}
                  </a>
                </li>
              ) : (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ),
            )}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="row">
    <LocaleCodes path={path} locales={locales} class="f-loc" />
    <MotionToggle />
    <p class="meta">
      <span>
        © {year} {SITE.name}
      </span>
      <span>{t`Marks: Simple Icons (CC0). Icons: Tabler (MIT). Font: Anybody (SIL OFL).`}</span>
      <span>
        {t`Built with`}{" "}
        <a href="https://astro.build/" data-umami-event="outbound" data-umami-event-target="astro">
          Astro
        </a>
        · <time datetime={BUILD_INFO.date}>{BUILD_INFO.date}</time>
        {BUILD_INFO.sha && <span class="tabular">{BUILD_INFO.sha}</span>}
      </span>
    </p>
  </div>

  <Fit lines={[surname]} base={[100, 100]} motion="calm" decorative class="f-name" />
</footer>

<style>
  .site-footer {
    padding-bottom: 0;
    overflow: clip;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr);
    gap: 1.75rem;
  }
  .link-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .say {
    margin: 0 0 1rem;
    max-width: 14ch;
    font-weight: 800;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1;
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .col-title {
    margin: 0 0 0.75rem;
  }
  ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    text-decoration: none;
  }
  ul a :global(.ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  ul a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-block: 0.875rem;
    border-top: 2px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .row :global(.motion-toggle) {
    min-height: 2.25rem;
    padding-inline: 0.75rem;
    font-size: 0.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0 0 0 auto;
  }
  .site-footer :global(.f-name) {
    margin-top: 0.5rem;
    color: var(--accent);
  }
  @media (max-width: 62.5rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .link-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .meta {
      margin-left: 0;
    }
  }
</style>
