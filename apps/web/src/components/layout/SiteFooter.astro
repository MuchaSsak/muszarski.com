---
/**
 * The footer (structure.md § Navigation and footer, requirements.md F10; design.md § Footer): a last-chance contact
 * line, the 4 link columns (this list owns the footer links), the language codes, credits for the marks, icons and
 * font, a pause-motion button, the build revision, and the surname fitted edge to edge as the poster's last line.
 * Behind it all, faint contour lines that drift (`scripts/footer-field.ts`, loaded only once the footer is near and the
 * reader has interacted; without WebGL, the plain bar).
 */
import { type Locale } from "@package/shared/locales";
import { IS_FULL_PRODUCTION } from "astro:env/server";
import { t } from "lingui-for-astro/macro";

import CvLink from "~/components/layout/CvLink.astro";
import LocaleCodes from "~/components/layout/LocaleCodes.astro";
import MotionToggle from "~/components/layout/MotionToggle.astro";
import Fit from "~/components/ui/Fit.astro";
import Icon from "~/components/ui/Icon.astro";
import Logo from "~/components/ui/Logo.astro";
import { visibleFlagships } from "~/data/projects";
import { ELSEWHERE, SITE } from "~/data/site";
import { BUILD_INFO } from "~/lib/build-info";
import { type IconName } from "~/lib/icons.gen";
import { chromeLinks } from "~/lib/nav";
import { type LocalizedPath } from "~/lib/routes";
import { typo } from "~/lib/typography";

interface Props {
  path: LocalizedPath;
  locales?: readonly Locale[] | undefined;
  fallback?: LocalizedPath | undefined;
}

const { path, locales, fallback = "" } = Astro.props;
const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const english = links.blogLocale === locale ? "" : " (EN)";
const year = BUILD_INFO.date.slice(0, 4);
const PROFILE_ICONS: Record<string, IconName> = {
  github: "si:github",
  linkedin: "tb:brand-linkedin",
  // Neutral glyphs: Google and Apple allow their store icons only inside their badges (assets.md § Marks).
  "google-play": "tbf:player-play",
  "app-store": "tbf:apps",
  npm: "si:npm",
  instagram: "si:instagram",
  facebook: "si:facebook",
  telegram: "si:telegram",
  discord: "si:discord",
};
const surname = SITE.name.split(" ").at(-1)!;
const newTab = t`(opens in a new tab)`;

const columns = [
  {
    id: "work",
    title: t`Work`,
    items: [
      ...visibleFlagships().map((project) => ({ label: project.name, href: links.project(project.anchor ?? project.slug) })),
      // An arrow marks it as the way on to the whole list [user 2026-10-07].
      { label: t`All projects`, href: links.workIndex, more: true },
    ],
  },
  {
    id: "site",
    title: t`Site`,
    items: [
      { label: t`Blog` + english, href: links.blog },
      { label: t`CV`, href: links.cv, cv: true },
      { label: t`My life`, href: links.myLife },
      { label: t`How this site was built`, href: links.thisSite },
      { label: t`RSS` + english, href: links.rss },
    ],
  },
  {
    id: "elsewhere",
    title: t`Elsewhere`,
    items: ELSEWHERE.map((profile) => ({ label: profile.label, href: profile.href, outbound: profile.id })),
  },
  {
    id: "legal",
    title: t`Legal`,
    items: [
      { label: t`Privacy policy`, href: links.privacy },
      { label: t`Terms`, href: links.terms },
    ],
  },
] as const;
---

<footer class="sec field-bar site-footer" data-contour>
  <canvas class="f-field" aria-hidden="true" data-contour-canvas></canvas>
  <div class="cols">
    <div class="say-col">
      <!-- PLACEHOLDER: draft line; the owner rewrites it in his voice (placeholders.md P6). -->
      <p class="say">{typo(locale, t`Let's talk about what you're building.`)}</p>
      <a
        href={links.contact}
        class="btn btn-acc"
        data-umami-event="cta"
        data-umami-event-id="contact"
        data-umami-event-source="footer"
      >
        {t`Contact`}
        <Icon name="tb:arrow-right" class="nudge" />
      </a>
    </div>
    <nav class="link-cols" aria-label={t`Footer`}>
      {columns.map((column) => (
        <div>
          <h2 class="kick col-title">{column.title}</h2>
          <ul role="list">
            {column.items.map((item) =>
              "outbound" in item ? (
                <li>
                  <a
                    href={item.href}
                    rel="me noopener"
                    target="_blank"
                    data-umami-event="outbound"
                    data-umami-event-target={item.outbound}
                  >
                    {PROFILE_ICONS[item.outbound] && <Icon name={PROFILE_ICONS[item.outbound]!} />}
                    {item.label}
                    <span class="sr-only">{newTab}</span>
                  </a>
                </li>
              ) : "cv" in item ? (
                <li>
                  <CvLink source="footer" plain />
                </li>
              ) : "more" in item ? (
                <li>
                  <a href={item.href} class="f-more">
                    {item.label.split(" ").slice(0, -1).join(" ")}{" "}
                    <span class="f-last">
                      {item.label.split(" ").at(-1)}
                      <Icon name="tb:arrow-right" class="nudge" />
                    </span>
                  </a>
                </li>
              ) : (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ),
            )}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="row">
    <LocaleCodes path={path} locales={locales} fallback={fallback} class="f-loc" />
    <MotionToggle />
    <p class="meta">
      <span class="f-copy">
        <Logo />© {year} {SITE.name}
      </span>
      <span>{t`Marks: Simple Icons (CC0), Playwright (Apache 2.0). Icons: Tabler (MIT). Font: Anybody (SIL OFL).`}</span>
      <span>
        {t`Built with`}{" "}
        <a href="https://astro.build/" rel="noopener" target="_blank" data-umami-event="outbound" data-umami-event-target="astro">
          Astro<span class="sr-only"> {newTab}</span>
        </a>{" "}
        {t`and love`}
        {/* The revision helps check a preview deploy; the launched site doesn't show it [user 2026-10-07]. */}
        {!IS_FULL_PRODUCTION && (
          <>
            · <time datetime={BUILD_INFO.date}>{BUILD_INFO.date}</time>
            {BUILD_INFO.sha && <span class="tabular">{BUILD_INFO.sha}</span>}
          </>
        )}
      </span>
    </p>
    {/* Its own line, so the Spanish row keeps the same shape as the others (it wrapped into a ragged block, 2026-10-08). */}
    {locale === "es" && (
      <p class="ai-note">{t`This Spanish version was translated with AI and has not been reviewed by a native speaker yet.`}</p>
    )}
  </div>

  {/* Decorative and cropped by the footer on purpose (text-fit probe: data-textfit). */}
  <div data-textfit="skip">
    <Fit lines={[surname]} base={[100, 100]} motion="calm" decorative class="f-name" />
  </div>
</footer>

<style>
  .f-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .f-copy :global(.logo) {
    width: 1.375rem;
    height: 1.375rem;
  }
  .site-footer {
    isolation: isolate;
    padding-bottom: 0;
    overflow: clip;
  }
  /* The contour lines lie under everything in the footer and fade in once drawn. */
  .f-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s var(--ease-out);
  }
  .f-field:global(.on) {
    opacity: 1;
  }
  /* The say-line takes only its own width, so the link columns start further left [user 2026-10-06]. */
  .cols {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 1.75rem clamp(2.5rem, 7vw, 7rem);
  }
  /* Each column spans two shared rows (title, list), so a title on two lines (Polish "Informacje prawne") moves its
     whole row down and the lists still start level. */
  .link-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 1.75rem;
  }
  .link-cols > div {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    align-content: start;
  }
  .link-cols ul {
    align-content: start;
    margin-bottom: 1.75rem;
  }
  .say {
    margin: 0 0 1rem;
    max-width: 14ch;
    font-weight: 800;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1;
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .col-title {
    margin: 0 0 0.75rem;
  }
  ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    text-decoration: none;
  }
  ul :global(a .ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  ul :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* The arrow follows the label's last word when the label wraps (inline-flex parked it at the column edge, and a bare
     inline arrow could drop to a line of its own): the last word and the arrow never part. */
  ul :global(a.f-more) {
    display: inline-block;
    padding-block: 0.25rem;
  }
  .f-last {
    white-space: nowrap;
  }
  .f-more :global(.nudge) {
    display: inline-block;
    vertical-align: -0.15em;
    margin-left: 0.375rem;
    transition: transform 0.3s var(--ease-pop);
  }
  .f-more:is(:hover, :focus-visible) :global(.nudge) {
    transform: translateX(4px);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-block: 0.875rem;
    border-top: 2px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .row :global(.motion-toggle) {
    min-height: 2.25rem;
    padding-inline: 0.75rem;
    font-size: 0.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0 0 0 auto;
  }
  .ai-note {
    flex-basis: 100%;
    margin: 0;
    text-align: right;
  }
  .site-footer :global(.f-name) {
    margin-top: 0.5rem;
    color: var(--accent);
  }
  @media (max-width: 62.5rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .link-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .meta {
      margin-left: 0;
    }
    .ai-note {
      text-align: left;
    }
  }
</style>

<script>
  import { afterInteraction } from "~/scripts/motion";

  // The footer's contour lines: the module loads once the footer is near the screen and the reader has interacted.
  const footer = document.querySelector<HTMLElement>("[data-contour]");
  if (footer)
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        afterInteraction(() => void import("~/scripts/footer-field").then(({ startFooterField }) => startFooterField(footer)));
      },
      { rootMargin: "400px 0px" },
    ).observe(footer);
</script>
