---
/**
 * The header (structure.md § Navigation, requirements.md F01; design.md § Header). Sticky. On the home page it sits
 * on the hero field; once the hero name scrolls away it turns into the navy bar. Other pages start in the bar state.
 * The logo (tile + name) is the same on every page and in every state [user 2026-10-06: "make logo consistent"].
 *
 * ≥ 1180 px: mark · Work · How I work · AI · Blog · language flags · CV · Hire me. Below: mark · CV · Hire me · Menu;
 * the rest (and My life, pause motion) lives in the full-screen menu (a native popover: 0 KB JS for open/close, Esc and
 * light dismiss for free). Button type condenses on phones (Anybody's width axis) so CV and Hire me stay visible down
 * to 320 px. The CV button downloads the PDF and opens the web CV (`CvLink`).
 */
import { type Locale } from "@package/shared/locales";
import { IS_AVAILABLE_FOR_HIRE } from "astro:env/server";
import { t } from "lingui-for-astro/macro";

import CvLink from "~/components/layout/CvLink.astro";
import LocaleCodes from "~/components/layout/LocaleCodes.astro";
import MotionToggle from "~/components/layout/MotionToggle.astro";
import Icon from "~/components/ui/Icon.astro";
import Logo from "~/components/ui/Logo.astro";
import { SITE } from "~/data/site";
import { chromeLinks } from "~/lib/nav";
import { type LocalizedPath } from "~/lib/routes";

interface Props {
  path: LocalizedPath;
  locales?: readonly Locale[] | undefined;
  /** Which main-nav item is the current section. */
  current?: "work" | "blog" | undefined;
  /** The home page: the header starts transparent on the hero field. */
  home?: boolean | undefined;
  /** Where the language switch goes when this page has no version in a locale. */
  fallback?: LocalizedPath | undefined;
}

const { path, locales, current, home = false, fallback = "" } = Astro.props;
const locale = Astro.locals.locale;
const links = chromeLinks(locale);
const blogSuffix = links.blogLocale === locale ? "" : " (EN)";
const nav = [
  { id: "work", href: links.work, label: t`Work` },
  { id: "how-i-work", href: links.howIWork, label: t`How I work` },
  { id: "ai", href: links.ai, label: t`AI` },
  {
    id: "blog",
    href: links.blog,
    label: t`Blog` + blogSuffix,
    hreflang: links.blogLocale === locale ? undefined : links.blogLocale,
  },
] as const;
const name = SITE.name;
const homeLabel = t`${name}, home`;
---

<header class:list={["site-header", { stuck: !home }]} data-site-header data-home={home ? "" : undefined}>
  <a href={links.home} class="mark">
    <span class="sr-only">{homeLabel}</span>
    <Logo />
    <span class="m-l" aria-hidden="true">
      {SITE.name.split(" ").map((word) => (
        <span>{word} </span>
      ))}
    </span>
  </a>

  <nav class="main" aria-label={t`Main`}>
    <ul role="list">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="draw-line"
            hreflang={"hreflang" in item ? item.hreflang : undefined}
            aria-current={current === item.id ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <LocaleCodes path={path} locales={locales} fallback={fallback} class="h-loc" />

  <div class="actions">
    <CvLink source="header" />
    <a
      href={links.contact}
      class="btn btn-acc hire"
      data-umami-event="cta"
      data-umami-event-id="contact"
      data-umami-event-source="header"
    >
      {IS_AVAILABLE_FOR_HIRE ? t`Hire me` : t`Contact`}
    </a>
    <button type="button" class="btn btn-line menu-btn" popovertarget="site-menu">
      <Icon inline name="tb:menu-2" />
      <span>{t`Menu`}</span>
    </button>
  </div>
</header>

<div id="site-menu" popover class="site-menu field-bar">
  <div class="sm-top">
    <span class="kick">{t`Menu`}</span>
    <button
      type="button"
      class="btn btn-line btn-icon"
      popovertarget="site-menu"
      popovertargetaction="hide"
      aria-label={t`Close menu`}
    >
      <Icon inline name="tb:x" />
    </button>
  </div>
  <nav aria-label={t`Main`}>
    <ul role="list" class="sm-nav">
      {[
        ...nav,
        { id: "my-life", href: links.myLife, label: t`My life` },
        { id: "contact", href: links.contact, label: t`Contact` },
      ].map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={item.href} aria-current={current === item.id ? "page" : undefined} data-close-menu>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="sm-row">
    <CvLink source="menu" long />
    <MotionToggle />
  </div>
  <LocaleCodes path={path} locales={locales} fallback={fallback} names class="sm-loc" />
</div>

<style>
  .site-header {
    --sbg: var(--hero-bg);
    --sfg: var(--hero-fg);
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1.375rem;
    min-height: var(--header-h);
    padding: 0.625rem var(--pad-x);
    background: var(--sbg);
    color: var(--sfg);
    transition:
      background-color var(--dur-base),
      color var(--dur-base);
  }
  .site-header.stuck {
    --sbg: var(--bar-bg);
    --sfg: var(--bar-fg);
  }

  /* The logo: the tile and the condensed full name, the same everywhere. The tile straightens a tilt on hover. */
  .mark {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 900;
    font-size: 1.375rem;
    line-height: 1;
    text-transform: uppercase;
    padding-block: 0.25rem;
  }
  .mark :global(.logo) {
    flex: none;
    width: 2rem;
    height: 2rem;
    box-shadow: 0 0 0 2px var(--sfg);
    rotate: -4deg;
    transition: rotate 0.4s var(--ease-pop);
  }
  .mark:is(:hover, :focus-visible) :global(.logo) {
    rotate: 0deg;
  }
  .m-l {
    white-space: nowrap;
    font-stretch: 72%;
  }

  .main {
    margin-left: auto;
  }
  .main ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
    font-size: 0.9375rem;
    font-stretch: 118%;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .main a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    background-position: 0 calc(100% - 0.55rem);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .site-header :global(.btn) {
    min-height: 2.5rem;
    padding-inline: 0.75rem;
    font-size: 0.8125rem;
  }
  .site-header :global(.btn-acc) {
    box-shadow: 3px 3px 0 var(--btn-shadow);
  }
  .site-header :global(.cv-link .ico) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 73.6875rem) {
    .main,
    .site-header :global(.h-loc) {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .actions {
      margin-left: auto;
    }
  }

  /* Phones: condensed button type keeps mark + CV + Contact + Menu on one row at 320 px. Up to 640 px: the one-line
     name and full buttons need ~590 px in Polish, so between 480 and 590 the Menu button sat past the screen edge
     (2026-10-08). */
  @media (max-width: 39.9375rem) {
    .site-header {
      gap: 0.5rem;
    }
    .mark {
      gap: 0.4375rem;
      font-size: 1.125rem;
    }
    .mark :global(.logo) {
      width: 1.625rem;
      height: 1.625rem;
    }
    /* The full name stacks in two short lines so it fits next to CV + Contact + Menu. */
    .m-l {
      font-size: 0.875rem;
      line-height: 0.95;
      align-self: center;
    }
    .m-l > span {
      display: block;
    }
    .actions {
      gap: 0.375rem;
    }
    .site-header :global(.btn) {
      padding-inline: 0.625rem;
      font-stretch: 82%;
      letter-spacing: 0.01em;
    }
    .menu-btn :global(.ico),
    .site-header :global(.cv-link .ico) {
      display: none;
    }
  }
  @media (max-width: 22.4375rem) {
    /* The narrowest phones keep the tile; the name is in the link's label. */
    .m-l {
      display: none;
    }
    .site-header :global(.btn) {
      padding-inline: 0.5rem;
      font-stretch: 72%;
    }
  }

  /* The menu: a full-screen poster of big condensed links. */
  .site-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0.875rem var(--gutter) 2rem;
    border: 0;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .site-menu::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .sm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sm-nav {
    display: grid;
    gap: 0.25rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .sm-nav a {
    display: inline-block;
    font-weight: 900;
    font-size: clamp(2.75rem, 12vw, 6rem);
    line-height: 0.95;
    font-stretch: 70%;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      font-stretch var(--dur-slow) var(--ease-out),
      color var(--dur-fast);
  }
  .sm-nav a:is(:hover, :focus-visible) {
    font-stretch: 110%;
    color: var(--accent);
  }
  .sm-nav a[aria-current] {
    color: var(--accent);
  }
  .site-menu:popover-open .sm-nav li {
    animation: sm-in 0.55s var(--ease-out) both;
    animation-delay: calc(var(--i) * 45ms);
  }
  @keyframes sm-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
      font-stretch: 50%;
    }
  }
  .sm-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }
  .site-menu :global(.sm-loc) {
    margin-top: 1rem;
    font-size: 1rem;
  }
  @media (min-width: 73.75rem) {
    .site-menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const heroName = document.querySelector("[data-hero-name]");
  if (header?.hasAttribute("data-home") && heroName) {
    // The bar state starts when the hero name has scrolled under the header.
    new IntersectionObserver(([e]) => header.classList.toggle("stuck", !e!.isIntersecting && e!.boundingClientRect.top < 0), {
      rootMargin: "-64px 0px 0px 0px",
    }).observe(heroName);
  }
  // Same-page anchors in the menu close it (the popover stays open otherwise).
  const menu = document.getElementById("site-menu");
  menu?.querySelectorAll("[data-close-menu]").forEach((a) => a.addEventListener("click", () => menu.hidePopover()));
  // Keyboard focus lands clear of the sticky header (WCAG 2.4.11). `scroll-padding-top` covers most moves, but Firefox
  // leaves an element that is only partly under the header where it is (focus moving up). Chapters handle their own.
  document.addEventListener("focusin", (event) => {
    const el = event.target;
    if (!header || !(el instanceof HTMLElement) || !el.matches(":focus-visible")) return;
    if (el.closest("[data-site-header], [popover], .chapter") || el.matches(".sr-only-focusable")) return;
    requestAnimationFrame(() => {
      const top = el.getBoundingClientRect().top - header.offsetHeight;
      if (document.activeElement === el && top < 0) scrollBy(0, top - 8);
    });
  });
</script>
