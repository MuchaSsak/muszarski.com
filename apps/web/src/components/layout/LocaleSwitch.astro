---
/**
 * Language switcher (wiki: site/i18n.md § Switcher): a native popover (0 KB JS, light-dismiss and Esc
 * for free), autonyms + code, no flags, keeps the current page; a locale without this page falls back
 * to `fallback`. Clicks are counted by Umami's data attributes (`locale_switch`, analytics.md).
 */
import { AUTONYMS, type Locale } from "@package/shared/locales";
import { t } from "lingui-for-astro/macro";

import LocaleLinks from "~/components/layout/LocaleLinks.astro";
import { type LocalizedPath } from "~/lib/routes";

interface Props {
  path: LocalizedPath;
  locales?: readonly Locale[] | undefined;
  fallback?: LocalizedPath;
}

const { path, locales, fallback = "" } = Astro.props;
const locale = Astro.locals.locale;
const current = AUTONYMS[locale];
---

<button type="button" class="locale-trigger label" popovertarget="locale-menu" aria-label={t`Language: ${current}`}>
  <span aria-hidden="true">{locale}</span>
  <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
    <path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </svg>
</button>
<div id="locale-menu" popover class="locale-menu">
  <LocaleLinks path={path} locales={locales} fallback={fallback} />
</div>

<style>
  .locale-trigger {
    anchor-name: --locale-trigger;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 100%;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    color: var(--ink);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .locale-trigger:hover {
    color: var(--accent);
  }
  .locale-menu {
    /* Fallback placement under the header's right edge; anchored where supported. */
    position: fixed;
    inset: auto;
    top: calc(var(--header-h) + 0.5rem);
    right: var(--gutter);
    margin: 0;
    min-width: 12rem;
    padding: 0.375rem;
    background: var(--paper-raised);
    color: var(--ink);
    border: var(--stroke-outline) solid var(--ink);
    border-radius: 2px;
    box-shadow: 4px 4px 0 0 var(--grid);
  }
  @supports (position-anchor: --locale-trigger) {
    .locale-menu {
      position-anchor: --locale-trigger;
      top: calc(anchor(bottom) + 0.5rem);
      right: anchor(right);
    }
  }
</style>
