---
/**
 * Theme switch: Cobalt (default) → Paper → Ink → Cobalt (design.md § Themes). Shows the current theme's name; a
 * click moves to the next one and stores it (ThemeScript applies it before first paint). Hidden but space-holding
 * until its script runs, so readers without JS never see a dead button. Event: `theme_toggle` (analytics.md).
 */
import { t } from "lingui-for-astro/macro";

import Icon from "~/components/ui/Icon.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
const names = { cobalt: t`Cobalt`, paper: t`Paper`, ink: t`Ink` };
const label = t`Change theme`;
---

<button
  type="button"
  class:list={["btn btn-line theme-cycle", className]}
  data-theme-cycle
  data-names={JSON.stringify(names)}
  aria-label={`${label}: ${names.cobalt}`}
  data-label={label}
>
  <Icon inline name="tb:palette" />
  <span data-theme-name>{names.cobalt}</span>
</button>

<style>
  .theme-cycle:not([data-ready]) {
    visibility: hidden;
  }
  .theme-cycle :global(.ico) {
    transition: transform var(--dur-slow) var(--ease-pop);
  }
  .theme-cycle:active :global(.ico) {
    transform: rotate(-90deg);
  }
</style>

<script>
  type Theme = "cobalt" | "paper" | "ink";
  const ORDER: Theme[] = ["cobalt", "paper", "ink"];
  const CHROME: Record<Theme, string> = { cobalt: "#2433ff", paper: "#f1ede2", ink: "#0b0c11" };
  const root = document.documentElement;
  const current = (): Theme => (root.dataset.theme === "paper" || root.dataset.theme === "ink" ? root.dataset.theme : "cobalt");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-cycle]")];

  const sync = () => {
    const theme = current();
    for (const button of buttons) {
      const names = JSON.parse(button.dataset.names ?? "{}") as Record<Theme, string>;
      button.querySelector("[data-theme-name]")!.textContent = names[theme];
      button.setAttribute("aria-label", `${button.dataset.label}: ${names[theme]}`);
    }
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute("content", CHROME[theme]);
  };

  const apply = (to: Theme) => {
    if (to === "cobalt") delete root.dataset.theme;
    else root.dataset.theme = to;
    try {
      if (to === "cobalt") localStorage.removeItem("theme");
      else localStorage.setItem("theme", to);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    sync();
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const to = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]!;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      // A short cross-fade where supported; instant otherwise and under reduced motion.
      if (document.startViewTransition && !reduce) document.startViewTransition(() => apply(to));
      else apply(to);
      window.umami?.track("theme_toggle", { to });
    });
    button.dataset.ready = "";
  }
  sync();
</script>
