---
/**
 * A post card (blog index, latest writing, related posts): the code-drawn cover, tags, date and reading time, the
 * title as the link, the description. The whole card is clickable through the title link's stretched hit area.
 * The compact card (the home teaser) is a paper note taped to the section: paper fill, a strip of tape, a tilt that
 * straightens on hover or focus [user 2026-10-06: the outlined cards were too flat].
 * Two kinds, told apart at a glance [user 2026-10-06: fewer badges, case studies vs articles]: a case study (the
 * `case-study` tag) is a navy poster with a "Case study" stamp; an article is the outlined card with a small "Article"
 * label. Topic tags stay off the cards (the blog index filters by them). The data attributes feed the index's search,
 * filters and sort. On the compact card the reading time sits over the thumbnail with a clock [user 2026-10-08]; it
 * comes last in the markup, so a screen reader still hears kind, date and title first.
 */
import { t } from "lingui-for-astro/macro";

import PostCover from "~/components/blog/PostCover.astro";
import Icon from "~/components/ui/Icon.astro";
import { type Post, postLocale, postMinutes, postPath } from "~/lib/posts";
import { typo } from "~/lib/typography";

interface Props {
  post: Post;
  /** The big card (featured post). */
  wide?: boolean;
  /** The small card (the home teaser): a thumbnail, the date and the title. */
  compact?: boolean;
  headingLevel?: "h2" | "h3";
}

const { post, wide = false, compact = false, headingLevel: H = "h3" } = Astro.props;
const locale = postLocale(post);
// The meta row is the page's chrome, so it reads in the page's language; only the title and description keep the
// post's (an English post on the Spanish home showed "OCT 5, 2026" beside "MIN DE LECTURA", 2026-10-08).
const date = new Intl.DateTimeFormat(Astro.locals.locale, {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "Europe/Warsaw",
}).format(post.data.published);
const minutes = postMinutes(post);
const caseStudy = post.data.tags.includes("case-study");
const search = [post.data.title, post.data.description, ...post.data.tags].join(" ").toLowerCase();
---

<article
  class:list={["card", { wide, compact, cs: caseStudy }]}
  data-tags={post.data.tags.join(" ")}
  data-kind={caseStudy ? "case-study" : "article"}
  data-minutes={minutes}
  data-search={search}
>
  {caseStudy && !compact && <span class="cs-stamp" aria-hidden="true">{t`Case study`}</span>}
  {/* A featured post on the home rail gets a sticker [user 2026-10-08: "add a featured badge to this on notes from work"]. */}
  {compact && post.data.featured && (
    <span class="feat">
      <Icon name="tbf:star" />
      {t`Featured`}
    </span>
  )}
  <div class="art">
    <PostCover cover={post.data.cover} />
  </div>
  <div class="txt">
    <p class="meta">
      {!(caseStudy && !compact) && <span class="kind">{caseStudy ? t`Case study` : t`Article`}</span>}
      <time datetime={post.data.published.toISOString()}>{date}</time>
      {!compact && <span>{t`${minutes} min read`}</span>}
    </p>
    <H class="title" lang={locale}>
      <a href={postPath(post)}>{post.data.title}</a>
    </H>
    {!compact && (
      <p class="desc" lang={locale}>
        {typo(locale, post.data.description)}
      </p>
    )}
  </div>
  {compact && (
    <p class="mins">
      <Icon name="tb:clock" />
      {t`${minutes} min read`}
    </p>
  )}
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
    padding: 0.75rem 0.75rem 1.25rem;
    box-shadow: inset 0 0 0 3px currentColor;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .card.wide {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0.75rem;
  }
  .art {
    overflow: hidden;
  }
  .art :global(.cover) {
    transition: transform 0.6s var(--ease-out);
  }
  .txt {
    display: grid;
    gap: 0.625rem;
    padding: 0 0.375rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    margin: 0;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-stretch: 115%;
  }
  .kind {
    padding: 0.1875rem 0.4375rem;
    box-shadow: inset 0 0 0 2px currentColor;
  }
  .cs .kind {
    background: var(--yellow);
    color: var(--navy);
    box-shadow: none;
  }
  /* A case study: a navy poster with a pink shadow and a stamp over its corner. */
  .card.cs:not(.compact) {
    background: var(--navy);
    color: var(--ice);
    box-shadow: 10px 10px 0 var(--pink);
  }
  .cs-stamp {
    position: absolute;
    z-index: 2;
    left: -0.75rem;
    top: -1rem;
    padding: 0.375rem 0.75rem;
    background: var(--yellow);
    color: var(--navy);
    box-shadow: 4px 4px 0 var(--navy);
    font-weight: 900;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-stretch: 120%;
    transform: rotate(-5deg);
  }
  .title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    line-height: 1.05;
    font-stretch: 85%;
    text-wrap: balance;
  }
  .wide .title {
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 0.98;
    font-stretch: 75%;
  }
  .title a {
    text-decoration: none;
  }
  /* The title's link covers the card. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .card:has(.title a:focus-visible) {
    outline: 3px solid currentColor;
    outline-offset: 4px;
  }
  .desc {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translate(-4px, -4px);
      box-shadow:
        inset 0 0 0 3px currentColor,
        6px 6px 0 0 var(--accent);
    }
    .card.cs:not(.compact):hover {
      box-shadow: 14px 14px 0 var(--pink);
    }
    .card:hover .art :global(.cover) {
      transform: scale(1.04);
    }
  }
  .card.compact {
    --tape: var(--yellow);
    --tilt: -1.25deg;
    grid-template: "mins txt" auto "art txt" auto / 8.5rem minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: 0.375rem 1rem;
    padding: 0.625rem 0.875rem 0.625rem 0.625rem;
    background: var(--ice);
    color: var(--navy);
    box-shadow: 8px 8px 0 var(--navy);
    transform: rotate(var(--tilt));
  }
  /* The tape: decorative, half see-through, across the top edge. */
  .card.compact::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: -0.625rem;
    left: 50%;
    width: 4.5rem;
    height: 1.25rem;
    background: color-mix(in srgb, var(--tape) 82%, transparent);
    transform: translateX(-50%) rotate(-3deg);
    pointer-events: none;
  }
  .card.compact:has(.title a:focus-visible) {
    outline-color: var(--sfg);
  }
  /* The featured sticker: pink, over the top right corner, tilted against the card. */
  .feat {
    position: absolute;
    z-index: 2;
    top: -0.875rem;
    right: -0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.3125rem 0.625rem 0.375rem;
    background: var(--pink);
    color: var(--navy);
    box-shadow: 3px 3px 0 var(--navy);
    font-weight: 900;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-stretch: 120%;
    transform: rotate(4deg);
    pointer-events: none;
  }
  .feat :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }
  .compact .art {
    grid-area: art;
  }
  .compact .txt {
    grid-area: txt;
    gap: 0.375rem;
    padding: 0;
  }
  /* Date and reading time a touch smaller than the kind label [user 2026-10-08]. */
  .compact .meta time,
  .mins {
    font-size: 0.6875rem;
  }
  .mins {
    grid-area: mins;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-stretch: 105%;
    white-space: nowrap;
  }
  .mins :global(svg) {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }
  .compact .title {
    font-size: clamp(1.0625rem, 1.25vw, 1.3125rem);
    line-height: 1.08;
  }
  .card.compact:has(.title a:focus-visible) {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--navy);
  }
  @media (hover: hover) and (pointer: fine) {
    .card.compact:hover {
      transform: translate(-3px, -3px);
      box-shadow: 11px 11px 0 var(--navy);
    }
  }
  @media (max-width: 48rem) {
    .card.wide {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Phones: the picture over the text, so a long Polish title gets the card's full width (beside an 8.5rem picture
     "brutalistyczne" ran out of a 320 px card, 2026-10-08). */
  @media (max-width: 30rem) {
    .card.compact {
      grid-template: "mins" auto "art" auto "txt" auto / minmax(0, 1fr);
      align-items: start;
      gap: 0.5rem;
      padding: 0.625rem 0.625rem 1rem;
    }
    .card.compact .txt {
      margin-top: 0.25rem;
    }
  }
</style>
