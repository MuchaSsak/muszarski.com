---
/**
 * A post card (blog index, latest writing, related posts): the code-drawn cover, tags, date and reading time, the
 * title as the link, the description. The whole card is clickable through the title link's stretched hit area.
 * The compact card (the home teaser) is a paper note taped to the section: paper fill, a strip of tape, a tilt that
 * straightens on hover or focus [user 2026-10-06: the outlined cards were too flat].
 */
import { t } from "lingui-for-astro/macro";

import PostCover from "~/components/blog/PostCover.astro";
import TagLabel from "~/components/blog/TagLabel.astro";
import { type Post, postLocale, postMinutes, postPath } from "~/lib/posts";
import { typo } from "~/lib/typography";

interface Props {
  post: Post;
  tone?: number;
  /** The big card (featured post). */
  wide?: boolean;
  /** The small card (the home teaser): a thumbnail, the date and the title. */
  compact?: boolean;
  headingLevel?: "h2" | "h3";
}

const { post, tone = 0, wide = false, compact = false, headingLevel: H = "h3" } = Astro.props;
const locale = postLocale(post);
const date = new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Warsaw" }).format(post.data.published);
const minutes = postMinutes(post);
---

<article class:list={["card", { wide, compact }]} data-tags={post.data.tags.join(" ")} lang={locale}>
  <div class="art"><PostCover cover={post.data.cover} tone={tone} /></div>
  <div class="txt">
    <p class="meta">
      {
        post.data.tags.slice(0, compact ? 0 : 2).map((tag) => (
          <span class="tag">
            <TagLabel tag={tag} />
          </span>
        ))
      }
      <time datetime={post.data.published.toISOString()}>{date}</time>
      <span>{t`${minutes} min read`}</span>
    </p>
    <H class="title"><a href={postPath(post)}>{post.data.title}</a></H>
    {!compact && <p class="desc">{typo(locale, post.data.description)}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
    padding: 0.75rem 0.75rem 1.25rem;
    box-shadow: inset 0 0 0 3px currentColor;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .card.wide {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0.75rem;
  }
  .art {
    overflow: hidden;
  }
  .art :global(.cover) {
    transition: transform 0.6s var(--ease-out);
  }
  .txt {
    display: grid;
    gap: 0.625rem;
    padding: 0 0.375rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    margin: 0;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-stretch: 115%;
  }
  .tag {
    padding: 0.1875rem 0.4375rem;
    background: var(--sfg);
    color: var(--sbg);
  }
  .title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    line-height: 1.05;
    font-stretch: 85%;
    text-wrap: balance;
  }
  .wide .title {
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 0.98;
    font-stretch: 75%;
  }
  .title a {
    text-decoration: none;
  }
  /* The title's link covers the card. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .card:has(.title a:focus-visible) {
    outline: 3px solid currentColor;
    outline-offset: 4px;
  }
  .desc {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translate(-4px, -4px);
      box-shadow:
        inset 0 0 0 3px currentColor,
        6px 6px 0 0 var(--accent);
    }
    .card:hover .art :global(.cover) {
      transform: scale(1.04);
    }
  }
  .card.compact {
    --tape: var(--yellow);
    --tilt: -1.25deg;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.625rem 0.875rem 0.625rem 0.625rem;
    background: var(--ice);
    color: var(--navy);
    box-shadow: 8px 8px 0 var(--navy);
    transform: rotate(var(--tilt));
  }
  /* The tape: decorative, half see-through, across the top edge. */
  .card.compact::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: -0.625rem;
    left: 50%;
    width: 4.5rem;
    height: 1.25rem;
    background: color-mix(in srgb, var(--tape) 82%, transparent);
    transform: translateX(-50%) rotate(-3deg);
    pointer-events: none;
  }
  .card.compact:has(.title a:focus-visible) {
    outline-color: var(--sfg);
  }
  .compact .txt {
    gap: 0.375rem;
    padding: 0;
  }
  .compact .title {
    font-size: clamp(1.0625rem, 1.25vw, 1.3125rem);
    line-height: 1.08;
  }
  .card.compact:has(.title a:focus-visible) {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--navy);
  }
  @media (hover: hover) and (pointer: fine) {
    .card.compact:hover {
      transform: translate(-3px, -3px);
      box-shadow: 11px 11px 0 var(--navy);
    }
  }
  @media (max-width: 48rem) {
    .card.wide {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
