---
/**
 * One or more screenshots in a framed figure with a caption (the case study's evidence). Two or more sit in a grid;
 * a tag marks a frame ("Claude's pick", "My pick"). Text comes from the post (per-locale MDX).
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Shot {
  image: ImageMetadata;
  alt: string;
  /** A short name under the frame. */
  name?: string;
  /** A tag on the frame. */
  tag?: string;
  /** Highlight this frame. */
  picked?: boolean;
}
interface Props {
  shots: Shot[];
  caption: string;
  /** Phone screens: all in one row on wide screens, two per row on phones. */
  phones?: boolean;
}

const { shots, caption, phones = false } = Astro.props;
const many = shots.length > 1;
const widths = phones ? [240, 480] : many ? [400, 800] : [480, 800, 1200];
const sizes = phones
  ? "(min-width: 64rem) 11rem, (min-width: 40rem) 22vw, 46vw"
  : many
    ? "(min-width: 64rem) 22rem, 46vw"
    : "(min-width: 64rem) 46rem, 94vw";
---

<figure class:list={["cs-shots", { "cs-many": many, "cs-phones": phones }]} style={phones ? `--n:${shots.length}` : undefined}>
  <div class="cs-grid">
    {shots.map((shot) => (
      <div class:list={["cs-frame", { "cs-picked": shot.picked }]}>
        <Image src={shot.image} alt={shot.alt} widths={widths} sizes={sizes} loading="lazy" />
        {shot.tag && <span class="cs-tag">{shot.tag}</span>}
        {shot.name && <span class="cs-name">{shot.name}</span>}
      </div>
    ))}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
