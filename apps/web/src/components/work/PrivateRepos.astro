---
/**
 * The end of All projects: the owner's note on the work in private repositories [user 2026-10-08: "a small fun and
 * cheeky disclaimer"; then the spy room was "too vibe coded", and "in there's more dont include the 'wink wink' text,
 * just some emoji"]. Type only, on the same night field as the page: the title whose letters answer the pointer (a tap
 * sends a wave), the line, and a winking emoji that winks again on hover. The head's contour rings come back faintly
 * in the corner to close the page. No links and no counts.
 */
import { t } from "lingui-for-astro/macro";

import HoverType from "~/components/ui/HoverType.astro";
import { typo } from "~/lib/typography";

const locale = Astro.locals.locale;
const line = typo(
  locale,
  t`There are actually a lot more projects I've built that I won't show here: they live in private repositories. I mean, I could show you, but then I'd have to neutralize you, you know?`,
);
---

<section class="sec pr" aria-labelledby="t-more">
  <div class="pr-in">
    <h2 class="pr-title" id="t-more" data-ht-tap>
      <HoverType text={t`There's more.`} hover />
    </h2>
    <!-- prettier-ignore -->
    <p class="pr-line">{line}{"\u00a0"}<span class="pr-emoji">😉</span></p>
  </div>
</section>

<style>
  .pr {
    --mute: #b2b4c6; /* ice at 74% on the ink, as a solid colour (no faded text) */
    overflow: clip;
    padding-block: clamp(4rem, 8vw, 8rem) clamp(4.5rem, 9vw, 9rem);
    background:
      repeating-radial-gradient(circle at 100% 100%, transparent 0 38px, rgb(58 70 255 / 0.28) 38px 39px) 100% 100% /
        min(60%, 44rem) 100% no-repeat,
      var(--space);
    color: var(--ice);
  }
  .pr-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 6rem);
    align-items: end;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid rgb(238 240 255 / 0.14);
  }
  .pr-title {
    --ht-c: var(--lime);
    --ht-thin: 300;
    --ht-mid: 600;
    margin: 0;
    font-weight: 900;
    font-size: clamp(3rem, 7.5vw, 7.5rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
    font-stretch: 70%;
  }
  .pr-line {
    max-width: 46ch;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--mute);
  }
  .pr-emoji {
    display: inline-block;
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 1.35em;
    line-height: 1;
    vertical-align: -0.12em;
    transition:
      rotate 0.5s var(--ease-pop),
      scale 0.5s var(--ease-pop);
  }
  @media (hover: hover) and (pointer: fine) {
    .pr-line:hover .pr-emoji {
      rotate: -14deg;
      scale: 1.2;
    }
  }
  @media (max-width: 48rem) {
    .pr-in {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
