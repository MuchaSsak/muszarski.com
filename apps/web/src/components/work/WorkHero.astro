---
/**
 * All projects, the head [user 2026-10-09: the background "more colorful slightly", the "On this page" list replaced
 * by something "more visual", the contour lines moved to the footer and a "different and better looking" effect here].
 * - The title (`HoverType`: the letter under a fine pointer thins out, a tap sends a wave) and one lede, real text,
 *   painted first (the LCP).
 * - A wall of every project: a tile per project with its real picture (a capture of the live site, the app's poster)
 *   or its real text (the test run, the CLI), and its name on a tab in its colour. One click jumps to the project.
 *   On wide screens the wall leans back in 3D, its columns drift at different speeds with the scroll and the whole
 *   wall leans a degree toward the mouse; a hovered or focused tile steps forward and everything else goes dark (the
 *   other tiles, the title, the field and the bar) [user 2026-10-09: "darken all things, including heading nad navbar
 *   so only thing lighten up is the card we hover", a trial]. On tablets and phones it is a flat two-row strip you
 *   swipe.
 * - Behind it a dithered colour field (`scripts/work-field.ts`, one fragment shader, no library) that gathers behind
 *   the wall and takes the colour of the project in play. It starts at the first interaction or a pointer over the
 *   head, only while in view; until then (or for good without WebGL) a CSS glow stands in. Paused or reduced motion:
 *   one still frame, no drift, no lean.
 */
import { t } from "lingui-for-astro/macro";

import HoverType from "~/components/ui/HoverType.astro";
import Icon from "~/components/ui/Icon.astro";
import { typo } from "~/lib/typography";

/** What a tile shows: a picture (`phone` for an app's portrait poster), or real text where there's nothing to film. */
export type Thumb = { src: string; phone?: boolean } | { text: "tests" | "cli" };

export interface IndexItem {
  slug: string;
  name: string;
  /** The project's colour (`#rrggbb`), readable with navy text: its tab, its tile, the field's accent. */
  color: string;
  thumb: Thumb;
}

interface Props {
  items: IndexItem[];
}

const { items } = Astro.props;
const locale = Astro.locals.locale;
const title = t`Things I’ve built`;
/**
 * Three columns, or two when there are few projects (the launch build shows only the ones cleared for it), so the
 * tiles stay big. The second column of the three (the second of two) sits half a tile lower, and each column drifts
 * at its own speed.
 */
const cols = items.length > 6 ? 3 : 2;
const DRIFT = cols === 3 ? ["-3rem", "-7rem", "-1.5rem"] : ["-2.5rem", "-6rem"];
---

<section class="sec wh near" aria-labelledby="t-work" data-field-host>
  <canvas class="wh-field" aria-hidden="true" data-field></canvas>
  <span class="wh-dim" aria-hidden="true"></span>
  <div class="wh-in">
    <div class="wh-head">
      <p class="kick wh-kick rise">{t`Work`}</p>
      <h1 class="wh-title" id="t-work" data-ht-tap>
        <HoverType text={title} hover />
      </h1>
      <p class="wh-lede rise" style="--d:2">
        {typo(locale, t`Client work, my own products, open source and experiments. Pick one, or scroll through all of them.`)}
      </p>
    </div>
    <nav class="wh-wall rise" aria-label={t`On this page`} style="--d:3" data-textfit="skip">
      <ol class:list={["ww", { few: cols === 2 }]} role="list" data-wall>
        {items.map((item, k) => (
          <li class:list={["wt", { low: k % cols === 1 }]} style={`--c:${item.color};--drift:${DRIFT[k % cols]}`}>
            <a class="wt-a" href={`#wk-${item.slug}`} data-tint={item.color}>
              <span
                class:list={["wt-pic", "text" in item.thumb ? `t-${item.thumb.text}` : { "t-phone": item.thumb.phone }]}
                aria-hidden="true"
              >
                {"src" in item.thumb && (
                  <img
                    src={item.thumb.src}
                    alt=""
                    width={item.thumb.phone ? 320 : 480}
                    height={item.thumb.phone ? 694 : 300}
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                )}
                {"text" in item.thumb && item.thumb.text === "tests" && (
                  <span class="wt-txt">
                    <Icon name="tb:circle-check" />
                    118 passed
                  </span>
                )}
                {"text" in item.thumb && item.thumb.text === "cli" && (
                  <span class="wt-txt">
                    <b>$</b> npx lingui-translate-ai
                  </span>
                )}
              </span>
              <span class="wt-name">{item.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  /* The night field, and the glow the shader replaces. */
  .wh {
    --mute: #b2b4c6; /* ice at 74% on the ink, as a solid colour (no faded text) */
    overflow: clip;
    padding-top: clamp(2.5rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
    background:
      radial-gradient(34% 52% at 76% 52%, rgb(255 79 184 / 0.22), transparent 70%),
      radial-gradient(48% 70% at 74% 50%, rgb(36 51 255 / 0.55), transparent 72%), var(--space);
    color: var(--ice);
  }
  /* One canvas pixel per dither cell, scaled up without smoothing. */
  .wh-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    image-rendering: pixelated;
    transition: opacity 1.2s var(--ease-out);
  }
  .wh-field:global(.on) {
    opacity: 1;
  }
  /* The dark over the field and the title while a tile is in play (the tiles dim their own way, below). */
  .wh-dim,
  .wt-a::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(7 8 28 / 0.74);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease-out);
  }
  .wh-dim {
    z-index: 1;
  }
  .wh-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
    min-height: min(40rem, calc(100svh - var(--header-h) - 8rem));
  }

  .wh-kick {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 clamp(1rem, 2vw, 1.75rem);
    color: var(--lime);
  }
  .wh-kick::before {
    content: "";
    width: 2.25rem;
    height: 2px;
    background: currentColor;
  }
  /* A plain title, not the fitted poster type: heavy, condensed, sentence case. */
  .wh-title {
    --ht-c: var(--lime);
    --ht-thin: 400;
    --ht-mid: 650;
    max-width: 10ch;
    margin: 0;
    font-weight: 900;
    font-size: clamp(3.25rem, 7vw, 8rem);
    line-height: 0.97;
    letter-spacing: -0.01em;
    font-stretch: 70%;
  }
  .wh-lede {
    max-width: 36ch;
    margin: clamp(1.5rem, 2.6vw, 2.25rem) 0 0;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--mute);
  }

  /* The wall: three columns leaning back toward the right edge; the middle column half a tile lower. The lean
     follows the mouse by a degree or two (`--lx`, `--ly`, set on the wrapper by scripts/work-field). */
  /* The mask box reaches past the wall on the left: the near side of the wall grows toward the title. */
  .wh-wall {
    position: relative;
    z-index: 2;
    margin: 0 calc(-1 * var(--pad-x)) 0 -5rem;
    padding: 2rem 0 7rem 5rem;
    mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 82%, transparent);
  }
  /* Capped, so the four rows of the first column fit the head on wide screens. */
  .ww {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.875rem, 1.3vw, 1.5rem);
    max-width: 50rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    transform: perspective(2200px) rotateX(calc(9deg - var(--ly, 0) * 4deg)) rotateY(calc(16deg + var(--lx, 0) * 6deg))
      rotateZ(-2deg);
    transform-origin: 100% 50%;
    transform-style: preserve-3d;
    transition: transform 1.2s var(--ease-out);
  }
  .ww.few {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 40rem;
  }
  .wt {
    transform-style: preserve-3d;
  }
  /* The column step is a relative offset (half the row), so it never pushes the layout. */
  .wt.low {
    position: relative;
    top: 50%;
  }
  .wt-a {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.625rem;
    background: var(--c);
    color: var(--navy);
    text-decoration: none;
    box-shadow:
      0 0 0 1px rgb(238 240 255 / 0.18),
      0 22px 44px -22px rgb(0 0 0 / 0.7);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }
  .wt-a:focus-visible {
    outline: 3px solid var(--ice);
    outline-offset: 3px;
  }
  .wt-pic {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .wt-pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* The app's portrait poster as a phone rising from the tile's foot. */
  .t-phone img {
    position: absolute;
    top: 12%;
    left: 50%;
    width: auto;
    height: 118%;
    aspect-ratio: 320 / 694;
    translate: -50% 0;
    border: 3px solid var(--navy);
    border-radius: 0.75rem;
  }
  .wt-txt {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0 0.75rem 1.5rem;
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-weight: 700;
    font-size: clamp(0.6875rem, 0.85vw, 1rem);
    line-height: 1.2;
    white-space: nowrap;
  }
  .wt-txt :global(.ico) {
    width: 1.25em;
    height: 1.25em;
  }
  .t-cli {
    background: var(--midnight);
    color: var(--ice);
  }
  .t-cli b {
    color: var(--lime);
  }
  /* The name on a tab in the project's colour (navy text reads on every project colour). */
  .wt-name {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    max-width: calc(100% - 1rem);
    padding: 0.3125rem 0.5625rem;
    border-radius: 0.3125rem;
    background: var(--c);
    color: var(--navy);
    font-weight: 800;
    font-size: clamp(0.75rem, 0.8vw, 0.9375rem);
    line-height: 1.15;
    font-stretch: 92%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 0 0 1px rgb(10 13 51 / 0.25);
  }
  /* A tile in play steps forward and is the one lit thing: the other tiles, the field, the title and the bar go dark
     (a mouse, or the keyboard; not a tap, whose hover sticks after the jump). */
  .wt-a::after {
    border-radius: inherit;
  }
  .wt-a:is(:hover, :focus-visible) {
    transform: translateZ(48px);
    box-shadow:
      0 0 0 2px var(--c),
      0 34px 60px -24px rgb(0 0 0 / 0.8);
  }
  .ww:has(.wt-a:focus-visible) .wt-a:not(:focus-visible)::after,
  .wh:has(.wt-a:focus-visible) .wh-dim,
  :global(html:has(.wt-a:focus-visible) .site-header)::after {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .ww:has(.wt-a:hover) .wt-a:not(:hover)::after,
    .wh:has(.wt-a:hover) .wh-dim,
    :global(html:has(.wt-a:hover) .site-header)::after {
      opacity: 1;
    }
  }
  /* The bar's own dark (the page's bar is a sibling of this section). */
  :global(.site-header)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(7 8 28 / 0.74);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease-out);
  }

  /* The columns drift apart with the scroll (wide screens, motion on). Longhands: the build folds a shorthand with
     animation-timeline into one Chrome rejects (lessons.md). */
  @media (width > 64rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .wt {
        animation-name: wt-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
    }
  }
  @keyframes wt-drift {
    to {
      translate: 0 var(--drift, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ww,
    .wt-a,
    .wt-a::after,
    .wh-dim,
    :global(.site-header)::after {
      transition: none;
    }
  }
  /* Paused: no lean, and no drift (a scroll timeline ignores the global pause, so the animation goes). */
  :global(.still) .ww {
    --lx: 0 !important;
    --ly: 0 !important;
  }
  :global(.still) .wt {
    animation: none !important;
  }

  /* Tablets and phones: the wall becomes a two-row strip under the title, flat, to swipe. */
  @media (max-width: 64rem) {
    .wh-in {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      min-height: 0;
    }
    .wh-title {
      max-width: none;
    }
    .wh-wall {
      margin-inline: calc(-1 * var(--pad-x));
      padding: 0;
      mask-image: none;
    }
    .ww,
    .ww.few {
      grid-template-columns: none;
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      grid-auto-columns: 31%;
      gap: 1rem;
      max-width: none;
      overflow-x: auto;
      padding: 0.25rem var(--pad-x) 0.75rem;
      scroll-padding-inline: var(--pad-x);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      transform: none;
    }
    .ww::-webkit-scrollbar {
      display: none;
    }
    .wt {
      scroll-snap-align: start;
    }
    .wt.low {
      top: 0;
    }
  }
  @media (max-width: 40rem) {
    .ww,
    .ww.few {
      grid-auto-columns: 62%;
      gap: 0.75rem;
    }
    .wt-name {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  import "~/scripts/work-field";
</script>
