---
/**
 * All projects, the head [user 2026-10-08: the TV head was "not far from being good, but i wish the background was
 * more alive, and maybe even the headings and some very micro hover effects"; the page "too vibe coded", "go for a
 * different style and theme"]. The night catalogue: a plain title on an ink field of contour lines that drift like a
 * map; the pointer raises a hill under itself (a tap sends a ripple, the scroll slides the map), and hovering or
 * focusing a name in the index tints the lines in that project's colour (`scripts/work-field.ts`, one fragment
 * shader, no library). The title's letters thin out under the pointer (`HoverType`). The index on the right is the
 * page in one glance: every project, its kind and year, one click to its plate.
 * The title is real text, painted first (the LCP); the shader starts at the first interaction or a pointer over the
 * head, only while it is in view, and concentric lines in CSS stand in until then (or for good without WebGL).
 * Paused or reduced motion: one still frame that moves only with the pointer.
 */
import { t } from "lingui-for-astro/macro";

import HoverType from "~/components/ui/HoverType.astro";
import Icon from "~/components/ui/Icon.astro";
import { typo } from "~/lib/typography";

export interface IndexItem {
  slug: string;
  name: string;
  /** Kind of work, e.g. "Own product". */
  kind: string;
  year: number;
  /** The project's colour, readable on the ink (`#rrggbb`); the shader tints its lines with it. */
  color: string;
}

interface Props {
  items: IndexItem[];
}

const { items } = Astro.props;
const locale = Astro.locals.locale;
const title = t`Things I’ve built`;
---

<section class="sec wh near" aria-labelledby="t-work" data-field-host>
  <canvas class="wh-field" aria-hidden="true" data-field></canvas>
  <div class="wh-in">
    <div class="wh-head">
      <p class="kick wh-kick rise">{t`Work`}</p>
      <h1 class="wh-title" id="t-work" data-ht-tap>
        <HoverType text={title} hover />
      </h1>
      <p class="wh-lede rise" style="--d:2">
        {typo(locale, t`Client work, my own products, open source and experiments. Pick one, or scroll through all of them.`)}
      </p>
    </div>
    <nav class="wh-toc rise" aria-labelledby="t-toc" style="--d:3">
      <p class="wh-toc-k" id="t-toc">{t`On this page`}</p>
      <ol role="list">
        {items.map((item, k) => (
          <li>
            <a href={`#wk-${item.slug}`} data-tint={item.color} style={`--c:${item.color}`}>
              <span class="wt-n tabular" aria-hidden="true">
                {String(k + 1).padStart(2, "0")}
              </span>
              <span class="wt-name">{item.name}</span>
              <span class="wt-meta">
                {item.kind} · <span class="tabular">{item.year}</span>
              </span>
              <Icon name="tb:arrow-down" class="wt-ar" />
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  /* The night field. Until the shader runs: rings of the same lines in CSS. */
  .wh {
    --hair: rgb(238 240 255 / 0.14);
    --mute: #b2b4c6; /* ice at 74% on the ink, as a solid colour (no faded text) */
    overflow: clip;
    padding-top: clamp(3rem, 7vw, 6.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6.5rem);
    background: repeating-radial-gradient(circle at 82% 18%, transparent 0 38px, rgb(58 70 255 / 0.32) 38px 39px), var(--space);
    color: var(--ice);
  }
  .wh-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .wh-field:global(.on) {
    opacity: 1;
  }
  .wh-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: end;
  }

  .wh-kick {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 clamp(1rem, 2vw, 1.75rem);
    color: var(--lime);
  }
  .wh-kick::before {
    content: "";
    width: 2.25rem;
    height: 2px;
    background: currentColor;
  }
  /* A plain title, not the fitted poster type: heavy, condensed, sentence case. */
  .wh-title {
    --ht-c: var(--lime);
    --ht-thin: 300;
    --ht-mid: 600;
    max-width: 10ch;
    margin: 0;
    font-weight: 900;
    font-size: clamp(3.25rem, 8.8vw, 9.5rem);
    line-height: 0.97;
    letter-spacing: -0.01em;
    font-stretch: 70%;
  }
  .wh-lede {
    max-width: 40ch;
    margin: clamp(1.5rem, 2.6vw, 2.25rem) 0 0;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--mute);
  }

  /* The index: number, name, kind · year, an arrow; hairlines between. */
  .wh-toc-k {
    margin: 0 0 0.75rem;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-stretch: 120%;
    color: var(--mute);
  }
  .wh-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }
  /* One-line rows: plain wrapping (the site's "pretty" on li costs layout passes for nothing here). */
  .wh-toc li {
    border-bottom: 1px solid var(--hair);
    text-wrap: wrap;
  }
  .wh-toc a {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto 1.125rem;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.875rem;
    text-decoration: none;
  }
  /* The project's colour as a bar that grows from the left on hover or focus. */
  .wh-toc a::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: var(--c);
    scale: 1 0;
    transition: scale 0.35s var(--ease-out);
  }
  .wt-n {
    padding-left: 0.625rem;
    font-weight: 800;
    font-size: 0.8125rem;
    color: var(--c);
  }
  .wt-name {
    overflow: hidden;
    font-weight: 800;
    font-size: 1.0625rem;
    font-stretch: 88%;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: translate 0.35s var(--ease-out);
  }
  .wt-meta {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-stretch: 105%;
    color: var(--mute);
    white-space: nowrap;
  }
  .wh-toc :global(.wt-ar) {
    width: 1.125rem;
    height: 1.125rem;
    opacity: 0.45;
    transition:
      translate 0.35s var(--ease-out),
      opacity 0.35s,
      color 0.35s;
  }
  .wh-toc a:focus-visible {
    outline-offset: 2px;
  }
  .wh-toc a:is(:hover, :focus-visible)::before {
    scale: 1 1;
  }
  .wh-toc a:is(:hover, :focus-visible) .wt-name {
    translate: 0.375rem 0;
  }
  .wh-toc a:is(:hover, :focus-visible) :global(.wt-ar) {
    translate: 0 3px;
    opacity: 1;
    color: var(--c);
  }

  /* Tablets: the index under the title, two columns. Phones: names only. */
  @media (max-width: 64rem) {
    .wh-in {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .wh-toc ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }
  @media (max-width: 40rem) {
    .wh-toc ol {
      column-gap: 1rem;
    }
    .wh-toc a {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.375rem;
      min-height: 2.75rem;
    }
    .wt-n {
      padding-left: 0.5rem;
      font-size: 0.75rem;
    }
    /* Long names wrap rather than lose their ends on narrow phones. */
    .wt-name {
      overflow: visible;
      padding-block: 0.375rem;
      font-size: 0.9375rem;
      line-height: 1.15;
      font-stretch: 80%;
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .wt-meta,
    .wh-toc :global(.wt-ar) {
      display: none;
    }
  }
</style>

<script>
  import "~/scripts/work-field";
</script>
