# Names only: the real values live in the Vercel project settings (Production + Preview), never in git.
# Purpose and defaults: .claude/project-info/tech/technologies.md § Environment variables.

# True only for the production launch build; every other build is noindex and the launch gate stays soft.
LAUNCH_BUILD=
# Canonical origin. Default https://matmuszarski.space; review deploys use VERCEL_URL.
PUBLIC_SITE_URL=

# Contact form (api/contact.ts), sent through EmailJS from the server. Unset = the form answers "can't send right
# now" and shows the email.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Account → Security → "Use Private Key" (recommended): the private key, sent only from the server.
EMAILJS_PRIVATE_KEY=

# Cloudflare Turnstile. Set both or neither.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami Cloud. The site's id is the default in astro.config.mjs; set this only to point at another website.
PUBLIC_UMAMI_WEBSITE_ID=
# Optional overrides (defaults: Umami Cloud script and collector).
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_COLLECT_ORIGIN=

# Search Console HTML tag, only when the property is not verified by DNS.
PUBLIC_GOOGLE_SITE_VERIFICATION=
