{
  "name": "@package/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node ./scripts/launch-gate.mjs",
