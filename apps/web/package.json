    "@lingui/format-po": "6.9.0",
    "@lingui/native-tools": "0.1.5",
    "@lingui/vite-plugin": "6.9.0",
    "@playwright/test": "1.63.0",
    "@tabler/icons": "3.49.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "fontkit": "^2.0.4",
    "lighthouse": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "simple-icons": "16.34.0",
    "subset-font": "^2.9.0",
