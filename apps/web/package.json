    "shots": "node ./scripts/shots.mjs",
    "fonts": "node ./scripts/fonts.mjs",
    "icons": "node ./scripts/icons.mjs",
    "cv:pdf": "node ./scripts/cv-sheet.mjs",
    "cv:sheet": "node ./scripts/cv-sheet.mjs",
    "cv:fonts": "node ./scripts/cv-fonts.mjs",
    "og": "node ./scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@package/shared": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "lingui-for-astro": "0.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3"
  },
