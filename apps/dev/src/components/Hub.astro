---
import { hubPath, LANG_NAMES, LANGS, OG_LOCALES, STRINGS, SWITCHER, type Lang } from "../data/i18n";
import { projects, projectUrl } from "../data/projects";

/**
 * The whole hub: one page of cards, rendered once per language (`/`, `/pl/`, `/es/`). Hidden on purpose: noindex
 * (meta + X-Robots-Tag in vercel.json), no sitemap, nothing on muszarski.com links here. Colours and face are the
 * portfolio's Cobalt poster palette, toned down.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = STRINGS[lang];
const title = `${t.heading} · Mateusz Muszarski`;
const description = t.description;
// Link previews (Discord, Slack, Messenger) still work: their bots read OG tags and ignore noindex.
const url = new URL(hubPath(lang), Astro.site).href;
const image = new URL("/og.png", Astro.site).href;
const heading = t.heading;
const portfolio = `https://muszarski.com/${lang}/`;
// Simple Icons paths (CC0), only as links to the owner's own profiles.
const social = [
  {
    label: "GitHub",
    href: "https://github.com/MuchaSsak",
    d: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "Discord",
    href: "https://discord.com/users/440900720334602242",
    d: "M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z",
  },
];
// This hub in each language.
const langs = SWITCHER.map((code) => ({ code, label: LANG_NAMES[code], href: hubPath(code), current: code === lang }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2433ff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mateusz Muszarski" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:image" content={image} />
    {LANGS.map((code) => <link rel="alternate" hreflang={code} href={new URL(hubPath(code), Astro.site).href} />)}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Side projects, dev.muszarski.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/anybody.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face {
        font-family: "Anybody";
        src: url("/fonts/anybody.woff2") format("woff2");
        font-weight: 400 900;
        font-stretch: 50% 150%;
        font-display: swap;
      }
      :root {
        color-scheme: dark;
        --cobalt: #2433ff;
        --ice: #eef0ff;
        --navy: #0a0d33;
        --pink: #ff4fb8;
        --gutter: clamp(1rem, 3.9vw, 3.5rem);
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100svh;
        background: var(--cobalt);
        color: var(--ice);
        font-family: "Anybody", "Arial Narrow", Arial, sans-serif;
        line-height: 1.5;
        display: flex;
        flex-direction: column;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1 data-wave aria-label={heading}>
          {[...heading].map((ch, i) => (ch === " " ? " " : <span class="ch" aria-hidden="true" style={`--i:${i}`}>{ch}</span>))}
        </h1>
        <p>
          {t.by} <a href={portfolio}>{t.name}</a>.
        </p>
      </header>

      <ul class="grid" role="list">
        {projects.map((p) => (
          <li>
            <a class="card" href={projectUrl(p, lang)}>
              <div class="thumb">
                <iframe
                  src={projectUrl(p, lang)}
                  title={`${p.name[lang]}, ${t.preview}`}
                  loading="lazy"
                  tabindex="-1"
                  aria-hidden="true"
                  sandbox="allow-scripts allow-same-origin"
                  referrerpolicy="no-referrer"
                />
              </div>
              <h2>{p.name[lang]}</h2>
              <p>{p.description[lang]}</p>
              <span class="go" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <footer class="foot" data-contour>
      <canvas class="field" aria-hidden="true" data-contour-canvas></canvas>
      <a class="home" href={portfolio}>muszarski.com <span aria-hidden="true">↗</span></a>
      <ul class="icons" role="list">
        {social.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d={s.d} /></svg>
            </a>
          </li>
        ))}
        {langs.map((l) => (
          <li>
            <a
              class="lang"
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              title={l.label}
              aria-current={l.current ? "page" : undefined}
            >
              {l.code.toUpperCase()}<span class="sr">, {l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </footer>

    <script>
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      // Title: one wave through the letters on hover; a tap (pointerdown) is its touch twin.
      const title = document.querySelector<HTMLElement>("[data-wave]");
      if (title) {
        const wave = () => {
          if (!reduce.matches) title.classList.add("waving");
        };
        title.addEventListener("pointerenter", wave);
        title.addEventListener("pointerdown", wave);
        title.addEventListener("animationend", (e) => {
          if (e.target === title.lastElementChild) title.classList.remove("waving");
        });
      }
      // Footer shader: loads only once the footer is near and the reader has interacted.
      const footer = document.querySelector<HTMLElement>("[data-contour]");
      if (footer) {
        let near = false;
        let interacted = false;
        let started = false;
        const go = () => {
          if (started || !near || !interacted) return;
          started = true;
          void import("../scripts/footer-field").then(({ startFooterField }) => startFooterField(footer));
        };
        const once = () => {
          interacted = true;
          go();
        };
        for (const type of ["pointerdown", "pointermove", "keydown", "scroll", "touchstart"])
          addEventListener(type, once, { once: true, passive: true });
        new IntersectionObserver(
          ([entry]) => {
            near = near || !!entry?.isIntersecting;
            go();
          },
          { rootMargin: "300px" },
        ).observe(footer);
      }
    </script>
  </body>
</html>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: 75rem;
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(3rem, 8vw, 5rem);
  }
  header {
    padding-block: clamp(2.5rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 0.95;
    text-transform: uppercase;
  }
  header p {
    margin: 0.75rem 0 0;
    font-size: 1.0625rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: block;
    height: 100%;
    padding: 0.75rem 0.75rem 1.25rem;
    background: var(--ice);
    color: var(--navy);
    text-decoration: none;
    box-shadow: 6px 6px 0 var(--navy);
    transition:
      transform 200ms cubic-bezier(0.2, 0.75, 0.1, 1),
      box-shadow 200ms cubic-bezier(0.2, 0.75, 0.1, 1);
  }
  /* Hover, keyboard focus and a tap share one look. */
  .card:hover,
  .card:focus-visible,
  .card:active {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--pink);
  }
  .card:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 3px;
  }

  /* The live site at a desktop width, scaled to a quarter. */
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--navy);
  }
  .thumb iframe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 400%;
    height: 400%;
    border: 0;
    transform: scale(0.25);
    transform-origin: 0 0;
    pointer-events: none;
  }

  h2 {
    margin: 1rem 0.25rem 0;
    font-size: 1.375rem;
    font-weight: 800;
    font-stretch: 85%;
    line-height: 1.15;
  }
  .card p {
    margin: 0.375rem 0.25rem 0;
    font-size: 1rem;
  }

  /* Arrow chip: the card's whole box is the link; the chip only says so. */
  .card {
    display: flex;
    flex-direction: column;
  }
  .go {
    display: grid;
    place-items: center;
    align-self: flex-end;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: auto;
    background: var(--navy);
    color: var(--ice);
    transition:
      background 200ms,
      transform 200ms cubic-bezier(0.2, 0.75, 0.1, 1);
  }
  .card p {
    margin-bottom: 0.75rem;
  }
  .card:hover .go,
  .card:focus-visible .go,
  .card:active .go {
    background: var(--pink);
    color: var(--navy);
  }
  .go svg {
    transition: transform 200ms cubic-bezier(0.2, 0.75, 0.1, 1);
  }
  .card:hover .go svg,
  .card:focus-visible .go svg,
  .card:active .go svg {
    transform: translateX(3px);
  }

  /* Title wave: each letter hops, leans and flashes pink in turn. Transform only, so nothing reflows. */
  .ch {
    display: inline-block;
  }
  .waving .ch {
    animation: hop 620ms cubic-bezier(0.3, 0.7, 0.2, 1) calc(var(--i) * 38ms) both;
  }
  @keyframes hop {
    35% {
      transform: translateY(-0.18em) rotate(-6deg) scale(1.08);
      color: var(--pink);
    }
    70% {
      transform: translateY(0.03em) rotate(1deg);
    }
  }

  .foot {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: clamp(3.5rem, 9vw, 6rem) var(--gutter) clamp(1.5rem, 4vw, 2.25rem);
    background: var(--navy);
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s ease-out;
  }
  .field:global(.on) {
    opacity: 1;
  }
  .home {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .home span {
    display: inline-block;
    color: var(--pink);
    transition: transform 200ms cubic-bezier(0.2, 0.75, 0.1, 1);
  }
  .home:hover span,
  .home:focus-visible span,
  .home:active span {
    transform: translate(3px, -3px);
  }
  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .icons a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: 0.5rem;
    border: 2px solid var(--ice);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 200ms cubic-bezier(0.2, 0.75, 0.1, 1),
      box-shadow 200ms cubic-bezier(0.2, 0.75, 0.1, 1),
      background 200ms,
      color 200ms;
  }
  .icons a:hover,
  .icons a:focus-visible,
  .icons a:active {
    background: var(--ice);
    color: var(--navy);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--pink);
  }
  /* The language this page is in: filled, like a pressed key. */
  .icons [aria-current] {
    background: var(--pink);
    border-color: var(--pink);
    color: var(--navy);
  }
  /* Anybody's caps sit high in their line box. */
  .icons .lang {
    padding-top: 0.45em;
  }
  .foot a:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 3px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .go,
    .go svg,
    .icons a,
    .home span {
      transition: none;
    }
  }
</style>
